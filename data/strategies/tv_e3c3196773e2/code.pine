//@version=6
strategy(
    title = "WTI/USDT PERP Glint News Pionex Bot GA #1",
    shorttitle = "WTI_USDT_PERP GA #1",
    overlay = true,
    initial_capital = 100,
    currency = "USDT",
    default_qty_type = strategy.percent_of_equity,
    default_qty_value = 100.0,
    commission_type = strategy.commission.percent,
    commission_value = 0.1,
    pyramiding = 1,
    margin_long = 0,
    margin_short = 0,
    calc_on_every_tick = false,
    calc_on_order_fills = false,
    process_orders_on_close = false,
    max_lines_count = 200,
    max_labels_count = 200,
    max_boxes_count = 200
)

grp_main = "Bot Einstellungen"
contracts = input.string("0.01", "Contracts", group=grp_main)
min_conf = input.int(35, "Min. Confidence Score", minval=0, maxval=100, group=grp_main)
use_shorts = input.bool(true, "Short Signale aktivieren", group=grp_main)
send_close = input.bool(true, "Close Signale senden", group=grp_main)

grp_risk = "Risiko und Filter"
risk_pct = input.float(0.002, "Positionsgroesse (Equity-Fraktion)", minval=0.0001, maxval=1.0, step=0.0001, group=grp_risk)
sl_atr_mul = input.float(0.805, "SL ATR Multiplikator", minval=0.1, step=0.1, group=grp_risk)
tp_atr_mul = input.float(1.9, "TP ATR Multiplikator", minval=0.1, step=0.1, group=grp_risk)
vol_mult = input.float(0.8, "Volumen Multiplikator", minval=0.5, step=0.1, group=grp_risk)
max_daily_move_pct = input.float(15.702, "Max Tagesbewegung Prozent", minval=0.5, step=0.5, group=grp_risk)
pivot_len = input.int(4, "CISD Pivot Laenge", minval=1, maxval=20, group=grp_risk)
body_floor_mult = input.float(0.1, "OB Body Floor (ATR Faktor)", minval=0.01, step=0.01, group=grp_risk)
ob_body_mult = input.float(1.1, "OB Body Multiplikator", minval=0.5, step=0.1, group=grp_risk)
w_trend = input.int(9, "Gewicht Trend", minval=0, maxval=100, group=grp_risk)
w_cisd = input.int(35, "Gewicht CISD", minval=0, maxval=100, group=grp_risk)
w_ob = input.int(22, "Gewicht Order Block", minval=0, maxval=100, group=grp_risk)
w_fvg = input.int(23, "Gewicht FVG", minval=0, maxval=100, group=grp_risk)
w_news = input.int(20, "Gewicht News", minval=0, maxval=100, group=grp_risk)
w_vol = input.int(16, "Gewicht Volumen", minval=0, maxval=100, group=grp_risk)

grp_tf = "Zeitfenster (3m Setup)"
tf_trend_high = input.timeframe("48", "Trend TF High", group=grp_tf)
tf_trend_mid = input.timeframe("12", "Trend TF Mid", group=grp_tf)
tf_trend_low = input.timeframe("3", "Trend TF Low", group=grp_tf)

grp_session = "Session"
use_session = input.bool(true, "Session Filter aktivieren", group=grp_session)
session_time = input.session("0800-2200", "Trading Session (UTC)", group=grp_session)

grp_news = "Glint News"
news_bull = input.bool(false, "News Bullish", group=grp_news)
news_bear = input.bool(false, "News Bearish", group=grp_news)

grp_vis = "Visualisierung"
show_ob = input.bool(true, "Order Blocks anzeigen", group=grp_vis)
show_fvg = input.bool(true, "FVGs anzeigen", group=grp_vis)
show_cisd = input.bool(true, "CISD Linien anzeigen", group=grp_vis)
show_table = input.bool(true, "Status Tabelle anzeigen", group=grp_vis)

f_payload(string tv_action, string tv_contracts, string pos_size) =>
    "{\"data\":{\"action\":\"" + tv_action + "\",\"contracts\":\"" + tv_contracts + "\",\"position_size\":\"" + pos_size + "\"},\"price\":\"{{close}}\",\"signal_param\":\"{}\",\"symbol\":\"{{ticker}}\",\"time\":\"{{timenow}}\"}"

f_trend_bull() =>
    ema50 = ta.ema(close, 50)
    ema200 = ta.ema(close, 200)
    ema50 > ema200 and close > ema50

f_trend_bear() =>
    ema50 = ta.ema(close, 50)
    ema200 = ta.ema(close, 200)
    ema50 < ema200 and close < ema50

bool in_session = not use_session or not na(time(timeframe.period, session_time))
float day_open = request.security(syminfo.tickerid, "D", open[1], lookahead=barmerge.lookahead_off)
float daily_move_pct = day_open > 0 ? math.abs(close - day_open) / day_open * 100.0 : 0.0
bool daily_guard_active = daily_move_pct >= max_daily_move_pct

bool h4_bull = request.security(syminfo.tickerid, tf_trend_high, f_trend_bull()[1], lookahead=barmerge.lookahead_off)
bool h4_bear = request.security(syminfo.tickerid, tf_trend_high, f_trend_bear()[1], lookahead=barmerge.lookahead_off)
bool h1_bull = request.security(syminfo.tickerid, tf_trend_mid, f_trend_bull()[1], lookahead=barmerge.lookahead_off)
bool h1_bear = request.security(syminfo.tickerid, tf_trend_mid, f_trend_bear()[1], lookahead=barmerge.lookahead_off)
bool m15_bull = request.security(syminfo.tickerid, tf_trend_low, f_trend_bull()[1], lookahead=barmerge.lookahead_off)
bool m15_bear = request.security(syminfo.tickerid, tf_trend_low, f_trend_bear()[1], lookahead=barmerge.lookahead_off)

atr = ta.atr(14)
atr_safe = math.max(atr, close * 0.0001)
vol_ma = ta.sma(volume, 20)
bool is_vol_high = volume > vol_ma * vol_mult

pivot_high = ta.pivothigh(high, pivot_len, pivot_len)
pivot_low = ta.pivotlow(low, pivot_len, pivot_len)
var float last_ph = na
var float last_pl = na
if not na(pivot_high)
    last_ph := pivot_high
if not na(pivot_low)
    last_pl := pivot_low

bool cisd_bull = not na(last_ph) and ta.crossover(close, last_ph)
bool cisd_bear = not na(last_pl) and ta.crossunder(close, last_pl)

float body_curr = math.abs(close - open)
float body_prev = math.abs(close[1] - open[1])
float body_min = math.max(body_prev, atr_safe * body_floor_mult)
bool ob_bull = close[1] < open[1] and close > open and body_curr > body_min * ob_body_mult
bool ob_bear = close[1] > open[1] and close < open and body_curr > body_min * ob_body_mult

bool fvg_bull = low > high[2] and close[1] > open[1]
bool fvg_bear = high < low[2] and close[1] < open[1]

bool news_dual_active = news_bull and news_bear
bool news_long_active = news_bull and not news_dual_active
bool news_short_active = news_bear and not news_dual_active

int score_long = 0
int score_short = 0
if h4_bull
    score_long += w_trend
if h4_bear
    score_short += w_trend
if h1_bull
    score_long += w_trend
if h1_bear
    score_short += w_trend
if m15_bull
    score_long += w_trend
if m15_bear
    score_short += w_trend
if cisd_bull
    score_long += w_cisd
if cisd_bear
    score_short += w_cisd
if ob_bull
    score_long += w_ob
if ob_bear
    score_short += w_ob
if fvg_bull
    score_long += w_fvg
if fvg_bear
    score_short += w_fvg
if news_long_active
    score_long += w_news
if news_short_active
    score_short += w_news
if is_vol_high
    score_long += w_vol
    score_short += w_vol

bool confirmed = barstate.isconfirmed
bool block_long = news_short_active or not in_session or daily_guard_active
bool block_short = news_long_active or not in_session or daily_guard_active

float size_units = strategy.equity * risk_pct / close

var float active_sl = na
var float active_tp = na
var float entry_price = na
var string exit_reason = ""

bool long_setup = confirmed and score_long >= min_conf and not block_long and strategy.position_size == 0
bool short_setup = confirmed and score_short >= min_conf and not block_short and use_shorts and strategy.position_size == 0

bool long_reverse = confirmed and strategy.position_size > 0 and score_short >= min_conf and not block_short and use_shorts
bool short_reverse = confirmed and strategy.position_size < 0 and score_long >= min_conf and not block_long
bool long_block_exit = confirmed and strategy.position_size > 0 and block_long
bool short_block_exit = confirmed and strategy.position_size < 0 and block_short

if long_reverse or long_block_exit
    exit_reason := long_block_exit ? "BLOCK" : "REVERSE"
    strategy.close("Long", comment=exit_reason, alert_message=send_close ? f_payload("sell", contracts, "0") : "")

if short_reverse or short_block_exit
    exit_reason := short_block_exit ? "BLOCK" : "REVERSE"
    strategy.close("Short", comment=exit_reason, alert_message=send_close ? f_payload("buy", contracts, "0") : "")

if long_setup
    exit_reason := ""
    strategy.entry("Long", strategy.long, qty=size_units, alert_message=f_payload("buy", contracts, "1"))

if short_setup
    exit_reason := ""
    strategy.entry("Short", strategy.short, qty=size_units, alert_message=f_payload("sell", contracts, "-1"))

bool new_long = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool new_short = strategy.position_size < 0 and strategy.position_size[1] >= 0

if new_long
    entry_price := strategy.position_avg_price
    active_sl := entry_price - atr_safe * sl_atr_mul
    active_tp := entry_price + atr_safe * tp_atr_mul

if new_short
    entry_price := strategy.position_avg_price
    active_sl := entry_price + atr_safe * sl_atr_mul
    active_tp := entry_price - atr_safe * tp_atr_mul

if strategy.position_size > 0 and not na(active_sl) and not na(active_tp)
    strategy.exit("Long Exit", from_entry="Long", stop=active_sl, limit=active_tp, alert_message=send_close ? f_payload("sell", contracts, "0") : "")

if strategy.position_size < 0 and not na(active_sl) and not na(active_tp)
    strategy.exit("Short Exit", from_entry="Short", stop=active_sl, limit=active_tp, alert_message=send_close ? f_payload("buy", contracts, "0") : "")

if strategy.position_size == 0 and strategy.position_size[1] != 0
    entry_price := na
    active_sl := na
    active_tp := na

plot(entry_price, color=color.new(color.orange, 0), linewidth=2, title="Entry")
plot(strategy.position_size != 0 ? active_sl : na, color=color.new(color.red, 0), linewidth=1, title="SL")
plot(strategy.position_size != 0 ? active_tp : na, color=color.new(color.green, 0), linewidth=1, title="TP")

plotshape(show_cisd and cisd_bull, title="CISD Bull", location=location.belowbar, color=color.new(color.lime, 0), style=shape.circle, size=size.tiny)
plotshape(show_cisd and cisd_bear, title="CISD Bear", location=location.abovebar, color=color.new(color.red, 0), style=shape.circle, size=size.tiny)
plotshape(show_ob and ob_bull, title="OB Bull", location=location.belowbar, color=color.new(color.green, 0), style=shape.triangleup, size=size.tiny)
plotshape(show_ob and ob_bear, title="OB Bear", location=location.abovebar, color=color.new(color.maroon, 0), style=shape.triangledown, size=size.tiny)
plotshape(show_fvg and fvg_bull, title="FVG Bull", location=location.belowbar, color=color.new(color.teal, 0), style=shape.square, size=size.tiny)
plotshape(show_fvg and fvg_bear, title="FVG Bear", location=location.abovebar, color=color.new(color.orange, 0), style=shape.square, size=size.tiny)

var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)
if show_table and barstate.islast
    table.cell(dash, 0, 0, "WTI_USDT_PERP GA #1", text_color=color.white, bgcolor=color.new(color.blue, 60))
    table.cell(dash, 1, 0, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color=strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.silver)
    table.cell(dash, 0, 1, "Score L/S", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(score_long) + " / " + str.tostring(score_short), text_color=color.white)
    table.cell(dash, 0, 2, "Session", text_color=color.white)
    table.cell(dash, 1, 2, in_session ? "ON" : "OFF", text_color=in_session ? color.lime : color.red)
    table.cell(dash, 0, 3, "TF(H/M/L)", text_color=color.white)
    table.cell(dash, 1, 3, (h4_bull ? "B" : h4_bear ? "S" : "-") + " / " + (h1_bull ? "B" : h1_bear ? "S" : "-") + " / " + (m15_bull ? "B" : m15_bear ? "S" : "-"), text_color=color.white)
    table.cell(dash, 0, 4, "Daily Move", text_color=color.white)
    table.cell(dash, 1, 4, str.tostring(daily_move_pct, "#.##") + "%", text_color=daily_guard_active ? color.orange : color.white)
    table.cell(dash, 0, 5, "Risk", text_color=color.white)
    table.cell(dash, 1, 5, str.tostring(risk_pct * 100.0, "#.###") + "%", text_color=color.aqua)
    table.cell(dash, 0, 6, "Contracts", text_color=color.white)
    table.cell(dash, 1, 6, contracts, text_color=color.white)
    table.cell(dash, 0, 7, "Exit", text_color=color.white)
    table.cell(dash, 1, 7, exit_reason == "" ? "NONE" : exit_reason, text_color=exit_reason == "BLOCK" ? color.orange : exit_reason == "REVERSE" ? color.yellow : color.white)
