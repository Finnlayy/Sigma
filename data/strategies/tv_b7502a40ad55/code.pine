//@version=6
// =====================================================================
// The Rule Book v3
// Reiner Regel-Connector mit dynamischem Trailing TP, Break-Even, 
// Bar Counter (Min/Max) und Konfidenz-Sizing.
// =====================================================================

strategy(
    title="The Rule Book",
    shorttitle="RuleBook",
    overlay=true,
    initial_capital=100,
    currency=currency.USDT,
    default_qty_type=strategy.cash,
    default_qty_value=100,
    pyramiding=3,
    calc_on_every_tick=false,
    process_orders_on_close=true,
    commission_type=strategy.commission.percent,
    commission_value=0.05,
    slippage=2,
    margin_long=0,
    margin_short=0,
    max_labels_count=200
)

const int STARTZEIT_DEFAULT = 1744119900000

