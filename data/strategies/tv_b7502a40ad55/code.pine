f_payload() =>
    "{\"data\":{\"action\":\"" + "{{strategy.order.action}}" + "\",\"contracts\":\"" + "{{strategy.order.contracts}}" + "\",\"position_size\":\"" + str.tostring(strategy.position_size) + "\"},\"price\":\"" + str.tostring(close) + "\",\"signal_param\":\"{}\",\"signal_type\":\"" + pionex_uuid + "\",\"symbol\":\"" + syminfo.ticker + "\",\"time\":\"" + str.tostring(timenow) + "\"}"

// =====================================================================
// HILFSFUNKTIONEN
// =====================================================================
f_compare(float links, string op, float rechts, float tol) =>
    bool cross_over = ta.crossover(links, rechts)
    bool cross_under = ta.crossunder(links, rechts)
    bool active = not na(links) and math.abs(links) > tol
    bool result = false
    if op == "Ist aktiv"
        result := active
    else if op == "Ist inaktiv"
        result := not active
    else if op == "Gleich"
        result := math.abs(links - rechts) <= tol
    else if op == "Nicht gleich"
        result := math.abs(links - rechts) > tol
    else if op == "Groesser"
        result := links > rechts
    else if op == "Kleiner"
        result := links < rechts
    else if op == "Groesser/gleich"
        result := links >= rechts
    else if op == "Kleiner/gleich"
        result := links <= rechts
    else if op == "Kreuzt ueber"
        result := cross_over
    else if op == "Kreuzt unter"
        result := cross_under
    result

f_recent(bool bedingung, int kerzen) =>
    int seit = ta.barssince(bedingung)
    kerzen == 0 ? bedingung : not na(seit) and seit <= kerzen

f_rule_hit(bool aktiv, float links, string op, string rechts_typ, float wert, float rechts_quelle) =>
    float rechts = rechts_typ == "Quelle" ? rechts_quelle : wert
    bool raw = aktiv and quellen_verbunden and f_compare(links, op, rechts, gleich_toleranz)
    bool remembered = f_recent(raw, signal_gedaechtnis)
    ausloese_modus == "Nur neues Signal" ? remembered and not remembered[1] : remembered

f_round_qty(float menge, float schritt) =>
    schritt > 0 ? math.floor(menge / schritt) * schritt : menge

f_kelly_prozent(float trefferquote, float win_loss, float anteil, float min_prozent, float max_prozent) =>
    float raw = win_loss > 0 ? trefferquote - (1.0 - trefferquote) / win_loss : 0.0
    float positiv = math.max(0.0, raw)
    float prozent = positiv > 0 ? positiv * anteil * 100.0 : min_prozent
    math.min(max_prozent, math.max(0.0, prozent))

f_auto_kelly_prozent(int lookback, float anteil, float min_prozent, float max_prozent) =>
    int trade_count = strategy.closedtrades
    int sample_size = math.min(trade_count, lookback)
    float wins = 0.0
    float losses = 0.0
    float gross_win = 0.0
    float gross_loss = 0.0
    if sample_size > 0
        int first_trade = trade_count - sample_size
        int last_trade = trade_count - 1
        for trade_no = first_trade to last_trade
            float trade_profit = strategy.closedtrades.profit(trade_no)
            if trade_profit > 0
                wins += 1.0
                gross_win += trade_profit
            else if trade_profit < 0
                losses += 1.0
                gross_loss += math.abs(trade_profit)
    float total = wins + losses
    float trefferquote = total > 0 ? wins / total : 0.0
    float avg_win = wins > 0 ? gross_win / wins : na
    float avg_loss = losses > 0 ? gross_loss / losses : na
    float win_loss = not na(avg_win) and not na(avg_loss) and avg_loss > 0 ? avg_win / avg_loss : 0.0
    f_kelly_prozent(trefferquote, win_loss, anteil, min_prozent, max_prozent)

// =====================================================================
// REGEL-AUSWERTUNG
// =====================================================================
bool zeit_ok = not startzeit_aktiv or time >= startzeit

bool regel_1_hit = zeit_ok and barstate.isconfirmed and f_rule_hit(regel_1_aktiv, regel_1_links, regel_1_operator, regel_1_rechts_typ, regel_1_wert, regel_1_rechts)
bool regel_2_hit = zeit_ok and barstate.isconfirmed and f_rule_hit(regel_2_aktiv, regel_2_links, regel_2_operator, regel_2_rechts_typ, regel_2_wert, regel_2_rechts)
bool regel_3_hit = zeit_ok and barstate.isconfirmed and f_rule_hit(regel_3_aktiv, regel_3_links, regel_3_operator, regel_3_rechts_typ, regel_3_wert, regel_3_rechts)
bool regel_4_hit = zeit_ok and barstate.isconfirmed and f_rule_hit(regel_4_aktiv, regel_4_links, regel_4_operator, regel_4_rechts_typ, regel_4_wert, regel_4_rechts)
bool regel_5_hit = zeit_ok and barstate.isconfirmed and f_rule_hit(regel_5_aktiv, regel_5_links, regel_5_operator, regel_5_rechts_typ, regel_5_wert, regel_5_rechts)
bool regel_6_hit = zeit_ok and barstate.isconfirmed and f_rule_hit(regel_6_aktiv, regel_6_links, regel_6_operator, regel_6_rechts_typ, regel_6_wert, regel_6_rechts)
bool regel_7_hit = zeit_ok and barstate.isconfirmed and f_rule_hit(regel_7_aktiv, regel_7_links, regel_7_operator, regel_7_rechts_typ, regel_7_wert, regel_7_rechts)
bool regel_8_hit = zeit_ok and barstate.isconfirmed and f_rule_hit(regel_8_aktiv, regel_8_links, regel_8_operator, regel_8_rechts_typ, regel_8_wert, regel_8_rechts)

bool long_open_req  = (regel_1_hit and regel_1_aktion == "Long oeffnen") or (regel_2_hit and regel_2_aktion == "Long oeffnen") or (regel_3_hit and regel_3_aktion == "Long oeffnen") or (regel_4_hit and regel_4_aktion == "Long oeffnen") or (regel_5_hit and regel_5_aktion == "Long oeffnen") or (regel_6_hit and regel_6_aktion == "Long oeffnen") or (regel_7_hit and regel_7_aktion == "Long oeffnen") or (regel_8_hit and regel_8_aktion == "Long oeffnen")
bool short_open_req = (regel_1_hit and regel_1_aktion == "Short oeffnen") or (regel_2_hit and regel_2_aktion == "Short oeffnen") or (regel_3_hit and regel_3_aktion == "Short oeffnen") or (regel_4_hit and regel_4_aktion == "Short oeffnen") or (regel_5_hit and regel_5_aktion == "Short oeffnen") or (regel_6_hit and regel_6_aktion == "Short oeffnen") or (regel_7_hit and regel_7_aktion == "Short oeffnen") or (regel_8_hit and regel_8_aktion == "Short oeffnen")
bool long_close_req = (regel_1_hit and regel_1_aktion == "Long schliessen") or (regel_2_hit and regel_2_aktion == "Long schliessen") or (regel_3_hit and regel_3_aktion == "Long schliessen") or (regel_4_hit and regel_4_aktion == "Long schliessen") or (regel_5_hit and regel_5_aktion == "Long schliessen") or (regel_6_hit and regel_6_aktion == "Long schliessen") or (regel_7_hit and regel_7_aktion == "Long schliessen") or (regel_8_hit and regel_8_aktion == "Long schliessen")
bool short_close_req = (regel_1_hit and regel_1_aktion == "Short schliessen") or (regel_2_hit and regel_2_aktion == "Short schliessen") or (regel_3_hit and regel_3_aktion == "Short schliessen") or (regel_4_hit and regel_4_aktion == "Short schliessen") or (regel_5_hit and regel_5_aktion == "Short schliessen") or (regel_6_hit and regel_6_aktion == "Short schliessen") or (regel_7_hit and regel_7_aktion == "Short schliessen") or (regel_8_hit and regel_8_aktion == "Short schliessen")
bool all_close_req  = (regel_1_hit and regel_1_aktion == "Alle schliessen") or (regel_2_hit and regel_2_aktion == "Alle schliessen") or (regel_3_hit and regel_3_aktion == "Alle schliessen") or (regel_4_hit and regel_4_aktion == "Alle schliessen") or (regel_5_hit and regel_5_aktion == "Alle schliessen") or (regel_6_hit and regel_6_aktion == "Alle schliessen") or (regel_7_hit and regel_7_aktion == "Alle schliessen") or (regel_8_hit and regel_8_aktion == "Alle schliessen")

// =====================================================================
// ORDER GROESSE & KONFIDENZ SIZING
// =====================================================================
float manuell_kelly_prozent = f_kelly_prozent(manuell_kelly_trefferquote * 0.01, manuell_kelly_win_loss, kelly_anteil, kelly_min_prozent, kelly_max_prozent)
float auto_kelly_prozent = f_auto_kelly_prozent(auto_kelly_lookback, kelly_anteil, kelly_min_prozent, kelly_max_prozent)

float konfidenz_skaliert_pct = 0.0
if konfidenz_wert >= min_konfidenz
    float conf_scale = (konfidenz_wert - min_konfidenz) / (1.0 - min_konfidenz)
    konfidenz_skaliert_pct := (kelly_anteil * 100.0) * (1.0 + conf_scale * (max_risk_mult - 1.0))
else
    konfidenz_skaliert_pct := 0.0

float aktiver_kapital_prozent = groessen_modus == "Manuelles Kelly" ? manuell_kelly_prozent : groessen_modus == "Auto Kelly" ? auto_kelly_prozent : groessen_modus == "Konfidenz & Risiko" ? konfidenz_skaliert_pct : na
float order_wert = groessen_modus == "Fester Einsatz" ? fester_einsatz_usdt : strategy.equity * aktiver_kapital_prozent * 0.01
float order_menge_raw = close > 0 ? order_wert / close : 0.0
float order_menge = f_round_qty(order_menge_raw, mengen_schritt)
bool groesse_ok = order_menge >= mengen_schritt
string payload_message = str.length(pionex_uuid) > 0 ? f_payload() : ""

// =====================================================================
// ENTRY / CLOSE & POSITIONSSTATUS LOGIK
// =====================================================================
isCurrentlyShort = strategy.position_size < 0
isCurrentlyLong  = strategy.position_size > 0

// Signale verknüpft mit "AND NOT Gegenposition im Gange"
bool clean_long_open  = long_open_req and not short_open_req and (not check_and_not_short or not isCurrentlyShort)
bool clean_short_open = short_open_req and not long_open_req and (not check_and_not_long or not isCurrentlyLong)

// Pruefe Reversal (Gegensignal)
bool opposite_long_to_short = clean_short_open and strategy.position_size > 0
bool opposite_short_to_long = clean_long_open and strategy.position_size < 0
bool same_long_to_long   = clean_long_open and strategy.position_size > 0
bool same_short_to_short = clean_short_open and strategy.position_size < 0

bool allow_turn = reversal_aktiv or modus_gleiche_richtung == "Schliessen & Neustart"
bool turn_long_to_short = allow_turn and opposite_long_to_short
bool turn_short_to_long = allow_turn and opposite_short_to_long

bool restart_long  = same_long_to_long and modus_gleiche_richtung == "Schliessen & Neustart"
bool restart_short = same_short_to_short and modus_gleiche_richtung == "Schliessen & Neustart"
bool scale_long    = same_long_to_long and modus_gleiche_richtung == "Einsatz erhoehen (Pyramiden)"
bool scale_short   = same_short_to_short and modus_gleiche_richtung == "Einsatz erhoehen (Pyramiden)"

var int entry_bar = na
bool neue_position = strategy.position_size != 0 and strategy.position_size[1] == 0
bool richtungswechsel = (strategy.position_size > 0 and strategy.position_size[1] < 0) or (strategy.position_size < 0 and strategy.position_size[1] > 0)
bool position_geschlossen = strategy.position_size == 0 and strategy.position_size[1] != 0

if neue_position or richtungswechsel or restart_long or restart_short or scale_long or scale_short
    entry_bar := bar_index

if position_geschlossen
    entry_bar := na

int bars_im_trade = not na(entry_bar) ? bar_index - entry_bar : 0

// Bar Counter Exits (Min & Max Bars)
bool min_bars_ok = minimale_trade_dauer == 0 or bars_im_trade >= minimale_trade_dauer
bool zeit_exit_long  = maximale_trade_dauer > 0 and strategy.position_size > 0 and bars_im_trade >= maximale_trade_dauer
bool zeit_exit_short = maximale_trade_dauer > 0 and strategy.position_size < 0 and bars_im_trade >= maximale_trade_dauer

bool do_long_close  = strategy.position_size > 0 and min_bars_ok and (all_close_req or long_close_req or turn_long_to_short or restart_long or zeit_exit_long)
bool do_short_close = strategy.position_size < 0 and min_bars_ok and (all_close_req or short_close_req or turn_short_to_long or restart_short or zeit_exit_short)

// =====================================================================
// ORDER AUSFUEHRUNG
// =====================================================================
if do_long_close
    string lc_kommentar = turn_long_to_short ? "Opposite Close Long" : restart_long ? "Restart Long" : zeit_exit_long ? "Max Bars Exit" : "Rule Long Close"
    strategy.close("Long", comment=lc_kommentar, alert_message=close_alerts_senden ? payload_message : "")

if do_short_close
    string sc_kommentar = turn_short_to_long ? "Opposite Close Short" : restart_short ? "Restart Short" : zeit_exit_short ? "Max Bars Exit" : "Rule Short Close"
    strategy.close("Short", comment=sc_kommentar, alert_message=close_alerts_senden ? payload_message : "")

float atr_val = ta.atr(sl_atr_len)
var float trade_sl_price = na
var float trail_high = na
var float trail_low = na
var float trail_stop_long = na
var float trail_stop_short = na

bool enter_long  = clean_long_open and groesse_ok and (strategy.position_size == 0 or turn_short_to_long or restart_long or scale_long)
bool enter_short = clean_short_open and groesse_ok and (strategy.position_size == 0 or turn_long_to_short or restart_short or scale_short)

if enter_long
    float sl_dist = sl_typ == "ATR" ? (atr_val * sl_faktor) : (close * sl_faktor / 100.0)
    trade_sl_price := close - sl_dist
    strategy.entry("Long", strategy.long, qty=order_menge, comment=scale_long ? "Scale In Long" : "Rule Long", alert_message=payload_message)

if enter_short
    float sl_dist = sl_typ == "ATR" ? (atr_val * sl_faktor) : (close * sl_faktor / 100.0)
    trade_sl_price := close + sl_dist
    strategy.entry("Short", strategy.short, qty=order_menge, comment=scale_short ? "Scale In Short" : "Rule Short", alert_message=payload_message)

bool position_changed_to_long = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool position_changed_to_short = strategy.position_size < 0 and strategy.position_size[1] >= 0

if position_changed_to_long
    trail_high := na
    trail_stop_long := na

if position_changed_to_short
    trail_low := na
    trail_stop_short := na

if strategy.position_size == 0
    trade_sl_price := na
    trail_high := na
    trail_low := na
    trail_stop_long := na
    trail_stop_short := na

// Break-Even Stop Adjuster
var float break_even_sl_price = na
if break_even_aktiv and strategy.position_size > 0
    float be_trigger = strategy.position_avg_price * (1.0 + break_even_trigger_pct / 100.0)
    if high >= be_trigger
        break_even_sl_price := strategy.position_avg_price * (1.0 + break_even_offset_pct / 100.0)
else if break_even_aktiv and strategy.position_size < 0
    float be_trigger = strategy.position_avg_price * (1.0 - break_even_trigger_pct / 100.0)
    if low <= be_trigger
        break_even_sl_price := strategy.position_avg_price * (1.0 - break_even_offset_pct / 100.0)
else
    break_even_sl_price := na

float final_sl_price = not na(break_even_sl_price) ? break_even_sl_price : trade_sl_price

// =====================================================================
// TP & SL LOGIK (ATR & VOLUMEN DYNAMISCHER TRAILING TP)
// =====================================================================
pos_price = strategy.position_avg_price

vol_ma = ta.sma(volume, ttp_vol_len)
rel_vol = vol_ma > 0 ? volume / vol_ma : 1.0
vol_factor = ttp_use_vol ? math.max(0.5, math.min(2.0, math.pow(rel_vol, ttp_vol_sens))) : 1.0

if strategy.position_size > 0
    trail_high := na(trail_high) ? high : math.max(trail_high, high)
else
    trail_high := na

if strategy.position_size < 0
    trail_low := na(trail_low) ? low : math.min(trail_low, low)
else
    trail_low := na

float trail_activation_price = na
float trail_distance = na
bool trail_active_long = false
bool trail_active_short = false

if trailing_tp_aktiv and pos_price > 0
    if trailing_tp_modus == "ATR & Volumen Dynamisch"
        trail_activation_price := atr_val * trailing_tp_act_pct
        trail_distance := atr_val * trailing_tp_trail_pct * vol_factor
    else
        trail_activation_price := pos_price * trailing_tp_act_pct / 100.0
        trail_distance := pos_price * trailing_tp_trail_pct / 100.0

    trail_active_long := strategy.position_size > 0 and not na(trail_high) and (trail_high - pos_price) >= trail_activation_price
    trail_active_short := strategy.position_size < 0 and not na(trail_low) and (pos_price - trail_low) >= trail_activation_price

    trail_stop_long := trail_active_long ? trail_high - trail_distance : na
    trail_stop_short := trail_active_short ? trail_low + trail_distance : na
else
    trail_stop_long := na
    trail_stop_short := na

float longExitStop = na
float shortExitStop = na

if strategy.position_size > 0 and min_bars_ok
    longExitStop := sl_aktiv or not na(break_even_sl_price) ? final_sl_price : na
    longExitStop := trailing_tp_aktiv and not na(trail_stop_long) ? (na(longExitStop) ? trail_stop_long : math.max(longExitStop, trail_stop_long)) : longExitStop
    strategy.exit("Exit Long", "Long", stop=longExitStop, alert_message=close_alerts_senden ? payload_message : "")

if strategy.position_size < 0 and min_bars_ok
    shortExitStop := sl_aktiv or not na(break_even_sl_price) ? final_sl_price : na
    shortExitStop := trailing_tp_aktiv and not na(trail_stop_short) ? (na(shortExitStop) ? trail_stop_short : math.min(shortExitStop, trail_stop_short)) : shortExitStop
    strategy.exit("Exit Short", "Short", stop=shortExitStop, alert_message=close_alerts_senden ? payload_message : "")

// =====================================================================
// VISUALISIERUNG & STATUS TABELLE
// =====================================================================
plot((sl_aktiv or not na(break_even_sl_price)) and strategy.position_size != 0 ? final_sl_price : na, title="Stop Loss / BE", color=color.red, style=plot.style_linebr, linewidth=2)
plot(trailing_tp_aktiv and strategy.position_size > 0 ? trail_stop_long : na, title="Trailing TP Long", color=color.lime, style=plot.style_linebr, linewidth=2)
plot(trailing_tp_aktiv and strategy.position_size < 0 ? trail_stop_short : na, title="Trailing TP Short", color=color.fuchsia, style=plot.style_linebr, linewidth=2)
plotshape(clean_long_open, title="Regel Long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="LO")
plotshape(clean_short_open, title="Regel Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SO")
plotshape(do_long_close, title="Regel Long Close", style=shape.xcross, location=location.abovebar, color=color.orange, size=size.tiny, text="LC")
plotshape(do_short_close, title="Regel Short Close", style=shape.xcross, location=location.belowbar, color=color.orange, size=size.tiny, text="SC")
bgcolor(not quellen_verbunden ? color.new(color.orange, 90) : not zeit_ok ? color.new(color.gray, 92) : na)

int aktive_regeln = (regel_1_aktiv ? 1 : 0) + (regel_2_aktiv ? 1 : 0) + (regel_3_aktiv ? 1 : 0) + (regel_4_aktiv ? 1 : 0) + (regel_5_aktiv ? 1 : 0) + (regel_6_aktiv ? 1 : 0) + (regel_7_aktiv ? 1 : 0) + (regel_8_aktiv ? 1 : 0)
int getroffene_regeln = (regel_1_hit ? 1 : 0) + (regel_2_hit ? 1 : 0) + (regel_3_hit ? 1 : 0) + (regel_4_hit ? 1 : 0) + (regel_5_hit ? 1 : 0) + (regel_6_hit ? 1 : 0) + (regel_7_hit ? 1 : 0) + (regel_8_hit ? 1 : 0)
float profit_factor = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
float net_profit = strategy.netprofit

var table status = table.new(position.top_right, 2, 15, bgcolor=color.new(color.black, 78), border_width=1)
if status_anzeigen and barstate.islast
    table.cell(status, 0, 0, "The Rule Book", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(status, 1, 0, syminfo.ticker + " " + timeframe.period, text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(status, 0, 1, "Quellen/Zeit", text_color=color.white)
    table.cell(status, 1, 1, quellen_verbunden ? zeit_ok ? "OK" : "VOR START" : "FEHLT", text_color=quellen_verbunden and zeit_ok ? color.lime : color.orange)
    table.cell(status, 0, 2, "Regeln", text_color=color.white)
    table.cell(status, 1, 2, str.tostring(getroffene_regeln) + "/" + str.tostring(aktive_regeln), text_color=getroffene_regeln > 0 ? color.lime : color.white)
    table.cell(status, 0, 3, "Aktion", text_color=color.white)
    table.cell(status, 1, 3, scale_long ? "SCALE IN LONG" : scale_short ? "SCALE IN SHORT" : restart_long ? "RESTART LONG" : restart_short ? "RESTART SHORT" : turn_short_to_long ? "CLOSE->LONG" : turn_long_to_short ? "CLOSE->SHORT" : clean_long_open ? "LONG" : clean_short_open ? "SHORT" : do_long_close ? "LONG CLOSE" : do_short_close ? "SHORT CLOSE" : "WARTEN", text_color=turn_short_to_long or clean_long_open or restart_long or scale_long ? color.lime : turn_long_to_short or clean_short_open or restart_short or scale_short ? color.red : do_long_close or do_short_close ? color.orange : color.gray)
    table.cell(status, 0, 4, "Gleiches Signal", text_color=color.white)
    table.cell(status, 1, 4, modus_gleiche_richtung, text_color=modus_gleiche_richtung != "Ignorieren" ? color.lime : color.white)
    table.cell(status, 0, 5, "Groesse", text_color=color.white)
    table.cell(status, 1, 5, groesse_ok ? str.tostring(order_menge, "#.######") : "KEINE", text_color=groesse_ok ? color.white : color.orange)
    table.cell(status, 0, 6, "Sizing", text_color=color.white)
    table.cell(status, 1, 6, groessen_modus, text_color=groessen_modus == "Fester Einsatz" ? color.white : color.lime)
    table.cell(status, 0, 7, "Kapital %", text_color=color.white)
    table.cell(status, 1, 7, groessen_modus == "Fester Einsatz" ? "-" : str.tostring(aktiver_kapital_prozent, "#.##"), text_color=color.white)
    table.cell(status, 0, 8, "Bars", text_color=color.white)
    table.cell(status, 1, 8, maximale_trade_dauer > 0 ? str.tostring(bars_im_trade) + "/" + str.tostring(maximale_trade_dauer) : str.tostring(bars_im_trade) + "/AUS", text_color=zeit_exit_long or zeit_exit_short ? color.orange : color.white)
    table.cell(status, 0, 9, "Position", text_color=color.white)
    table.cell(status, 1, 9, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color=strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray)
    table.cell(status, 0, 10, "PF", text_color=color.white)
    table.cell(status, 1, 10, na(profit_factor) ? "NA" : str.tostring(profit_factor, "#.##"), text_color=na(profit_factor) ? color.gray : profit_factor >= 1.0 ? color.lime : color.red)
    table.cell(status, 0, 11, "Net Profit", text_color=color.white)
    table.cell(status, 1, 11, str.tostring(net_profit, "#.##"), text_color=net_profit >= 0 ? color.lime : color.red)
    table.cell(status, 0, 12, "Stop Loss", text_color=color.white)
    table.cell(status, 1, 12, sl_aktiv ? sl_typ + " " + str.tostring(sl_faktor) : "AUS", text_color=sl_aktiv ? color.lime : color.white)
    table.cell(status, 0, 13, "Trailing TP", text_color=color.white)
    table.cell(status, 1, 13, trailing_tp_aktiv ? str.tostring(trailing_tp_act_pct) + "% / " + str.tostring(trailing_tp_trail_pct) + "%" : "AUS", text_color=trailing_tp_aktiv ? color.lime : color.white)
