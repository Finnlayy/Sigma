//@version=6
// =================================================================================================
// ETH/USDT QuantDesk Pro v4.0: MTF CISD + OB/FVG + Live News
// =================================================================================================
// PIONEX MASTER RULES APPLIED:
// - initial_capital = 100
// - default_qty_type = strategy.cash
// - default_qty_value = 1 (bis 100 USDT)
// - pyramiding = 1
// - calc_on_every_tick = false
// - margin_long = 0, margin_short = 0
// - process_orders_on_close = true
// - Webhook Payload: Pionex Standard Format (signal_listener)
// =================================================================================================

strategy(
    title             = "ETH/USDT QuantDesk Pro v4",
    shorttitle        = "QuantDesk v4",
    overlay           = true,
    initial_capital   = 100,
    default_qty_type  = strategy.cash,
    default_qty_value = 1,
    pyramiding        = 1,
    calc_on_every_tick= false,
    margin_long       = 0,
    margin_short      = 0,
    process_orders_on_close = true,
    commission_type   = strategy.commission.percent,
    commission_value  = 0.05,
    slippage          = 2,
    max_lines_count   = 200,
    max_labels_count  = 200,
    max_boxes_count   = 200
)

// =================================================================================================
// 1. EINSTELLUNGEN
// =================================================================================================
grp_main   = "Haupt-Einstellungen"
uuid       = input.string("8a17bcf9-0d9c-4a09-92ae-27adf755d95d", "Pionex Signal Bot UUID", group=grp_main)
min_conf   = input.int(75, "Min. Confidence Score (0-100)", minval=0, maxval=100, group=grp_main)
use_shorts = input.bool(true, "Short-Trades erlauben", group=grp_main)

grp_risk   = "Risiko & Filter"
sl_atr_mul = input.float(1.2, "SL ATR Multiplikator", step=0.1, minval=0.1, group=grp_risk)
tp_atr_mul = input.float(4.0, "TP ATR Multiplikator", step=0.1, minval=0.1, group=grp_risk)
vol_mult   = input.float(1.3, "Volumen Multiplikator Filter", step=0.1, minval=0.5, group=grp_risk)
max_dd_pct = input.float(5.0, "Max Drawdown Limit (%)", step=0.5, minval=1.0, group=grp_risk)

grp_session = "Session Filter"
use_session = input.bool(true, "Session-Filter aktivieren", group=grp_session)
session_time = input.session("0800-2200", "Trading Session (UTC)", group=grp_session)

grp_news   = "Glint News Integration"
news_bull  = input.bool(false, "News Sentiment: Bullish (via Webhook)", group=grp_news)
news_bear  = input.bool(false, "News Sentiment: Bearish (via Webhook)", group=grp_news)

grp_vis    = "Visualisierung"
show_ob    = input.bool(true, "Order Blocks anzeigen", group=grp_vis)
show_fvg   = input.bool(true, "FVGs anzeigen", group=grp_vis)
show_cisd  = input.bool(true, "CISD-Linien anzeigen", group=grp_vis)

// =================================================================================================
// 2. SYSTEM STATUS (Session & Drawdown)
// =================================================================================================
// Session Check
bool in_session = not use_session or not na(time(timeframe.period, session_time))

// Drawdown Check
float peak_equity = 0.0
peak_equity := math.max(nz(peak_equity[1], strategy.initial_capital), strategy.equity)
float current_dd_pct = ((peak_equity - strategy.equity) / peak_equity) * 100.0
bool dd_guard_active = current_dd_pct >= max_dd_pct

// =================================================================================================
// 3. ECHTES MULTI-TIMEFRAME (MTF) VIA request.security()
// =================================================================================================
f_trend() =>
    ema50 = ta.ema(close, 50)
    ema200 = ta.ema(close, 200)
    bull = ema50 > ema200 and close > ema50
    bear = ema50 < ema200 and close < ema50
    [bull, bear]

[h4_bull, h4_bear] = request.security(syminfo.tickerid, "240", f_trend(), lookahead=barmerge.lookahead_on)
[h1_bull, h1_bear] = request.security(syminfo.tickerid, "60", f_trend(), lookahead=barmerge.lookahead_on)
[m15_bull, m15_bear] = request.security(syminfo.tickerid, "15", f_trend(), lookahead=barmerge.lookahead_on)

// =================================================================================================
// 4. LOKALE INDIKATOREN (M5)
// =================================================================================================
atr = ta.atr(14)
atr_safe = math.max(atr, close * 0.0001)
vol_ma = ta.sma(volume, 20)
bool is_vol_high = volume > (vol_ma * vol_mult)

// CISD (Change In State of Delivery)
pivot_high = ta.pivothigh(high, 5, 5)
pivot_low  = ta.pivotlow(low,  5, 5)
var float last_ph = na
var float last_pl = na
if not na(pivot_high)
    last_ph := pivot_high
if not na(pivot_low)
    last_pl := pivot_low

bool cisd_bull = not na(last_ph) and ta.crossover(close, last_ph)
bool cisd_bear = not na(last_pl) and ta.crossunder(close, last_pl)

if show_cisd and not na(last_ph)
    line.new(bar_index - 1, last_ph, bar_index, last_ph, color=color.new(color.orange, 60), width=1)
if show_cisd and not na(last_pl)
    line.new(bar_index - 1, last_pl, bar_index, last_pl, color=color.new(color.aqua, 60), width=1)

// Order Blocks
float body_curr = math.abs(close - open)
float body_prev = math.abs(close[1] - open[1])
float body_min  = math.max(body_prev, atr_safe * 0.1)

bool ob_bull = close[1] < open[1] and close > open and body_curr > body_min * 1.5
bool ob_bear = close[1] > open[1] and close < open and body_curr > body_min * 1.5

if show_ob and ob_bull
    box.new(bar_index - 1, open[1], bar_index, close[1], bgcolor=color.new(color.green, 85), border_color=color.new(color.green, 40))
if show_ob and ob_bear
    box.new(bar_index - 1, open[1], bar_index, close[1], bgcolor=color.new(color.red, 85), border_color=color.new(color.red, 40))

// FVG
bool fvg_bull = low > high[2] and close[1] > open[1]
bool fvg_bear = high < low[2] and close[1] < open[1]

if show_fvg and fvg_bull
    box.new(bar_index - 2, high[2], bar_index, low, bgcolor=color.new(color.teal, 88), border_color=color.new(color.teal, 50))
if show_fvg and fvg_bear
    box.new(bar_index - 2, low[2], bar_index, high, bgcolor=color.new(color.maroon, 88), border_color=color.new(color.maroon, 50))

// =================================================================================================
// 5. SCORING ENGINE (0-100)
// =================================================================================================
int score_long = 0
int score_short = 0

if h4_bull
    score_long += 10
if h4_bear
    score_short += 10
if h1_bull
    score_long += 10
if h1_bear
    score_short += 10
if m15_bull
    score_long += 10
if m15_bear
    score_short += 10

if cisd_bull
    score_long += 20
if cisd_bear
    score_short += 20
if ob_bull
    score_long += 10
if ob_bear
    score_short += 10
if fvg_bull
    score_long += 10
if fvg_bear
    score_short += 10

if news_bull
    score_long += 20
if news_bear
    score_short += 20
if is_vol_high
    score_long += 10
    score_short += 10

// =================================================================================================
// 6. ENTRY / EXIT LOGIK
// =================================================================================================
bool block_long = news_bear or not in_session or dd_guard_active
bool block_short = news_bull or not in_session or dd_guard_active

// PIONEX MASTER RULE: process_orders_on_close = true handles confirmation implicitly,
// but we keep barstate.isconfirmed as an extra safety net for the triggers.
bool confirmed = barstate.isconfirmed

bool go_long = confirmed and score_long >= min_conf and not block_long and strategy.position_size == 0
bool go_short = confirmed and score_short >= min_conf and not block_short and strategy.position_size == 0 and use_shorts

float sl_long_price = close - (atr_safe * sl_atr_mul)
float tp_long_price = close + (atr_safe * tp_atr_mul)
float sl_short_price = close + (atr_safe * sl_atr_mul)
float tp_short_price = close - (atr_safe * tp_atr_mul)

// PIONEX MASTER RULE: qty is handled by default_qty_value (cash amount).
// strategy.order.contracts will automatically reflect the position size based on this.
if go_long
    strategy.entry("Long", strategy.long, comment="L" + str.tostring(score_long))
    strategy.exit("Long Exit", "Long", stop=sl_long_price, limit=tp_long_price, comment_loss="SL", comment_profit="TP")

if go_short
    strategy.entry("Short", strategy.short, comment="S" + str.tostring(score_short))
    strategy.exit("Short Exit", "Short", stop=sl_short_price, limit=tp_short_price, comment_loss="SL", comment_profit="TP")

plotshape(go_long, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(go_short, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// =================================================================================================
// 7. WEBHOOK ALERTS (PIONEX MASTER FORMAT)
// =================================================================================================
// WEBHOOK URL (in TradingView Alert Dialog eintragen):
// https://www.pionex.com/signal/api/v1/signal_listener/trading_view?token=70d3780a-eabe-403b-b238-dde8df402233
//
// Pionex requires this exact JSON structure for their signal_listener API
string pionex_payload = '{ "data": { "action": "{{strategy.order.action}}", "contracts": "{{strategy.order.contracts}}", "position_size": "{{strategy.position_size}}" }, "price": "{{close}}", "signal_param": "{}", "signal_type": "' + uuid + '", "symbol": "{{ticker}}", "time": "{{timenow}}" }'

if go_long or go_short
    alert(pionex_payload, alert.freq_once_per_bar_close)

// =================================================================================================
// 8. QUANTDESK PRO DASHBOARD
// =================================================================================================
var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(#0f172a, 10), border_width=1, border_color=color.new(#334155, 0))

if barstate.islast
    table.cell(dash, 0, 0, "QuantDesk Pro v4", text_color=color.white, text_size=size.small, bgcolor=color.new(#1e293b, 0))
    table.cell(dash, 1, 0, "ETH/USDT", text_color=color.new(#38bdf8, 0), text_size=size.small, bgcolor=color.new(#1e293b, 0))

    table.cell(dash, 0, 1, "Session", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 1, in_session ? "ACTIVE" : "CLOSED", text_color=in_session ? color.new(#10b981, 0) : color.new(#f43f5e, 0), text_size=size.small)

    table.cell(dash, 0, 2, "Drawdown", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(current_dd_pct, "#.##") + "% / " + str.tostring(max_dd_pct, "#.##") + "%", text_color=dd_guard_active ? color.new(#f43f5e, 0) : color.white, text_size=size.small)

    table.cell(dash, 0, 3, "H4 Macro", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 3, h4_bull ? "BULL" : h4_bear ? "BEAR" : "NEUTRAL", text_color=h4_bull ? color.new(#10b981, 0) : h4_bear ? color.new(#f43f5e, 0) : color.gray, text_size=size.small)

    table.cell(dash, 0, 4, "H1 Trend", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 4, h1_bull ? "BULL" : h1_bear ? "BEAR" : "NEUTRAL", text_color=h1_bull ? color.new(#10b981, 0) : h1_bear ? color.new(#f43f5e, 0) : color.gray, text_size=size.small)

    table.cell(dash, 0, 5, "Long Score", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(score_long) + "/100", text_color=score_long >= min_conf ? color.new(#10b981, 0) : color.white, text_size=size.small)

    table.cell(dash, 0, 6, "Short Score", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(score_short) + "/100", text_color=score_short >= min_conf ? color.new(#f43f5e, 0) : color.white, text_size=size.small)

    table.cell(dash, 0, 7, "Win Rate", text_color=color.new(#94a3b8, 0), text_size=size.small)
    float wr = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades * 100) : 0
    table.cell(dash, 1, 7, str.tostring(wr, "#.#") + "%", text_color=wr >= 50 ? color.new(#10b981, 0) : color.new(#f59e0b, 0), text_size=size.small)

    table.cell(dash, 0, 8, "Net Profit", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(strategy.netprofit, "#.##") + " $", text_color=strategy.netprofit >= 0 ? color.new(#10b981, 0) : color.new(#f43f5e, 0), text_size=size.small)
