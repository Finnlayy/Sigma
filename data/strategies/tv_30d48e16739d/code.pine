//@version=6
// Pionex-LuxAlgo Regel-Vermittler v5.0 — Strategy Evaluation Tool
// Reiner Signal-Relay mit aggressiver Gewinnsicherung, Scalping-Exits und integriertem Evaluations-Dashboard.
// Alle Signalfilter liegen in den externen LuxAlgo-Indikatoren — dieses Skript greift NUR auf der Exit-Seite ein.
strategy(
    title="Pionex LuxAlgo Regel Vermittler v5.0",
    shorttitle="Px Lux Rules v5.0",
    overlay=true,
    initial_capital=100,
    currency=currency.USDT,
    default_qty_type=strategy.cash,
    default_qty_value=100,
    pyramiding=3,
    calc_on_every_tick=false,     // Fuer tick-genaue Scalping-Exits auf true setzen
    process_orders_on_close=true,
    commission_type=strategy.commission.percent,
    commission_value=0.05,
    slippage=2,
    margin_long=100,
    margin_short=100,
    max_labels_count=200
)

const int STARTZEIT_DEFAULT = 1744119900000

