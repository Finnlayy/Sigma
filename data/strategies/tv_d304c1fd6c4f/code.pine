//@version=6
strategy("Manas: Ciel - SOLUSD KNN SMC ATX KDE Volume Cluster Strategy v6", 
  overlay=true, 
  initial_capital=10000, 
  default_qty_type=strategy.percent_of_equity, 
  default_qty_value=15, 
  commission_type=strategy.commission.percent, 
  commission_value=0.05, 
  slippage=2,
  process_orders_on_close=true)

// ============================================================================
// 1. INPUT PARAMETERS & CONFIGURATION
// ============================================================================
// --- ATX Deviation Model Settings ---
i_atxPeriod     = input.int(20, "ATX: Baseline Period", minval=5, maxval=100, group="ATX Deviation Model")
i_atxDevMult    = input.float(2.0, "ATX: Deviation Multiplier (ATR)", minval=1.0, maxval=4.0, step=0.1, group="ATX Deviation Model")

// --- KDE & Volume Cluster Settings ---
i_kdeWindow     = input.int(30, "KDE: Lookback Window", minval=10, maxval=100, group="Kernel Density & Volume Clusters")
i_kdeBandwidth  = input.float(1.0, "KDE: Bandwidth Smoothing (h)", minval=0.2, maxval=3.0, step=0.1, group="Kernel Density & Volume Clusters")

// --- KNN Settings ---
i_kNeighbors    = input.int(5, "KNN: K Neighbors", minval=1, maxval=25, group="KNN Pattern Synthesizer")
i_knnWindow     = input.int(80, "KNN: Training Window (Bars)", minval=20, maxval=300, group="KNN Pattern Synthesizer")
i_knnThreshold  = input.float(0.15, "KNN: Signal Threshold", minval=0.05, maxval=0.8, step=0.05, group="KNN Pattern Synthesizer")

// --- SMC & Order Block Settings ---
i_pivotLegs     = input.int(3, "SMC: Pivot Strength (Left/Right)", minval=1, maxval=10, group="Smart Money Concepts")
i_obValidity    = input.int(30, "SMC: Max OB Lifetime (Bars)", minval=5, maxval=100, group="Smart Money Concepts")

// --- Risk & Frequency Settings ---
i_rrRatio       = input.float(2.5, "Risk/Reward Ratio (TP Multiplier)", minval=1.5, maxval=5.0, step=0.1, group="Risk Management")
i_atrMultSL     = input.float(1.2, "SL Buffer (ATR Multiplier)", minval=0.5, maxval=3.0, step=0.1, group="Risk Management")
i_minTradeGap   = input.int(3, "Min Bars Between Trades (Frequency Control)", minval=1, maxval=15, group="Execution Control")

// ============================================================================
// 2. ATX DEVIATION ENGINE (VOLATILITY ENVELOPE)
// ============================================================================
f_atr = ta.atr(14)
atx_mean = ta.vwma(close, i_atxPeriod)
atx_upper = atx_mean + (f_atr * i_atxDevMult)
atx_lower = atx_mean - (f_atr * i_atxDevMult)

// ATX Deviation States (Sweep & Reclaim)
atx_bull_sweep   = low < atx_lower                    // Liquidity sweep below lower ATX band
atx_bull_reclaim = ta.crossover(close, atx_lower)     // Reclaim back inside value range
atx_bear_sweep   = high > atx_upper                   // Liquidity sweep above upper ATX band
atx_bear_reclaim = ta.crossunder(close, atx_upper)    // Reclaim back inside value range

// ATX Normalized Ratio for KNN (-1 to +1 scale)
f_atx_ratio = f_atr > 0 ? (close - atx_mean) / (f_atr * i_atxDevMult) : 0.0

// Plotting ATX Envelopes
plot(atx_mean, "ATX Baseline", color=color.blue, linewidth=2)
p_upper = plot(atx_upper, "ATX Upper Deviation", color=color.red, linewidth=1)
p_lower = plot(atx_lower, "ATX Lower Deviation", color=color.green, linewidth=1)
fill(p_upper, p_lower, color=color.new(color.blue, 95), title="ATX Value Area")

// ============================================================================
// 3. KERNEL DENSITY ESTIMATION (KDE) & VOLUME CLUSTERING ENGINE
// ============================================================================
// Gaussian Kernel Function: K(u) = exp(-0.5 * u^2) / sqrt(2 * pi)
fn_gaussian_kernel(float u) =>
    math.exp(-0.5 * math.pow(u, 2)) / math.sqrt(2 * math.pi)

// Volume-Weighted Kernel Density Estimation at current price
fn_kde_volume_density(int window, float h) =>
    float density = 0.0
    float total_vol = 0.0
    float scale = h * (f_atr > 0 ? f_atr : 1.0)
    
    if bar_index > window and scale > 0
        for i = 0 to window - 1
            float dist_price = (close - close[i]) / scale
            float k_weight = fn_gaussian_kernel(dist_price)
            float v_weight = volume[i]
            density += k_weight * v_weight
            total_vol += v_weight

    total_vol > 0 ? density / total_vol : 0.0

kde_density = fn_kde_volume_density(i_kdeWindow, i_kdeBandwidth)

// Volume Cluster High Nodes (HVN Proxy) & Density Z-Score
kde_mean_density = ta.sma(kde_density, 20)
kde_std_density  = ta.stdev(kde_density, 20)
kde_z_score      = kde_std_density > 0 ? (kde_density - kde_mean_density) / kde_std_density : 0.0

// High Volume Cluster Node Confirmation
in_volume_cluster = kde_z_score > 0.5

// ============================================================================
// 4. FEATURE EXTRACTION & KNN PATTERN SYNTHESIZER
// ============================================================================
// Feature 1: RSI (Scaled -1 to 1)
f_rsi = (ta.rsi(close, 14) - 50.0) / 50.0

// Feature 2: ATX Deviation Ratio
f_dev = math.max(-2.0, math.min(2.0, f_atx_ratio)) / 2.0

// Feature 3: Volume Cluster KDE Density Z-Score (Scaled -1 to 1)
f_kde = math.max(-2.0, math.min(2.0, kde_z_score)) / 2.0

// KNN Prediction Function
fn_knn_predict() =>
    float score = 0.0
    if bar_index > i_knnWindow + 5
        var float[] distances = array.new_float(0)
        var float[] direction = array.new_float(0)
        array.clear(distances)
        array.clear(direction)

        float cur_f1 = f_rsi
        float cur_f2 = f_dev
        float cur_f3 = f_kde

        for i = 1 to i_knnWindow
            float h_f1 = f_rsi[i]
            float h_f2 = f_dev[i]
            float h_f3 = f_kde[i]

            float future_return = close[i] != 0 ? (close[i - 1] - close[i]) / close[i] : 0.0
            float dist = math.sqrt(math.pow(cur_f1 - h_f1, 2) + math.pow(cur_f2 - h_f2, 2) + math.pow(cur_f3 - h_f3, 2))
            
            array.push(distances, dist)
            array.push(direction, future_return > 0 ? 1.0 : (future_return < 0 ? -1.0 : 0.0))

        if array.size(distances) >= i_kNeighbors
            float sum_weights = 0.0
            float weighted_signal = 0.0

            for k = 0 to i_kNeighbors - 1
                int min_idx = array.indexof(distances, array.min(distances))
                if min_idx >= 0
                    float d = array.get(distances, min_idx)
                    float w = 1.0 / (d + 0.0001)
                    weighted_signal += array.get(direction, min_idx) * w
                    sum_weights += w
                    array.set(distances, min_idx, 10e10)

            if sum_weights > 0
                score := weighted_signal / sum_weights
    score

knn_score = fn_knn_predict()

// ============================================================================
// 5. SMART MONEY CONCEPTS (SMC) & ORDER BLOCKS
// ============================================================================
ph = ta.pivothigh(high, i_pivotLegs, i_pivotLegs)
pl = ta.pivotlow(low, i_pivotLegs, i_pivotLegs)

var float last_ph = na
var float last_pl = na

if not na(ph)
    last_ph := ph
if not na(pl)
    last_pl := pl

// Break of Structure (BOS)
bullish_bos = ta.crossover(close, last_ph)
bearish_bos = ta.crossunder(close, last_pl)

// Persistent Order Block Storage
var float bull_ob_top = na
var float bull_ob_bottom = na
var int   bull_ob_bar = 0

var float bear_ob_top = na
var float bear_ob_bottom = na
var int   bear_ob_bar = 0

// Capture Bullish OB during ATX Deviation / BOS / Volume Cluster
if bullish_bos or atx_bull_reclaim
    for i = 1 to 10
        if open[i] > close[i]
            bull_ob_top := high[i]
            bull_ob_bottom := low[i]
            bull_ob_bar := bar_index[i]
            break

// Capture Bearish OB during ATX Deviation / BOS / Volume Cluster
if bearish_bos or atx_bear_reclaim
    for i = 1 to 10
        if close[i] > open[i]
            bear_ob_top := high[i]
            bear_ob_bottom := low[i]
            bear_ob_bar := bar_index[i]
            break

// Order Block Invalidation / Mitigation Check
if not na(bull_ob_bottom) and (close < bull_ob_bottom or (bar_index - bull_ob_bar > i_obValidity))
    bull_ob_top := na
    bull_ob_bottom := na

if not na(bear_ob_top) and (close > bear_ob_top or (bar_index - bear_ob_bar > i_obValidity))
    bear_ob_top := na
    bear_ob_bottom := na

// Active OB Zone Touch Check
in_bull_ob = not na(bull_ob_top) and (low <= bull_ob_top and high >= bull_ob_bottom)
in_bear_ob = not na(bear_ob_top) and (high >= bear_ob_bottom and low <= bear_ob_top)

// Visualizing Active Order Blocks
var box bull_box = na
var box bear_box = na

if (bullish_bos or atx_bull_reclaim) and not na(bull_ob_top)
    box.delete(bull_box)
    bull_box := box.new(left=bull_ob_bar, top=bull_ob_top, right=bar_index + 5, bottom=bull_ob_bottom, 
                         bgcolor=color.new(color.green, 85), border_color=color.green)

if (bearish_bos or atx_bear_reclaim) and not na(bear_ob_top)
    box.delete(bear_box)
    bear_box := box.new(left=bear_ob_bar, top=bear_ob_top, right=bar_index + 5, bottom=bear_ob_bottom, 
                         bgcolor=color.new(color.red, 85), border_color=color.red)

// ============================================================================
// 6. TRADING SIGNALS & EXECUTION CONTROLLER
// ============================================================================
var int last_trade_bar = 0
bar_gap_ok = (bar_index - last_trade_bar) >= i_minTradeGap

// Long Signal: ATX Bullish Reclaim/OB Touch + Positive KNN Score + Volume Cluster Confluence
long_condition = barstate.isconfirmed and bar_gap_ok and (knn_score > i_knnThreshold) and (atx_bull_reclaim or in_bull_ob) and in_volume_cluster

// Short Signal: ATX Bearish Reclaim/OB Touch + Negative KNN Score + Volume Cluster Confluence
short_condition = barstate.isconfirmed and bar_gap_ok and (knn_score < -i_knnThreshold) and (atx_bear_reclaim or in_bear_ob) and in_volume_cluster

// Execute Orders with Dynamic Risk Management
if long_condition and strategy.position_size == 0
    float sl_base = not na(bull_ob_bottom) ? math.min(bull_ob_bottom, low) - (f_atr * i_atrMultSL) : close - (f_atr * i_atrMultSL)
    float sl = math.min(sl_base, close - (f_atr * 0.5))
    float risk = close - sl
    if risk > 0
        float tp = close + (risk * i_rrRatio)
        strategy.entry("Long ATX+KDE+KNN", strategy.long)
        strategy.exit("Exit Long", "Long ATX+KDE+KNN", stop=sl, limit=tp)
        last_trade_bar := bar_index

if short_condition and strategy.position_size == 0
    float sl_base = not na(bear_ob_top) ? math.max(bear_ob_top, high) + (f_atr * i_atrMultSL) : close + (f_atr * i_atrMultSL)
    float sl = math.max(sl_base, close + (f_atr * 0.5))
    float risk = sl - close
    if risk > 0
        float tp = close - (risk * i_rrRatio)
        strategy.entry("Short ATX+KDE+KNN", strategy.short)
        strategy.exit("Exit Short", "Short ATX+KDE+KNN", stop=sl, limit=tp)
        last_trade_bar := bar_index

// Plotting Signals and Metrics
plot(knn_score, "KNN Bias Score", color=knn_score > 0 ? color.green : color.red, display=display.data_window)
plot(kde_z_score, "KDE Volume Cluster Z-Score", color=color.purple, display=display.data_window)
plotshape(long_condition and strategy.position_size == 0, "Long ATX+KDE Trigger", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short_condition and strategy.position_size == 0, "Short ATX+KDE Trigger", shape.triangledown, location.abovebar, color.red, size=size.small)
