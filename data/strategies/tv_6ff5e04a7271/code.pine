//@version=6
strategy("BTC 5m High-Frequency Scalper", 
     overlay = true, 
     margin_long = 100, 
     margin_short = 100, 
     commission_type = strategy.commission.percent, 
     commission_value = 0.05, 
     default_qty_type = strategy.percent_of_equity, 
     default_qty_value = 10)

// --- Inputs ---
// Logic
rsiLen      = input.int(2, "RSI Length", minval = 1, group = "Core")
rsiOb       = input.int(85, "RSI OB Level", minval = 50, group = "Core")
rsiOs       = input.int(15, "RSI OS Level", maxval = 50, group = "Core")
trendEmaLen = input.int(200, "Trend EMA", minval = 1, group = "Core")

// Risk
atrLen      = input.int(14, "ATR Length", minval = 1, group = "Risk")
tpMult      = input.float(2.0, "TP (ATR Mult)", minval = 0.1, step = 0.1, group = "Risk")
slMult      = input.float(1.0, "SL (ATR Mult)", minval = 0.1, step = 0.1, group = "Risk")

// --- Calculations ---
rsiVal   = ta.rsi(close, rsiLen)
trendEma = ta.ema(close, trendEmaLen)
atrVal   = ta.atr(atrLen)

// --- Conditions ---
// Long: Trend is up and RSI oversold (Pullback)
longCond  = close > trendEma and ta.crossunder(rsiVal, rsiOs)
// Short: Trend is down and RSI overbought (Pullback)
shortCond = close < trendEma and ta.crossover(rsiVal, rsiOb)

// --- Strategy Execution ---
if longCond and strategy.position_size == 0
    float sl = close - atrVal * slMult
    float tp = close + atrVal * tpMult
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")

if shortCond and strategy.position_size == 0
    float sl = close + atrVal * slMult
    float tp = close - atrVal * tpMult
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")

// --- Visuals ---
plot(trendEma, "Trend EMA", color.new(color.blue, 50), 2)
plotshape(longCond, "Long", shape.triangleup, location.belowbar, color.green, size = size.small)
plotshape(shortCond, "Short", shape.triangledown, location.abovebar, color.red, size = size.small)

// Fills for ATR Zones (visual aid)
plot(strategy.position_size > 0 ? strategy.opentrades.entry_price(0) + atrVal * tpMult : na, "Target", color.green, style = plot.style_linebr)
plot(strategy.position_size > 0 ? strategy.opentrades.entry_price(0) - atrVal * slMult : na, "Stop", color.red, style = plot.style_linebr)
