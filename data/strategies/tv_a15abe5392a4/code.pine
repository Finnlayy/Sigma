showWfoMarkers = input.bool(true, "Show WFO finish markers", group=group_wfo)

f_wfoActiveSet() =>
    int s = 2
    if not useGuidedWfo or wfoRoutingMode == "Manual Inputs"
        s := 2
    else if wfoRoutingMode == "Force Set 1 - Strict Prop"
        s := 2
    else if wfoRoutingMode == "Force Set 2 - Balanced"
        s := 2
    else if wfoRoutingMode == "Force Set 3 - Trend"
        s := 2
    else if wfoRoutingMode == "Force Set 4 - Chop Defense"
        s := 2
    else if wfoRoutingMode == "Force Set 5 - Aggressive"
        s := 2
    else
        s := 2
    s

int wfoSet = f_wfoActiveSet()
string wfoSetName = "HYPE_MODE2_SINGLE_ACTIVE"

