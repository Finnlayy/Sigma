//@version=6
strategy("CleanTradeQuantum_HYPEUSDT_15m_10x_RR2_PositionSizing", overlay=true, pyramiding=0, calc_on_every_tick=true, calc_on_order_fills=true, process_orders_on_close=false, default_qty_type=strategy.fixed, default_qty_value=0, initial_capital=1000, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1, max_labels_count=500, max_lines_count=500, max_boxes_count=100, max_bars_back=5000)

