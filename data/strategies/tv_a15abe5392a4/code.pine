wfoRoutingMode = input.string("Force Set 2 - Balanced", "WFO routing mode", options=["Manual Inputs", "Date Segments", "Force Set 1 - Strict Prop", "Force Set 2 - Balanced", "Force Set 3 - Trend", "Force Set 4 - Chop Defense", "Force Set 5 - Aggressive"], group=group_wfo)
wfoFinish1 = input.time(1717200000000, "Finish Point 1", group=group_wfo)
wfoFinish2 = input.time(1725148800000, "Finish Point 2", group=group_wfo)
wfoFinish3 = input.time(1733011200000, "Finish Point 3", group=group_wfo)
