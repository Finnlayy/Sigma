//@version=6
strategy("Trend Ribbon + HI [ML-Tier GREEN]", 
     overlay=true, 
     pyramiding=0, 
     initial_capital=1000, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=10, 
     calc_on_every_tick=false,
     process_orders_on_close=true,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=2)

// ============================================================================
// PIONEX WEBHOOK
// ============================================================================
uuid = input.string("8a17bcf9-0d9c-4a09-92ae-27adf755d95d", "Pionex Signal Bot UUID", group="Pionex Webhook")
string pionex_payload = '{ "data": { "action": "{{strategy.order.action}}", "contracts": "{{strategy.order.contracts}}", "position_size": "{{strategy.position_size}}" }, "price": "{{close}}", "signal_param": "{}", "signal_type": "' + uuid + '", "symbol": "{{ticker}}", "time": "{{timenow}}" }'

// ============================================================================
// FRAMEWORK 1: DYNAMIC TREND RIBBON
// ============================================================================
int   ribbon_fast = input.int(21, "Ribbon Fast EMA", group="01. Trend Ribbon")
int   ribbon_slow = input.int(50, "Ribbon Slow EMA", group="01. Trend Ribbon")

float ema_fast = ta.ema(close, ribbon_fast)
float ema_slow = ta.ema(close, ribbon_slow)

bool is_bullish = ema_fast > ema_slow
bool is_bearish = ema_fast < ema_slow

color col_bull = color.new(#2962FF, 70) 
color col_bear = color.new(#F44336, 70) 

p1 = plot(ema_fast, color=is_bullish ? #2962FF : #F44336, linewidth=1, title="Fast Boundary", display=display.none)
p2 = plot(ema_slow, color=is_bullish ? #2962FF : #F44336, linewidth=1, title="Slow Boundary", display=display.none)
fill(p1, p2, color=is_bullish ? col_bull : col_bear, title="Trend Ribbon")

// ============================================================================
// FRAMEWORK 2: MULTI-TIMEFRAME HARMONY INDEX (HI)
// ============================================================================
float hi_threshold = input.float(0.2, "HI Min Threshold", minval=0.0, maxval=1.0, step=0.1, group="02. Harmony Index", tooltip="Mindestwert für den Einstieg. 0.2 = Moderate Harmony, 0.6 = Strong Harmony.")

// Funktion zur fehlerfreien HTF-Abfrage (Kein Repainting)
get_htf_bias(tf, f_len, s_len) =>
    request.security(syminfo.tickerid, tf, ta.ema(close, f_len) > ta.ema(close, s_len) ? 1.0 : -1.0, lookahead=barmerge.lookahead_off)

// Exponential Decay Weighting (D1=40%, 4H=25%, 1H=20%, 15m=15%)
float bias_1d  = get_htf_bias("D", ribbon_fast, ribbon_slow)
float bias_4h  = get_htf_bias("240", ribbon_fast, ribbon_slow)
float bias_1h  = get_htf_bias("60", ribbon_fast, ribbon_slow)
float bias_15m = is_bullish ? 1.0 : -1.0

float raw_hi    = (bias_1d * 0.40) + (bias_4h * 0.25) + (bias_1h * 0.20) + (bias_15m * 0.15)
float smooth_hi = ta.ema(raw_hi, 5) // Adaptive Smoothing

bool hi_long_ok  = smooth_hi >= hi_threshold
bool hi_short_ok = smooth_hi <= -hi_threshold

// ============================================================================
// FRAMEWORK 3: MACHINE LEARNING / HIGH-CONVICTION FILTER (+)
// ============================================================================
float vol_sma = ta.sma(volume, 20)
bool  ml_plus_bull = (volume > vol_sma) and ta.rising(close, 2)
bool  ml_plus_bear = (volume > vol_sma) and ta.falling(close, 2)

// ============================================================================
// FRAMEWORK 4: PULLBACK ENTRIES (Strikt gefiltert durch HI)
// ============================================================================
bool pb_long_base = is_bullish and (low <= ema_fast) and (close > open) and (close > ema_slow) and hi_long_ok
bool pb_long      = pb_long_base and not pb_long_base[1]

bool entry_l_plus = pb_long and ml_plus_bull
bool entry_l_std  = pb_long and not ml_plus_bull

bool pb_short_base = is_bearish and (high >= ema_fast) and (close < open) and (close < ema_slow) and hi_short_ok
bool pb_short      = pb_short_base and not pb_short_base[1]

bool entry_s_plus = pb_short and ml_plus_bear
bool entry_s_std  = pb_short and not ml_plus_bear

// // ============================================================================
// FRAMEWORK 5: DYNAMISCHE EXITS (ChoCH) & DYNAMIC POSITION SIZING
// ============================================================================
int   exit_speed = input.int(13, "Exit Momentum EMA", group="03. Exit Logik")
float ema_exit   = ta.ema(close, exit_speed)

bool exit_l_trigger = is_bullish and ta.crossunder(ema_exit, ema_fast) and not (is_bullish[1] and ta.crossunder(ema_exit[1], ema_fast[1]))
bool exit_s_trigger = is_bearish and ta.crossover(ema_exit, ema_fast) and not (is_bearish[1] and ta.crossover(ema_exit[1], ema_fast[1]))

float sl_atr_mult = input.float(2.0, "Notfall SL Buffer (ATR)", minval=0.5, step=0.1, group="03. Exit Logik")
float atr         = ta.atr(14)

// Dynamisches Position Sizing (Prozentsatz vom Equity)
float risk_std  = input.float(0.10, "Risiko Standard (%)", minval=0.01, maxval=1.0, step=0.01, group="04. Position Sizing")
float risk_plus = input.float(0.20, "Risiko High Conviction (%)", minval=0.01, maxval=1.0, step=0.01, group="04. Position Sizing")

var float trade_sl_l = na
var float trade_sl_s = na

if strategy.position_size == 0
    trade_sl_l := na
    trade_sl_s := na

// Order Execution mit dynamischer Menge
if (entry_l_std or entry_l_plus) and strategy.position_size == 0
    trade_sl_l := low - (atr * sl_atr_mult)
    float risk_pct = entry_l_plus ? risk_plus : risk_std
    float qty_long = (strategy.equity * risk_pct) / close
    strategy.entry("Long", strategy.long, qty=qty_long, comment=entry_l_plus ? "L+" : "L", alert_message=pionex_payload)

if (entry_s_std or entry_s_plus) and strategy.position_size == 0
    trade_sl_s := high + (atr * sl_atr_mult)
    float risk_pct = entry_s_plus ? risk_plus : risk_std
    float qty_short = (strategy.equity * risk_pct) / close
    strategy.entry("Short", strategy.short, qty=qty_short, comment=entry_s_plus ? "S+" : "S", alert_message=pionex_payload)

if strategy.position_size > 0
    if exit_l_trigger
        strategy.close("Long", comment="L-ChoCH", alert_message=pionex_payload)
    strategy.exit("L-Hard SL", "Long", stop=trade_sl_l, alert_message=pionex_payload)

if strategy.position_size < 0
    if exit_s_trigger
        strategy.close("Short", comment="S-ChoCH", alert_message=pionex_payload)
    strategy.exit("S-Hard SL", "Short", stop=trade_sl_s, alert_message=pionex_payload)
// VISUALISIERUNG & DASHBOARD
// ============================================================================
plotshape(entry_l_std,  style=shape.labelup, location=location.belowbar, color=color.new(#00C853, 0), size=size.normal, title="Entry Long", text="▲", textcolor=color.white)
plotshape(entry_l_plus, style=shape.labelup, location=location.belowbar, color=color.new(#00E676, 0), size=size.normal, title="Entry Long +", text="▲+", textcolor=color.white)

plotshape(entry_s_std,  style=shape.labeldown, location=location.abovebar, color=color.new(#D50000, 0), size=size.normal, title="Entry Short", text="▼", textcolor=color.white)
plotshape(entry_s_plus, style=shape.labeldown, location=location.abovebar, color=color.new(#FF5252, 0), size=size.normal, title="Entry Short +", text="▼+", textcolor=color.white)

plotshape(exit_l_trigger, style=shape.xcross, location=location.abovebar, color=color.new(color.orange, 0), size=size.small, title="Exit Long Marker")
plotshape(exit_s_trigger, style=shape.xcross, location=location.belowbar, color=color.new(#2962FF, 0), size=size.small, title="Exit Short Marker")

// HI Bias Dashboard
var table dash = table.new(position.bottom_right, 2, 2, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Harmony Index", text_color=color.white, text_size=size.small)
    
    color hi_color = color.gray
    string hi_text = "Neutral"
    if smooth_hi >= 0.6
        hi_color := #00E676
        hi_text  := "Strong Bullish"
    else if smooth_hi >= 0.2
        hi_color := #00C853
        hi_text  := "Moderate Bullish"
    else if smooth_hi <= -0.6
        hi_color := #FF5252
        hi_text  := "Strong Bearish"
    else if smooth_hi <= -0.2
        hi_color := #D50000
        hi_text  := "Moderate Bearish"
        
    table.cell(dash, 1, 0, str.tostring(smooth_hi, "#.##"), text_color=hi_color, text_size=size.small)
    table.cell(dash, 0, 1, "Status", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, hi_text, text_color=hi_color, text_size=size.small)