// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
strategy("LuxAlgo Inspired Volatility Scalper", shorttitle="LIVS", overlay=true, margin_long=100, margin_short=100, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05)

// --- Inputs ---
var string G_TREND = "Trend Detection"
int length = input.int(14, "ATR Length", group=G_TREND)
float mult = input.float(2.0, "Volatility Multiplier", group=G_TREND, step=0.1)

var string G_FILTER = "Momentum Filter"
int rsiLen = input.int(14, "RSI Length", group=G_FILTER)
int rsiLong = input.int(55, "RSI Long Threshold", group=G_FILTER)
int rsiShort = input.int(45, "RSI Short Threshold", group=G_FILTER)

// --- Logic ---
// Volatility Trailing Stop (Supertrend Concept)
float atr = ta.atr(length)
float hl2 = (high + low) / 2
float up = hl2 - (mult * atr)
float dn = hl2 + (mult * atr)

var float trendUp = 0.0
trendUp := close[1] > trendUp[1] ? math.max(up, trendUp[1]) : up

var float trendDn = 0.0
trendDn := close[1] < trendDn[1] ? math.min(dn, trendDn[1]) : dn

var int trend = 1
trend := nz(trend[1], 1)
trend := trend == -1 and close > trendDn[1] ? 1 : trend == 1 and close < trendUp[1] ? -1 : trend

float trailStop = trend == 1 ? trendUp : trendDn

// Filters
float rsi = ta.rsi(close, rsiLen)

// Conditions
bool longCond = trend == 1 and trend[1] == -1 and rsi > rsiLong
bool shortCond = trend == -1 and trend[1] == 1 and rsi < rsiShort

// --- Strategy ---
// Bei jedem neuen Signal: aktiven Trade zuerst schliessen, dann neu einsteigen
if longCond
    strategy.close_all()
    strategy.entry("Long", strategy.long)

if shortCond
    strategy.close_all()
    strategy.entry("Short", strategy.short)

// Trailing Exit
if strategy.position_size > 0 and close < trailStop
    strategy.close("Long")

if strategy.position_size < 0 and close > trailStop
    strategy.close("Short")

// --- Visuals ---
color trendColor = trend == 1 ? color.new(#089981, 0) : color.new(#f23645, 0)
plot(trailStop, "Volatility Trail", color=trendColor, style=plot.style_linebr, linewidth=2)

// Fills for visual clarity
float fillBase = trend == 1 ? math.min(low, trailStop) : math.max(high, trailStop)
fill(plot(trailStop, display=display.none), plot(close, display=display.none), trend == 1 ? color.new(#089981, 90) : color.new(#f23645, 90))