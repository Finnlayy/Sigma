//@version=6
// Pionex-LuxAlgo Regel-Vermittler v3.
// Reiner Regel-Connector: Jede Regel waehlt eine Aktion und definiert, welche LuxAlgo-Quelle
// diese Aktion ausloest. TradingView Alert: {{strategy.order.alert_message}}
strategy(
    title="Pionex LuxAlgo Regel Vermittler v3",
    shorttitle="Px Lux Rules v3",
    overlay=true,
    initial_capital=100,
    currency=currency.USDT,
    default_qty_type=strategy.cash,
    default_qty_value=100,
    pyramiding=0,
    calc_on_every_tick=false,
    process_orders_on_close=true,
    commission_type=strategy.commission.percent,
    commission_value=0.05,
    slippage=2,
    margin_long=0,
    margin_short=0,
    max_labels_count=200
)

const int STARTZEIT_DEFAULT = 1744119900000

string GRP_CONN = "1. Verbindung"
bool lux_quellen_verbunden = input.bool(false, "Lux Quellen verbunden", group=GRP_CONN, tooltip="Erst aktivieren, wenn die genutzten LuxAlgo-Quellen wirklich in den Regeln ausgewaehlt wurden.")
string ausloese_modus = input.string("Nur neues Signal", "Ausloese-Modus", options=["Nur neues Signal", "Aktiver Zustand"], group=GRP_CONN, tooltip="Nur neues Signal feuert nur beim frischen Wechsel auf wahr. Aktiver Zustand feuert, solange die Bedingung wahr ist und eine Order erlaubt ist.")
int signal_gedaechtnis = input.int(0, "Signal-Gedaechtnis Kerzen", minval=0, maxval=20, group=GRP_CONN, tooltip="0 = nur aktuelle Kerze. Hoehere Werte halten ein Signal fuer mehrere Kerzen aktiv.")
float gleich_toleranz = input.float(0.000001, "Gleichheits-Toleranz", minval=0.0, step=0.000001, group=GRP_CONN, tooltip="Toleranz fuer Gleich/Nicht gleich. Hilft, wenn externe Quellen nicht exakt 1.000000 liefern.")
bool startzeit_aktiv = input.bool(false, "Startzeitfilter aktiv", group=GRP_CONN, tooltip="Trades werden erst ab der gewaehlten Startzeit erlaubt.")
int startzeit = input.time(STARTZEIT_DEFAULT, "Startzeit", group=GRP_CONN, tooltip="Optionaler Startzeitpunkt. Beispiel: 2025-04-08 13:45 UTC.")

