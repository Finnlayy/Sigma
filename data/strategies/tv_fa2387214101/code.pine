bool regel_1_aktiv = input.bool(false, "Regel 1 aktiv", group=GRP_RULES, tooltip="Aktiviert diese Regel.")
string regel_1_aktion = input.string("Long oeffnen", "Regel 1 Aktion", options=["Long oeffnen", "Short oeffnen", "Long schliessen", "Short schliessen", "Alle schliessen"], group=GRP_RULES, tooltip="Was passieren soll, wenn die Bedingung wahr wird.")
float regel_1_links = input.source(close, "Regel 1 Quelle", group=GRP_RULES, tooltip="LuxAlgo-Quelle oder Chart-Quelle, z.B. bullish_ob_entered oder confirmation_uptrend.")
string regel_1_operator = input.string("Gleich", "Regel 1 Vergleich", options=["Ist aktiv", "Ist inaktiv", "Gleich", "Nicht gleich", "Groesser", "Kleiner", "Groesser/gleich", "Kleiner/gleich", "Kreuzt ueber", "Kreuzt unter"], group=GRP_RULES, tooltip="Ist aktiv erkennt auch X-/Label-Plots, die Preiswerte statt 1 ausgeben. Sonst Vergleich zwischen Quelle und rechter Seite.")
string regel_1_rechts_typ = input.string("Wert", "Regel 1 Rechte Seite", options=["Wert", "Quelle"], group=GRP_RULES, tooltip="Wert = feste Zahl wie 1. Quelle = zweite TradingView/LuxAlgo-Quelle.")
