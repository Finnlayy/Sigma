//@version=6
strategy(
     "Quantum_HFT_PRO_Fusion_V6_PIONEX_FINAL",
     overlay=true,
     pyramiding=1,
     calc_on_every_tick=false,
     calc_on_order_fills=true,
     process_orders_on_close=false,
     initial_capital=100,
     default_qty_type=strategy.cash,
     default_qty_value=25,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     margin_long=0,
     margin_short=0)

// ==========================================
// === INPUTS ===
// ==========================================
group_general = "=== General ==="
allowLongs = input.bool(true, "Allow Longs", group=group_general)
allowShorts = input.bool(true, "Allow Shorts", group=group_general)
reentryCooldownBars = input.int(0, "Reentry Cooldown Bars", minval=0, maxval=20, group=group_general)

group_speed = "=== Speed Tuning ==="
useHftMode = input.bool(true, "HFT Turbo Modus aktiv", group=group_speed)
hftSignalScore = input.int(4, "HFT Min Score", minval=1, maxval=20, group=group_speed)
hftEdgeMin = input.int(1, "HFT Min Edge", minval=0, maxval=20, group=group_speed)
hftKamaLen = input.int(6, "HFT KAMA Reaktion", minval=2, group=group_speed)
fastEmaLen = input.int(5, "Fast EMA", minval=1, group=group_speed)
slowEmaLen = input.int(13, "Slow EMA", minval=2, group=group_speed)
fastRsiLen = input.int(7, "Fast RSI", minval=2, group=group_speed)
macdFastLen = input.int(8, "MACD Fast", minval=1, group=group_speed)
macdSlowLen = input.int(17, "MACD Slow", minval=2, group=group_speed)
macdSignalLen = input.int(5, "MACD Signal", minval=1, group=group_speed)

group_quantum = "=== Quantum Strategy Core ==="
historyBars = input.int(24, "Analyse Zeitraum", minval=8, group=group_quantum)
confThreshold = input.float(0.51, "Min Confidence", step=0.01, group=group_quantum)
signalScoreMin = input.int(6, "Strategie Min Score", minval=1, maxval=20, group=group_quantum)
signalEdgeMin = input.int(1, "Strategie Min Edge", minval=0, maxval=20, group=group_quantum)

group_risk = "=== Risk Management ==="
tp1Mult = input.float(1.25, "TP 1 (ATR Mult)", step=0.05, group=group_risk)
tp2Mult = input.float(1.90, "TP 2 (ATR Mult)", step=0.05, group=group_risk)
tp3Mult = input.float(2.50, "TP 3 (ATR Mult)", step=0.05, group=group_risk)
slMult = input.float(1.30, "SL (ATR Mult)", step=0.10, group=group_risk)
tp1ClosePct = input.float(50.0, "TP1 Close %", minval=0, maxval=100, step=5, group=group_risk)
tp2ClosePct = input.float(35.0, "TP2 Close %", minval=0, maxval=100, step=5, group=group_risk)
trailAtrMult = input.float(0.90, "Trail ATR Mult after TP2", minval=0.1, step=0.1, group=group_risk)
minHoldBars = input.int(2, "Min Hold Bars before fast exit", minval=0, maxval=20, group=group_risk)
fastExitEdge = input.int(2, "Fast Exit Score Edge", minval=0, maxval=10, group=group_risk)

// ==========================================
// === HELPERS ===
// ==========================================
f_manualKama(float src, int len) =>
    float diff = math.abs(src - src[len])
    float volatility = math.sum(math.abs(src - src[1]), len)
    float er = volatility != 0 ? diff / volatility : 0.0
    float fastAlpha = 2.0 / (2.0 + 1.0)
    float slowAlpha = 2.0 / (30.0 + 1.0)
    float sc = math.pow(er * (fastAlpha - slowAlpha) + slowAlpha, 2)
    float kamaVal = na
    kamaVal := nz(kamaVal[1], src) + sc * (src - nz(kamaVal[1], src))
    kamaVal

tp1Pct = math.min(100.0, math.max(0.0, tp1ClosePct))
tp2Pct = math.min(100.0 - tp1Pct, math.max(0.0, tp2ClosePct))
tp3Pct = math.max(0.0, 100.0 - tp1Pct - tp2Pct)

// ==========================================
// === INDICATORS ===
// ==========================================
atr = ta.atr(14)
kama = f_manualKama(close, hftKamaLen)
vwapV = ta.vwap(hlc3)
emaFast = ta.ema(close, fastEmaLen)
emaSlow = ta.ema(close, slowEmaLen)
rsiFast = ta.rsi(close, fastRsiLen)
[macdM, macdS, _] = ta.macd(close, macdFastLen, macdSlowLen, macdSignalLen)

// ==========================================
// === QUANTUM PROBABILITY ===
// ==========================================
float upCount = 0.0
float downCount = 0.0

for i = 1 to historyBars
    float weight = historyBars - i + 1
    float delta = close[i - 1] - close[i]
    if delta > 0
        upCount += weight
    else if delta < 0
        downCount += weight

float totalMoves = upCount + downCount
bullProb = totalMoves > 0 ? upCount / totalMoves : 0.5
bearProb = totalMoves > 0 ? downCount / totalMoves : 0.5

// ==========================================
// === SCORING ===
// ==========================================
float lScore = 0.0
float sScore = 0.0

lScore += close > emaFast ? 1 : 0
lScore += emaFast > emaSlow ? 1 : 0
lScore += close > vwapV ? 1 : 0
lScore += macdM > macdS ? 1 : 0
lScore += rsiFast > 52 ? 1 : 0
lScore += bullProb > confThreshold ? 2 : 0
lScore += emaFast > kama ? 1 : 0

sScore += close < emaFast ? 1 : 0
sScore += emaFast < emaSlow ? 1 : 0
sScore += close < vwapV ? 1 : 0
sScore += macdM < macdS ? 1 : 0
sScore += rsiFast < 48 ? 1 : 0
sScore += bearProb > confThreshold ? 2 : 0
sScore += emaFast < kama ? 1 : 0

requiredScore = useHftMode ? hftSignalScore : signalScoreMin
requiredEdge = useHftMode ? hftEdgeMin : signalEdgeMin

isKamaLong = close > kama
isKamaShort = close < kama

longSignal = allowLongs and lScore >= requiredScore and (lScore - sScore) >= requiredEdge and isKamaLong
shortSignal = allowShorts and sScore >= requiredScore and (sScore - lScore) >= requiredEdge and isKamaShort

// ==========================================
// === RUNTIME STATE ===
// ==========================================
var int lastFlatBar = na
var int tradeEntryBar = na
var float tradeEntryPrice = na
var float tradeRiskAtr = na
var float activeStop = na
var float activeTp1 = na
var float activeTp2 = na
var float activeTp3 = na
var float trailStop = na
var float trailExtreme = na
var bool tp1Done = false
var bool tp2Done = false
var bool trailArmed = false
var bool exitLockThisBar = false

if barstate.isnew
    exitLockThisBar := false

newLongPosition = strategy.position_size > 0 and strategy.position_size[1] <= 0
newShortPosition = strategy.position_size < 0 and strategy.position_size[1] >= 0
flatNow = strategy.position_size == 0 and strategy.position_size[1] != 0
posReduced = strategy.position_size != 0 and math.abs(strategy.position_size) < math.abs(strategy.position_size[1])

if flatNow
    lastFlatBar := bar_index
    tradeEntryBar := na
    tradeEntryPrice := na
    tradeRiskAtr := na
    activeStop := na
    activeTp1 := na
    activeTp2 := na
    activeTp3 := na
    trailStop := na
    trailExtreme := na
    tp1Done := false
    tp2Done := false
    trailArmed := false
    exitLockThisBar := true

if posReduced
    exitLockThisBar := true

if newLongPosition
    tradeEntryBar := bar_index
    tradeEntryPrice := strategy.position_avg_price
    tradeRiskAtr := atr
    activeStop := tradeEntryPrice - tradeRiskAtr * slMult
    activeTp1 := tradeEntryPrice + tradeRiskAtr * tp1Mult
    activeTp2 := tradeEntryPrice + tradeRiskAtr * tp2Mult
    activeTp3 := tradeEntryPrice + tradeRiskAtr * tp3Mult
    trailStop := na
    trailExtreme := na
    tp1Done := false
    tp2Done := false
    trailArmed := false

if newShortPosition
    tradeEntryBar := bar_index
    tradeEntryPrice := strategy.position_avg_price
    tradeRiskAtr := atr
    activeStop := tradeEntryPrice + tradeRiskAtr * slMult
    activeTp1 := tradeEntryPrice - tradeRiskAtr * tp1Mult
    activeTp2 := tradeEntryPrice - tradeRiskAtr * tp2Mult
    activeTp3 := tradeEntryPrice - tradeRiskAtr * tp3Mult
    trailStop := na
    trailExtreme := na
    tp1Done := false
    tp2Done := false
    trailArmed := false

barsInTrade = na(tradeEntryBar) ? 0 : bar_index - tradeEntryBar
cooldownPassed = na(lastFlatBar) or (bar_index - lastFlatBar >= reentryCooldownBars)

// ==========================================
// === ENTRY LOGIC ===
// ==========================================
longTrigger = longSignal and strategy.position_size == 0 and cooldownPassed and barstate.isconfirmed and not exitLockThisBar
shortTrigger = shortSignal and strategy.position_size == 0 and cooldownPassed and barstate.isconfirmed and not exitLockThisBar

if longTrigger and not shortTrigger
    strategy.entry("Long", strategy.long)

if shortTrigger and not longTrigger
    strategy.entry("Short", strategy.short)

// ==========================================
// === LONG MANAGEMENT ===
// ==========================================
if strategy.position_size > 0
    if not tp1Done and not na(activeTp1) and high >= activeTp1
        tp1Done := true
        activeStop := math.max(nz(activeStop, tradeEntryPrice), tradeEntryPrice)

    if not tp2Done and not na(activeTp2) and high >= activeTp2
        tp2Done := true
        trailArmed := true
        trailExtreme := high

    if trailArmed
        trailExtreme := math.max(nz(trailExtreme, high), high)
        trailStop := trailExtreme - nz(tradeRiskAtr, atr) * trailAtrMult
        activeStop := math.max(nz(activeStop, trailStop), math.max(nz(tradeEntryPrice, trailStop), trailStop))

    if tp1Pct > 0
        strategy.exit("Long_TP1", from_entry="Long", stop=activeStop, limit=activeTp1, qty_percent=tp1Pct)
    if tp2Pct > 0
        strategy.exit("Long_TP2", from_entry="Long", stop=activeStop, limit=activeTp2, qty_percent=tp2Pct)
    if tp3Pct > 0
        strategy.exit("Long_TP3", from_entry="Long", stop=activeStop, limit=activeTp3, qty_percent=tp3Pct)

    longFastExit = barsInTrade >= minHoldBars and close < kama and emaFast < emaSlow and macdM < macdS and sScore >= lScore + fastExitEdge
    if longFastExit
        strategy.close("Long", comment="Fast Exit")
        exitLockThisBar := true

// ==========================================
// === SHORT MANAGEMENT ===
// ==========================================
if strategy.position_size < 0
    if not tp1Done and not na(activeTp1) and low <= activeTp1
        tp1Done := true
        activeStop := math.min(nz(activeStop, tradeEntryPrice), tradeEntryPrice)

    if not tp2Done and not na(activeTp2) and low <= activeTp2
        tp2Done := true
        trailArmed := true
        trailExtreme := low

    if trailArmed
        trailExtreme := math.min(nz(trailExtreme, low), low)
        trailStop := trailExtreme + nz(tradeRiskAtr, atr) * trailAtrMult
        activeStop := math.min(nz(activeStop, trailStop), math.min(nz(tradeEntryPrice, trailStop), trailStop))

    if tp1Pct > 0
        strategy.exit("Short_TP1", from_entry="Short", stop=activeStop, limit=activeTp1, qty_percent=tp1Pct)
    if tp2Pct > 0
        strategy.exit("Short_TP2", from_entry="Short", stop=activeStop, limit=activeTp2, qty_percent=tp2Pct)
    if tp3Pct > 0
        strategy.exit("Short_TP3", from_entry="Short", stop=activeStop, limit=activeTp3, qty_percent=tp3Pct)

    shortFastExit = barsInTrade >= minHoldBars and close > kama and emaFast > emaSlow and macdM > macdS and lScore >= sScore + fastExitEdge
    if shortFastExit
        strategy.close("Short", comment="Fast Exit")
        exitLockThisBar := true

// ==========================================
// === VISUALS ===
// ==========================================
plot(kama, color=color.new(color.orange, 0), linewidth=2, title="KAMA Fusion Line")
plot(vwapV, color=color.new(color.blue, 50), title="VWAP")
plot(emaFast, color=color.new(color.green, 0), title="Fast EMA")
plot(emaSlow, color=color.new(color.red, 0), title="Slow EMA")

plot(strategy.position_size > 0 ? activeStop : na, title="Long Stop", color=color.new(color.red, 0), style=plot.style_linebr)
plot(strategy.position_size > 0 ? activeTp1 : na, title="Long TP1", color=color.new(color.green, 35), style=plot.style_linebr)
plot(strategy.position_size > 0 ? activeTp2 : na, title="Long TP2", color=color.new(color.green, 15), style=plot.style_linebr)
plot(strategy.position_size > 0 ? activeTp3 : na, title="Long TP3", color=color.new(color.green, 0), style=plot.style_linebr)

plot(strategy.position_size < 0 ? activeStop : na, title="Short Stop", color=color.new(color.red, 0), style=plot.style_linebr)
plot(strategy.position_size < 0 ? activeTp1 : na, title="Short TP1", color=color.new(color.aqua, 35), style=plot.style_linebr)
plot(strategy.position_size < 0 ? activeTp2 : na, title="Short TP2", color=color.new(color.aqua, 15), style=plot.style_linebr)
plot(strategy.position_size < 0 ? activeTp3 : na, title="Short TP3", color=color.new(color.aqua, 0), style=plot.style_linebr)

plotshape(longTrigger and not shortTrigger, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Long Trigger")
plotshape(shortTrigger and not longTrigger, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Trigger")

var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Bull Prob", text_color=color.white)
    table.cell(dash, 1, 0, str.tostring(bullProb, "#.##"), text_color=bullProb > 0.5 ? color.green : color.red)
    table.cell(dash, 0, 1, "Bear Prob", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(bearProb, "#.##"), text_color=bearProb > 0.5 ? color.red : color.green)
    table.cell(dash, 0, 2, "Long Score", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(lScore, "#.##"), text_color=color.green)
    table.cell(dash, 0, 3, "Short Score", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(sScore, "#.##"), text_color=color.red)
    table.cell(dash, 0, 4, "Mode", text_color=color.white)
    table.cell(dash, 1, 4, useHftMode ? "HFT" : "CORE", text_color=color.yellow)
    table.cell(dash, 0, 5, "Bias", text_color=color.white)
    table.cell(dash, 1, 5, lScore > sScore ? "LONG" : sScore > lScore ? "SHORT" : "NEUTRAL", text_color=lScore > sScore ? color.green : sScore > lScore ? color.red : color.gray)