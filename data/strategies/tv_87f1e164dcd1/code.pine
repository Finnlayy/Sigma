//@version=6
// Pionex-LuxAlgo Regel-Vermittler v6.5 — Adaptive Auto SL/TP + Temporal Exits + Entry Limits

// Reiner Signal-Relay mit aggressiver Gewinnsicherung, Scalping-Exits und integriertem Evaluations-Dashboard.
// v6.0: Verknuepfungen UND / ODER / EINZEL / UND NICHT + "Und nicht" Regel-Modus + zeitversetzte Confluence.
// v6.1: LuxAlgo-Style UI — Analytics Dashboard (Sparkline, Stunden-Histogramm, Heatmap,
//       Position/Groesse waehlbar), Gradient-Kerzen, Trade-Linien mit Treffer-Markierung.
// v6.2: Konservatives Fill-Modell, Bar Magnifier, Standard-OHLC, Backtest-Zeitfenster,
//       keine Realtime-Tick-Rechnung, W/L/BE-Kennzahlen und klar als Exit-Legs markierte Analytics.
// v6.3: Optionales Online-Lernen mit rollierenden, ATR-normalisierten MAE/MFE-Quantilen für Auto-SL/TP.
// v6.4: Optionales Zeit-/Bar-Exit-Modul für maximale Haltedauer, stagnierende Trades und Session-Cutoff.
// v6.5: Optionales, variabel einstellbares Long-/Short-Entry-Limit pro UTC-Stunde.

strategy(
        title="Pionex LuxAlgo Regel Vermittler v6.5 Trade Limits",
    shorttitle="Px Lux v6.5 Limits",

    overlay=true,
    initial_capital=100,
    currency=currency.USDT,
        default_qty_type=strategy.cash,
    default_qty_value=1,          // Pionex-Referenz: 1 USDT = 1 % Margin bei initial_capital 100
    pyramiding=1,                 // ein Risikoobjekt pro Position; Add-ons erst leg-basiert nachrüsten
    calc_on_every_tick=false,     // historische und Realtime-Auswertung konsistent halten
    calc_on_order_fills=false,
    process_orders_on_close=true, // Pionex-Referenz: Signal und simulierte Marktorder am Kerzenschluss

    commission_type=strategy.commission.percent,
    commission_value=0.05,
    slippage=2,
    backtest_fill_limits_assumption=1, // TP-/Partial-Limits müssen um mindestens einen Tick überlaufen werden
    use_bar_magnifier=true,
    fill_orders_on_standard_ohlc=true,
    margin_long=0,
    margin_short=0,

    max_lines_count=500,
    max_labels_count=500
)

const int STARTZEIT_DEFAULT = 1744119900000

// =====================================================================
// 0. BACKTEST-INTEGRITAET
// =====================================================================
string GRP_BT = "0. Backtest-Integritaet"
bool bt_zeitfenster_aktiv = input.bool(true, "Festes Backtest-Zeitfenster aktiv", group=GRP_BT)
int bt_start = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Backtest Start (UTC)", group=GRP_BT)
int bt_ende = input.time(timestamp("01 Jan 2035 00:00 +0000"), "Backtest Ende (UTC)", group=GRP_BT)
int bt_mindest_exit_legs = input.int(30, "Mindestzahl Exit-Legs fuer Kennzahlen", minval=5, maxval=500, group=GRP_BT)
bool bt_kelly_erst_nach_sample = input.bool(true, "Auto Kelly erst nach Mindest-Sample", group=GRP_BT)
bool bt_restart_erlauben = input.bool(false, "Same-Bar Restart im Backtest erlauben", group=GRP_BT, tooltip="Standard AUS: Close und Re-Entry auf derselben Kerze können die Simulation gegenüber der Live-Ausführung verzerren.")
bool bt_am_ende_flatten = input.bool(true, "Am Ende des Testfensters flatten", group=GRP_BT)

// =====================================================================
// 1. VERBINDUNG & GRUNDEINSTELLUNGEN

// =====================================================================
string GRP_CONN = "1. Verbindung"
bool lux_quellen_verbunden = input.bool(false, "Lux Quellen verbunden", group=GRP_CONN, tooltip="Erst aktivieren, wenn die genutzten LuxAlgo-Quellen wirklich in den Regeln ausgewaehlt wurden.")
string ausloese_modus = input.string("Nur neues Signal", "Ausloese-Modus", options=["Nur neues Signal", "Aktiver Zustand"], group=GRP_CONN)
int signal_gedaechtnis = input.int(0, "Signal-Gedaechtnis Kerzen", minval=-1, maxval=20, group=GRP_CONN, tooltip="0 = nur exakter Bar. 1-20 = Signal bleibt N Bars heiss (zeitversetzte Confluence). -1 = unbegrenzt vorgemerkt bis zum naechsten Entry.")
float gleich_toleranz = input.float(0.000001, "Gleichheits-Toleranz", minval=0.0, step=0.000001, group=GRP_CONN)
bool startzeit_aktiv = input.bool(false, "Startzeitfilter aktiv", group=GRP_CONN)
int startzeit = input.time(STARTZEIT_DEFAULT, "Startzeit", group=GRP_CONN)

// =====================================================================
// 2. REGEL-BUILDER & CONFLUENCE ENGINE
// =====================================================================
// Logik der Verknuepfungen (Option A):
// - EINZEL / ODER: trennt — die folgende Regel startet eine neue Gruppe.
// - UND: die folgende Regel gehoert zur selben Gruppe und MUSS (zeitversetzt
//   innerhalb des Signal-Gedaechtnisses) erfuellt sein.
// - UND NICHT: die folgende Regel DARF im Zeitfenster NICHT gefeuert haben.
// Eine Gruppe feuert, wenn alle UND-Regeln erfuellt und keine UND-NICHT-Regel
// ausgeloest wurde. Das Gesamtsignal ist das ODER aller Gruppen.
string GRP_RULES = "2. Regel-Builder"

bool regel_1_aktiv = input.bool(false, "Regel 1 aktiv", group=GRP_RULES)
string regel_1_aktion = input.string("Long oeffnen", "Regel 1 Aktion", options=["Long oeffnen", "Short oeffnen", "Long schliessen", "Short schliessen", "Alle schliessen"], group=GRP_RULES)
float regel_1_links = input.source(close, "Regel 1 Quelle", group=GRP_RULES)
string regel_1_operator = input.string("Gleich", "Regel 1 Vergleich", options=["Ist aktiv", "Ist inaktiv", "Gleich", "Nicht gleich", "Groesser", "Kleiner", "Groesser/gleich", "Kleiner/gleich", "Kreuzt ueber", "Kreuzt unter"], group=GRP_RULES)
string regel_1_modus = input.string("Normal", "Regel 1 Modus", options=["Normal", "Und nicht (rechte Seite)"], group=GRP_RULES, tooltip="Und nicht: Vergleich muss zutreffen UND die rechte Vergleichsquelle darf NICHT aktiv sein. Bei rechter Seite = Wert wird der Vergleich umgekehrt.")
string regel_1_rechts_typ = input.string("Wert", "Regel 1 Rechte Seite", options=["Wert", "Quelle"], group=GRP_RULES)
float regel_1_wert = input.float(1.0, "Regel 1 Wert", step=0.1, group=GRP_RULES)
float regel_1_rechts = input.source(open, "Regel 1 Vergleichsquelle", group=GRP_RULES)

string verb_2 = input.string("EINZEL", "Verknuepfung R1 -> R2", options=["UND", "ODER", "EINZEL", "UND NICHT"], group=GRP_RULES)
bool regel_2_aktiv = input.bool(false, "Regel 2 aktiv", group=GRP_RULES)
string regel_2_aktion = input.string("Short oeffnen", "Regel 2 Aktion", options=["Long oeffnen", "Short oeffnen", "Long schliessen", "Short schliessen", "Alle schliessen"], group=GRP_RULES)
float regel_2_links = input.source(close, "Regel 2 Quelle", group=GRP_RULES)
string regel_2_operator = input.string("Gleich", "Regel 2 Vergleich", options=["Ist aktiv", "Ist inaktiv", "Gleich", "Nicht gleich", "Groesser", "Kleiner", "Groesser/gleich", "Kleiner/gleich", "Kreuzt ueber", "Kreuzt unter"], group=GRP_RULES)
string regel_2_modus = input.string("Normal", "Regel 2 Modus", options=["Normal", "Und nicht (rechte Seite)"], group=GRP_RULES, tooltip="Und nicht: Vergleich muss zutreffen UND die rechte Vergleichsquelle darf NICHT aktiv sein. Bei rechter Seite = Wert wird der Vergleich umgekehrt.")
string regel_2_rechts_typ = input.string("Wert", "Regel 2 Rechte Seite", options=["Wert", "Quelle"], group=GRP_RULES)
float regel_2_wert = input.float(1.0, "Regel 2 Wert", step=0.1, group=GRP_RULES)
float regel_2_rechts = input.source(open, "Regel 2 Vergleichsquelle", group=GRP_RULES)

string verb_3 = input.string("EINZEL", "Verknuepfung R2 -> R3", options=["UND", "ODER", "EINZEL", "UND NICHT"], group=GRP_RULES)
bool regel_3_aktiv = input.bool(false, "Regel 3 aktiv", group=GRP_RULES)
string regel_3_aktion = input.string("Long schliessen", "Regel 3 Aktion", options=["Long oeffnen", "Short oeffnen", "Long schliessen", "Short schliessen", "Alle schliessen"], group=GRP_RULES)
float regel_3_links = input.source(close, "Regel 3 Quelle", group=GRP_RULES)
string regel_3_operator = input.string("Gleich", "Regel 3 Vergleich", options=["Ist aktiv", "Ist inaktiv", "Gleich", "Nicht gleich", "Groesser", "Kleiner", "Groesser/gleich", "Kleiner/gleich", "Kreuzt ueber", "Kreuzt unter"], group=GRP_RULES)
string regel_3_modus = input.string("Normal", "Regel 3 Modus", options=["Normal", "Und nicht (rechte Seite)"], group=GRP_RULES, tooltip="Und nicht: Vergleich muss zutreffen UND die rechte Vergleichsquelle darf NICHT aktiv sein. Bei rechter Seite = Wert wird der Vergleich umgekehrt.")
string regel_3_rechts_typ = input.string("Wert", "Regel 3 Rechte Seite", options=["Wert", "Quelle"], group=GRP_RULES)
float regel_3_wert = input.float(1.0, "Regel 3 Wert", step=0.1, group=GRP_RULES)
float regel_3_rechts = input.source(open, "Regel 3 Vergleichsquelle", group=GRP_RULES)

string verb_4 = input.string("EINZEL", "Verknuepfung R3 -> R4", options=["UND", "ODER", "EINZEL", "UND NICHT"], group=GRP_RULES)
bool regel_4_aktiv = input.bool(false, "Regel 4 aktiv", group=GRP_RULES)
string regel_4_aktion = input.string("Short schliessen", "Regel 4 Aktion", options=["Long oeffnen", "Short oeffnen", "Long schliessen", "Short schliessen", "Alle schliessen"], group=GRP_RULES)
float regel_4_links = input.source(close, "Regel 4 Quelle", group=GRP_RULES)
string regel_4_operator = input.string("Gleich", "Regel 4 Vergleich", options=["Ist aktiv", "Ist inaktiv", "Gleich", "Nicht gleich", "Groesser", "Kleiner", "Groesser/gleich", "Kleiner/gleich", "Kreuzt ueber", "Kreuzt unter"], group=GRP_RULES)
string regel_4_modus = input.string("Normal", "Regel 4 Modus", options=["Normal", "Und nicht (rechte Seite)"], group=GRP_RULES, tooltip="Und nicht: Vergleich muss zutreffen UND die rechte Vergleichsquelle darf NICHT aktiv sein. Bei rechter Seite = Wert wird der Vergleich umgekehrt.")
string regel_4_rechts_typ = input.string("Wert", "Regel 4 Rechte Seite", options=["Wert", "Quelle"], group=GRP_RULES)
float regel_4_wert = input.float(1.0, "Regel 4 Wert", step=0.1, group=GRP_RULES)
float regel_4_rechts = input.source(open, "Regel 4 Vergleichsquelle", group=GRP_RULES)

string verb_5 = input.string("EINZEL", "Verknuepfung R4 -> R5", options=["UND", "ODER", "EINZEL", "UND NICHT"], group=GRP_RULES)
bool regel_5_aktiv = input.bool(false, "Regel 5 aktiv", group=GRP_RULES)
string regel_5_aktion = input.string("Long oeffnen", "Regel 5 Aktion", options=["Long oeffnen", "Short oeffnen", "Long schliessen", "Short schliessen", "Alle schliessen"], group=GRP_RULES)
float regel_5_links = input.source(close, "Regel 5 Quelle", group=GRP_RULES)
string regel_5_operator = input.string("Gleich", "Regel 5 Vergleich", options=["Ist aktiv", "Ist inaktiv", "Gleich", "Nicht gleich", "Groesser", "Kleiner", "Groesser/gleich", "Kleiner/gleich", "Kreuzt ueber", "Kreuzt unter"], group=GRP_RULES)
string regel_5_modus = input.string("Normal", "Regel 5 Modus", options=["Normal", "Und nicht (rechte Seite)"], group=GRP_RULES, tooltip="Und nicht: Vergleich muss zutreffen UND die rechte Vergleichsquelle darf NICHT aktiv sein. Bei rechter Seite = Wert wird der Vergleich umgekehrt.")
string regel_5_rechts_typ = input.string("Wert", "Regel 5 Rechte Seite", options=["Wert", "Quelle"], group=GRP_RULES)
float regel_5_wert = input.float(1.0, "Regel 5 Wert", step=0.1, group=GRP_RULES)
float regel_5_rechts = input.source(open, "Regel 5 Vergleichsquelle", group=GRP_RULES)

string verb_6 = input.string("EINZEL", "Verknuepfung R5 -> R6", options=["UND", "ODER", "EINZEL", "UND NICHT"], group=GRP_RULES)
bool regel_6_aktiv = input.bool(false, "Regel 6 aktiv", group=GRP_RULES)
string regel_6_aktion = input.string("Short oeffnen", "Regel 6 Aktion", options=["Long oeffnen", "Short oeffnen", "Long schliessen", "Short schliessen", "Alle schliessen"], group=GRP_RULES)
float regel_6_links = input.source(close, "Regel 6 Quelle", group=GRP_RULES)
string regel_6_operator = input.string("Gleich", "Regel 6 Vergleich", options=["Ist aktiv", "Ist inaktiv", "Gleich", "Nicht gleich", "Groesser", "Kleiner", "Groesser/gleich", "Kleiner/gleich", "Kreuzt ueber", "Kreuzt unter"], group=GRP_RULES)
string regel_6_modus = input.string("Normal", "Regel 6 Modus", options=["Normal", "Und nicht (rechte Seite)"], group=GRP_RULES, tooltip="Und nicht: Vergleich muss zutreffen UND die rechte Vergleichsquelle darf NICHT aktiv sein. Bei rechter Seite = Wert wird der Vergleich umgekehrt.")
string regel_6_rechts_typ = input.string("Wert", "Regel 6 Rechte Seite", options=["Wert", "Quelle"], group=GRP_RULES)
float regel_6_wert = input.float(1.0, "Regel 6 Wert", step=0.1, group=GRP_RULES)
float regel_6_rechts = input.source(open, "Regel 6 Vergleichsquelle", group=GRP_RULES)

string verb_7 = input.string("EINZEL", "Verknuepfung R6 -> R7", options=["UND", "ODER", "EINZEL", "UND NICHT"], group=GRP_RULES)
bool regel_7_aktiv = input.bool(false, "Regel 7 aktiv", group=GRP_RULES)
string regel_7_aktion = input.string("Long schliessen", "Regel 7 Aktion", options=["Long oeffnen", "Short oeffnen", "Long schliessen", "Short schliessen", "Alle schliessen"], group=GRP_RULES)
float regel_7_links = input.source(close, "Regel 7 Quelle", group=GRP_RULES)
string regel_7_operator = input.string("Gleich", "Regel 7 Vergleich", options=["Ist aktiv", "Ist inaktiv", "Gleich", "Nicht gleich", "Groesser", "Kleiner", "Groesser/gleich", "Kleiner/gleich", "Kreuzt ueber", "Kreuzt unter"], group=GRP_RULES)
string regel_7_modus = input.string("Normal", "Regel 7 Modus", options=["Normal", "Und nicht (rechte Seite)"], group=GRP_RULES, tooltip="Und nicht: Vergleich muss zutreffen UND die rechte Vergleichsquelle darf NICHT aktiv sein. Bei rechter Seite = Wert wird der Vergleich umgekehrt.")
string regel_7_rechts_typ = input.string("Wert", "Regel 7 Rechte Seite", options=["Wert", "Quelle"], group=GRP_RULES)
float regel_7_wert = input.float(1.0, "Regel 7 Wert", step=0.1, group=GRP_RULES)
float regel_7_rechts = input.source(open, "Regel 7 Vergleichsquelle", group=GRP_RULES)

string verb_8 = input.string("EINZEL", "Verknuepfung R7 -> R8", options=["UND", "ODER", "EINZEL", "UND NICHT"], group=GRP_RULES)
bool regel_8_aktiv = input.bool(false, "Regel 8 aktiv", group=GRP_RULES)
string regel_8_aktion = input.string("Short schliessen", "Regel 8 Aktion", options=["Long oeffnen", "Short oeffnen", "Long schliessen", "Short schliessen", "Alle schliessen"], group=GRP_RULES)
float regel_8_links = input.source(close, "Regel 8 Quelle", group=GRP_RULES)
string regel_8_operator = input.string("Gleich", "Regel 8 Vergleich", options=["Ist aktiv", "Ist inaktiv", "Gleich", "Nicht gleich", "Groesser", "Kleiner", "Groesser/gleich", "Kleiner/gleich", "Kreuzt ueber", "Kreuzt unter"], group=GRP_RULES)
string regel_8_modus = input.string("Normal", "Regel 8 Modus", options=["Normal", "Und nicht (rechte Seite)"], group=GRP_RULES, tooltip="Und nicht: Vergleich muss zutreffen UND die rechte Vergleichsquelle darf NICHT aktiv sein. Bei rechter Seite = Wert wird der Vergleich umgekehrt.")
string regel_8_rechts_typ = input.string("Wert", "Regel 8 Rechte Seite", options=["Wert", "Quelle"], group=GRP_RULES)
float regel_8_wert = input.float(1.0, "Regel 8 Wert", step=0.1, group=GRP_RULES)
float regel_8_rechts = input.source(open, "Regel 8 Vergleichsquelle", group=GRP_RULES)

// =====================================================================
// 3. LOKALE FILTER (Optional — Standard: deaktiviert)
// =====================================================================
string GRP_FILTER = "3. Lokale Filter (optional)"
bool trend_filter_aktiv = input.bool(false, "Trend-Filter aktiv (EMA/SMA)", group=GRP_FILTER)
string trend_ma_typ = input.string("EMA", "Trend MA Typ", options=["EMA", "SMA"], group=GRP_FILTER)
int trend_ma_len = input.int(200, "Trend MA Laenge", minval=1, group=GRP_FILTER)
float trend_ma_src = input.source(close, "Trend MA Quelle", group=GRP_FILTER)
bool session_filter_aktiv = input.bool(false, "Session-Filter aktiv", group=GRP_FILTER)
string session_zeit = input.session("0800-2200:1234567", "Handelszeit (UTC)", group=GRP_FILTER)
bool wochenende_sperren = input.bool(false, "Wochenende sperren (Sa/So)", group=GRP_FILTER)

// =====================================================================
// 4. RISIKOMANAGEMENT & CAPITAL PROTECTION
// =====================================================================
string GRP_RISK = "4. Risikomanagement"
bool daily_loss_guard_aktiv = input.bool(false, "Tages-Drawdown-Schutz aktiv", group=GRP_RISK)
float max_daily_loss_pct = input.float(3.0, "Maximaler Tagesverlust %", minval=0.1, step=0.1, group=GRP_RISK)
bool consec_loss_guard_aktiv = input.bool(false, "Pause nach Verluststraehne aktiv", group=GRP_RISK)
int max_consec_losses = input.int(3, "Max. Verluste in Folge", minval=1, maxval=10, group=GRP_RISK)
int pause_bars_count = input.int(20, "Handelspause in Kerzen", minval=1, maxval=200, group=GRP_RISK)
bool cooldown_aktiv = input.bool(false, "Re-Entry Cooldown nach SL", group=GRP_RISK, tooltip="Sperrt neue Entries fuer N Kerzen nach einem Stop-Loss-Treffer.")
int cooldown_bars = input.int(5, "Cooldown Kerzen nach SL", minval=1, maxval=50, group=GRP_RISK)

// =====================================================================
// 4A. ENTRY-LIMITS PRO UTC-STUNDE (OPTIONAL)
// =====================================================================
string GRP_ENTRY_LIMIT = "4A. Entry-Limits pro UTC-Stunde (optional)"
bool entry_limit_aktiv = input.bool(false, "Long-/Short-Trade-Limit aktiv", group=GRP_ENTRY_LIMIT)
int max_long_entries_pro_stunde = input.int(3, "Max. Long-Entries pro UTC-Stunde", minval=0, maxval=100, group=GRP_ENTRY_LIMIT, tooltip="Vollständig variabel. 0 sperrt bei aktivem Modul alle neuen Long-Entries in der jeweiligen UTC-Stunde.")
int max_short_entries_pro_stunde = input.int(3, "Max. Short-Entries pro UTC-Stunde", minval=0, maxval=100, group=GRP_ENTRY_LIMIT, tooltip="Vollständig variabel. 0 sperrt bei aktivem Modul alle neuen Short-Entries in der jeweiligen UTC-Stunde.")

// =====================================================================
// 5. STOP LOSS & GEWINNSICHERUNG
// =====================================================================
string GRP_SL = "5. Stop Loss & Gewinnsicherung"
bool reversal_aktiv = input.bool(false, "Reversal aktiv", group=GRP_SL)
string modus_gleiche_richtung = input.string("Schliessen & Neustart", "Aktion bei gleichem Signal", options=["Ignorieren", "Schliessen & Neustart", "Einsatz erhoehen (Pyramiden)"], group=GRP_SL)
int maximale_trade_dauer = input.int(0, "Maximale Trade-Dauer Kerzen (Legacy)", minval=0, maxval=100, group=GRP_SL)
bool doppelt_validieren = input.bool(false, "Doppelte Close-Validierung", group=GRP_SL, tooltip="Regel-Close-Signale muessen 2x feuern bevor geschlossen wird. SL/TP/Trail/Pinbar/Fade bleiben sofort.")

// =====================================================================
// 5A. TEMPORALE EXITS (OPTIONAL)
// =====================================================================
string GRP_TIME_EXIT = "5A. Temporale Exits (optional)"
bool temporal_exit_aktiv = input.bool(false, "Temporale Exits aktiv", group=GRP_TIME_EXIT)
bool temporal_max_bars_aktiv = input.bool(true, "Maximale Haltedauer verwenden", group=GRP_TIME_EXIT)
int temporal_max_bars = input.int(24, "Maximale Haltedauer Kerzen", minval=1, maxval=1000, group=GRP_TIME_EXIT)
bool temporal_stagnation_aktiv = input.bool(false, "Stagnations-Exit verwenden", group=GRP_TIME_EXIT, tooltip="Schließt eine Position, die nach N Kerzen nicht mindestens den definierten Gewinn erreicht hat.")
int temporal_stagnation_bars = input.int(12, "Stagnation nach Kerzen", minval=1, maxval=500, group=GRP_TIME_EXIT)
float temporal_min_profit_pct = input.float(0.10, "Mindestgewinn bis Stagnation %", minval=-10.0, step=0.05, group=GRP_TIME_EXIT)
bool temporal_session_exit_aktiv = input.bool(false, "Session-Cutoff Exit verwenden", group=GRP_TIME_EXIT, tooltip="Schließt auf der ersten Kerze, die den UTC-Cutoff überschreitet. Die Ausführung ist auf groben Timeframes entsprechend weniger präzise.")
int temporal_cutoff_stunde = input.int(22, "Session-Cutoff Stunde UTC", minval=0, maxval=23, group=GRP_TIME_EXIT)
int temporal_cutoff_minute = input.int(0, "Session-Cutoff Minute UTC", minval=0, maxval=59, group=GRP_TIME_EXIT)
string temporal_cutoff_tag = input.string("Taeglich", "Session-Cutoff Tag", options=["Taeglich", "Freitag"], group=GRP_TIME_EXIT)

// Initialer Stop Loss
bool sl_aktiv = input.bool(true, "Stop Loss aktiv", group=GRP_SL)
string sl_typ = input.string("ATR", "SL Typ", options=["ATR", "Prozent"], group=GRP_SL)
float sl_faktor = input.float(2.25, "SL Faktor / Prozentwert", step=0.25, group=GRP_SL)
int sl_atr_len = input.int(14, "SL ATR Laenge", minval=1, group=GRP_SL)

// Multi-Stage Profit Lock (ersetzt Break-Even)
bool stage_lock_aktiv = input.bool(false, "Multi-Stage Profit Lock aktiv", group=GRP_SL, tooltip="Zieht den SL stufenweise nach oben. Stufe 1 = Break-Even.")
float stage1_trigger = input.float(0.4, "Stufe 1 Trigger %", minval=0.05, step=0.05, group=GRP_SL)
float stage1_lock = input.float(0.05, "Stufe 1 Lock %", minval=0.0, step=0.01, group=GRP_SL, tooltip="0.05% deckt Gebuehren ab = Break-Even.")
float stage2_trigger = input.float(0.8, "Stufe 2 Trigger %", minval=0.1, step=0.05, group=GRP_SL)
float stage2_lock = input.float(0.4, "Stufe 2 Lock %", minval=0.0, step=0.05, group=GRP_SL)
float stage3_trigger = input.float(1.2, "Stufe 3 Trigger %", minval=0.1, step=0.05, group=GRP_SL)
float stage3_lock = input.float(0.8, "Stufe 3 Lock %", minval=0.0, step=0.05, group=GRP_SL)

// Trailing Stop (Unified: Prozent oder Chandelier ATR)
bool trailing_aktiv = input.bool(false, "Trailing Stop aktiv", group=GRP_SL)
string trailing_modus = input.string("Prozent", "Trailing Modus", options=["Prozent", "Chandelier ATR"], group=GRP_SL)
float trailing_act_pct = input.float(1.0, "Trailing Aktivierung %", minval=0.1, step=0.1, group=GRP_SL, tooltip="Ab wieviel % Gewinn der Trail greift (nur Prozent-Modus).")
