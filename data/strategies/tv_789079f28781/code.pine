//@version=6
// Strategy-driven alert() version.
// TradingView alert setup:
// 1. Condition: this strategy
// 2. Trigger: Any alert() function call
// 3. Webhook URL: your webhook endpoint
// 4. Message field can be blank because the script sends JSON itself
strategy(
    "BPRC PRO - Institutional Strategy (clean v3 alerts)",
    overlay=true,
    calc_on_every_tick=false,
    initial_capital=100000,
    default_qty_type=strategy.percent_of_equity,
    default_qty_value=5,
    margin_long=10,
    margin_short=10,
    max_labels_count=50
)

// ====================================================================================================
// 1. INPUTS
// ====================================================================================================
group_core = "BPRC Core Engine"
in_channel_len = input.int(20, "Channel Length", group=group_core)
in_bp_mult = input.float(2.0, "Breakout Multiplier (BP)", group=group_core)
in_r_mult = input.float(0.5, "Reload Multiplier (R)", group=group_core)
in_vol_norm = input.float(1.2, "Vol/Mom Normalization Threshold", group=group_core)

group_mtf = "MTF Alignment & A+ Engine"
in_req_align = input.int(70, "Required Alignment % (A+)", group=group_mtf, minval=0, maxval=100)
in_use_mtf = input.bool(true, "Use MTF Filter?", group=group_mtf)

group_risk = "Trade Plan & Risk"
in_sl_atr_mult = input.float(1.5, "Stop Loss ATR Multiplier", group=group_risk)
in_tp_step = input.float(1.0, "TP Step ATR Multiplier", group=group_risk)
in_tp1_pct = input.float(20, "TP1 Exit %", group=group_risk)
in_tp2_pct = input.float(20, "TP2 Exit %", group=group_risk)
in_tp3_pct = input.float(20, "TP3 Exit %", group=group_risk)
in_tp4_pct = input.float(20, "TP4 Exit %", group=group_risk)
in_tp5_pct = input.float(20, "TP5 Exit %", group=group_risk)

group_logic = "Filters & Execution"
in_alternating = input.bool(true, "Enforce Alternating Signals", group=group_logic)
in_show_ui = input.bool(true, "Show Dashboard", group=group_logic)

// ====================================================================================================
// 2. SMART NORMALIZATION & BASE INDICATORS
// ====================================================================================================
float atr = ta.atr(14)
float vol_ma = ta.sma(volume, 20)
float norm_vol = vol_ma > 0 ? volume / vol_ma : 0.0
float body_size = math.abs(close - open)
float norm_body = atr > 0 ? body_size / atr : 0.0
bool confirmed = barstate.isconfirmed

float basis = ta.ema(close, in_channel_len)
float bp_upper = basis + atr * in_bp_mult
float bp_lower = basis - atr * in_bp_mult
float r_upper = basis + atr * in_r_mult
float r_lower = basis - atr * in_r_mult

plot(basis, color=color.new(color.gray, 50), title="Basis")
p_bpu = plot(bp_upper, color=color.new(color.teal, 80), title="BP Upper")
p_ru = plot(r_upper, color=color.new(color.teal, 50), title="R Upper")
plot(r_lower, color=color.new(color.red, 50), title="R Lower")
p_bpl = plot(bp_lower, color=color.new(color.red, 80), title="BP Lower")
fill(p_bpu, p_ru, color=color.new(color.teal, 90), title="Bull Breakout Zone")
fill(p_bpl, p_ru, color=color.new(color.red, 90), title="Bear Breakout Zone")

// ====================================================================================================
// 3. MTF BIAS ENGINE (UDT)
// ====================================================================================================
type BiasData
    int bias_val
    int bars_act

f_calc_bias() =>
    float vwap_val = ta.vwap(hlc3)
    float fast = ta.ema(close, 9)
    float slow = ta.ema(close, 21)

    int current_bias = 0
    if close > vwap_val and fast > slow
        current_bias := 1
    else if close < vwap_val and fast < slow
        current_bias := -1

    int current_bars = 1
    if current_bias == nz(current_bias[1])
        current_bars := nz(current_bars[1]) + 1

    BiasData.new(current_bias, current_bars)

BiasData data_1m = request.security(syminfo.tickerid, "1", f_calc_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
BiasData data_5m = request.security(syminfo.tickerid, "5", f_calc_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
BiasData data_15m = request.security(syminfo.tickerid, "15", f_calc_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
BiasData data_30m = request.security(syminfo.tickerid, "30", f_calc_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
BiasData data_60m = request.security(syminfo.tickerid, "60", f_calc_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
BiasData data_240m = request.security(syminfo.tickerid, "240", f_calc_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
BiasData data_D = request.security(syminfo.tickerid, "D", f_calc_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

float total_tfs = 7.0

float bull_tfs = 0.0
bull_tfs += data_1m.bias_val == 1 ? 1 : 0
bull_tfs += data_5m.bias_val == 1 ? 1 : 0
bull_tfs += data_15m.bias_val == 1 ? 1 : 0
bull_tfs += data_30m.bias_val == 1 ? 1 : 0
bull_tfs += data_60m.bias_val == 1 ? 1 : 0
bull_tfs += data_240m.bias_val == 1 ? 1 : 0
bull_tfs += data_D.bias_val == 1 ? 1 : 0

float bear_tfs = 0.0
bear_tfs += data_1m.bias_val == -1 ? 1 : 0
bear_tfs += data_5m.bias_val == -1 ? 1 : 0
bear_tfs += data_15m.bias_val == -1 ? 1 : 0
bear_tfs += data_30m.bias_val == -1 ? 1 : 0
bear_tfs += data_60m.bias_val == -1 ? 1 : 0
bear_tfs += data_240m.bias_val == -1 ? 1 : 0
bear_tfs += data_D.bias_val == -1 ? 1 : 0

float align_bull_pct = math.round(bull_tfs / total_tfs * 100)
float align_bear_pct = math.round(bear_tfs / total_tfs * 100)
int dominant_bias = align_bull_pct >= in_req_align ? 1 : align_bear_pct >= in_req_align ? -1 : 0
bool mtf_long_ok = not in_use_mtf or dominant_bias == 1
bool mtf_short_ok = not in_use_mtf or dominant_bias == -1
bool is_a_plus = not in_use_mtf or dominant_bias != 0

// ====================================================================================================
// 4. BPRC STATE MACHINE & CORE LOGIC
// ====================================================================================================
var int state = 0
var float trigger_price = 0.0
var int last_trade_dir = 0

bool valid_strength = norm_vol > in_vol_norm and norm_body > 0.5

bool bp_bull = close > bp_upper and valid_strength
bool bp_bear = close < bp_lower and valid_strength

bool r_bull = state == 1 and close < r_upper and close >= basis
bool r_bear = state == -1 and close > r_lower and close <= basis

bool c_bull = state == 2 and close > high[1] and close > open
bool c_bear = state == -2 and close < low[1] and close < open

if state > 0 and close < bp_lower
    state := 0
if state < 0 and close > bp_upper
    state := 0

if state == 0
    if bp_bull
        state := 1
    else if bp_bear
        state := -1
else if state == 1
    if r_bull
        state := 2
else if state == -1
    if r_bear
        state := -2
else if state == 2
    if c_bull
        state := 3
        trigger_price := close
else if state == -2
    if c_bear
        state := -3
        trigger_price := close

// ====================================================================================================
// 5. TRADE PLAN & EXECUTION
// ====================================================================================================
var float trade_entry = na
var float trade_sl = na
var float trade_tp1 = na
var float trade_tp2 = na
var float trade_tp3 = na
var float trade_tp4 = na
var float trade_tp5 = na

bool in_trade = strategy.position_size != 0
bool can_long = not in_alternating or last_trade_dir != 1
bool can_short = not in_alternating or last_trade_dir != -1

bool execute_long = confirmed and state == 3 and not in_trade and mtf_long_ok and can_long
bool execute_short = confirmed and state == -3 and not in_trade and mtf_short_ok and can_short

float tp1_qty = math.max(0.0, math.min(100.0, in_tp1_pct))
float tp2_qty = math.max(0.0, math.min(100.0 - tp1_qty, in_tp2_pct))
float tp3_qty = math.max(0.0, math.min(100.0 - tp1_qty - tp2_qty, in_tp3_pct))
float tp4_qty = math.max(0.0, math.min(100.0 - tp1_qty - tp2_qty - tp3_qty, in_tp4_pct))
float tp5_qty = math.max(0.0, 100.0 - tp1_qty - tp2_qty - tp3_qty - tp4_qty)

f_json_value(_value) =>
    na(_value) ? "null" : "\"" + str.tostring(_value, format.mintick) + "\""

f_alert_payload(_signal, _event, _side) =>
    "{\"signal\":\"" + _signal + "\",\"event\":\"" + _event + "\",\"side\":\"" + _side + "\",\"ticker\":\"" + syminfo.ticker + "\",\"time\":\"" + str.tostring(time) + "\",\"price\":\"" + str.tostring(close, format.mintick) + "\",\"position_size\":\"" + str.tostring(strategy.position_size) + "\",\"entry\":" + f_json_value(trade_entry) + ",\"stop\":" + f_json_value(trade_sl) + ",\"tp1\":" + f_json_value(trade_tp1) + "}"

f_emit_alert(_signal, _event, _side) =>
    alert(f_alert_payload(_signal, _event, _side), alert.freq_once_per_bar_close)

f_submit_long_exits() =>
    if tp1_qty > 0
        strategy.exit("Long TP1", from_entry="Long", qty_percent=tp1_qty, limit=trade_tp1, stop=trade_sl)
    if tp2_qty > 0
        strategy.exit("Long TP2", from_entry="Long", qty_percent=tp2_qty, limit=trade_tp2, stop=trade_sl)
    if tp3_qty > 0
        strategy.exit("Long TP3", from_entry="Long", qty_percent=tp3_qty, limit=trade_tp3, stop=trade_sl)
    if tp4_qty > 0
        strategy.exit("Long TP4", from_entry="Long", qty_percent=tp4_qty, limit=trade_tp4, stop=trade_sl)
    if tp5_qty > 0
        strategy.exit("Long TP5", from_entry="Long", qty_percent=tp5_qty, limit=trade_tp5, stop=trade_sl)

f_submit_short_exits() =>
    if tp1_qty > 0
        strategy.exit("Short TP1", from_entry="Short", qty_percent=tp1_qty, limit=trade_tp1, stop=trade_sl)
    if tp2_qty > 0
        strategy.exit("Short TP2", from_entry="Short", qty_percent=tp2_qty, limit=trade_tp2, stop=trade_sl)
    if tp3_qty > 0
        strategy.exit("Short TP3", from_entry="Short", qty_percent=tp3_qty, limit=trade_tp3, stop=trade_sl)
    if tp4_qty > 0
        strategy.exit("Short TP4", from_entry="Short", qty_percent=tp4_qty, limit=trade_tp4, stop=trade_sl)
    if tp5_qty > 0
        strategy.exit("Short TP5", from_entry="Short", qty_percent=tp5_qty, limit=trade_tp5, stop=trade_sl)

if execute_long
    float current_atr = atr
    trade_entry := close
    trade_sl := trade_entry - current_atr * in_sl_atr_mult
    trade_tp1 := trade_entry + current_atr * in_tp_step * 1
    trade_tp2 := trade_entry + current_atr * in_tp_step * 2
    trade_tp3 := trade_entry + current_atr * in_tp_step * 3
    trade_tp4 := trade_entry + current_atr * in_tp_step * 4
    trade_tp5 := trade_entry + current_atr * in_tp_step * 5

    strategy.entry("Long", strategy.long)
    f_submit_long_exits()
    f_emit_alert("BPRC A+ BUY", "ENTRY", "LONG")
    last_trade_dir := 1
    state := 0

if execute_short
    float current_atr = atr
    trade_entry := close
    trade_sl := trade_entry + current_atr * in_sl_atr_mult
    trade_tp1 := trade_entry - current_atr * in_tp_step * 1
    trade_tp2 := trade_entry - current_atr * in_tp_step * 2
    trade_tp3 := trade_entry - current_atr * in_tp_step * 3
    trade_tp4 := trade_entry - current_atr * in_tp_step * 4
    trade_tp5 := trade_entry - current_atr * in_tp_step * 5

    strategy.entry("Short", strategy.short)
    f_submit_short_exits()
    f_emit_alert("BPRC A+ SELL", "ENTRY", "SHORT")
    last_trade_dir := -1
    state := 0

bool new_long = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool new_short = strategy.position_size < 0 and strategy.position_size[1] >= 0

if new_long
    float current_atr = atr
    trade_entry := strategy.position_avg_price
    trade_sl := trade_entry - current_atr * in_sl_atr_mult
    trade_tp1 := trade_entry + current_atr * in_tp_step * 1
    trade_tp2 := trade_entry + current_atr * in_tp_step * 2
    trade_tp3 := trade_entry + current_atr * in_tp_step * 3
    trade_tp4 := trade_entry + current_atr * in_tp_step * 4
    trade_tp5 := trade_entry + current_atr * in_tp_step * 5

if new_short
    float current_atr = atr
    trade_entry := strategy.position_avg_price
    trade_sl := trade_entry + current_atr * in_sl_atr_mult
    trade_tp1 := trade_entry - current_atr * in_tp_step * 1
    trade_tp2 := trade_entry - current_atr * in_tp_step * 2
    trade_tp3 := trade_entry - current_atr * in_tp_step * 3
    trade_tp4 := trade_entry - current_atr * in_tp_step * 4
    trade_tp5 := trade_entry - current_atr * in_tp_step * 5

if strategy.position_size > 0 and not na(trade_sl)
    f_submit_long_exits()

if strategy.position_size < 0 and not na(trade_sl)
    f_submit_short_exits()

float prev_pos = nz(strategy.position_size[1], 0)
bool just_flat = strategy.position_size == 0 and prev_pos != 0
bool close_long = just_flat and prev_pos > 0
bool close_short = just_flat and prev_pos < 0

if close_long
    f_emit_alert("BPRC A+ CLOSE BUY", "EXIT", "LONG")

if close_short
    f_emit_alert("BPRC A+ CLOSE SELL", "EXIT", "SHORT")

if just_flat
    trade_entry := na
    trade_sl := na
    trade_tp1 := na
    trade_tp2 := na
    trade_tp3 := na
    trade_tp4 := na
    trade_tp5 := na

plot(strategy.position_size != 0 ? trade_sl : na, color=color.red, style=plot.style_cross, title="Stop Loss")
plot(strategy.position_size != 0 ? trade_tp1 : na, color=color.green, style=plot.style_circles, title="TP 1")

// ====================================================================================================
// 6. UI / DASHBOARD
// ====================================================================================================
var table dashboard = table.new(position.top_right, 3, 10, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if in_show_ui and barstate.islast
    table.cell(dashboard, 0, 0, "BPRC PRO", text_color=color.white, text_halign=text.align_center, bgcolor=color.new(color.blue, 50))
    table.cell(dashboard, 1, 0, "ALIGNMENT", text_color=color.white, text_halign=text.align_center, bgcolor=color.new(color.blue, 50))
    table.cell(dashboard, 2, 0, "TRADE STATUS", text_color=color.white, text_halign=text.align_center, bgcolor=color.new(color.blue, 50))

    string state_txt = state == 0 ? "Neutral" : state == 1 ? "Bullish BP" : state == 2 ? "Bullish Reload" : state == 3 ? "Bullish Trigger" : state == -1 ? "Bearish BP" : state == -2 ? "Bearish Reload" : "Bearish Trigger"
    color state_col = state > 0 ? color.green : state < 0 ? color.red : color.gray
    table.cell(dashboard, 0, 1, "State:", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 0, 2, state_txt, text_color=state_col, text_halign=text.align_center)

    color align_col = dominant_bias == 1 ? color.new(#FFD700, 0) : dominant_bias == -1 ? color.red : color.gray
    table.cell(dashboard, 1, 1, "Bull / Bear %", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 1, 2, str.tostring(align_bull_pct) + "% / " + str.tostring(align_bear_pct) + "%", text_color=align_col, text_halign=text.align_center)
    table.cell(dashboard, 1, 3, is_a_plus ? "A+ VALID" : "NO A+", text_color=align_col, text_halign=text.align_center)

    string pos_txt = strategy.position_size > 0 ? "LONG ACTIVE" : strategy.position_size < 0 ? "SHORT ACTIVE" : "FLAT"
    color pos_col = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dashboard, 2, 1, pos_txt, text_color=pos_col, text_halign=text.align_center)
    table.cell(dashboard, 2, 2, "Last: " + (last_trade_dir == 1 ? "Long" : last_trade_dir == -1 ? "Short" : "None"), text_color=color.white, text_halign=text.align_center)
