//@version=6
strategy(
     title="MOS - SNRZ Multi-Timeframe Ultimate [v6 Optimized]",
     shorttitle="MOS_SNRZ_v6_Opt",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=15,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     slippage=2,
     max_labels_count=500,
     max_lines_count=500
 )

// ==========================================
// PARAMETERS & INPUTS
// ==========================================
var string G_SNRZ   = "SNRZ Zone Engine Settings"
var string G_FILT   = "Regime & Energy Filters"
var string G_RISK   = "Quantitative Risk Management (Kelly)"

// SNRZ Inputs
int   leftBars      = input.int(3, "Pivot Left Bars", group=G_SNRZ)
int   rightBars     = input.int(1, "Pivot Right Bars", group=G_SNRZ)
int   atrLen        = input.int(200, "Zone ATR Baseline Length", group=G_SNRZ)
float heightAtr     = input.float(1.3, "Zone Height ATR Multiplier", group=G_SNRZ)
float strongThr     = input.float(8.5, "Min Zone Quality Score (Optimized)", group=G_SNRZ, tooltip="Raised to 8.5 based on 9.8 avg winning trade score")
int   volLen        = input.int(20, "Volume Profile Length", group=G_SNRZ)
float wTouch        = input.float(0.7, "Weight: Touches", group=G_SNRZ)
float wVol          = input.float(2.4, "Weight: Volume", group=G_SNRZ)
float wWick         = input.float(1.0, "Weight: Wick Rejection", group=G_SNRZ)
bool  useDecay      = input.bool(true, "Apply Time Decay to Zones", group=G_SNRZ)
int   decayBars     = input.int(62, "Decay Half-Life (Bars)", group=G_SNRZ)

// Strategy Execution Inputs
float slParam       = input.float(1.9, "Stop Loss ATR Multiplier", group=G_SNRZ)
float tpParam       = input.float(8.0, "Take Profit ATR Multiplier", group=G_SNRZ)
int   atrLenStrat   = input.int(14, "Strategy ATR Length", group=G_SNRZ)

// Regime Inputs
bool  useRegimeFlt  = input.bool(true, "Enable Hurst Exponent Regime Filter", group=G_FILT)
float hurstMaxThresh= input.float(0.48, "Max Hurst Exponent (Mean Reversion Cap)", group=G_FILT)
int   hurstLen      = input.int(100, "Hurst Lookback Period", group=G_FILT)

bool  useDerFilter  = input.bool(true, "Enable DER Trend Energy Filter", group=G_FILT)
int   derLookback   = input.int(20, "DER Lookback", group=G_FILT)
int   derSmooth     = input.int(5, "DER Smoothing Period", group=G_FILT)
float derMaxEnergy  = input.float(0.65, "Max DER Energy Threshold for Counter-Zone", group=G_FILT)

// Risk & Kelly Inputs
bool  useKelly      = input.bool(true, "Enable Dynamic Fractional Kelly Sizing", group=G_RISK)
float kellyFraction = input.float(0.5, "Kelly Multiplier (0.5 = Half-Kelly)", group=G_RISK)
float maxRiskCapPct = input.float(20.0, "Absolute Max Risk Cap Per Trade (%)", group=G_RISK)

// ==========================================
// QUANTITATIVE REGIME ENGINES
// ==========================================

// 1. Rescaled Range Hurst Exponent Engine
f_hurst(src, len) =>
    float log_ret = math.log(src / src[1])
    float mean_ret = ta.sma(log_ret, len)
    float dev = log_ret - mean_ret
    
    // Cumulative deviations
    float cum_dev = 0.0
    float max_dev = -999999.0
    float min_dev = 999999.0
    for i = 0 to len - 1
        cum_dev := cum_dev + dev[i]
        if cum_dev > max_dev
            max_dev := cum_dev
        if cum_dev < min_dev
            min_dev := cum_dev
            
    float range_val = max_dev - min_dev
    float stdev_val = ta.stdev(log_ret, len)
    float rs = (stdev_val > 0) ? (range_val / stdev_val) : 0.5
    float h = (rs > 0) ? (math.log(rs) / math.log(len)) : 0.5
    h

hurstVal = f_hurst(close, hurstLen)
regimePass = not useRegimeFlt or (hurstVal <= hurstMaxThresh)

// 2. Directional Energy Ratio (DER) Engine
f_der(len, smooth) =>
    float priceDelta = close - open
    float energyUp = math.sum(priceDelta > 0 ? math.pow(priceDelta, 2) : 0.0, len)
    float energyDown = math.sum(priceDelta < 0 ? math.pow(priceDelta, 2) : 0.0, len)
    float totalEnergy = energyUp + energyDown
    float rawDer = totalEnergy > 0 ? (energyUp - energyDown) / totalEnergy : 0.0
    float smoothedDer = ta.ema(rawDer, smooth)
    smoothedDer

derEnergy = f_der(derLookback, derSmooth)
derPass = not useDerFilter or (math.abs(derEnergy) <= derMaxEnergy)

// ==========================================
// SNRZ ZONE IDENTIFICATION & SCORING
// ==========================================
atrVal = ta.atr(atrLen)
stratAtr = ta.atr(atrLenStrat)

// Pivot High/Low Detection
pHi = ta.pivothigh(high, leftBars, rightBars)
pLo = ta.pivotlow(low, leftBars, rightBars)

// Volume & Wick Calculations
volAvg = ta.sma(volume, volLen)
volRatio = volume / volAvg
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bodySize = math.abs(close - open)

// Dynamic Zone Quality Scoring Function
f_scoreZone(isSup, pVolume, pWick, pBody) =>
    float vScore = math.min(pVolume * wVol, 4.0)
    float wScore = math.min((pBody > 0 ? pWick / pBody : 1.0) * wWick, 3.0)
    float tScore = wTouch * 1.0 // Initial touch value
    float rawScore = vScore + wScore + tScore
    math.min(rawScore, 10.0)

var float activeSupTop = na
var float activeSupBot = na
var float activeSupScore = 0.0

var float activeResTop = na
var float activeResBot = na
var float activeResScore = 0.0

if not na(pLo)
    activeSupBot := low[rightBars] - (atrVal[rightBars] * heightAtr * 0.5)
    activeSupTop := low[rightBars] + (atrVal[rightBars] * heightAtr * 0.5)
    activeSupScore := f_scoreZone(true, volRatio[rightBars], lowerWick[rightBars], bodySize[rightBars])

if not na(pHi)
    activeResBot := high[rightBars] - (atrVal[rightBars] * heightAtr * 0.5)
    activeResTop := high[rightBars] + (atrVal[rightBars] * heightAtr * 0.5)
    activeResScore := f_scoreZone(false, volRatio[rightBars], upperWick[rightBars], bodySize[rightBars])

// Score Decay over time
if useDecay and not na(activeSupScore)
    activeSupScore := math.max(activeSupScore * math.pow(0.5, 1.0 / decayBars), 1.0)
if useDecay and not na(activeResScore)
    activeResScore := math.max(activeResScore * math.pow(0.5, 1.0 / decayBars), 1.0)

// Visualisation of Zones
plot(activeSupTop, "Support Top", color=color.new(color.teal, 50), style=plot.style_linebr)
plot(activeSupBot, "Support Bottom", color=color.new(color.teal, 80), style=plot.style_linebr)
plot(activeResTop, "Resistance Top", color=color.new(color.red, 80), style=plot.style_linebr)
plot(activeResBot, "Resistance Bottom", color=color.new(color.red, 50), style=plot.style_linebr)

// ==========================================
// DYNAMIC HALF-KELLY POSITION SIZING
// ==========================================
f_getKellySizing(winRate, winLossRatio, mult, maxCap) =>
    float p = winRate
    float q = 1.0 - p
    float b = winLossRatio
    float kellyF = (b > 0) ? ((p * b - q) / b) : 0.0
    float fraction = math.max(kellyF * mult, 0.01) // Ensure non-negative
    math.min(fraction * 100.0, maxCap)

// Historical Backtest Estimation Inputs (5 wins / 11 trades, Ratio 3.83)
var float estWinRate = 0.4545
var float estWinLossRatio = 3.83

float kellyPosSizePercent = useKelly ? f_getKellySizing(estWinRate, estWinLossRatio, kellyFraction, maxRiskCapPct) : 10.0

// ==========================================
// TRADING CONDITIONS & EXECUTION
// ==========================================
bool supTouch = low <= activeSupTop and high >= activeSupBot and activeSupScore >= strongThr
bool resTouch = high >= activeResBot and low <= activeResTop and activeResScore >= strongThr

bool longCondition  = supTouch and regimePass and derPass and strategy.position_size == 0
bool shortCondition = resTouch and regimePass and derPass and strategy.position_size == 0

// Execution Logic
if longCondition
    float sl = close - (stratAtr * slParam)
    float tp = close + (stratAtr * tpParam)
    strategy.entry("SNRZ_Long", strategy.long, qty=strategy.equity * (kellyPosSizePercent / 100.0) / close)
    strategy.exit("Exit_Long", "SNRZ_Long", stop=sl, limit=tp)

if shortCondition
    float sl = close + (stratAtr * slParam)
    float tp = close - (stratAtr * tpParam)
    strategy.entry("SNRZ_Short", strategy.short, qty=strategy.equity * (kellyPosSizePercent / 100.0) / close)
    strategy.exit("Exit_Short", "SNRZ_Short", stop=sl, limit=tp)

// ==========================================
// QUANT DASHBOARD
// ==========================================
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Hurst Exponent", text_color=color.white)
    table.cell(dash, 1, 0, str.tostring(hurstVal, "#.##"), text_color = hurstVal <= hurstMaxThresh ? color.green : color.red)
    
    table.cell(dash, 0, 1, "DER Energy", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(derEnergy, "#.##"), text_color = math.abs(derEnergy) <= derMaxEnergy ? color.green : color.red)
    
    table.cell(dash, 0, 2, "Half-Kelly Equity %", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(kellyPosSizePercent, "#.#") + "%", text_color=color.yellow)
    
    table.cell(dash, 0, 3, "Regime Status", text_color=color.white)
    table.cell(dash, 1, 3, (regimePass and derPass) ? "TRADE ALLOWED" : "FILTERED", text_color = (regimePass and derPass) ? color.green : color.red)