//@version=6
// Direct Pionex Signal Bot version of BPRC PRO.
// TradingView alert setup:
// 1. Condition: this strategy
// 2. Trigger: Order fills only
// 3. Webhook URL: paste the Pionex Signal Bot URL from Pionex
// 4. Message: {{strategy.order.alert_message}}
strategy(
    title="BPRC PRO - Institutional Strategy Pionex Direct",
    shorttitle="BPRC PRO Px",
    overlay=true,
    calc_on_every_tick=false,
    initial_capital=100,
    currency="USDT",
    default_qty_type=strategy.percent_of_equity,
    default_qty_value=1,
    pyramiding=1,
    margin_long=0,
    margin_short=0,
    process_orders_on_close=false,
    commission_type=strategy.commission.percent,
    commission_value=0.05,
    slippage=2,
    max_labels_count=50
)

// ====================================================================================================
// 1. INPUTS
// ====================================================================================================
string group_core = "BPRC Core Engine"
int in_channel_len = input.int(20, "Channel Length", group=group_core)
float in_bp_mult = input.float(2.0, "Breakout Multiplier (BP)", group=group_core)
float in_r_mult = input.float(0.5, "Reload Multiplier (R)", group=group_core)
float in_vol_norm = input.float(1.2, "Vol/Mom Normalization Threshold", group=group_core)

string group_mtf = "MTF Alignment & A+ Engine"
int in_req_align = input.int(70, "Required Alignment % (A+)", group=group_mtf, minval=0, maxval=100)
bool in_use_mtf = input.bool(true, "Use MTF Filter?", group=group_mtf)

string group_risk = "Trade Plan & Risk"
float in_sl_atr_mult = input.float(1.5, "Stop Loss ATR Multiplier", group=group_risk)
float in_tp_step = input.float(1.0, "TP Step ATR Multiplier", group=group_risk)
float in_tp1_pct = input.float(20, "TP1 Exit %", group=group_risk)
float in_tp2_pct = input.float(20, "TP2 Exit %", group=group_risk)
float in_tp3_pct = input.float(20, "TP3 Exit %", group=group_risk)
float in_tp4_pct = input.float(20, "TP4 Exit %", group=group_risk)
float in_tp5_pct = input.float(20, "TP5 Exit %", group=group_risk)

string group_logic = "Filters & Execution"
bool in_alternating = input.bool(true, "Enforce Alternating Signals", group=group_logic)
bool in_show_ui = input.bool(true, "Show Dashboard", group=group_logic)

string group_pionex = "Pionex Webhook"
string pionex_uuid = input.string("", "Pionex Signal Bot UUID", group=group_pionex)
bool send_close_alerts = input.bool(true, "Send close alerts", group=group_pionex)

// ====================================================================================================
// 2. HELPERS & BASE INDICATORS
// ====================================================================================================
f_pionex_payload() =>
    "{\"data\":{\"action\":\"{{strategy.order.action}}\",\"contracts\":\"{{strategy.order.contracts}}\",\"position_size\":\"{{strategy.position_size}}\"},\"price\":\"{{close}}\",\"signal_param\":\"{}\",\"signal_type\":\"" + pionex_uuid + "\",\"symbol\":\"{{ticker}}\",\"time\":\"{{timenow}}\"}"

f_bias_value() =>
    float vwap_val = ta.vwap(hlc3)
    float fast = ta.ema(close, 9)
    float slow = ta.ema(close, 21)
    close > vwap_val and fast > slow ? 1 : close < vwap_val and fast < slow ? -1 : 0

float atr = ta.atr(14)
float vol_ma = ta.sma(volume, 20)
float norm_vol = vol_ma > 0 ? volume / vol_ma : 0.0
float body_size = math.abs(close - open)
float norm_body = atr > 0 ? body_size / atr : 0.0
bool confirmed = barstate.isconfirmed
bool pionex_ready = str.length(pionex_uuid) > 0
string payload_message = pionex_ready ? f_pionex_payload() : ""

// Channel Engine
float basis = ta.ema(close, in_channel_len)
float bp_upper = basis + atr * in_bp_mult
float bp_lower = basis - atr * in_bp_mult
float r_upper = basis + atr * in_r_mult
float r_lower = basis - atr * in_r_mult

// Plot Channel
plot(basis, color=color.new(color.gray, 50), title="Basis")
plot_bp_upper = plot(bp_upper, color=color.new(color.teal, 80), title="BP Upper")
plot_r_upper = plot(r_upper, color=color.new(color.teal, 50), title="R Upper")
plot_r_lower = plot(r_lower, color=color.new(color.red, 50), title="R Lower")
plot_bp_lower = plot(bp_lower, color=color.new(color.red, 80), title="BP Lower")
fill(plot_bp_upper, plot_r_upper, color=color.new(color.teal, 90), title="Bull Breakout Zone")
fill(plot_bp_lower, plot_r_lower, color=color.new(color.red, 90), title="Bear Breakout Zone")

// ====================================================================================================
// 3. MTF BIAS ENGINE
// ====================================================================================================
int bias_1m = request.security(syminfo.tickerid, "1", f_bias_value(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int bias_5m = request.security(syminfo.tickerid, "5", f_bias_value(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int bias_15m = request.security(syminfo.tickerid, "15", f_bias_value(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int bias_30m = request.security(syminfo.tickerid, "30", f_bias_value(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int bias_60m = request.security(syminfo.tickerid, "60", f_bias_value(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int bias_240m = request.security(syminfo.tickerid, "240", f_bias_value(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int bias_d = request.security(syminfo.tickerid, "D", f_bias_value(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

float total_tfs = 7.0
float bull_tfs = 0.0
bull_tfs += bias_1m == 1 ? 1 : 0
bull_tfs += bias_5m == 1 ? 1 : 0
bull_tfs += bias_15m == 1 ? 1 : 0
bull_tfs += bias_30m == 1 ? 1 : 0
bull_tfs += bias_60m == 1 ? 1 : 0
bull_tfs += bias_240m == 1 ? 1 : 0
bull_tfs += bias_d == 1 ? 1 : 0

float bear_tfs = 0.0
bear_tfs += bias_1m == -1 ? 1 : 0
bear_tfs += bias_5m == -1 ? 1 : 0
bear_tfs += bias_15m == -1 ? 1 : 0
bear_tfs += bias_30m == -1 ? 1 : 0
bear_tfs += bias_60m == -1 ? 1 : 0
bear_tfs += bias_240m == -1 ? 1 : 0
bear_tfs += bias_d == -1 ? 1 : 0

int align_bull_pct = int(math.round(bull_tfs / total_tfs * 100.0))
int align_bear_pct = int(math.round(bear_tfs / total_tfs * 100.0))
int dominant_bias = align_bull_pct >= in_req_align ? 1 : align_bear_pct >= in_req_align ? -1 : 0
bool mtf_long_ok = not in_use_mtf or dominant_bias == 1
bool mtf_short_ok = not in_use_mtf or dominant_bias == -1

// ====================================================================================================
// 4. BPRC STATE MACHINE & CORE LOGIC
// ====================================================================================================
var int state = 0
var int last_trade_dir = 0

bool valid_strength = norm_vol > in_vol_norm and norm_body > 0.5

// A) Breakout Logic (BP)
bool bp_bull = close > bp_upper and valid_strength
bool bp_bear = close < bp_lower and valid_strength

// B) Pullback Logic (R)
bool r_bull = state == 1 and close < r_upper and close >= basis
bool r_bear = state == -1 and close > r_lower and close <= basis

// C) Continuation Logic (C)
bool c_bull = state == 2 and close > high[1] and close > open
bool c_bear = state == -2 and close < low[1] and close < open

// State Updates & Reset Logic
if state > 0 and close < bp_lower
    state := 0
if state < 0 and close > bp_upper
    state := 0

if state == 0
    if bp_bull
        state := 1
    else if bp_bear
        state := -1
else if state == 1
    if r_bull
        state := 2
else if state == -1
    if r_bear
        state := -2
else if state == 2
    if c_bull
        state := 3
else if state == -2
    if c_bear
        state := -3

// ====================================================================================================
// 5. TRADE PLAN & EXECUTION
// ====================================================================================================
var float trade_entry = na
var float trade_sl = na
var float trade_tp1 = na
var float trade_tp2 = na
var float trade_tp3 = na
var float trade_tp4 = na
var float trade_tp5 = na

bool in_trade = strategy.position_size != 0

bool can_long = not in_alternating or last_trade_dir != 1
bool can_short = not in_alternating or last_trade_dir != -1

bool execute_long = confirmed and state == 3 and not in_trade and mtf_long_ok and can_long
bool execute_short = confirmed and state == -3 and not in_trade and mtf_short_ok and can_short

float tp1_qty = math.max(0.0, math.min(100.0, in_tp1_pct))
float tp2_qty = math.max(0.0, math.min(100.0 - tp1_qty, in_tp2_pct))
float tp3_qty = math.max(0.0, math.min(100.0 - tp1_qty - tp2_qty, in_tp3_pct))
float tp4_qty = math.max(0.0, math.min(100.0 - tp1_qty - tp2_qty - tp3_qty, in_tp4_pct))
float tp5_qty = math.max(0.0, math.min(100.0 - tp1_qty - tp2_qty - tp3_qty - tp4_qty, in_tp5_pct))

f_submit_long_exits() =>
    if tp1_qty > 0
        strategy.exit("Long TP1", from_entry="Long", qty_percent=tp1_qty, limit=trade_tp1, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")
    if tp2_qty > 0
        strategy.exit("Long TP2", from_entry="Long", qty_percent=tp2_qty, limit=trade_tp2, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")
    if tp3_qty > 0
        strategy.exit("Long TP3", from_entry="Long", qty_percent=tp3_qty, limit=trade_tp3, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")
    if tp4_qty > 0
        strategy.exit("Long TP4", from_entry="Long", qty_percent=tp4_qty, limit=trade_tp4, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")
    if tp5_qty > 0
        strategy.exit("Long TP5", from_entry="Long", qty_percent=tp5_qty, limit=trade_tp5, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")

f_submit_short_exits() =>
    if tp1_qty > 0
        strategy.exit("Short TP1", from_entry="Short", qty_percent=tp1_qty, limit=trade_tp1, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")
    if tp2_qty > 0
        strategy.exit("Short TP2", from_entry="Short", qty_percent=tp2_qty, limit=trade_tp2, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")
    if tp3_qty > 0
        strategy.exit("Short TP3", from_entry="Short", qty_percent=tp3_qty, limit=trade_tp3, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")
    if tp4_qty > 0
        strategy.exit("Short TP4", from_entry="Short", qty_percent=tp4_qty, limit=trade_tp4, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")
    if tp5_qty > 0
        strategy.exit("Short TP5", from_entry="Short", qty_percent=tp5_qty, limit=trade_tp5, stop=trade_sl, alert_message=send_close_alerts ? payload_message : "")

if execute_long
    float current_atr = atr
    trade_entry := close
    trade_sl := trade_entry - current_atr * in_sl_atr_mult
    trade_tp1 := trade_entry + current_atr * in_tp_step * 1
    trade_tp2 := trade_entry + current_atr * in_tp_step * 2
    trade_tp3 := trade_entry + current_atr * in_tp_step * 3
    trade_tp4 := trade_entry + current_atr * in_tp_step * 4
    trade_tp5 := trade_entry + current_atr * in_tp_step * 5
    strategy.entry("Long", strategy.long, alert_message=payload_message)
    f_submit_long_exits()
    last_trade_dir := 1
    state := 0

if execute_short
    float current_atr = atr
    trade_entry := close
    trade_sl := trade_entry + current_atr * in_sl_atr_mult
    trade_tp1 := trade_entry - current_atr * in_tp_step * 1
    trade_tp2 := trade_entry - current_atr * in_tp_step * 2
    trade_tp3 := trade_entry - current_atr * in_tp_step * 3
    trade_tp4 := trade_entry - current_atr * in_tp_step * 4
    trade_tp5 := trade_entry - current_atr * in_tp_step * 5
    strategy.entry("Short", strategy.short, alert_message=payload_message)
    f_submit_short_exits()
    last_trade_dir := -1
    state := 0

bool new_long = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool new_short = strategy.position_size < 0 and strategy.position_size[1] >= 0

if new_long
    float current_atr = atr
    trade_entry := strategy.position_avg_price
    trade_sl := trade_entry - current_atr * in_sl_atr_mult
    trade_tp1 := trade_entry + current_atr * in_tp_step * 1
    trade_tp2 := trade_entry + current_atr * in_tp_step * 2
    trade_tp3 := trade_entry + current_atr * in_tp_step * 3
    trade_tp4 := trade_entry + current_atr * in_tp_step * 4
    trade_tp5 := trade_entry + current_atr * in_tp_step * 5

if new_short
    float current_atr = atr
    trade_entry := strategy.position_avg_price
    trade_sl := trade_entry + current_atr * in_sl_atr_mult
    trade_tp1 := trade_entry - current_atr * in_tp_step * 1
    trade_tp2 := trade_entry - current_atr * in_tp_step * 2
    trade_tp3 := trade_entry - current_atr * in_tp_step * 3
    trade_tp4 := trade_entry - current_atr * in_tp_step * 4
    trade_tp5 := trade_entry - current_atr * in_tp_step * 5

if strategy.position_size > 0 and not na(trade_sl)
    f_submit_long_exits()

if strategy.position_size < 0 and not na(trade_sl)
    f_submit_short_exits()

if strategy.position_size == 0 and strategy.position_size[1] != 0
    trade_entry := na
    trade_sl := na
    trade_tp1 := na
    trade_tp2 := na
    trade_tp3 := na
    trade_tp4 := na
    trade_tp5 := na

// Plotting Exits for visual control
plot(strategy.position_size != 0 ? trade_sl : na, color=color.red, style=plot.style_cross, title="Stop Loss")
plot(strategy.position_size != 0 ? trade_tp1 : na, color=color.green, style=plot.style_circles, title="TP 1")

// ====================================================================================================
// 6. UI / DASHBOARD
// ====================================================================================================
var table dashboard = table.new(position.top_right, 3, 10, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if in_show_ui and barstate.islast
    table.cell(dashboard, 0, 0, "BPRC PRO", text_color=color.white, text_halign=text.align_center, bgcolor=color.new(color.blue, 50))
    table.cell(dashboard, 1, 0, "ALIGNMENT", text_color=color.white, text_halign=text.align_center, bgcolor=color.new(color.blue, 50))
    table.cell(dashboard, 2, 0, "TRADE STATUS", text_color=color.white, text_halign=text.align_center, bgcolor=color.new(color.blue, 50))

    string state_txt = state == 0 ? "Neutral" : state == 1 ? "Bullish BP" : state == 2 ? "Bullish Reload" : state == 3 ? "Bullish Trigger" : state == -1 ? "Bearish BP" : state == -2 ? "Bearish Reload" : "Bearish Trigger"
    color state_col = state > 0 ? color.green : state < 0 ? color.red : color.gray
    table.cell(dashboard, 0, 1, "State:", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 0, 2, state_txt, text_color=state_col, text_halign=text.align_center)
    table.cell(dashboard, 0, 3, "Pionex", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 0, 4, pionex_ready ? "UUID SET" : "UUID MISSING", text_color=pionex_ready ? color.lime : color.orange, text_halign=text.align_center)

    color align_col = dominant_bias == 1 ? color.lime : dominant_bias == -1 ? color.red : color.gray
    table.cell(dashboard, 1, 1, "Bull / Bear %", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 1, 2, str.tostring(align_bull_pct) + "% / " + str.tostring(align_bear_pct) + "%", text_color=align_col, text_halign=text.align_center)
    table.cell(dashboard, 1, 3, "MTF", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 1, 4, not in_use_mtf ? "DISABLED" : dominant_bias == 1 ? "BULL A+" : dominant_bias == -1 ? "BEAR A+" : "NO A+", text_color=align_col, text_halign=text.align_center)

    string pos_txt = strategy.position_size > 0 ? "LONG ACTIVE" : strategy.position_size < 0 ? "SHORT ACTIVE" : "FLAT"
    color pos_col = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dashboard, 2, 1, pos_txt, text_color=pos_col, text_halign=text.align_center)
    table.cell(dashboard, 2, 2, "Last: " + (last_trade_dir == 1 ? "Long" : last_trade_dir == -1 ? "Short" : "None"), text_color=color.white, text_halign=text.align_center)
    table.cell(dashboard, 2, 3, "TP Total", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 2, 4, str.tostring(tp1_qty + tp2_qty + tp3_qty + tp4_qty + tp5_qty, "#.##") + "%", text_color=color.white, text_halign=text.align_center)

var bool uuid_label_shown = false
if barstate.islast and not pionex_ready and not uuid_label_shown
    label.new(bar_index, high, "Paste your Pionex UUID", style=label.style_label_down, color=color.orange, textcolor=color.black, size=size.small)
    uuid_label_shown := true
if pionex_ready
    uuid_label_shown := false
