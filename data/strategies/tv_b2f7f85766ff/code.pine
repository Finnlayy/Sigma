//@version=6
strategy("LTM Strategy [WillyAlgoTrader]", overlay=true, initial_capital=1000000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05, slippage=0)

// ==== Eingaben ====
grpMain = "Trend Engine"
grpSig  = "Signale"
grpRisk = "Risk Management"

atrLen      = input.int(14, "ATR Länge", group=grpMain)
trendLen    = input.int(50, "Trend-EMA", group=grpMain)
atrMultBand = input.float(3.0, "Bandbreite (ATR-Multiplikator)", group=grpMain)
minScore    = input.int(55, "Min Retest Score", group=grpSig)
sweepLookback = input.int(20, "Sweep-Lookback (Bars)", group=grpSig)
volLen      = input.int(20, "Volumen-Periode", group=grpSig)
tpMult      = input.float(3.0, "TP (ATR-Multiplikator)", group=grpRisk)
slMult      = input.float(3.0, "SL (ATR-Multiplikator)", group=grpRisk)

// ==== Berechnungen ====
atr = ta.atr(atrLen)
trendEma = ta.ema(close, trendLen)
volSma = ta.sma(volume, volLen)
volRatio = volume / volSma

// MOS VR/VS Signale (feste Lookbacks 10/5)
ph = ta.pivothigh(high, 10, 5)
pl = ta.pivotlow(low, 10, 5)

// Swing-Highs/Lows für Liquidity Sweep
swingHigh = ta.pivothigh(high, sweepLookback, sweepLookback)
swingLow  = ta.pivotlow(low, sweepLookback, sweepLookback)

// Letzten bestätigten Swing-Wert tracken (KEIN nz-Rückfall auf low/high)
var float lastSwingLow  = na
var float lastSwingHigh = na
if not na(swingLow)
    lastSwingLow := swingLow
if not na(swingHigh)
    lastSwingHigh := swingHigh

// Liquidity Sweep: NUR wenn ein echter vorheriger Swing existiert.
// bullSweep: Preis sticht kurz UNTER den letzten Swing-Low und schließt darüber.
// bearSweep: Preis sticht kurz ÜBER den letzten Swing-High und schließt darunter.
bullSweep = not na(lastSwingLow) and low <= lastSwingLow and close > lastSwingLow
bearSweep = not na(lastSwingHigh) and high >= lastSwingHigh and close < lastSwingHigh

// Retest-Score: Signalqualität aus Sweep-Tiefe, Volumen und Trend
scoreBull = (lastSwingLow - low) / (atr + 0.0001) * 50 + volRatio * 25 + (close > trendEma ? 25 : 0)
scoreBear = (high - lastSwingHigh) / (atr + 0.0001) * 50 + volRatio * 25 + (close < trendEma ? 25 : 0)

longSignal  = bullSweep and scoreBull >= minScore
shortSignal = bearSweep and scoreBear >= minScore

// ==== Entry/Exit ====
if longSignal
    strategy.entry("Long", strategy.long)
if shortSignal
    strategy.entry("Short", strategy.short)

strategy.exit("Long Exit", "Long", profit=ta.valuewhen(longSignal, atr, 0) * tpMult, loss=ta.valuewhen(longSignal, atr, 0) * slMult)
strategy.exit("Short Exit", "Short", profit=ta.valuewhen(shortSignal, atr, 0) * tpMult, loss=ta.valuewhen(shortSignal, atr, 0) * slMult)

// ==== Visualisierung ====
plot(trendEma, "Trend EMA", color=color.orange, linewidth=2)
plotshape(longSignal, "Long", shape.triangleup, location.belowbar, color=color.green, size=size.small)
plotshape(shortSignal, "Short", shape.triangledown, location.abovebar, color=color.red, size=size.small)
plotshape(not na(ph), "VR", shape.triangledown, location.abovebar, color=color.red)
plotshape(not na(pl), "VS", shape.triangleup, location.belowbar, color=color.green)

if not na(ph)
    label.new(bar_index, high, "VR", color=color.red, textcolor=chart.fg_color, style=label.style_label_down, size=size.small)

if not na(pl)
    label.new(bar_index, low, "VS", color=color.green, textcolor=chart.fg_color, style=label.style_label_up, size=size.small)
