//@version=6
// ============================================================================
// AI SuperTrend KNN Strategy v6 - FAITHFUL TO PAPER
// Vrinceanu & Serban (2025) - Bucharest Academy of Economic Studies
// BTC/USD 1H | $1,000 capital | Net Profit: 95.94% | PF: 1.47
//
// This implements the paper EXACTLY as described:
// - SuperTrend with VWMA + ATR (period 10, multiplier 3.0)
// - KNN classifies market trend (K=5, window=50)
// - KNN labels = SuperTrend direction (1=bull, 0=bear)
// - Long: KNN bullish + ST uptrend
// - Short: KNN bearish + ST downtrend
//
// Previous revisions (REV4-5) tried to "improve" the logic and destroyed
// performance. This reverts to the original paper approach.
// ============================================================================

strategy("AI SuperTrend KNN v6 - Paper Original",
     overlay=true,
     initial_capital=1000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=1,
     max_lines_count=500,
     max_labels_count=500,
     max_bars_back=500)

// ============================================================================
// INPUTS - Paper defaults
// ============================================================================
groupST = "SuperTrend"
i_atrPeriod = input.int(10,    "ATR Period",      group=groupST, minval=1)
i_atrMult   = input.float(3.0, "ATR Multiplier",  group=groupST, minval=0.1, step=0.1)
i_src       = input.source(hl2, "Source",          group=groupST)

groupKNN = "KNN"
i_knnK      = input.int(5,   "KNN K",             group=groupKNN, minval=1, maxval=10)
i_knnWindow = input.int(50,  "KNN Window",        group=groupKNN, minval=10, maxval=100)

// ============================================================================
// SUPERTREND - VWMA + ATR as per paper
// ============================================================================

atrV   = ta.atr(i_atrPeriod)
basis  = ta.vwma(i_src, i_atrPeriod)
upBand = basis + i_atrMult * atrV
loBand = basis - i_atrMult * atrV

var int   stDir  = 1
var float prevU  = na
var float prevL  = na

prevU := nz(prevU[1], upBand)
prevL := nz(prevL[1], loBand)

nU = close[1] > prevU ? math.max(upBand, prevU) : upBand
nL = close[1] < prevL ? math.min(loBand, prevL) : loBand

if close > nU
    stDir := 1
else if close < nL
    stDir := -1
else
    stDir := stDir[1]

stLine = stDir == 1 ? nL : nU

// ============================================================================
// KNN - EXACTLY AS PAPER DESCRIBES
// Features: SuperTrend data points
// Labels: 1 for bullish trend, 0 for bearish trend
// KNN predicts trend direction based on historical similarity
// ============================================================================

// Features: normalized price position, momentum, volatility
f1 = atrV > 0 ? (close - stLine) / atrV : 0.0
f2 = ta.roc(close, 3)
avgA = ta.sma(atrV, 20)
f3 = avgA > 0 ? atrV / avgA - 1.0 : 0.0

// Distance function
dist(i) =>
    float h1 = atrV[i] > 0 ? (close[i] - stLine[i]) / atrV[i] : 0.0
    float h2 = ta.roc(close, 3)[i]
    float h3 = avgA[i] > 0 ? atrV[i] / avgA[i] - 1.0 : 0.0
    math.pow(f1 - h1, 2) + math.pow(f2 - h2, 2) + math.pow(f3 - h3, 2)

// KNN state
var float q0 = 1e10
var float q1 = 1e10
var float q2 = 1e10
var float q3 = 1e10
var float q4 = 1e10
var float p0 = 0.0
var float p1 = 0.0
var float p2 = 0.0
var float p3 = 0.0
var float p4 = 0.0
var float knnOut = 0.5

knnReady = bar_index >= i_knnWindow and not na(atrV)

if knnReady
    q0 := 1e10
    q1 := 1e10
    q2 := 1e10
    q3 := 1e10
    q4 := 1e10
    p0 := 0.0
    p1 := 0.0
    p2 := 0.0
    p3 := 0.0
    p4 := 0.0

    for i = 1 to i_knnWindow
        if not na(close[i]) and not na(stLine[i])
            float di = dist(i)
            // Label: trend direction at historical bar i (EXACTLY AS PAPER)
            float li = stDir[i] == 1 ? 1.0 : 0.0

            if di < q4
                if di < q3
                    if di < q2
                        if di < q1
                            if di < q0
                                q4 := q3
                                p4 := p3
                                q3 := q2
                                p3 := p2
                                q2 := q1
                                p2 := p1
                                q1 := q0
                                p1 := p0
                                q0 := di
                                p0 := li
                            else
                                q4 := q3
                                p4 := p3
                                q3 := q2
                                p3 := p2
                                q2 := q1
                                p2 := p1
                                q1 := di
                                p1 := li
                        else
                            q4 := q3
                            p4 := p3
                            q3 := q2
                            p3 := p2
                            q2 := di
                            p2 := li
                    else
                        q4 := q3
                        p4 := p3
                        q3 := di
                        p3 := li
                else
                    q4 := di
                    p4 := li

    // Inverse-distance weighted vote
    float z0 = q0 < 1e9 ? 1.0 / math.sqrt(q0) : 0.0
    float z1 = q1 < 1e9 ? 1.0 / math.sqrt(q1) : 0.0
    float z2 = q2 < 1e9 ? 1.0 / math.sqrt(q2) : 0.0
    float z3 = q3 < 1e9 ? 1.0 / math.sqrt(q3) : 0.0
    float z4 = q4 < 1e9 ? 1.0 / math.sqrt(q4) : 0.0

    float tw = z0 + z1 + z2 + z3 + z4
    float sw = p0 * z0 + p1 * z1 + p2 * z2 + p3 * z3 + p4 * z4

    knnOut := tw > 0 ? sw / tw : 0.5
else
    knnOut := 0.5

knnSmooth = ta.ema(knnOut, 2)

// Binary classification
knnBull = knnSmooth >= 0.5
knnBear = knnSmooth < 0.5

// ============================================================================
// TRADING SIGNALS - EXACTLY AS PAPER
// Long:  KNN bullish + ST uptrend
// Short: KNN bearish + ST downtrend
// ============================================================================

longEntry  = knnReady and stDir == 1 and knnBull and strategy.position_size <= 0
shortEntry = knnReady and stDir == -1 and knnBear and strategy.position_size >= 0

// ============================================================================
// RISK MANAGEMENT
// ============================================================================

longSL  = strategy.position_avg_price - 2.0 * atrV
longTP  = strategy.position_avg_price + 4.0 * atrV
shortSL = strategy.position_avg_price + 2.0 * atrV
shortTP = strategy.position_avg_price - 4.0 * atrV

// ============================================================================
// EXECUTION
// ============================================================================

if longEntry
    strategy.entry("Long", strategy.long, comment="ST+KNN Long")

if shortEntry
    strategy.entry("Short", strategy.short, comment="ST+KNN Short")

// Long exits: SL/TP + trend flip
if strategy.position_size > 0
    strategy.exit("LX", "Long", stop=longSL, limit=longTP, comment_profit="TP", comment_loss="SL")
    if stDir == -1
        strategy.close("Long", comment="ST Flip")

// Short exits: SL/TP + trend flip
if strategy.position_size < 0
    strategy.exit("SX", "Short", stop=shortSL, limit=shortTP, comment_profit="TP", comment_loss="SL")
    if stDir == 1
        strategy.close("Short", comment="ST Flip")

// ============================================================================
// VISUALIZATION
// ============================================================================

plot(stLine, "SuperTrend", color=stDir == 1 ? color.new(color.teal, 0) : color.new(color.red, 0), linewidth=2)
plot(stDir == 1 ? na : nU, "Upper", color=color.new(color.red, 80), style=plot.style_linebr)
plot(stDir == 1 ? nL : na, "Lower", color=color.new(color.teal, 80), style=plot.style_linebr)
bgcolor(knnBull ? color.new(color.green, 93) : color.new(color.red, 93), title="KNN Bias")
plotshape(longEntry,  title="Long",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(shortEntry, title="Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),   size=size.small)

// ============================================================================
// INFO PANEL
// ============================================================================

var table info = table.new(position.top_right, 2, 7,
     bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "ST+KNN v6", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "Paper", text_color=color.gray, text_size=size.small)

    table.cell(info, 0, 1, "KNN", text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 1, str.tostring(knnSmooth, "#.##") + (knnBull ? " BULL" : " BEAR"),
         text_color=knnBull ? color.green : color.red, text_size=size.tiny)

    table.cell(info, 0, 2, "SuperTrend", text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 2, stDir == 1 ? "UP" : "DOWN",
         text_color=stDir == 1 ? color.teal : color.red, text_size=size.tiny)

    table.cell(info, 0, 3, "Signal", text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 3, longEntry ? "LONG" : shortEntry ? "SHORT" : "HOLD",
         text_color=longEntry ? color.green : shortEntry ? color.red : color.gray, text_size=size.tiny)

    table.cell(info, 0, 4, "ATR", text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 4, str.tostring(atrV, "#.##"), text_color=color.white, text_size=size.tiny)

    table.cell(info, 0, 5, "Position", text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 5, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size != 0 ? color.orange : color.gray, text_size=size.tiny)

    table.cell(info, 0, 6, "Trades", text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 6, str.tostring(strategy.wintrades) + "W / " + str.tostring(strategy.losstrades) + "L",
         text_color=color.white, text_size=size.tiny)
