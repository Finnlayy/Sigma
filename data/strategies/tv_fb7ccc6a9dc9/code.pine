// MTF CISD + OB/FVG — Pionex Signal Bot
// Version: 1.2 | BTC/USDT 5M | 2026-04-07
//@version=6
indicator(title="MTF CISD + OB/FVG — Pionex Signal Bot", shorttitle="CISD·OB·FVG·PIONEX", overlay=true, max_boxes_count=200, max_lines_count=100)

// ── GRUPPE 1: MULTI-TIMEFRAME ────────────────────────────────────────
string tf_h4   = input.timeframe("240", title="Timeframe H4",  group="Multi-TF Alignment")
bool   en_h4   = input.bool(true,       title="H4 aktivieren", group="Multi-TF Alignment")
string tf_h1   = input.timeframe("60",  title="Timeframe H1",  group="Multi-TF Alignment")
bool   en_h1   = input.bool(true,       title="H1 aktivieren", group="Multi-TF Alignment")
string tf_m15  = input.timeframe("15",  title="Timeframe M15", group="Multi-TF Alignment")
bool   en_m15  = input.bool(true,       title="M15 aktivieren",group="Multi-TF Alignment")
string tf_m5   = input.timeframe("5",   title="Timeframe M5",  group="Multi-TF Alignment")
bool   en_m5   = input.bool(true,       title="M5 aktivieren", group="Multi-TF Alignment")

// ── GRUPPE 2: OB / FVG ───────────────────────────────────────────────
bool  show_ob    = input.bool(true,  title="Order Blocks anzeigen",   group="Order Blocks & FVG")
bool  show_fvg   = input.bool(true,  title="Fair Value Gaps anzeigen", group="Order Blocks & FVG")
float ob_atr_mul = input.float(1.5,  title="OB Mindestgroesse (ATR x)", minval=0.5, step=0.1, group="Order Blocks & FVG")
int   ob_pivot   = input.int(5,      title="OB Pivot-Lookback",         minval=3, maxval=10,   group="Order Blocks & FVG")

// ── GRUPPE 3: CONFIDENCE & FILTER ───────────────────────────────────
int   min_conf  = input.int(7,    title="Mindest-Confidence (0-17)", minval=4, maxval=17, group="Signal Filter")
bool  use_vol   = input.bool(true, title="Volumen-Filter",                                group="Signal Filter")
float vol_mult  = input.float(1.2, title="Volumen-Multiplikator",    minval=1.0, step=0.1, group="Signal Filter")
bool  use_time  = input.bool(true, title="Zeitfenster-Filter",                             group="Signal Filter")
int   sess_start = input.int(8,   title="Session Start (UTC Stunde)", minval=0, maxval=23, group="Signal Filter")
int   sess_end   = input.int(22,  title="Session End (UTC Stunde)",   minval=0, maxval=23, group="Signal Filter")
bool  use_daily  = input.bool(true, title="Daily Loss Limit",                              group="Signal Filter")
float daily_lim  = input.float(3.0, title="Daily Loss Limit (%)",    minval=0.5, step=0.5, group="Signal Filter")

// ── GRUPPE 4: PIONEX WEBHOOK ─────────────────────────────────────────
// signal_type = Pionex Signal Bot UUID (aus Bot-Einstellungen kopieren)
string signal_type = input.string("93f67120-5075-42cc-ba26-d09fc3328b1f", title="Signal Type (Bot UUID)", group="Pionex Webhook Config")
bool   send_long   = input.bool(true,  title="Long-Signale senden",                group="Pionex Webhook Config")
bool   send_short  = input.bool(false, title="Short-Signale senden (Spot: aus!)",  group="Pionex Webhook Config")
bool   send_close  = input.bool(true,  title="Close-Signale senden",               group="Pionex Webhook Config")

// ── GRUPPE 5: DARSTELLUNG ────────────────────────────────────────────
bool show_table = input.bool(true, title="Dashboard anzeigen", group="Darstellung")
bool show_bg    = input.bool(true, title="Hintergrundfarbe",   group="Darstellung")

// ── KONSTANTEN ───────────────────────────────────────────────────────
color COL_BULL    = color.new(color.lime,   0)
color COL_BEAR    = color.new(color.red,    0)
color COL_NEUTRAL = color.new(color.gray,   0)
color COL_OB_BULL = color.new(color.green, 75)
color COL_OB_BEAR = color.new(color.red,   75)
color COL_FVG_BULL = color.new(color.lime,  85)
color COL_FVG_BEAR = color.new(color.orange, 85)

// ── HILFSFUNKTIONEN ──────────────────────────────────────────────────
f_priceStr(float val) =>
    na(val) ? "na" : str.tostring(val, format.mintick)

// CISD-Logik
f_cisd() =>
    var float bull_target = na
    var float bear_target = na
    var string state = "Neutral"
    bool is_inside  = high < high[1] and low > low[1]
    bool is_bearish = close < open
    bool is_bullish = close > open
    bool bull_cisd  = not na(bull_target) and close > bull_target and close[1] <= bull_target
    bool bear_cisd  = not na(bear_target) and close < bear_target and close[1] >= bear_target
    if barstate.isconfirmed
        if bull_cisd
            state := "Bullish"
        if bear_cisd
            state := "Bearish"
    if is_bearish and not is_inside
        bull_target := open
    if is_bullish and not is_inside
        bear_target := open
    [state, bull_cisd, bear_cisd]

// Offizielles Pionex Signal Bot Payload-Format
// {"data":{"action":"buy","contracts":"0.001","position_size":"1"},"price":"...","signal_param":"{}","signal_type":"...","symbol":"...","time":"..."}
f_pionexPayload(string tv_action, string contracts, string pos_size) =>
    "{\"data\":{\"action\":\"" + tv_action + "\",\"contracts\":\"" + contracts + "\",\"position_size\":\"" + pos_size + "\"},\"price\":\"" + f_priceStr(close) + "\",\"signal_param\":\"{}\",\"signal_type\":\"" + signal_type + "\",\"symbol\":\"" + syminfo.ticker + "\",\"time\":\"" + str.tostring(timenow) + "\"}"

// ── MULTI-TIMEFRAME CISD STATES ──────────────────────────────────────
[local_state, local_bull, local_bear] = f_cisd()
[state_h4,  _, _] = request.security(syminfo.tickerid, tf_h4,  f_cisd())
[state_h1,  _, _] = request.security(syminfo.tickerid, tf_h1,  f_cisd())
[state_m15, _, _] = request.security(syminfo.tickerid, tf_m15, f_cisd())
[state_m5,  _, _] = request.security(syminfo.tickerid, tf_m5,  f_cisd())

var int enabled_count = 0
var int bull_count    = 0
var int bear_count    = 0

enabled_count := 0
bull_count    := 0
bear_count    := 0

if en_h4
    enabled_count += 1
    bull_count += state_h4 == "Bullish" ? 1 : 0
    bear_count += state_h4 == "Bearish" ? 1 : 0
if en_h1
    enabled_count += 1
    bull_count += state_h1 == "Bullish" ? 1 : 0
    bear_count += state_h1 == "Bearish" ? 1 : 0
if en_m15
    enabled_count += 1
    bull_count += state_m15 == "Bullish" ? 1 : 0
    bear_count += state_m15 == "Bearish" ? 1 : 0
if en_m5
    enabled_count += 1
    bull_count += state_m5 == "Bullish" ? 1 : 0
    bear_count += state_m5 == "Bearish" ? 1 : 0

bool all_bull = enabled_count > 0 and bull_count == enabled_count
bool all_bear = enabled_count > 0 and bear_count == enabled_count

// ── ORDER BLOCKS ─────────────────────────────────────────────────────
var box[] bull_ob_boxes = array.new_box()
var box[] bear_ob_boxes = array.new_box()

float atr14 = ta.atr(14)

float ph = ta.pivothigh(ob_pivot, ob_pivot)
if not na(ph[ob_pivot]) and (high[ob_pivot] - low[ob_pivot]) > atr14[ob_pivot] * ob_atr_mul
    float ob_top = math.max(open[ob_pivot * 2], close[ob_pivot * 2])
    float ob_bot = math.min(open[ob_pivot * 2], close[ob_pivot * 2])
    if ob_top > ob_bot
        array.push(bull_ob_boxes, box.new(bar_index[ob_pivot], ob_top, bar_index + 100, ob_bot, border_color=color.new(color.green, 40), bgcolor=COL_OB_BULL))

float pl = ta.pivotlow(ob_pivot, ob_pivot)
if not na(pl[ob_pivot]) and (high[ob_pivot] - low[ob_pivot]) > atr14[ob_pivot] * ob_atr_mul
    float ob_top2 = math.max(open[ob_pivot * 2], close[ob_pivot * 2])
    float ob_bot2 = math.min(open[ob_pivot * 2], close[ob_pivot * 2])
    if ob_top2 > ob_bot2
        array.push(bear_ob_boxes, box.new(bar_index[ob_pivot], ob_top2, bar_index + 100, ob_bot2, border_color=color.new(color.red, 40), bgcolor=COL_OB_BEAR))

for idx = array.size(bull_ob_boxes) - 1 to 0
    b = array.get(bull_ob_boxes, idx)
    if close < box.get_bottom(b)
        array.remove(bull_ob_boxes, idx)
    else if show_ob
        box.set_right(b, bar_index + 1)

for idx = array.size(bear_ob_boxes) - 1 to 0
    b = array.get(bear_ob_boxes, idx)
    if close > box.get_top(b)
        array.remove(bear_ob_boxes, idx)
    else if show_ob
        box.set_right(b, bar_index + 1)

bool ob_bull_touch = array.size(bull_ob_boxes) > 0 and low <= box.get_top(array.last(bull_ob_boxes)) and close > box.get_bottom(array.last(bull_ob_boxes))
bool ob_bear_touch = array.size(bear_ob_boxes) > 0 and high >= box.get_bottom(array.last(bear_ob_boxes)) and close < box.get_top(array.last(bear_ob_boxes))

// ── FAIR VALUE GAPS ──────────────────────────────────────────────────
var box[] bull_fvg_boxes = array.new_box()
var box[] bear_fvg_boxes = array.new_box()

if low[2] > high[0]
    array.push(bull_fvg_boxes, box.new(bar_index[2], low[2], bar_index + 60, high[0], border_color=color.new(color.lime, 50), bgcolor=COL_FVG_BULL))

if high[2] < low[0]
    array.push(bear_fvg_boxes, box.new(bar_index[2], low[0], bar_index + 60, high[2], border_color=color.new(color.orange, 50), bgcolor=COL_FVG_BEAR))

for idx = array.size(bull_fvg_boxes) - 1 to 0
    b = array.get(bull_fvg_boxes, idx)
    if close < box.get_bottom(b)
        array.remove(bull_fvg_boxes, idx)
    else if show_fvg
        box.set_right(b, bar_index + 1)

for idx = array.size(bear_fvg_boxes) - 1 to 0
    b = array.get(bear_fvg_boxes, idx)
    if close > box.get_top(b)
        array.remove(bear_fvg_boxes, idx)
    else if show_fvg
        box.set_right(b, bar_index + 1)

bool fvg_bull_touch = array.size(bull_fvg_boxes) > 0 and low <= box.get_top(array.last(bull_fvg_boxes)) and close > box.get_bottom(array.last(bull_fvg_boxes))
bool fvg_bear_touch = array.size(bear_fvg_boxes) > 0 and high >= box.get_bottom(array.last(bear_fvg_boxes)) and close < box.get_top(array.last(bear_fvg_boxes))

// ── VOLUMEN-FILTER ───────────────────────────────────────────────────
float vol_sma20   = ta.sma(volume, 20)
bool  vol_ok_bull = not use_vol or (volume > vol_sma20 * vol_mult and close > open)
bool  vol_ok_bear = not use_vol or (volume > vol_sma20 * vol_mult and close < open)

// ── ZEITFENSTER-FILTER ───────────────────────────────────────────────
int  curr_hour = hour(time, "UTC")
bool time_ok   = not use_time or (curr_hour >= sess_start and curr_hour < sess_end)

// ── DAILY LOSS LIMIT ─────────────────────────────────────────────────
var float daily_pnl_tracker = 0.0
var int   last_day = 0
int curr_day = dayofmonth(time, "UTC")
if curr_day != last_day
    daily_pnl_tracker := 0.0
    last_day := curr_day
bool daily_ok = not use_daily or daily_pnl_tracker > -(close * daily_lim / 100)

// ── CONFIDENCE SCORING (0-17) ────────────────────────────────────────
bool strong_bull_candle = (close - open) > atr14 * 0.5 and close > open
bool strong_bear_candle = (open - close) > atr14 * 0.5 and close < open

int conf_bull = 0
int conf_bear = 0

conf_bull += all_bull ? 4 : bull_count >= 3 ? 2 : 0
conf_bear += all_bear ? 4 : bear_count >= 3 ? 2 : 0
conf_bull += local_bull ? 3 : 0
conf_bear += local_bear ? 3 : 0
conf_bull += ob_bull_touch ? 3 : 0
conf_bear += ob_bear_touch ? 3 : 0
conf_bull += fvg_bull_touch ? 3 : 0
conf_bear += fvg_bear_touch ? 3 : 0
conf_bull += vol_ok_bull ? 2 : 0
conf_bear += vol_ok_bear ? 2 : 0
conf_bull += strong_bull_candle ? 2 : 0
conf_bear += strong_bear_candle ? 2 : 0

// ── SIGNAL-GENERIERUNG ───────────────────────────────────────────────
var bool pending_long  = false
var bool pending_short = false

bool new_bull_align = all_bull and not all_bull[1]
bool new_bear_align = all_bear and not all_bear[1]

if new_bull_align
    pending_long  := true
    pending_short := false
if new_bear_align
    pending_short := true
    pending_long  := false
if not all_bull
    pending_long  := false
if not all_bear
    pending_short := false

bool final_long  = pending_long  and local_bull and conf_bull >= min_conf and time_ok and daily_ok
bool final_short = pending_short and local_bear and conf_bear >= min_conf and time_ok and daily_ok

// ── ALERTS: OFFIZIELLES PIONEX SIGNAL BOT FORMAT ─────────────────────
// buy  = Long-Einstieg  | position_size "1"  = offen
// sell = Long-Ausstieg  | position_size "0"  = geschlossen
string CONTRACTS = "0.001"

if final_long and send_long
    alert(f_pionexPayload("buy", CONTRACTS, "1"), alert.freq_once_per_bar_close)

if final_short and send_short
    alert(f_pionexPayload("sell", CONTRACTS, "-1"), alert.freq_once_per_bar_close)

bool alignment_lost_long  = not all_bull and all_bull[1]
bool alignment_lost_short = not all_bear and all_bear[1]

if alignment_lost_long and send_close
    alert(f_pionexPayload("sell", CONTRACTS, "0"), alert.freq_once_per_bar_close)
if alignment_lost_short and send_close
    alert(f_pionexPayload("buy", CONTRACTS, "0"), alert.freq_once_per_bar_close)

// ── VISUELLE DARSTELLUNG ─────────────────────────────────────────────
bgcolor(show_bg and all_bull ? color.new(color.green, 92) : show_bg and all_bear ? color.new(color.red, 92) : na, title="Alignment Hintergrund")

plotshape(local_bull,  title="Bull CISD",   style=shape.arrowup,   location=location.belowbar, color=color.new(color.lime, 30), size=size.small)
plotshape(local_bear,  title="Bear CISD",   style=shape.arrowdown, location=location.abovebar, color=color.new(color.red,  30), size=size.small)
plotshape(final_long,  title="LONG SIGNAL", style=shape.arrowup,   location=location.belowbar, color=COL_BULL, size=size.large)
plotshape(final_short, title="SHORT SIGNAL",style=shape.arrowdown, location=location.abovebar, color=COL_BEAR, size=size.large)

// ── DASHBOARD TABLE ──────────────────────────────────────────────────
if show_table and barstate.islast
    var table dash = table.new(position.top_right, 2, 12, bgcolor=color.new(#1e222d, 80), border_width=1, frame_color=color.gray)

    table.cell(dash, 0, 0, "MTF CISD + OB/FVG",  text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)
    table.cell(dash, 1, 0, "Pionex Signal Bot",   text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)

    table.cell(dash, 0, 1, "H4",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, state_h4  == "Bullish" ? "▲" : state_h4  == "Bearish" ? "▼" : "·", text_color=state_h4  == "Bullish" ? COL_BULL : state_h4  == "Bearish" ? COL_BEAR : COL_NEUTRAL, text_size=size.normal)

    table.cell(dash, 0, 2, "H1",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, state_h1  == "Bullish" ? "▲" : state_h1  == "Bearish" ? "▼" : "·", text_color=state_h1  == "Bullish" ? COL_BULL : state_h1  == "Bearish" ? COL_BEAR : COL_NEUTRAL, text_size=size.normal)

    table.cell(dash, 0, 3, "M15", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, state_m15 == "Bullish" ? "▲" : state_m15 == "Bearish" ? "▼" : "·", text_color=state_m15 == "Bullish" ? COL_BULL : state_m15 == "Bearish" ? COL_BEAR : COL_NEUTRAL, text_size=size.normal)

    table.cell(dash, 0, 4, "M5",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, state_m5  == "Bullish" ? "▲" : state_m5  == "Bearish" ? "▼" : "·", text_color=state_m5  == "Bullish" ? COL_BULL : state_m5  == "Bearish" ? COL_BEAR : COL_NEUTRAL, text_size=size.normal)

    table.cell(dash, 0, 5, "---------", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, "---------", text_color=color.gray, text_size=size.tiny)

    table.cell(dash, 0, 6, "OB Bull",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, ob_bull_touch  ? "AKTIV" : "-", text_color=ob_bull_touch  ? COL_BULL : COL_NEUTRAL, text_size=size.small)

    table.cell(dash, 0, 7, "FVG Bull", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, fvg_bull_touch ? "AKTIV" : "-", text_color=fvg_bull_touch ? COL_BULL : COL_NEUTRAL, text_size=size.small)

    table.cell(dash, 0, 8, "---------", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, "---------", text_color=color.gray, text_size=size.tiny)

    table.cell(dash, 0, 9,  "Conf Long",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9,  str.tostring(conf_bull) + "/" + str.tostring(min_conf), text_color=conf_bull >= min_conf ? COL_BULL : color.orange, text_size=size.small)

    table.cell(dash, 0, 10, "Conf Short", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(conf_bear) + "/" + str.tostring(min_conf), text_color=conf_bear >= min_conf ? COL_BEAR : color.orange, text_size=size.small)

    table.cell(dash, 0, 11, "SIGNAL", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 11, final_long ? "LONG" : final_short ? "SHORT" : pending_long ? "WARTE L" : pending_short ? "WARTE S" : "KEIN", text_color=final_long ? COL_BULL : final_short ? COL_BEAR : pending_long or pending_short ? color.yellow : COL_NEUTRAL, text_size=size.small)
