[macd_long_sig, macd_short_sig, macd_long_score, macd_short_score, macd_long_sl, macd_long_tp, macd_short_sl, macd_short_tp] = f_macd_momentum_set()
[stoch_long_sig, stoch_short_sig, stoch_long_score, stoch_short_score, stoch_long_sl, stoch_long_tp, stoch_short_sl, stoch_short_tp] = f_stoch_reversal_set()
[adx_long_sig, adx_short_sig, adx_long_score, adx_short_score, adx_long_sl, adx_long_tp, adx_short_sl, adx_short_tp] = f_adx_pullback_set()
[kc_long_sig, kc_short_sig, kc_long_score, kc_short_score, kc_long_sl, kc_long_tp, kc_short_sl, kc_short_tp] = f_keltner_breakout_set()
[vwaprev_long_sig, vwaprev_short_sig, vwaprev_long_score, vwaprev_short_score, vwaprev_long_sl, vwaprev_long_tp, vwaprev_short_sl, vwaprev_short_tp] = f_vwap_reversion_set()
[fractal_long_sig, fractal_short_sig, fractal_long_score, fractal_short_score, fractal_long_sl, fractal_long_tp, fractal_short_sl, fractal_short_tp] = f_fractal_breakout_set()
[pivot_long_sig, pivot_short_sig, pivot_long_score, pivot_short_score, pivot_long_sl, pivot_long_tp, pivot_short_sl, pivot_short_tp] = f_pivot_rejection_set()
[atrx_long_sig, atrx_short_sig, atrx_long_score, atrx_short_score, atrx_long_sl, atrx_long_tp, atrx_short_sl, atrx_short_tp] = f_atr_expansion_set()
[vol_long_sig, vol_short_sig, vol_long_score, vol_short_score, vol_long_sl, vol_long_tp, vol_short_sl, vol_short_tp] = f_volume_climax_set()
[eng_long_sig, eng_short_sig, eng_long_score, eng_short_score, eng_long_sl, eng_long_tp, eng_short_sl, eng_short_tp] = f_engulfing_reversal_set()
[inside_long_sig, inside_short_sig, inside_long_score, inside_short_score, inside_long_sl, inside_long_tp, inside_short_sl, inside_short_tp] = f_inside_bar_breakout_set()
[ha_long_sig, ha_short_sig, ha_long_score, ha_short_score, ha_long_sl, ha_long_tp, ha_short_sl, ha_short_tp] = f_heikin_trend_set()
[psar_long_sig, psar_short_sig, psar_long_score, psar_short_score, psar_long_sl, psar_long_tp, psar_short_sl, psar_short_tp] = f_psar_trend_set()

