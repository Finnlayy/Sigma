    best_score := psar_trend_candidate_score

string features_json = "[" + str.tostring(atr_pct, "#.###") + "," + str.tostring(rsi_val / 100.0, "#.###") + "," + str.tostring(vol_ratio, "#.###") + "," + str.tostring(mtf_bull_ratio, "#.###") + "," + str.tostring(mtf_bear_ratio, "#.###") + "," + str.tostring(local_state, "#") + "," + str.tostring(bb_width_pct, "#.###") + "," + str.tostring(macd_hist, "#.###") + "," + str.tostring(adx_val / 100.0, "#.###") + "," + str.tostring(ema_slope / math.max(close, syminfo.mintick), "#.###") + "," + str.tostring(vwap_dist, "#.###") + "," + str.tostring(daily_pnl_pct / 100.0, "#.###") + "," + str.tostring(current_dd_pct / 100.0, "#.###") + "," + str.tostring(news_bias, "#") + "," + str.tostring(mtf_bias, "#") + "," + str.tostring(ha_bias, "#") + "," + str.tostring(structure_bias, "#") + "]"

string candidates_json = "[" + f_candidate_json("EMA_TREND", ema_long_sig, ema_short_sig, ema_long_score, ema_short_score, ema_long_sl, ema_long_tp, ema_short_sl, ema_short_tp) + "," + f_candidate_json("EMA_VWAP_SCALPER", vwap_long_sig, vwap_short_sig, vwap_long_score, vwap_short_score, vwap_long_sl, vwap_long_tp, vwap_short_sl, vwap_short_tp) + "," + f_candidate_json("RSI_REVERSION", rsi_long_sig, rsi_short_sig, rsi_long_score, rsi_short_score, rsi_long_sl, rsi_long_tp, rsi_short_sl, rsi_short_tp) + "," + f_candidate_json("ORB_BREAKOUT", orb_long_sig, orb_short_sig, orb_long_score, orb_short_score, orb_long_sl, orb_long_tp, orb_short_sl, orb_short_tp) + "," + f_candidate_json("QUANTUM_TREND", quant_long_sig, quant_short_sig, quant_long_score, quant_short_score, quant_long_sl, quant_long_tp, quant_short_sl, quant_short_tp) + "," + f_candidate_json("CISD_STRUCTURE", struct_long_sig, struct_short_sig, struct_long_score, struct_short_score, struct_long_sl, struct_long_tp, struct_short_sl, struct_short_tp) + "," + f_candidate_json("GLINT_NEWS", glint_long_sig, glint_short_sig, glint_long_score, glint_short_score, glint_long_sl, glint_long_tp, glint_short_sl, glint_short_tp) + "," + f_candidate_json("WTI_SCALPER", wti_long_sig, wti_short_sig, wti_long_score, wti_short_score, wti_long_sl, wti_long_tp, wti_short_sl, wti_short_tp) + "," + f_candidate_json("BB_REVERSION", bb_long_sig, bb_short_sig, bb_long_score, bb_short_score, bb_long_sl, bb_long_tp, bb_short_sl, bb_short_tp) + "," + f_candidate_json("BB_SQUEEZE", squeeze_long_sig, squeeze_short_sig, squeeze_long_score, squeeze_short_score, squeeze_long_sl, squeeze_long_tp, squeeze_short_sl, squeeze_short_tp) + "," + f_candidate_json("DONCHIAN_BREAKOUT", don_long_sig, don_short_sig, don_long_score, don_short_score, don_long_sl, don_long_tp, don_short_sl, don_short_tp) + "," + f_candidate_json("HMA_TREND", hma_long_sig, hma_short_sig, hma_long_score, hma_short_score, hma_long_sl, hma_long_tp, hma_short_sl, hma_short_tp) + "," + f_candidate_json("MACD_MOMENTUM", macd_long_sig, macd_short_sig, macd_long_score, macd_short_score, macd_long_sl, macd_long_tp, macd_short_sl, macd_short_tp) + "," + f_candidate_json("STOCH_REVERSAL", stoch_long_sig, stoch_short_sig, stoch_long_score, stoch_short_score, stoch_long_sl, stoch_long_tp, stoch_short_sl, stoch_short_tp) + "," + f_candidate_json("ADX_PULLBACK", adx_long_sig, adx_short_sig, adx_long_score, adx_short_score, adx_long_sl, adx_long_tp, adx_short_sl, adx_short_tp) + "," + f_candidate_json("KELTNER_BREAKOUT", kc_long_sig, kc_short_sig, kc_long_score, kc_short_score, kc_long_sl, kc_long_tp, kc_short_sl, kc_short_tp) + "," + f_candidate_json("VWAP_REVERSION", vwaprev_long_sig, vwaprev_short_sig, vwaprev_long_score, vwaprev_short_score, vwaprev_long_sl, vwaprev_long_tp, vwaprev_short_sl, vwaprev_short_tp) + "," + f_candidate_json("FRACTAL_BREAKOUT", fractal_long_sig, fractal_short_sig, fractal_long_score, fractal_short_score, fractal_long_sl, fractal_long_tp, fractal_short_sl, fractal_short_tp) + "," + f_candidate_json("PIVOT_REJECTION", pivot_long_sig, pivot_short_sig, pivot_long_score, pivot_short_score, pivot_long_sl, pivot_long_tp, pivot_short_sl, pivot_short_tp) + "," + f_candidate_json("ATR_EXPANSION", atrx_long_sig, atrx_short_sig, atrx_long_score, atrx_short_score, atrx_long_sl, atrx_long_tp, atrx_short_sl, atrx_short_tp) + "," + f_candidate_json("VOLUME_CLIMAX", vol_long_sig, vol_short_sig, vol_long_score, vol_short_score, vol_long_sl, vol_long_tp, vol_short_sl, vol_short_tp) + "," + f_candidate_json("ENGULFING_REVERSAL", eng_long_sig, eng_short_sig, eng_long_score, eng_short_score, eng_long_sl, eng_long_tp, eng_short_sl, eng_short_tp) + "," + f_candidate_json("INSIDE_BAR_BREAKOUT", inside_long_sig, inside_short_sig, inside_long_score, inside_short_score, inside_long_sl, inside_long_tp, inside_short_sl, inside_short_tp) + "," + f_candidate_json("HEIKIN_TREND", ha_long_sig, ha_short_sig, ha_long_score, ha_short_score, ha_long_sl, ha_long_tp, ha_short_sl, ha_short_tp) + "," + f_candidate_json("PSAR_TREND", psar_long_sig, psar_short_sig, psar_long_score, psar_short_score, psar_long_sl, psar_long_tp, psar_short_sl, psar_short_tp) + "]"

string pack_raw = "{\"mode\":\"SCAN\",\"catalog_size\":25,\"symbol\":\"" + syminfo.ticker + "\",\"timeframe\":\"" + timeframe.period + "\",\"best_family\":\"" + best_family + "\",\"best_side\":\"" + best_side + "\",\"best_score\":" + str.tostring(best_score) + ",\"helpers\":{\"fractal_tp\":" + (use_fractal_tp ? "true" : "false") + ",\"reverse_available\":true},\"features\":" + features_json + ",\"candidates\":" + candidates_json + "}"

bool confirmed = barstate.isconfirmed
bool scan_ready = confirmed and emit_scans and str.length(signal_type) > 0 and (emit_every_bar or best_score >= min_conf)
if scan_ready
    float outer_stop = best_side == "short" ? close + atr_val * sl_atr_mul : close - atr_val * sl_atr_mul
    float outer_target = best_side == "short" ? close - atr_val * tp_atr_mul : close + atr_val * tp_atr_mul
    alert(f_build_payload("scan", "0", best_family, best_side, outer_stop, outer_target, best_score, "scan", pack_raw), alert.freq_once_per_bar_close)

if scan_ready and debug_mode and best_score >= math.max(1, min_conf - 2)
    label.new(bar_index, high + atr_val * 0.5, best_family + " / " + best_side + " / " + str.tostring(best_score), style=label.style_label_down, color=best_side == "long" ? color.green : color.red, textcolor=color.white, size=size.tiny)

plot(show_visuals ? ema200 : na, "EMA 200", color=color.new(color.blue, 35), linewidth=2)
plot(show_visuals ? vwap_val : na, "VWAP", color=color.new(color.orange, 25), linewidth=1)
plot(show_visuals ? ut_stop : na, "UT Stop", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(show_visuals and orb_ready ? orb_high : na, "ORB High", color=color.new(color.green, 30), style=plot.style_linebr)
plot(show_visuals and orb_ready ? orb_low : na, "ORB Low", color=color.new(color.red, 30), style=plot.style_linebr)
bgcolor(best_side == "long" ? color.new(color.green, 92) : best_side == "short" ? color.new(color.red, 92) : na)
plotshape(scan_ready and best_side == "long" and best_score >= min_conf, title="Best Long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, text="ONNX")
plotshape(scan_ready and best_side == "short" and best_score >= min_conf, title="Best Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="ONNX")
