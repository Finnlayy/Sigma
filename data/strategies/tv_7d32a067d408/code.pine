// @version=6
// =============================================================================
// ZECUSDT.P 5m Intraday Multi-Filter Strategy
// =============================================================================
// Weighted voting engine: SMA bias + MACD + RSI + Bollinger + Stoch + ADX.
// Confirmed-bar entries, cooldown gating, ATR/percent trailing stop,
// Full Kelly sizing, optional SL/TP/BE, performance table dashboard.
// =============================================================================

// =============================================================================
// === STRATEGY DECLARATION (must use CONST literals, not input variables) ===
// =============================================================================
strategy("ZECUSDT.P 5m Intraday",
     overlay=true,
     initial_capital=10000.0,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     slippage=1,
     pyramiding=1,
     calc_on_every_tick=false,
     process_orders_on_close=true)

// =============================================================================
// === INPUTS ===
// =============================================================================

// --- Strategy Settings (for display/reference only; must match strategy() above) ---
dfQty       = input.float(100.0,  "Default Order Size", group="Settings")
// Note: initial_capital, commission_value, slippage, pyramiding are set in strategy() above
//       Change them there if you need different hardcoded defaults.

// --- SMA (Directional Bias Only) ---
smaFL = input.int(9,   "SMA Fast Length", group="SMA", inline="s1")
smaSL = input.int(21,  "SMA Slow Length", group="SMA", inline="s1")
smaW  = input.float(1.0, "SMA Weight", step=0.1, group="SMA", inline="s2")
smaEn = input.bool(true, "SMA Enabled", group="SMA", inline="s2")

// --- MACD ---
mcF  = input.int(12,  "MACD Fast", group="MACD", inline="m1")
mcS  = input.int(26,  "MACD Slow", group="MACD", inline="m1")
mcSg = input.int(9,   "MACD Signal", group="MACD", inline="m1")
mcW  = input.float(1.0, "MACD Weight", step=0.1, group="MACD", inline="m2")
mcEn = input.bool(true, "MACD Enabled", group="MACD", inline="m2")

// --- RSI ---
rLen = input.int(14,  "RSI Length", group="RSI", inline="r1")
rOB  = input.int(70,  "RSI Overbought", group="RSI", inline="r1")
rOS  = input.int(30,  "RSI Oversold", group="RSI", inline="r1")
rW   = input.float(1.0, "RSI Weight", step=0.1, group="RSI", inline="r2")
rEn  = input.bool(true, "RSI Enabled", group="RSI", inline="r2")

// --- Bollinger Bands ---
bbL  = input.int(20,  "BB Length", group="BB", inline="b1")
bbM  = input.float(2.0, "BB StdDev", step=0.1, group="BB", inline="b1")
bbW  = input.float(1.0, "BB Weight", step=0.1, group="BB", inline="b2")
bbEn = input.bool(true, "BB Enabled", group="BB", inline="b2")

// --- Stochastic ---
stK  = input.int(14,  "%K Length", group="Stoch", inline="k1")
stD  = input.int(3,   "%D Length", group="Stoch", inline="k1")
stSm = input.int(3,   "Smoothing", group="Stoch", inline="k1")
stOB = input.int(80,  "Stoch OB", group="Stoch", inline="k2")
stOS = input.int(20,  "Stoch OS", group="Stoch", inline="k2")
stW  = input.float(1.0, "Stoch Weight", step=0.1, group="Stoch", inline="k3")
stEn = input.bool(true, "Stoch Enabled", group="Stoch", inline="k3")

// --- ADX ---
adxL  = input.int(14,  "ADX Length", group="ADX", inline="a1")
adxTh = input.int(20,  "ADX Threshold", group="ADX", inline="a1")
adxW  = input.float(1.0, "ADX Weight", step=0.1, group="ADX", inline="a2")
adxEn = input.bool(true, "ADX Enabled", group="ADX", inline="a2")

// --- Scoring & Direction ---
scrThresh = input.float(2.0, "Score Threshold", step=0.1, group="Scoring")
longEn    = input.bool(true,  "Long Enabled", group="Scoring")
shortEn   = input.bool(true,  "Short Enabled", group="Scoring")

// --- Cooldown ---
cooldown  = input.int(3, "Cooldown Bars", group="Cooldown")

// --- Long Exits ---
lTrlType  = input.string("ATR", "Long Trail Type", options=["ATR","Percent"], group="Long Exits")
lTrlMul   = input.float(1.5, "Long ATR Mult", step=0.1, group="Long Exits")
lTrlLen   = input.int(14,  "Long ATR Length", group="Long Exits")
lTrlPct   = input.float(1.0, "Long Trail %", step=0.1, group="Long Exits")
lTrlAct   = input.float(0.0, "Long Activation Profit %", step=0.1, group="Long Exits")
lEnSL  = input.bool(true,  "Long Use SL", group="Long Exits")
lSlP   = input.float(1.5,  "Long SL %", step=0.1, group="Long Exits")
lEnTP  = input.bool(false, "Long Use TP", group="Long Exits")
lTpP   = input.float(4.0,  "Long TP %", step=0.1, group="Long Exits")
lEnBE  = input.bool(false, "Long Use BE", group="Long Exits")
lBeTr  = input.float(1.0,  "Long BE Trigger %", step=0.1, group="Long Exits")
lBeOf  = input.float(0.0,  "Long BE Offset (ticks)", step=0.1, group="Long Exits")

// --- Short Exits ---
sTrlType  = input.string("None", "Short Trail Type", options=["ATR","Percent","None"], group="Short Exits")
sTrlMul   = input.float(1.5, "Short ATR Mult", step=0.1, group="Short Exits")
sTrlLen   = input.int(14,  "Short ATR Length", group="Short Exits")
sTrlPct   = input.float(1.0, "Short Trail %", step=0.1, group="Short Exits")
sTrlAct   = input.float(2.0, "Short Activation Profit %", step=0.1, group="Short Exits")
sEnSL  = input.bool(true,  "Short Use SL", group="Short Exits")
sSlP   = input.float(1.5,  "Short SL %", step=0.1, group="Short Exits")
sEnTP  = input.bool(true,  "Short Use TP", group="Short Exits")
sTpP   = input.float(3.5,  "Short TP %", step=0.1, group="Short Exits")
sEnBE  = input.bool(true, "Short Use BE", group="Short Exits")
sBeTr  = input.float(1.0,  "Short BE Trigger %", step=0.1, group="Short Exits")
sBeOf  = input.float(0.0,  "Short BE Offset (ticks)", step=0.1, group="Short Exits")

// --- Catch Trade ---
catchEnable    = input.bool(true,  "Catch Trade Enabled", group="Catch Trade")
catchMaxBars   = input.int(10,    "Catch Max Bars", group="Catch Trade")
catchOnShortExit = input.string("Any", "Catch On Short", options=["Any","SL Only","TP Only"], group="Catch Trade")
catchUseTightTP = input.bool(false, "Catch Tight TP", group="Catch Trade")
catchTightTP   = input.float(2.0,  "Catch TP %", step=0.1, group="Catch Trade")
catchShadowPct = input.float(0.5, "Catch Shadow Trail %", step=0.1, group="Catch Trade")
catchShadowEn  = input.bool(true, "Catch Shadow Trail", group="Catch Trade")
catchMaxDurBars = input.int(25, "Catch Duration Bars", minval=1, maxval=500, group="Catch Trade", tooltip="Close catch long after this many bars regardless of price")
catchDurEn     = input.bool(true, "Use Duration Close", group="Catch Trade")
catchBbClose   = input.bool(true, "Close on BB Basis", group="Catch Trade", tooltip="Close catch long if bar closes below Bollinger Band middle line")

// --- Kelly Sizing ---
enKelly = input.bool(true,  "Use Kelly", group="Kelly")
kFrac   = input.float(1.0,  "Kelly Fraction", step=0.1, group="Kelly")
kMinTr  = input.int(10,   "Min Trades", group="Kelly")

// --- Dashboard ---
showDash = input.bool(true,  "Show Dashboard", group="Dashboard")
dashPos  = input.string("top_right", "Position", options=["top_right","top_left","bottom_right","bottom_left"], group="Dashboard")
dashSz   = input.string("normal", "Size", options=["small","normal","large"], group="Dashboard")

// =============================================================================
// === ADX HELPER FUNCTIONS (ta.adx not available; compute manually) ===
// =============================================================================

dirmov(len) =>
    up      = ta.change(high)
    down    = -ta.change(low)
    plusDM  = na(up)   ? na : (up > down and up > 0   ? up   : 0.0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0.0)
    truerange = ta.rma(ta.tr(true), len)
    plus  = nz(100 * ta.rma(plusDM,  len) / truerange)
    minus = nz(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]

calcADX(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)

// =============================================================================
// === CORE INDICATORS ===
// =============================================================================

smaFast = ta.sma(close, smaFL)
smaSlow = ta.sma(close, smaSL)

[macdLine, signalLine, _] = ta.macd(close, mcF, mcS, mcSg)

rsiVal = ta.rsi(close, rLen)

bbBasis = ta.sma(close, bbL)
bbDev   = bbM * ta.stdev(close, bbL)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

stochKVal = ta.sma(ta.stoch(high, low, close, stK), stSm)
stochDVal = ta.sma(stochKVal, stD)

// ADX computed via helper functions
[diPlus, diMinus] = dirmov(adxL)
adxVal = calcADX(adxL, adxL)

// =============================================================================
// === SCORING ENGINE ===
// =============================================================================
// SMA gives directional bias only (bull/bear gate), zero score points.
// MACD: line>signal=long, line<signal=short
// RSI:  value>midpoint(OB,OS)=long, value<midpoint=short
// BB:   close>basis=long, close<basis=short
// Stoch:%K>%D AND not extreme OB=long, %K<%D AND not extreme OS=short
// ADX:  >threshold adds to BOTH sides (trend strength confirmation)

var longScore  = 0.0
var shortScore = 0.0

longScore  := 0.0
shortScore := 0.0

if mcEn and not na(macdLine) and not na(signalLine)
    if macdLine > signalLine
        longScore  += mcW
    else if macdLine < signalLine
        shortScore += mcW

rsiMid = (rOB + rOS) / 2.0
if rEn and not na(rsiVal)
    if rsiVal > rsiMid
        longScore  += rW
    else if rsiVal < rsiMid
        shortScore += rW

if bbEn and not na(bbBasis)
    if close > bbBasis
        longScore  += bbW
    else if close < bbBasis
        shortScore += bbW

if stEn and not na(stochKVal) and not na(stochDVal)
    if stochKVal > stochDVal and stochKVal < stOB
        longScore  += stW
    else if stochKVal < stochDVal and stochKVal > stOS
        shortScore += stW

if adxEn and not na(adxVal) and adxVal > adxTh
    longScore  += adxW
    shortScore += adxW

// =============================================================================
// === ENTRY LOGIC ===
// =============================================================================

var int lastEntryBar = na

// Catch trade tracking
var int   shortEntryBar   = na
var float shortEntryPrice = na
var bool  catchLongPending = false
var int   catchPendingBar = na
var float catchHighest    = na
var int   catchEntryBar  = na

bullBias = not na(smaFast) and not na(smaSlow) and smaFast > smaSlow
bearBias = not na(smaFast) and not na(smaSlow) and smaFast < smaSlow

longCond  = longEn and bullBias and longScore  >= scrThresh and barstate.isconfirmed
shortCond = shortEn and bearBias and shortScore >= scrThresh and barstate.isconfirmed

cdOK = na(lastEntryBar) or (bar_index - lastEntryBar) > cooldown

// =============================================================================
// === FULL KELLY POSITION SIZING ===
// =============================================================================
// Kelly Criterion: f* = (p*b - q) / b
//   p = win rate (W),  q = 1-p,  b = avgWin/avgLoss (R)
// Substituting: f* = (W*R - (1-W)) / R
// kellyFraction scales the result (1.0 = Full Kelly).

var float kellyF = na

if enKelly and strategy.closedtrades >= kMinTr and strategy.wintrades > 0 and strategy.losstrades > 0
    wr      = strategy.wintrades / strategy.closedtrades
    avgWin  = strategy.grossprofit / strategy.wintrades
    avgLoss = math.abs(strategy.grossloss / strategy.losstrades)
    if avgLoss != 0.0 and avgWin > 0.0
        W = wr
        R = avgWin / avgLoss
        kRaw = (W * R - (1.0 - W)) / R
        kellyF := math.max(0.0, kRaw) * kFrac
    else
        kellyF := 0.0
else
    kellyF := na

rawSz = enKelly and not na(kellyF) and kellyF > 0.0 ? math.round(dfQty * kellyF / close) : dfQty
posSz = int(math.max(rawSz, 1.0))

// =============================================================================
// === EXECUTE ENTRIES ===
// =============================================================================

// --- Catch Long Entry (check BEFORE regular entries so a catch isn't preempted) ---

// Clear stale catch flag after 1 bar if no catch occurred
if catchLongPending and not na(catchPendingBar) and bar_index > catchPendingBar + 1
    catchLongPending := false
    catchPendingBar  := na

// Enter catch long on the bar AFTER short SL hit
if catchEnable and catchLongPending and strategy.position_size == 0 and not na(catchPendingBar) and bar_index > catchPendingBar
    catchLongPending := false
    catchPendingBar  := na
    strategy.entry("Catch Long", strategy.long, qty=posSz, comment="Catch Long")
    catchHighest := high
    catchEntryBar := bar_index
    lastEntryBar := bar_index

// --- Regular Entries ---

if longCond and cdOK
    if strategy.position_size < 0
        strategy.close("Short", comment="Close Short")
    strategy.entry("Long", strategy.long, qty=posSz, comment="Long S=" + str.tostring(longScore, "#.##"))
    lastEntryBar := bar_index

if shortCond and cdOK
    if strategy.position_size > 0
        strategy.close("Long", comment="Close Long")
    strategy.entry("Short", strategy.short, qty=posSz, comment="Short S=" + str.tostring(shortScore, "#.##"))
    lastEntryBar := bar_index

// =============================================================================
// === EXIT LOGIC ===
// =============================================================================

var beTriggered = false
var float entryPrice = na
var trlActiveF  = false

isNewLong  = strategy.position_size > 0  and strategy.position_size[1] <= 0
isNewShort = strategy.position_size < 0  and strategy.position_size[1] >= 0
isFlat     = strategy.position_size == 0 and strategy.position_size[1] != 0

if isNewLong or isNewShort
    beTriggered := false
    trlActiveF  := false
    entryPrice  := strategy.position_avg_price
    if isNewShort
        shortEntryBar   := bar_index
        shortEntryPrice := strategy.position_avg_price
else if isFlat
    beTriggered := false
    trlActiveF  := false
    entryPrice  := na
    // Detect if short hit SL within catchMaxBars → set catch flag
    if catchEnable and not na(shortEntryBar) and not na(shortEntryPrice)
        barsInShort = bar_index - shortEntryBar
        slHit = close >= shortEntryPrice * (1.0 + sSlP / 100.0)
        beHit = math.abs(close[1] - shortEntryPrice) / shortEntryPrice <= 0.002
        if (barsInShort <= catchMaxBars and slHit) or beHit
            catchLongPending := true
            catchPendingBar  := bar_index
    shortEntryBar   := na
    shortEntryPrice := na
    catchEntryBar := na
    catchHighest  := na
else if strategy.position_size != 0
    entryPrice  := strategy.position_avg_price
    // Ensure short tracking vars are set even on reversal entries
    if strategy.position_size < 0 and na(shortEntryBar)
        shortEntryBar   := bar_index
        shortEntryPrice := strategy.position_avg_price

unrlPct = 0.0
if strategy.position_size != 0 and not na(entryPrice) and entryPrice != 0.0
    if strategy.position_size > 0
        unrlPct := (close - entryPrice) / entryPrice * 100.0
    else
        unrlPct := (entryPrice - close) / entryPrice * 100.0

if not beTriggered and strategy.position_size != 0 and not na(entryPrice)
    if strategy.position_size > 0 and lEnBE and unrlPct >= lBeTr
        beTriggered := true
    if strategy.position_size < 0 and sEnBE and unrlPct >= sBeTr
        beTriggered := true

if strategy.position_size != 0 and not na(unrlPct)
    if strategy.position_size > 0 and unrlPct >= lTrlAct
        trlActiveF := true
    if strategy.position_size < 0 and unrlPct >= sTrlAct
        trlActiveF := true

lTrlActive = lTrlAct <= 0.0 or trlActiveF
sTrlActive = sTrlAct <= 0.0 or trlActiveF

safeMT = syminfo.mintick != 0.0 ? syminfo.mintick : 0.01

// Long exit values
lAtrV       = ta.atr(lTrlLen)
lTrlOffPrice = lTrlType == "ATR" ? (nz(lAtrV, close * 0.01) * lTrlMul) : (close * lTrlPct / 100.0)
lTrlTicks    = int(math.max(lTrlOffPrice / safeMT, 1.0))
lSlTix = lEnSL and not na(entryPrice) ? int(entryPrice * lSlP / 100.0 / safeMT) : na
lTpTix = lEnTP and not na(entryPrice) ? int(entryPrice * lTpP / 100.0 / safeMT) : na
lActTrlOff = lTrlActive and strategy.position_size > 0 ? lTrlTicks : na

// Short exit values
sAtrV       = ta.atr(sTrlLen)
sTrlOffPrice = sTrlType == "ATR" ? (nz(sAtrV, close * 0.01) * sTrlMul) : sTrlType == "Percent" ? (close * sTrlPct / 100.0) : 0.0
sTrlTicks    = int(math.max(sTrlOffPrice / safeMT, 1.0))
sSlTix = sEnSL and not na(entryPrice) ? int(entryPrice * sSlP / 100.0 / safeMT) : na
sTpTix = sEnTP and not na(entryPrice) ? int(entryPrice * sTpP / 100.0 / safeMT) : na
sActTrlOff = sTrlType != "None" and sTrlActive and strategy.position_size < 0 ? sTrlTicks : na

// =============================================================================
// === APPLY EXITS ===
// =============================================================================

if strategy.position_size > 0
    // --- BB Basis close (catch long) ---
    isCatchLongPos = strategy.position_size > 0 and not na(strategy.opentrades.entry_id(0)) and strategy.opentrades.entry_id(0) == "Catch Long"
    if catchBbClose and isCatchLongPos and not na(bbBasis) and close < bbBasis
        strategy.close("Catch Long", comment="BB Basis")
    else if catchShadowEn and isCatchLongPos
        catchHighest := math.max(catchHighest, high)
        if close < catchHighest * (1.0 - catchShadowPct / 100.0)
            strategy.close("Catch Long", comment="Shadow Trail")
    else if catchDurEn and isCatchLongPos and not na(catchEntryBar) and bar_index - catchEntryBar >= catchMaxDurBars
        strategy.close("Catch Long", comment="Duration")

    strategy.exit("XL", "Long",
         trail_offset = lActTrlOff,
         loss         = lSlTix,
         profit       = lTpTix,
         comment_trailing = "Trail",
         comment_loss     = "SL",
         comment_profit   = "TP")
    strategy.exit("XCL", "Catch Long",
         loss         = lSlTix,
         profit       = catchUseTightTP ? int(entryPrice * catchTightTP / 100.0 / safeMT) : lTpTix,
         comment_loss     = "SL",
         comment_profit   = "TP")

    beLvlL = not na(entryPrice) ? entryPrice - lBeOf * safeMT : na
    if lEnBE and beTriggered and not na(beLvlL) and close <= beLvlL
        strategy.close("Long", comment="BE")

if strategy.position_size < 0
    strategy.exit("XS", "Short",
         trail_offset = sActTrlOff,
         loss         = sSlTix,
         profit       = sTpTix,
         comment_trailing = "Trail",
         comment_loss     = "SL",
         comment_profit   = "TP")

    beLvlS = not na(entryPrice) ? entryPrice + sBeOf * safeMT : na
    if sEnBE and beTriggered and not na(beLvlS) and close >= beLvlS
        strategy.close("Short", comment="BE")

// =============================================================================
// === PLOTS ===
// =============================================================================

plot(smaFast, "SMAf", color=color.new(color.blue, 0),   linewidth=1)
plot(smaSlow, "SMAs", color=color.new(color.orange, 0), linewidth=1)
plot(bbUpper, "BBu",  color=color.new(color.gray, 50),  linewidth=1)
plot(bbLower, "BBb",  color=color.new(color.gray, 50),  linewidth=1)
plot(bbBasis, "BBm",  color=color.new(color.gray, 30),  linewidth=1)

bgcolor(bullBias ? color.new(color.green, 95) : bearBias ? color.new(color.red, 95) : color.new(color.gray, 95), title="Bias")

// =============================================================================
// === DASHBOARD ===
// =============================================================================

pMap = dashPos == "top_right"    ? position.top_right
     : dashPos == "top_left"     ? position.top_left
     : dashPos == "bottom_right" ? position.bottom_right
     : dashPos == "bottom_left"  ? position.bottom_left
     : position.top_right

sMap = dashSz == "small"  ? size.small
     : dashSz == "normal" ? size.normal
     : dashSz == "large"  ? size.large
     : size.normal

var dashT = table.new(pMap, 2, 13,
     bgcolor      = color.new(color.black, 10),
     frame_color  = color.new(color.gray, 50),
     frame_width  = 1,
     border_color = color.new(color.gray, 50),
     border_width = 1)

if showDash
    table.cell(dashT, 0, 0, "Metric", text_color=color.white, text_size=sMap, bgcolor=color.new(color.gray, 30))
    table.cell(dashT, 1, 0, "Value",  text_color=color.white, text_size=sMap, bgcolor=color.new(color.gray, 30))

    np = strategy.netprofit
    npC = np > 0 ? color.new(color.green, 70) : np < 0 ? color.new(color.red, 70) : color.new(color.gray, 70)
    table.cell(dashT, 0, 1, "Net Profit", text_color=color.white, text_size=sMap, bgcolor=npC)
    table.cell(dashT, 1, 1, str.tostring(np, format.mintick), text_color=np > 0 ? color.green : np < 0 ? color.red : color.gray, text_size=sMap, bgcolor=npC)

    pf = strategy.grossloss != 0.0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    pfv = nz(pf, 0.0)
    pfC = pfv > 1.5 ? color.new(color.green, 70) : pfv > 1.0 ? color.new(color.teal, 70) : pfv > 0.0 ? color.new(color.orange, 70) : color.new(color.red, 70)
    table.cell(dashT, 0, 2, "Profit Factor", text_color=color.white, text_size=sMap, bgcolor=pfC)
    table.cell(dashT, 1, 2, str.tostring(pfv, "#.##"), text_color=pfv > 1.0 ? color.green : color.red, text_size=sMap, bgcolor=pfC)

    wrv = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0
    wrC = wrv > 55.0 ? color.new(color.green, 70) : wrv > 45.0 ? color.new(color.gray, 70) : color.new(color.red, 70)
    table.cell(dashT, 0, 3, "Win Rate %", text_color=color.white, text_size=sMap, bgcolor=wrC)
    table.cell(dashT, 1, 3, str.tostring(wrv, "#.##") + "%", text_color=wrv > 50.0 ? color.green : color.red, text_size=sMap, bgcolor=wrC)

    tc = strategy.closedtrades
    table.cell(dashT, 0, 4, "Trade Count", text_color=color.white, text_size=sMap, bgcolor=tc > 0 ? color.new(color.blue, 70) : color.new(color.gray, 70))
    table.cell(dashT, 1, 4, str.tostring(tc), text_color=color.white, text_size=sMap, bgcolor=tc > 0 ? color.new(color.blue, 70) : color.new(color.gray, 70))

    awv = strategy.wintrades > 0 ? strategy.grossprofit / strategy.wintrades : 0.0
    table.cell(dashT, 0, 5, "Avg Win", text_color=color.white, text_size=sMap, bgcolor=color.new(color.green, 80))
    table.cell(dashT, 1, 5, str.tostring(awv, format.mintick), text_color=color.green, text_size=sMap, bgcolor=color.new(color.green, 80))

    alv = strategy.losstrades > 0 ? math.abs(strategy.grossloss / strategy.losstrades) : 0.0
    table.cell(dashT, 0, 6, "Avg Loss", text_color=color.white, text_size=sMap, bgcolor=color.new(color.red, 80))
    table.cell(dashT, 1, 6, str.tostring(alv, format.mintick), text_color=color.red, text_size=sMap, bgcolor=color.new(color.red, 80))

    kfv = nz(kellyF, 0.0)
    kfvC = kfv > 0.0 ? color.new(color.green, 70) : color.new(color.gray, 70)
    table.cell(dashT, 0, 7, "Kelly F", text_color=color.white, text_size=sMap, bgcolor=kfvC)
    table.cell(dashT, 1, 7, str.tostring(kfv, "#.###"), text_color=kfv > 0.0 ? color.green : color.gray, text_size=sMap, bgcolor=kfvC)

    sp = posSz
    table.cell(dashT, 0, 8, "Pos Size", text_color=color.white, text_size=sMap, bgcolor=color.new(color.blue, 80))
    table.cell(dashT, 1, 8, str.tostring(sp), text_color=color.white, text_size=sMap, bgcolor=color.new(color.blue, 80))

    lsc = strategy.losstrades > 0 ? strategy.max_drawdown / strategy.losstrades : 0.0
    table.cell(dashT, 0, 9, "MDD / Losses", text_color=color.white, text_size=sMap, bgcolor=lsc > 0 ? color.new(color.red, 70) : color.new(color.gray, 70))
    table.cell(dashT, 1, 9, str.tostring(lsc, format.mintick), text_color=lsc > 0 ? color.red : color.gray, text_size=sMap, bgcolor=lsc > 0 ? color.new(color.red, 70) : color.new(color.gray, 70))

    maxDD = strategy.max_drawdown
    table.cell(dashT, 0, 10, "Max DD", text_color=color.white, text_size=sMap, bgcolor=color.new(color.orange, 70))
    table.cell(dashT, 1, 10, str.tostring(maxDD, format.mintick), text_color=color.orange, text_size=sMap, bgcolor=color.new(color.orange, 70))

    // Market / OS info
    symText = syminfo.ticker
    table.cell(dashT, 0, 11, "Symbol", text_color=color.white, text_size=sMap, bgcolor=color.new(color.gray, 80))
    table.cell(dashT, 1, 11, symText, text_color=color.white, text_size=sMap, bgcolor=color.new(color.gray, 80))

    tfText = timeframe.period
    table.cell(dashT, 0, 12, "Timeframe", text_color=color.white, text_size=sMap, bgcolor=color.new(color.gray, 80))
    table.cell(dashT, 1, 12, tfText, text_color=color.white, text_size=sMap, bgcolor=color.new(color.gray, 80))
