//@version=6
// ============================================================================
// QuantumForexTrader SniperFusion — STRATEGY v2 (Risk/Regime Refactor)
// Entry-Engine (Quantum-Score + Sniper) unveraendert aus v1.
// Neu: risk-basiertes Sizing (kein Margin-Call moeglich), strukturelle Stops,
// BE-Gate >= 1.5R, Ratchet-Trailing erst ab +2R, Friktions-Mindestdistanz,
// harter HTF-Regime-Gate, ADX-Hard-Gate, barstate.isconfirmed, State-Machine.
// ============================================================================
strategy("QuantumForexTrader_SniperFusion_Strategy_v2",
     overlay=true,
     max_labels_count=500, max_boxes_count=100, max_bars_back=5000,
     initial_capital=10000,
     pyramiding=0,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=2,
     process_orders_on_close=true,
     calc_on_every_tick=false)

// === Inputs ===
group_analysis = "=== Quantum Core ==="
historyBars = input.int(72, "History bars for analysis", group=group_analysis, minval=32, maxval=4096)
confThreshold = input.float(0.54, "Minimum confidence", group=group_analysis, step=0.01)
momentumThreshold = input.float(0.08, "Minimum momentum", group=group_analysis, step=0.01)
memoryDecay = input.float(0.88, "Memory decay", group=group_analysis, minval=0.50, maxval=0.99, step=0.01)
memoryThreshold = input.float(0.05, "Memory threshold", group=group_analysis, minval=0.01, maxval=1.00, step=0.01)

group_filters = "=== Trend Filters ==="
useEMAfilter = input.bool(true, "Use EMA Trend Filter", group=group_filters)
useMTFfilter = input.bool(true, "Use higher timeframe trend filter", group=group_filters)
useVolFilter = input.bool(true, "Use Volume Filter", group=group_filters)
useATRfilter = input.bool(true, "Use ATR Volatility Filter", group=group_filters)
useCandleFilter = input.bool(true, "Use Candle Body Filter", group=group_filters)
trendEmaLen = input.int(34, "Trend EMA Length", group=group_filters)
mtfTf = input.timeframe("60", "MTF Trend TF", group=group_filters)
volLookback = input.int(24, "Volume SMA Length", group=group_filters)
volMultiplier = input.float(1.00, "Min Relative Volume", group=group_filters, step=0.05)
atrLen = input.int(14, "ATR Length", group=group_filters)
atrMaLen = input.int(21, "ATR SMA Length", group=group_filters)
atrMultiplier = input.float(0.95, "Min ATR vs ATR-SMA", group=group_filters, step=0.05)
bodyRatioMin = input.float(0.35, "Min Candle Body Ratio", group=group_filters, step=0.05)

group_sniper = "=== Sniper Logic ==="
useSniperBiasFilter = input.bool(true, "Require sniper bias alignment", group=group_sniper)
sniperMinPct = input.float(57.0, "Minimum sniper score %", group=group_sniper, minval=40, maxval=100, step=1)
useSniperCrossTrigger = input.bool(true, "Allow EMA 9/21 cross trigger", group=group_sniper)
strongBiasDiff = input.float(40.0, "Strong bias difference", group=group_sniper, minval=10, maxval=100, step=5)

group_signal = "=== Signal Generation ==="
signalIntervalMin = input.int(3, "Signal interval (minutes)", group=group_signal, minval=1, maxval=240)
signalScoreMin = input.int(8, "Minimum total score", group=group_signal, minval=1, maxval=20)
signalEdgeMin = input.int(2, "Minimum score edge", group=group_signal, minval=0, maxval=20)
minMoveAtr = input.float(0.30, "Min move from last signal (ATR)", group=group_signal, step=0.05)
includePriceInAlert = input.bool(true, "Include price in webhook", group=group_signal)
useCloseActionForExit = input.bool(true, "Use close instead of reverse-open", group=group_signal)

group_regime = "=== Regime & Direction Gates (NEU v2) ==="
allowLong = input.bool(true, "Allow longs", group=group_regime)
allowShort = input.bool(true, "Allow shorts", group=group_regime)
useRegimeGate = input.bool(true, "Hard HTF regime gate (long nur ueber HTF-EMA)", group=group_regime)
regimeTf = input.timeframe("240", "Regime TF", group=group_regime)
regimeEmaLen = input.int(50, "Regime EMA Length", group=group_regime, minval=10, maxval=400)
useAdxHardGate = input.bool(true, "ADX hard gate (Momentum-Regime, Kaminski-Lo)", group=group_regime)
adxMin = input.float(20.0, "Min ADX", group=group_regime, minval=10, maxval=40, step=1)

group_risk = "=== Risk Management (NEU v2) ==="
riskPerTradePct = input.float(1.0, "Risk per trade % of equity", group=group_risk, minval=0.1, maxval=10.0, step=0.1)
maxLeverage = input.float(1.0, "Max leverage (1.0 = no margin call possible)", group=group_risk, minval=0.1, maxval=10.0, step=0.5)
swingLen = input.int(10, "Structural swing lookback", group=group_risk, minval=3, maxval=100)
stopBufferAtr = input.float(0.5, "Structural stop buffer (ATR)", group=group_risk, minval=0.0, maxval=1.0, step=0.1)
minStopAtr = input.float(1.5, "Min stop width (ATR)", group=group_risk, minval=0.5, maxval=5.0, step=0.1)
maxStopAtr = input.float(3.0, "Max stop width (ATR)", group=group_risk, minval=1.0, maxval=10.0, step=0.5)
tp1R = input.float(1.5, "TP1 in R (scaling out, Varianz-Reduktion)", group=group_risk, minval=0.5, maxval=5.0, step=0.1)
tp1SharePct = input.float(50.0, "TP1 size % of position", group=group_risk, minval=0, maxval=100, step=5)
useBreakEven = input.bool(true, "Move stop to BE after TP1 (Gate: TP1 >= 1.5R)", group=group_risk)
trailActivateR = input.float(2.0, "Trailing activation (R) — kein Trailing vor +2R", group=group_risk, minval=1.0, maxval=10.0, step=0.5)
trailAtrMult = input.float(2.5, "Trailing distance (ATR, Ratchet)", group=group_risk, minval=0.5, maxval=6.0, step=0.5)

group_friction = "=== Friction Gate (NEU v2) ==="
useFrictionGate = input.bool(true, "Skip trades when stop distance < friction coverage", group=group_friction)
takerFeePct = input.float(0.05, "Taker fee % per side", group=group_friction, minval=0.0, step=0.01)
slippageEstPct = input.float(0.02, "Slippage estimate % per side", group=group_friction, minval=0.0, step=0.01)
feeCoverageMin = input.float(6.0, "Min stop distance = x * roundtrip friction", group=group_friction, minval=1.0, maxval=20.0, step=0.5)

group_visual = "=== Visuals ==="
showDashboard = input.bool(true, "Show dashboard", group=group_visual)
showRibbon = input.bool(true, "Show EMA ribbon", group=group_visual)
showTargets = input.bool(true, "Show entry/SL/TP lines", group=group_visual)
showSignalLabels = input.bool(true, "Show entry/exit markers", group=group_visual)
showVwap = input.bool(true, "Show VWAP", group=group_visual)
ribbonOpacity = input.int(75, "EMA Ribbon Opacity", group=group_visual, minval=0, maxval=100)
dashTextSizeStr = input.string("small", "Dashboard font size", options=["tiny", "small", "normal", "large", "huge"], group=group_visual)
tradeTextSizeStr = input.string("small", "Trade label size", options=["tiny", "small", "normal", "large", "huge"], group=group_visual)
labelOffset = input.int(12, "Label right offset (bars)", minval=1, group=group_visual)

group_time = "=== Trading Schedule ==="
useTimeFilter = input.bool(false, "Use time filter", group=group_time)
startHour = input.int(7, "Start trading hour", group=group_time, minval=0, maxval=23)
endHour = input.int(23, "End trading hour", group=group_time, minval=0, maxval=23)

// === Functions ===
getTextSize(string s) =>
    switch s
        "tiny" => size.tiny
        "normal" => size.normal
        "large" => size.large
        "huge" => size.huge
        => size.small

inSession() =>
    if not useTimeFilter
        true
    else
        int h = hour(time, syminfo.timezone)
        startHour <= endHour ? (h >= startHour and h < endHour) : (h >= startHour or h < endHour)

f_addDashRow(_table, _row, _title, _value, _textColor, _size) =>
    table.cell(_table, 0, _row, _title, text_color=color.black, text_halign=text.align_left, text_size=_size)
    table.cell(_table, 1, _row, _value, text_color=_textColor, text_halign=text.align_right, text_size=_size)

// === Session ===
bool sessionOK = inSession()

// === Shared indicators (ta.* unconditionally, every bar) ===
float ema9 = ta.ema(close, 9)
float ema21 = ta.ema(close, 21)
float vwapValue = ta.vwap(hlc3)
float atrValue = ta.atr(atrLen)
float rsiValue = ta.rsi(close, 14)
[macdMain, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
[dmiPlus, dmiMinus, adxValue] = ta.dmi(14, 14)
float volAvg = ta.sma(volume, 20)
float trendEmaValue = ta.ema(close, trendEmaLen)
float volSMA = ta.sma(volume, volLookback)
float atrBase = ta.sma(atrValue, atrMaLen)
float swingLow = ta.lowest(low, swingLen)
float swingHigh = ta.highest(high, swingLen)

bool emaCrossUp = ta.crossover(ema9, ema21)
bool emaCrossDn = ta.crossunder(ema9, ema21)

// === HTF data: confirmed values only ([1] + lookahead_on = no future leak) ===
float rsi5m      = request.security(syminfo.tickerid, "5", ta.rsi(close, 14)[1], lookahead=barmerge.lookahead_on)
bool mtfBullRaw  = request.security(syminfo.tickerid, mtfTf, (close > ta.ema(close, trendEmaLen) and ta.ema(close, trendEmaLen) > ta.ema(close, trendEmaLen)[1])[1], lookahead=barmerge.lookahead_on)
bool mtfBearRaw  = request.security(syminfo.tickerid, mtfTf, (close < ta.ema(close, trendEmaLen) and ta.ema(close, trendEmaLen) < ta.ema(close, trendEmaLen)[1])[1], lookahead=barmerge.lookahead_on)
float regimeEma  = request.security(syminfo.tickerid, regimeTf, ta.ema(close, regimeEmaLen)[1], lookahead=barmerge.lookahead_on)
float regimeEmaP = request.security(syminfo.tickerid, regimeTf, ta.ema(close, regimeEmaLen)[2], lookahead=barmerge.lookahead_on)
float regimeCls  = request.security(syminfo.tickerid, regimeTf, close[1], lookahead=barmerge.lookahead_on)

bool regimeBull = regimeCls > regimeEma and regimeEma > regimeEmaP
bool regimeBear = regimeCls < regimeEma and regimeEma < regimeEmaP
bool mtfBull = mtfBullRaw
bool mtfBear = mtfBearRaw

// === Quantum Analysis ===
int maxHist = 4096
int histLen = historyBars > maxHist ? maxHist : historyBars

float upCount = 0.0
float downCount = 0.0

for i = 1 to histLen
    if not na(close[i]) and not na(close[i + 1])
        float chg = close[i] - close[i + 1]
        float weight = 1.0 + ((histLen - i) / histLen)
        if chg > 0
            upCount += weight
        else if chg < 0
            downCount += weight

float totalMoves = upCount + downCount
float bullProb = totalMoves > 0 ? upCount / totalMoves : 0.0
float bearProb = totalMoves > 0 ? downCount / totalMoves : 0.0

int trendDir =
     bullProb > bearProb ? 1 :
     bearProb > bullProb ? -1 : 0

float stateMomentum =
     bullProb > bearProb ? (bullProb - bearProb) :
     bearProb > bullProb ? (bearProb - bullProb) : 0.0

float confidence = math.max(bullProb, bearProb)
int confidenceScore = confidence >= confThreshold ? 1 : 0
int momentumScore = stateMomentum >= momentumThreshold ? 1 : 0

// === Quantum filters ===
float trendEmaSlope = trendEmaValue - trendEmaValue[1]
bool emaBull = close > trendEmaValue and trendEmaSlope > 0
bool emaBear = close < trendEmaValue and trendEmaSlope < 0

bool volOK = not na(volSMA) and volume > volSMA * volMultiplier
bool atrOK = not useATRfilter or (not na(atrBase) and atrValue >= atrBase * atrMultiplier)

float candleRange = math.max(high - low, syminfo.mintick)
float bodyRatio = math.abs(close - open) / candleRange
bool bullCandle = close > open and bodyRatio >= bodyRatioMin
bool bearCandle = close < open and bodyRatio >= bodyRatioMin

// === Sniper dual-score logic ===
float bullScoreSniper = 0
bullScoreSniper += close > vwapValue ? 1 : 0
bullScoreSniper += rsiValue > 50 ? 1 : 0
bullScoreSniper += macdMain > macdSignal ? 1 : 0
bullScoreSniper += ema9 > ema21 ? 1 : 0
bullScoreSniper += adxValue > 25 and close > ema9 ? 1 : 0
bullScoreSniper += volume > volAvg and close > open ? 1 : 0
bullScoreSniper += rsi5m > 50 ? 1 : 0
float bullPct = bullScoreSniper / 7.0 * 100.0

float bearScoreSniper = 0
bearScoreSniper += close < vwapValue ? 1 : 0
bearScoreSniper += rsiValue < 50 ? 1 : 0
bearScoreSniper += macdMain < macdSignal ? 1 : 0
bearScoreSniper += ema9 < ema21 ? 1 : 0
bearScoreSniper += adxValue > 25 and close < ema9 ? 1 : 0
bearScoreSniper += volume > volAvg and close < open ? 1 : 0
bearScoreSniper += rsi5m < 50 ? 1 : 0
float bearPct = bearScoreSniper / 7.0 * 100.0

float biasDiff = bullPct - bearPct
string biasText =
     biasDiff >= strongBiasDiff ? "STRONG BULL" :
     -biasDiff >= strongBiasDiff ? "STRONG BEAR" :
     bullPct > bearPct ? "MILD BULL" :
     bearPct > bullPct ? "MILD BEAR" : "NEUTRAL"

color biasColor =
     biasText == "STRONG BULL" ? color.green :
     biasText == "STRONG BEAR" ? color.red :
     color.gray

bool sniperLongBias = bullPct > bearPct and bullPct >= sniperMinPct
bool sniperShortBias = bearPct > bullPct and bearPct >= sniperMinPct

bool sniperLongTrigger = useSniperCrossTrigger and emaCrossUp and sniperLongBias and close > vwapValue and macdMain > macdSignal and rsi5m > 50
bool sniperShortTrigger = useSniperCrossTrigger and emaCrossDn and sniperShortBias and close < vwapValue and macdMain < macdSignal and rsi5m < 50

// === Memory and interval ===
varip int lastSignalBarIndex = na
varip int lastSignalType = 0
varip float lastSignalPrice = na
varip float qMemory = 0.0
varip int orderSeq = 0
varip string openLongOrderId = ""
varip string openShortOrderId = ""

int chartSecondsRaw = timeframe.in_seconds(timeframe.period)
int chartSeconds = na(chartSecondsRaw) ? 60 : chartSecondsRaw
int intervalBars = math.max(1, int(math.ceil(signalIntervalMin * 60.0 / chartSeconds)))
bool newCheck = na(lastSignalBarIndex) ? true : (bar_index - lastSignalBarIndex >= intervalBars)

float memoryInput =
     trendDir == 1 ? (0.18 + stateMomentum * 0.30) :
     trendDir == -1 ? -(0.18 + stateMomentum * 0.30) : 0.0

qMemory := math.max(-1.0, math.min(1.0, qMemory * memoryDecay + memoryInput))
int memoryBias =
     qMemory > memoryThreshold ? 1 :
     qMemory < -memoryThreshold ? -1 : 0

int preferredDir = trendDir != 0 ? trendDir : memoryBias

// === Hybrid score (unveraendert aus v1) ===
int longScore =
     (preferredDir == 1 ? 2 : 0) +
     (trendDir == 1 ? 1 : 0) +
     (memoryBias == 1 ? 1 : 0) +
     confidenceScore +
     momentumScore +
     ((not useEMAfilter or emaBull) ? 1 : 0) +
     ((not useMTFfilter or mtfBull) ? 1 : 0) +
     ((not useVolFilter or volOK) ? 1 : 0) +
     (atrOK ? 1 : 0) +
     ((not useCandleFilter or bullCandle) ? 1 : 0) +
     (bullPct > bearPct ? 2 : 0) +
     (biasDiff >= strongBiasDiff ? 1 : 0) +
     (close > vwapValue ? 1 : 0) +
     (macdMain > macdSignal ? 1 : 0) +
     (adxValue > 25 ? 1 : 0) +
     (rsi5m > 50 ? 1 : 0)

int shortScore =
     (preferredDir == -1 ? 2 : 0) +
     (trendDir == -1 ? 1 : 0) +
     (memoryBias == -1 ? 1 : 0) +
     confidenceScore +
     momentumScore +
     ((not useEMAfilter or emaBear) ? 1 : 0) +
     ((not useMTFfilter or mtfBear) ? 1 : 0) +
     ((not useVolFilter or volOK) ? 1 : 0) +
     (atrOK ? 1 : 0) +
     ((not useCandleFilter or bearCandle) ? 1 : 0) +
     (bearPct > bullPct ? 2 : 0) +
     (-biasDiff >= strongBiasDiff ? 1 : 0) +
     (close < vwapValue ? 1 : 0) +
     (macdMain < macdSignal ? 1 : 0) +
     (adxValue > 25 ? 1 : 0) +
     (rsi5m < 50 ? 1 : 0)

int longEdge = longScore - shortScore
int shortEdge = shortScore - longScore

bool longRearmOK = na(lastSignalPrice) or lastSignalType != 1 or close >= lastSignalPrice + atrValue * minMoveAtr
bool shortRearmOK = na(lastSignalPrice) or lastSignalType != -1 or close <= lastSignalPrice - atrValue * minMoveAtr

bool longBiasGate = not useSniperBiasFilter or sniperLongBias or biasText == "STRONG BULL"
bool shortBiasGate = not useSniperBiasFilter or sniperShortBias or biasText == "STRONG BEAR"

bool rawLongSignal = sessionOK and newCheck and longRearmOK and longBiasGate and longScore >= signalScoreMin and longEdge >= signalEdgeMin
bool rawShortSignal = sessionOK and newCheck and shortRearmOK and shortBiasGate and shortScore >= signalScoreMin and shortEdge >= signalEdgeMin

rawLongSignal := rawLongSignal or sniperLongTrigger
rawShortSignal := rawShortSignal or sniperShortTrigger

if rawLongSignal and rawShortSignal
    if bullPct >= bearPct
        rawShortSignal := false
    else
        rawLongSignal := false

// ============================================================================
// NEU v2: State-Machine (0 = flat, 1 = long, -1 = short) — chronologische
// Setup-Validierung, Entries nur auf bestaetigten Bars.
// ============================================================================
var int state = 0
var float entryPrice = na
var float stopPrice = na        // initialer (struktureller) Stop
var float curStop = na          // effektiver Stop (inkl. BE + Ratchet-Trail)
var float tp1Price = na
var float riskDist = na
var float trailStop = na
var bool tp1Done = false
var bool trailActive = false

bool inLong = state == 1
bool inShort = state == -1
bool isFlat = state == 0

// === NEU v2: Struktureller Stop (Swing +/- ATR-Puffer, geklemmt 1.5-3x ATR) ===
float rawStopL = swingLow[1] - atrValue * stopBufferAtr
float rawStopS = swingHigh[1] + atrValue * stopBufferAtr
float distL = math.min(math.max(close - rawStopL, atrValue * minStopAtr), atrValue * maxStopAtr)
float distS = math.min(math.max(rawStopS - close, atrValue * minStopAtr), atrValue * maxStopAtr)

// === NEU v2: Friction Gate — Stop-Distanz muss Friktion deutlich abdecken ===
float roundTripFrictionPct = (takerFeePct + slippageEstPct) * 2.0
bool frictionOKL = not useFrictionGate or (distL / close * 100.0 >= feeCoverageMin * roundTripFrictionPct)
bool frictionOKS = not useFrictionGate or (distS / close * 100.0 >= feeCoverageMin * roundTripFrictionPct)

// === NEU v2: Harte Gates (Regime, ADX/Momentum, Direction, Friktion) ===
bool gateLong = allowLong and (not useRegimeGate or regimeBull) and (not useAdxHardGate or adxValue >= adxMin) and frictionOKL
bool gateShort = allowShort and (not useRegimeGate or regimeBear) and (not useAdxHardGate or adxValue >= adxMin) and frictionOKS

bool closeShortSignal = useCloseActionForExit and inShort and rawLongSignal
bool closeLongSignal = useCloseActionForExit and inLong and rawShortSignal
bool buySignal = barstate.isconfirmed and isFlat and rawLongSignal and gateLong
bool sellSignal = barstate.isconfirmed and isFlat and rawShortSignal and gateShort

if buySignal or sellSignal or closeShortSignal or closeLongSignal
    lastSignalBarIndex := bar_index
    lastSignalType := rawLongSignal ? 1 : rawShortSignal ? -1 : lastSignalType
    lastSignalPrice := close

// === NEU v2: Risk-basiertes Sizing (eliminiert Margin Calls) ===
float riskUsd = strategy.equity * riskPerTradePct / 100.0
float qtyL = math.min(riskUsd / distL, strategy.equity * maxLeverage / close)
float qtyS = math.min(riskUsd / distS, strategy.equity * maxLeverage / close)

// === Webhook alert helpers ===
string pionexOrderPrefix = "QF_SOLUSDT_SNIPE"

makeOrderId(string action, int seq) =>
    pionexOrderPrefix + "_" + timeframe.period + "_" + str.tostring(bar_index) + "_" + str.tostring(seq) + "_" + action

makeAlertMessage(string action, string orderId) =>
    string priceField = includePriceInAlert ? ',"price":' + str.tostring(close, format.mintick) : ""
    '{"action":"' + action + '","symbol":"' + syminfo.ticker + '"' + priceField + ',"order_id":"' + orderId + '"}'

// === Orders: Close bei Gegensignal ===
if closeShortSignal and barstate.isconfirmed
    strategy.cancel_all()
    string exitShortOrderId = openShortOrderId
    openShortOrderId := ""
    strategy.close("Short", alert_message=makeAlertMessage("close", exitShortOrderId))
    alert(makeAlertMessage("close", exitShortOrderId), alert.freq_once_per_bar_close)

if closeLongSignal and barstate.isconfirmed
    strategy.cancel_all()
    string exitLongOrderId = openLongOrderId
    openLongOrderId := ""
    strategy.close("Long", alert_message=makeAlertMessage("close", exitLongOrderId))
    alert(makeAlertMessage("close", exitLongOrderId), alert.freq_once_per_bar_close)

// === Orders: Entries (nur confirmed, nur aus State 0) ===
if buySignal
    orderSeq += 1
    string entryLongOrderId = makeOrderId("buy", orderSeq)
    openLongOrderId := entryLongOrderId
    state := 1
    entryPrice := close
    riskDist := distL
    stopPrice := close - distL
    curStop := stopPrice
    tp1Price := close + distL * tp1R
    trailStop := stopPrice
    tp1Done := false
    trailActive := false
    strategy.entry("Long", strategy.long, qty=qtyL, alert_message=makeAlertMessage("buy", entryLongOrderId))
    alert(makeAlertMessage("buy", entryLongOrderId), alert.freq_once_per_bar_close)

if sellSignal
    orderSeq += 1
    string entryShortOrderId = makeOrderId("sell", orderSeq)
    openShortOrderId := entryShortOrderId
    state := -1
    entryPrice := close
    riskDist := distS
    stopPrice := close + distS
    curStop := stopPrice
    tp1Price := close - distS * tp1R
    trailStop := stopPrice
    tp1Done := false
    trailActive := false
    strategy.entry("Short", strategy.short, qty=qtyS, alert_message=makeAlertMessage("sell", entryShortOrderId))
    alert(makeAlertMessage("sell", entryShortOrderId), alert.freq_once_per_bar_close)

// === NEU v2: Trade-Management — TP1 (Varianz), BE-Gate, Ratchet-Trail ab +2R ===
if inLong
    tp1Done := tp1Done or high >= tp1Price
    if useBreakEven and tp1Done
        curStop := math.max(curStop, entryPrice)
    trailActive := trailActive or close >= entryPrice + riskDist * trailActivateR
    if trailActive
        trailStop := math.max(trailStop, close - atrValue * trailAtrMult)
        curStop := math.max(curStop, trailStop)

if inShort
    tp1Done := tp1Done or low <= tp1Price
    if useBreakEven and tp1Done
        curStop := math.min(curStop, entryPrice)
    trailActive := trailActive or close <= entryPrice - riskDist * trailActivateR
    if trailActive
        trailStop := math.min(trailStop, close + atrValue * trailAtrMult)
        curStop := math.min(curStop, trailStop)

// === Exits: TP1 skaliert raus, Rest laeuft mit dynamischem Stop (Runner) ===
if (inLong or buySignal) and not na(curStop)
    strategy.exit("L-TP1", from_entry="Long", qty_percent=tp1SharePct, limit=tp1Price, stop=curStop)
    strategy.exit("L-RUN", from_entry="Long", stop=curStop)

if (inShort or sellSignal) and not na(curStop)
    strategy.exit("S-TP1", from_entry="Short", qty_percent=tp1SharePct, limit=tp1Price, stop=curStop)
    strategy.exit("S-RUN", from_entry="Short", stop=curStop)

// === State-Machine: Reset when flat (persistente Levels via var float) ===
if strategy.position_size == 0 and not buySignal and not sellSignal
    state := 0
    entryPrice := na
    stopPrice := na
    curStop := na
    tp1Price := na
    riskDist := na
    trailStop := na
    tp1Done := false
    trailActive := false

// === Visuals ===
string dashTextSize = getTextSize(dashTextSizeStr)
string tradeTextSize = getTextSize(tradeTextSizeStr)

pFast = plot(showRibbon ? ema9 : na, color=color.new(color.green, 20), title="EMA 9")
pSlow = plot(showRibbon ? ema21 : na, color=color.new(color.red, 20), title="EMA 21")
fill(pFast, pSlow, color = ema9 > ema21 ? color.new(color.green, 100 - ribbonOpacity) : color.new(color.red, 100 - ribbonOpacity))
plot(showVwap ? vwapValue : na, color=close > vwapValue ? color.green : color.red, linewidth=2, title="VWAP")
plot(showTargets and (inLong or inShort) ? curStop : na, color=color.red, linewidth=2, style=plot.style_linebr, title="Effective Stop")

plotshape(showSignalLabels and buySignal, title="Buy Open", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, text="BUY")
plotshape(showSignalLabels and sellSignal, title="Sell Open", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, text="SELL")
plotshape(showSignalLabels and closeShortSignal, title="Close Short", style=shape.xcross, location=location.abovebar, color=color.orange, text="X-S")
plotshape(showSignalLabels and closeLongSignal, title="Close Long", style=shape.xcross, location=location.belowbar, color=color.orange, text="X-L")

var line entryLine = na
var line tp1Line = na
var label entryLabel = na
var label tp1Label = na

if isFlat and not buySignal and not sellSignal
    line.delete(entryLine), line.delete(tp1Line)
    label.delete(entryLabel), label.delete(tp1Label)
    entryLine := na, tp1Line := na
    entryLabel := na, tp1Label := na

if (buySignal or sellSignal) and showTargets
    line.delete(entryLine), line.delete(tp1Line)
    label.delete(entryLabel), label.delete(tp1Label)
    entryLine := line.new(bar_index, entryPrice, bar_index + 20, entryPrice, color=color.blue, width=2, extend=extend.right)
    tp1Line := line.new(bar_index, tp1Price, bar_index + 20, tp1Price, color=color.green, style=line.style_dashed, extend=extend.right)
    entryLabel := label.new(bar_index + labelOffset, entryPrice, "ENTRY: " + str.tostring(entryPrice, format.mintick), color=color.blue, textcolor=color.white, style=label.style_label_left, size=tradeTextSize)
    tp1Label := label.new(bar_index + labelOffset, tp1Price, "TP1 (" + str.tostring(tp1R, "#.#") + "R): " + str.tostring(tp1Price, format.mintick), color=color.green, textcolor=color.white, style=label.style_label_left, size=tradeTextSize)

// === Dashboard ===
var table dash = table.new(position.middle_left, 2, 15, bgcolor=color.new(#FFF9C4, 10), border_width=1, border_color=color.new(color.gray, 60))
if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "BULL SCORE", text_color=color.white, bgcolor=color.green, text_size=dashTextSize)
    table.cell(dash, 1, 0, str.tostring(bullPct, "#") + "%", text_color=color.white, bgcolor=color.green, text_size=dashTextSize)
    table.cell(dash, 0, 1, "BEAR SCORE", text_color=color.white, bgcolor=color.red, text_size=dashTextSize)
    table.cell(dash, 1, 1, str.tostring(bearPct, "#") + "%", text_color=color.white, bgcolor=color.red, text_size=dashTextSize)
    table.cell(dash, 0, 2, "MARKET BIAS", text_color=color.white, bgcolor=color.black, text_size=dashTextSize)
    table.cell(dash, 1, 2, biasText, text_color=color.white, bgcolor=biasColor, text_size=dashTextSize)
    f_addDashRow(dash, 3, "Quantum", preferredDir == 1 ? "LONG" : preferredDir == -1 ? "SHORT" : "NEUTRAL", preferredDir == 1 ? color.green : preferredDir == -1 ? color.red : color.gray, dashTextSize)
    f_addDashRow(dash, 4, "Regime " + regimeTf, regimeBull ? "BULL" : regimeBear ? "BEAR" : "FLAT", regimeBull ? color.green : regimeBear ? color.red : color.gray, dashTextSize)
    f_addDashRow(dash, 5, "ADX gate", str.tostring(adxValue, "#.#") + (adxValue >= adxMin ? " OK" : " BLOCK"), adxValue >= adxMin ? color.green : color.gray, dashTextSize)
    f_addDashRow(dash, 6, "Friction", frictionOKL or frictionOKS ? "OK" : "BLOCK", frictionOKL or frictionOKS ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 7, "VWAP", close > vwapValue ? "ABOVE" : "BELOW", close > vwapValue ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 8, "RSI 14", str.tostring(rsiValue, "#.#"), rsiValue > 50 ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 9, "MACD", macdMain > macdSignal ? "BULL" : "BEAR", macdMain > macdSignal ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 10, "Score", str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#"), longScore > shortScore ? color.green : shortScore > longScore ? color.red : color.gray, dashTextSize)
    f_addDashRow(dash, 11, "Signal", buySignal ? "BUY" : sellSignal ? "SELL" : closeShortSignal or closeLongSignal ? "CLOSE" : "WAIT", buySignal ? color.green : sellSignal ? color.red : closeShortSignal or closeLongSignal ? color.orange : color.gray, dashTextSize)
    f_addDashRow(dash, 12, "State", inLong ? "LONG" : inShort ? "SHORT" : "FLAT", inLong ? color.green : inShort ? color.red : color.gray, dashTextSize)
    f_addDashRow(dash, 13, "Stop", na(curStop) ? "-" : str.tostring(curStop, format.mintick) + (trailActive ? " TRAIL" : tp1Done ? " BE" : ""), color.red, dashTextSize)
    f_addDashRow(dash, 14, "ATR", str.tostring(atrValue, "#.##"), color.black, dashTextSize)