//@version=6
strategy(
    title = "Grid Trading Strategy (v6)",
    overlay = true,
    default_qty_type = strategy.percent_of_equity,
    default_qty_value = 100.0,
    commission_type = strategy.commission.percent,
    commission_value = 0.1,
    pyramiding = 5,
    initial_capital = 10000,
    calc_on_every_tick = false,
    calc_on_order_fills = false,
    process_orders_on_close = true
)

// ┌─────────────────────────────────────────────────────────────────────────────
// │ INPUTS
// └─────────────────────────────────────────────────────────────────────────────

// === Grid Configuration ===
num_grid_levels    = input.int(7, "Number of Grid Levels", minval=2, group="Grid Settings")
grid_static        = input.bool(false, "Static Grid", tooltip="If true, grid is fixed to start price; otherwise anchored dynamically.", group="Grid Settings")
spacing_mode       = input.string("ATR", options=["Fixed %", "ATR"], group="Grid Settings")
fixed_spacing_pct  = input.float(1.0, "Fixed Spacing (%)", minval=0.01, maxval=10, step=0.1, group="Grid Settings") / 100.0
atr_length         = input.int(14, "ATR Length", minval=1, group="Grid Settings")
atr_multiplier     = input.float(1.5, "ATR Multiplier", minval=0.1, step=0.1, group="Grid Settings")

// === Entry Logic ===
entry_mode    = input.string("Mean Reversion", options=["Mean Reversion", "Breakout"], group="Entry Logic")
allow_long    = input.bool(true, "Allow Long Entries", group="Entry Logic")
allow_short   = input.bool(true, "Allow Short Entries", group="Entry Logic")
scale_in      = input.bool(true, "Scale In Across Levels", group="Entry Logic")

// === Risk Management ===
max_concurrent_positions = input.int(5, "Max Concurrent Positions", minval=1, group="Risk Management")
max_position_exposure    = input.float(25.0, "Max Equity Exposure per Trade (%)", minval=0.1, maxval=100.0, step=0.5, group="Risk Management") / 100.0
use_trend_filter         = input.bool(true, "Use EMA Trend Filter", group="Risk Management")
ema_length               = input.int(50, "Trend EMA Length", minval=10, group="Risk Management")
use_volatility_filter    = input.bool(true, "Use Volatility Filter", group="Risk Management")
vol_threshold_multiplier = input.float(3.0, "Volatility Threshold (x ATR)", minval=1.0, group="Risk Management")
use_session_filter       = input.bool(false, "Limit to Session Hours", group="Risk Management")
session_hours            = input.session("0930-1600", "Trading Session", group="Risk Management")
min_dist_to_last_entry   = input.float(0.5, "Min Distance to Last Entry (%)", minval=0.1, group="Risk Management") / 100.0

// === Exit Logic ===
take_profit_mode        = input.string("Next Grid Level", options=["Next Grid Level", "Fixed %", "None"], group="Exit Logic")
tp_fixed_pct            = input.float(1.5, "Take Profit (%)", minval=0.1, group="Exit Logic") / 100.0
sl_percent              = input.float(2.0, "Stop Loss (%)", minval=0.1, group="Exit Logic") / 100.0
use_atr_sl              = input.bool(true, "Use ATR-based Stop Loss", group="Exit Logic")
atr_sl_mult             = input.float(2.0, "ATR SL Multiplier", minval=0.5, step=0.5, group="Exit Logic")
exit_on_opposite_signal = input.bool(true, "Full Exit on Opposite Signal", group="Exit Logic")
flatten_if_outside_grid = input.bool(true, "Flatten If Price Leaves Grid", group="Exit Logic")

// === Visualization ===
show_grid_lines = input.bool(true, "Show Grid Lines", group="Visualization")
show_signals    = input.bool(true, "Show Entry/Exit Signals", group="Visualization")
long_color      = color.green
short_color     = color.red

// ┌─────────────────────────────────────────────────────────────────────────────
// │ HELPER FUNCTIONS  (no return-type keywords in v6)
// └─────────────────────────────────────────────────────────────────────────────

safe_div(a, b) =>
    b == 0 ? na : a / b

in_trading_session() =>
    not use_session_filter ? true : not na(time(timeframe.period, session_hours))

price_touches_level(price, level, tol) =>
    math.abs(price - level) <= math.max(tol, level * 0.0001)

get_order_id(dir, level_idx) =>
    dir + "_" + str.tostring(level_idx)

// ┌─────────────────────────────────────────────────────────────────────────────
// │ GRID CALCULATIONS
// └─────────────────────────────────────────────────────────────────────────────

atr_val      = ta.atr(atr_length)
grid_spacing = spacing_mode == "Fixed %" ? close * fixed_spacing_pct : atr_val * atr_multiplier

var float anchor_price = na
if bar_index == 0
    anchor_price := close
else if not grid_static
    anchor_price := math.avg(ta.lowest(low, num_grid_levels * 2), ta.highest(high, num_grid_levels * 2))

// Build grid level arrays each bar
var grid_levels_long  = array.new_float()
var grid_levels_short = array.new_float()

array.clear(grid_levels_long)
array.clear(grid_levels_short)

for i = 0 to num_grid_levels - 1
    offset = grid_spacing * (i + 1)
    array.push(grid_levels_long,  anchor_price - offset)
    array.push(grid_levels_short, anchor_price + offset)

array.sort(grid_levels_long,  order.ascending)
array.sort(grid_levels_short, order.ascending)

// ┌─────────────────────────────────────────────────────────────────────────────
// │ FILTERS
// └─────────────────────────────────────────────────────────────────────────────

ema_trend       = ta.ema(close, ema_length)
trend_bullish   = use_trend_filter ? close > ema_trend : true
trend_bearish   = use_trend_filter ? close < ema_trend : true

excessive_vol   = use_volatility_filter and atr_val > (ta.atr(50) * vol_threshold_multiplier)
can_trade_vol   = not excessive_vol
can_trade_time  = in_trading_session()
can_trade       = can_trade_vol and can_trade_time

far_from_last_entry = strategy.position_size == 0 or na(strategy.position_avg_price) ? true : math.abs(close - strategy.position_avg_price) / strategy.position_avg_price > min_dist_to_last_entry

// ┌─────────────────────────────────────────────────────────────────────────────
// │ SIGNAL GENERATION
// └─────────────────────────────────────────────────────────────────────────────

var triggered_long  = array.new_bool(50, false)
var triggered_short = array.new_bool(50, false)

// Reset triggers when position is flat
if strategy.position_size == 0
    for i = 0 to array.size(triggered_long) - 1
        array.set(triggered_long, i, false)
        array.set(triggered_short, i, false)

tolerance = syminfo.mintick * 5

var bool should_enter_long  = false
var bool should_enter_short = false
should_enter_long  := false
should_enter_short := false

next_long_level_index  = -1
next_short_level_index = -1

if entry_mode == "Mean Reversion"
    // Long: lower levels — iterate top-down (closest to anchor first)
    for i = num_grid_levels - 1 to 0
        lvl = array.get(grid_levels_long, i)
        already_hit = i < array.size(triggered_long) ? array.get(triggered_long, i) : false
        if price_touches_level(low, lvl, tolerance) and not already_hit and allow_long and trend_bullish and can_trade and far_from_last_entry
            should_enter_long := true
            next_long_level_index := i
            if i < array.size(triggered_long)
                array.set(triggered_long, i, true)
            break

    // Short: upper levels — iterate bottom-up (closest to anchor first)
    for i = 0 to num_grid_levels - 1
        lvl = array.get(grid_levels_short, i)
        already_hit = i < array.size(triggered_short) ? array.get(triggered_short, i) : false
        if price_touches_level(high, lvl, tolerance) and not already_hit and allow_short and trend_bearish and can_trade and far_from_last_entry
            should_enter_short := true
            next_short_level_index := i
            if i < array.size(triggered_short)
                array.set(triggered_short, i, true)
            break

else if entry_mode == "Breakout"
    upper_bound = array.get(grid_levels_short, num_grid_levels - 1)
    lower_bound = array.get(grid_levels_long, 0)

    if high >= upper_bound and allow_long and trend_bullish and can_trade
        should_enter_long := true
        next_long_level_index := num_grid_levels - 1
    if low <= lower_bound and allow_short and trend_bearish and can_trade
        should_enter_short := true
        next_short_level_index := 0

within_position_limit = math.abs(strategy.opentrades) < max_concurrent_positions
should_enter_long  := should_enter_long  and within_position_limit
should_enter_short := should_enter_short and within_position_limit

// ┌─────────────────────────────────────────────────────────────────────────────
// │ TRADE EXECUTION
// └─────────────────────────────────────────────────────────────────────────────

size_units = strategy.equity * max_position_exposure / close

if should_enter_long
    strategy.entry(get_order_id("LONG", next_long_level_index), strategy.long, qty=size_units)

if should_enter_short
    strategy.entry(get_order_id("SHORT", next_short_level_index), strategy.short, qty=size_units)

// ┌─────────────────────────────────────────────────────────────────────────────
// │ EXITS AND PROTECTION
// └─────────────────────────────────────────────────────────────────────────────

dynamic_sl = use_atr_sl ? atr_val * atr_sl_mult : close * sl_percent

float take_profit_price = na
if take_profit_mode == "Next Grid Level" and strategy.position_size != 0
    if strategy.position_size > 0
        take_profit_price := strategy.position_avg_price + grid_spacing
    else
        take_profit_price := strategy.position_avg_price - grid_spacing
else if take_profit_mode == "Fixed %" and strategy.position_size != 0
    take_profit_price := strategy.position_size > 0 ? strategy.position_avg_price * (1 + tp_fixed_pct) : strategy.position_avg_price * (1 - tp_fixed_pct)

if strategy.position_size != 0
    float stop_price = strategy.position_size > 0 ? strategy.position_avg_price - dynamic_sl : strategy.position_avg_price + dynamic_sl
    if take_profit_mode != "None" and not na(take_profit_price)
        strategy.exit("Exit", from_entry="", stop=stop_price, limit=take_profit_price)
    else
        strategy.exit("Exit", from_entry="", stop=stop_price)

// Exit on opposite signal
if exit_on_opposite_signal
    if (should_enter_short and strategy.position_size > 0) or (should_enter_long and strategy.position_size < 0)
        strategy.close_all(comment="Opposite Signal")

// Flatten if outside grid bounds
if flatten_if_outside_grid and strategy.position_size != 0
    upper_grid = array.get(grid_levels_short, num_grid_levels - 1)
    lower_grid = array.get(grid_levels_long, 0)
    out_of_bounds = (strategy.position_size > 0 and close > upper_grid) or (strategy.position_size < 0 and close < lower_grid)
    if out_of_bounds
        strategy.close_all(comment="Out of Grid")

// ┌─────────────────────────────────────────────────────────────────────────────
// │ PLOTS AND DASHBOARD
// └─────────────────────────────────────────────────────────────────────────────

// Plot grid levels via lines (redrawn each bar via var lines won't work cleanly; use simple lines)
var line[] long_lines  = array.new_line()
var line[] short_lines = array.new_line()

if show_grid_lines
    // Clear old lines
    for i = 0 to array.size(long_lines) - 1
        line.delete(array.get(long_lines, i))
    for i = 0 to array.size(short_lines) - 1
        line.delete(array.get(short_lines, i))
    array.clear(long_lines)
    array.clear(short_lines)

    for i = 0 to num_grid_levels - 1
        ll = array.get(grid_levels_long, i)
        sl = array.get(grid_levels_short, i)
        array.push(long_lines,  line.new(bar_index - 5, ll, bar_index, ll, color=color.new(long_color, 30), width=1, extend=extend.right))
        array.push(short_lines, line.new(bar_index - 5, sl, bar_index, sl, color=color.new(short_color, 30), width=1, extend=extend.right))

plot(anchor_price, color=color.orange, linewidth=2, title="Grid Anchor")

plotshape(show_signals and should_enter_long,  location=location.belowbar, color=long_color,  style=shape.triangleup,   size=size.small, title="Long Signal")
plotshape(show_signals and should_enter_short, location=location.abovebar, color=short_color, style=shape.triangledown, size=size.small, title="Short Signal")

// Dashboard
var table status_table = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_width=1, frame_color=color.gray, frame_width=1)

if barstate.islast
    mode_str       = entry_mode == "Mean Reversion" ? "MR" : "BRK"
    bias_str       = trend_bullish ? "Bull" : trend_bearish ? "Bear" : "Neutral"
    pos_str        = strategy.position_size == 0 ? "Flat" : strategy.position_size > 0 ? "Long" : "Short"
    active_levels  = str.tostring(strategy.opentrades) + "/" + str.tostring(max_concurrent_positions)

    table.cell(status_table, 0, 0, "Mode",     text_color=color.white, bgcolor=color.blue)
    table.cell(status_table, 1, 0, mode_str,   text_color=color.white)
    table.cell(status_table, 0, 1, "Bias",     text_color=color.white, bgcolor=color.blue)
    table.cell(status_table, 1, 1, bias_str,   text_color=color.white, bgcolor=trend_bullish ? color.green : trend_bearish ? color.red : color.gray)
    table.cell(status_table, 0, 2, "Position", text_color=color.white, bgcolor=color.blue)
    table.cell(status_table, 1, 2, pos_str + " " + active_levels, text_color=color.white)
    table.cell(status_table, 0, 3, "Filters",  text_color=color.white, bgcolor=color.blue)
    table.cell(status_table, 1, 3, can_trade ? "OK" : "BLOCK", text_color=color.white, bgcolor=can_trade ? color.green : color.red)
    table.cell(status_table, 0, 4, "Anchor",   text_color=color.white, bgcolor=color.blue)
    table.cell(status_table, 1, 4, str.tostring(math.round_to_mintick(anchor_price)), text_color=color.orange)
    table.cell(status_table, 0, 5, "Spacing",  text_color=color.white, bgcolor=color.blue)
    table.cell(status_table, 1, 5, str.tostring(math.round(grid_spacing, 4)), text_color=color.yellow)
