//@version=6
// ============================================================================
// CIIF Master v9 - XRP 1m Precision Engine (Clean Single Order - No Hedging)
// Optimized for XRPUSDT 1-Minute Chart | GainzAlgo ML SMC Hybrid
// Pine Script v6 strategy.
// ============================================================================
strategy(
     title                  = "CIIF Master v9 - XRP 1m Precision",
     shorttitle             = "CIIF v9 XRP1m",
     overlay                = true,
     max_labels_count       = 500,
     max_boxes_count        = 500,
     max_lines_count        = 500,
     max_bars_back          = 5000,
     pyramiding             = 1,
     calc_on_every_tick     = false,
     calc_on_order_fills    = false,
     process_orders_on_close = false,
     initial_capital        = 1000,
     currency               = currency.USD,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 10,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.05,
     slippage               = 2)

// ============================================================================
// UI & Inputs (Optimized for XRP 1m)
// ============================================================================
grp_algo   = "🧠 Quant & ML Engine (XRP 1m Tuned)"
lookahead  = input.int(10,   "Look-Ahead Window (Bars)",     minval=5,   maxval=50,   step=1,   group=grp_algo)
windowLen  = input.int(1000, "Historical Memory Window",     minval=300, maxval=2000, step=100, group=grp_algo)
kNeighbors = input.int(5,    "K-Nearest Neighbors (K)",      minval=1,   maxval=10,             group=grp_algo)
minScore   = input.int(55,   "Min Significance Score (%)",   minval=0,   maxval=100,  step=5,   group=grp_algo)
atrLen     = input.int(10,   "ATR Period (Micro 1m)",        minval=3,                          group=grp_algo)
swingLen   = input.int(3,    "Pivot Length (Fast 1m)",       minval=2,   maxval=15,             group=grp_algo)

grp_risk   = "🛡️ Risiko & Exit Management"
riskPctPerTrade = input.float(2.0, "Risiko pro Trade (% Equity)", group=grp_risk, minval=0.5, maxval=10.0, step=0.5)
tpAtrMult       = input.float(2.0, "Fallback TP ATR Multiplikator", group=grp_risk, minval=0.5, maxval=10.0, step=0.25)
slAtrMult       = input.float(1.0, "Stop Loss ATR Multiplikator", group=grp_risk, minval=0.3, maxval=5.0, step=0.1)
enableQuickFlip  = input.bool(true, "Position-Flip bei Gegensignal im Verlust", group=grp_risk)

grp_core   = "⚙️ Trading Direction & Cooldown"
enableLongs      = input.bool(true, "Long-Trades erlauben", group=grp_core)
enableShorts     = input.bool(true, "Short-Trades erlauben", group=grp_core)
minBarsBetween    = input.int(3, "Mindest-Kerzen zwischen Trades", minval=1, maxval=30, group=grp_core)

grp_ui     = "🎨 Visual Style & Target Levels"
themeMode  = input.string("Obsidian", "Theme", options=["Obsidian", "Monochrome Alpha"], group=grp_ui)
hiProbClr  = input.color(color.rgb(160, 130, 255), "High Probability (>80%)",   group=grp_ui)
medProbClr = input.color(color.rgb(200, 180, 255),  "Medium Probability (≥60%)", group=grp_ui)
bgTableClr = input.color(color.rgb(8, 8, 14),    "Panel Background",          group=grp_ui)
txtTable   = input.color(color.rgb(190, 185, 210), "Panel Text",               group=grp_ui)

showSwingLines  = input.bool(true,  "CHoCH Connector Lines",   group=grp_ui)
showBrokenLevel = input.bool(true,  "Broken Level Marker",     group=grp_ui)
extendLines     = input.bool(false, "Extend Active Level",     group=grp_ui)
showWickTrace   = input.bool(true,  "Neon Wick Trace",         group=grp_ui)
showFill        = input.bool(true,  "CHoCH Region Fill",       group=grp_ui)
fillTransp      = input.int(93,     "Fill Transparency",        minval=70, maxval=98, step=2, group=grp_ui)

showPriceTarget = input.bool(true,  "Show KNN Price Targets",  group=grp_ui)
targetExtBars   = input.int(10,     "Target Extension (Bars)", minval=2, maxval=300,   group=grp_ui)
targetScalar    = input.float(0.5,  "Conservative Scalar",     minval=0.1, maxval=1.0, step=0.05, group=grp_ui)
tp1Clr          = input.color(color.rgb(120, 200, 160), "TP1 Color (Conservative)", group=grp_ui)
tp2Clr          = input.color(color.rgb(180, 160, 255), "TP2 Color (Median)",       group=grp_ui)
tp3Clr          = input.color(color.rgb(220, 130, 180), "TP3 Color (Aggressive)",   group=grp_ui)
showTpLabels    = input.bool(true,  "Show TP Labels In Box",   group=grp_ui)
manualBoxExt    = input.bool(false, "Manual Box Extension Override", group=grp_ui)
manualExtBars   = input.int(100,    "Manual Extension (Bars)", minval=2, maxval=500, group=grp_ui)

grp_exec   = "🔔 Integration & Visuals"
pionexUuid     = input.string("", "Pionex Signal Bot UUID", group=grp_exec)
showDashboard    = input.bool(true, "Dashboard anzeigen", group=grp_exec)
showZones        = input.bool(true, "Liquiditätszonen anzeigen", group=grp_exec)

// ============================================================================
// Autonome Interne Parameter (XRP 1m Optimized)
// ============================================================================
var string primaryTf        = "5"
var string confTf1          = "15"
var string confTf2          = "30"
var string confTf3          = "60"
var int maxZones            = 12
var int zoneMaxAgeBars      = 200
var float minZoneQuality    = 0.85
var float fvgAtrMin         = 0.25
var float obDisplacementAtr = 1.00
var int obSwingLen          = 3
var int obSearchBars        = 5

var int fastEmaLen          = 12
var int slowEmaLen          = 34
var int regressionLen       = 60
var int sweepLen            = 8

var float minSniperScore    = 58.0
var float minConfidence     = 0.50

// ============================================================================
// Types
// ============================================================================
type ChochFeature
    int   barIndex
    float volumeDelta
    float displacementZ
    float priceVelocity
    bool  isBullish
    float outcomeValue
    float favorableRun

type TargetRecord
    float price
    bool  isBull
    int   tier

type LiquidityZone
    string kind
    int direction
    float top
    float bottom
    float mid
    float quality
    int confluence
    int bornBar
    int bornTime
    int touches
    bool mitigated
    box boxId

var ChochFeature[] database       = array.new<ChochFeature>()
var TargetRecord[] outstandingTgts = array.new<TargetRecord>()

// ============================================================================
// Helpers
// ============================================================================
f_clamp(float value, float lo, float hi) =>
    math.max(lo, math.min(hi, value))

f_safeDiv(float numerator, float denominator, float fallback) =>
    denominator != 0.0 ? numerator / denominator : fallback

f_normSigned(float value, float scale) =>
    scale > 0.0 ? f_clamp(value / scale, -1.0, 1.0) : 0.0

f_fmt(float value) =>
    na(value) ? "na" : str.tostring(value, "#.####")

f_dirText(int direction) =>
    direction == 1 ? "bull" : direction == -1 ? "bear" : "neutral"

f_zoneColor(int direction, float quality) =>
    int alpha = quality >= 2.0 ? 78 : quality >= 1.35 ? 84 : 90
    direction == 1 ? color.new(color.lime, alpha) : color.new(color.red, alpha)

f_payload(string action, string direction, string reason, float quality, float cvmiValue, float kellyPct, float confidence) =>
    string uuid = str.length(pionexUuid) > 0 ? pionexUuid : "CIIF_LOCAL_REVIEW"
    string meta = "{\\\"reason\\\":\\\"" + reason + "\\\",\\\"quality\\\":\\\"" + f_fmt(quality) + "\\\",\\\"cvmi\\\":\\\"" + f_fmt(cvmiValue) + "\\\",\\\"kelly\\\":\\\"" + f_fmt(kellyPct) + "\\\",\\\"confidence\\\":\\\"" + f_fmt(confidence) + "\\\"}"
    "{\"data\":{\"action\":\"" + action + "\",\"contracts\":\"{strategy.order.contracts}\",\"position_size\":\"{strategy.position_size}\"},\"price\":\"{close}\",\"signal_param\":\"" + meta + "\",\"signal_type\":\"" + uuid + "\",\"symbol\":\"{ticker}\",\"time\":\"{timenow}\"}"

// ============================================================================
// Machine Learning SMC & CHoCH Engine
// ============================================================================
swingHigh = ta.pivothigh(high, swingLen, swingLen)
swingLow  = ta.pivotlow(low,  swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
var int   lastHighIndex = na
var int   lastLowIndex  = na

if not na(swingHigh)
    lastSwingHigh := swingHigh
    lastHighIndex := bar_index - swingLen

if not na(swingLow)
    lastSwingLow := swingLow
    lastLowIndex := bar_index - swingLen

float currentVolumeDelta = 0.0
if volume > 0
    float candleRange   = math.max(high - low, 1e-6)
    float buyingVolume  = volume * ((close - low)  / candleRange)
    float sellingVolume = volume * ((high - close) / candleRange)
    currentVolumeDelta := (buyingVolume - sellingVolume) / volume

float currentAtr = ta.atr(atrLen)

var int marketTrend = 0
bool isBullishChoch = false
bool isBearishChoch = false

if not na(lastSwingHigh) and marketTrend <= 0 and close > lastSwingHigh
    isBullishChoch := true
    marketTrend    := 1

if not na(lastSwingLow) and marketTrend >= 0 and close < lastSwingLow
    isBearishChoch := true
    marketTrend    := -1

float volDeltaFeature = 0.0
float displaceFeature = 0.0
float velocityFeature = 0.0

if isBullishChoch or isBearishChoch
    int calculationStartBar = isBullishChoch ? lastHighIndex : lastLowIndex
    int duration            = math.min(math.max(1, bar_index - calculationStartBar), 4990)
    int safeLookback        = math.min(duration, 50)
    
    float runningVolDelta = 0.0
    for i = 0 to safeLookback - 1
        runningVolDelta += currentVolumeDelta[i]
    volDeltaFeature := runningVolDelta / math.max(1, safeLookback)
    
    float totalMove = math.abs(close - open[duration])
    displaceFeature := currentAtr > 0 ? totalMove / currentAtr : 1.0
    velocityFeature := totalMove / duration

// KNN Calculation
float outputSignificanceScore = 0.0
int   totalMatchesFound       = 0
int   successfulOutcomes      = 0
float bullishProb             = 50.0
float bearishProb             = 50.0

var float tp1Price = 0.0   // mean (conservative)
var float tp2Price = 0.0   // median
var float tp3Price = 0.0   // 75th-pct aggressive

if isBullishChoch or isBearishChoch
    int dbSize = array.size(database)
    if dbSize > 0
        float[] matchedDistances = array.new<float>(0)
        int[]   matchedIndices   = array.new<int>(0)
        
        for i = 0 to dbSize - 1
            ChochFeature record = array.get(database, i)
            if bar_index - record.barIndex <= windowLen and record.isBullish == isBullishChoch
                float dVol      = math.pow(volDeltaFeature - record.volumeDelta,   2)
                float dDisplace = math.pow(displaceFeature - record.displacementZ, 2)
                float dVelocity = math.pow(velocityFeature - record.priceVelocity, 2)
                float distance  = math.sqrt(dVol + dDisplace + dVelocity)
                array.push(matchedDistances, distance)
                array.push(matchedIndices, i)
        
        if array.size(matchedDistances) > 0
            int nMatches = array.size(matchedDistances)
            int limitK   = math.min(kNeighbors, nMatches)
            bool[] used  = array.new<bool>(nMatches, false)
            int[] sortedIndices = array.new<int>(0)
            
            for _k = 0 to limitK - 1
                float minDist = 1e38
                int   minIdx  = 0
                for _s = 0 to nMatches - 1
                    if not array.get(used, _s)
                        float d = array.get(matchedDistances, _s)
                        if d < minDist
                            minDist := d
                            minIdx  := _s
                array.set(used, minIdx, true)
                array.push(sortedIndices, minIdx)
            
            float[] neighborRuns = array.new<float>(0)
            for k = 0 to limitK - 1
                int idxInMatched          = array.get(sortedIndices, k)
                int targetDbIdx           = array.get(matchedIndices, idxInMatched)
                ChochFeature targetRecord = array.get(database, targetDbIdx)
                totalMatchesFound += 1
                if targetRecord.outcomeValue > 0.0
                    successfulOutcomes += 1
                    array.push(neighborRuns, targetRecord.favorableRun)
            
            float totalK = limitK * 1.0
            if isBullishChoch
                bullishProb := (float(successfulOutcomes) / totalK) * 100.0
                bearishProb := 100.0 - bullishProb
            else
                bearishProb := (float(successfulOutcomes) / totalK) * 100.0
                bullishProb := 100.0 - bearishProb
            
            array.sort(neighborRuns)
            int nRuns = array.size(neighborRuns)
            
            float medRun = nRuns > 0 ? array.get(neighborRuns, int(nRuns / 2)) : 0.0
            
            float sumRuns = 0.0
            if nRuns > 0
                for r = 0 to nRuns - 1
                    sumRuns += array.get(neighborRuns, r)
            float meanRun = nRuns > 0 ? sumRuns / nRuns : 0.0
            
            int p75idx = nRuns > 1 ? int(math.round(nRuns * 0.75)) - 1 : 0
            p75idx    := math.min(p75idx, math.max(0, nRuns - 1))
            float aggrRun = nRuns > 0 ? array.get(neighborRuns, p75idx) : 0.0
            
            float dir = isBullishChoch ? 1.0 : -1.0
            tp1Price := close + dir * (meanRun * targetScalar)
            tp2Price := close + dir * medRun
            tp3Price := close + dir * aggrRun
            
            outputSignificanceScore := totalMatchesFound > 0 ? (float(successfulOutcomes) / float(totalMatchesFound)) * 100.0 : 50.0
    else
        outputSignificanceScore := 50.0

// KNN DB Training
if isBullishChoch[lookahead] or isBearishChoch[lookahead]
    bool  wasBullish      = isBullishChoch[lookahead]
    float initialRefPrice = close[lookahead]
    float maxFavorableRun = 0.0
    float maxAdverseRun   = 0.0
    
    for lookIdx = 1 to lookahead
        float highOffset = high[lookahead - lookIdx]
        float lowOffset  = low[lookahead - lookIdx]
        if wasBullish
            maxFavorableRun := math.max(maxFavorableRun, highOffset - initialRefPrice)
            maxAdverseRun   := math.max(maxAdverseRun,  initialRefPrice - lowOffset)
        else
            maxFavorableRun := math.max(maxFavorableRun, initialRefPrice - lowOffset)
            maxAdverseRun   := math.max(maxAdverseRun,  highOffset - initialRefPrice)
            
    ChochFeature historicalEvent = ChochFeature.new(
         barIndex      = bar_index[lookahead],
         volumeDelta   = volDeltaFeature[lookahead],
         displacementZ = displaceFeature[lookahead],
         priceVelocity = velocityFeature[lookahead],
         isBullish     = wasBullish,
         outcomeValue  = maxFavorableRun > maxAdverseRun ? 1.0 : -1.0,
         favorableRun  = maxFavorableRun
     )
    array.push(database, historicalEvent)
    if array.size(database) > 2000
        array.remove(database, 0)

// Target tracking
if array.size(outstandingTgts) > 0
    int i = array.size(outstandingTgts) - 1
    while i >= 0
        TargetRecord rec = array.get(outstandingTgts, i)
        bool hit = rec.isBull ? high >= rec.price : low <= rec.price
        if hit
            array.remove(outstandingTgts, i)
        i -= 1

// ============================================================================
// Multi-Timeframe CIIF Event Engines & Indicators
// ============================================================================
f_fvgEvent() =>
    float atr = ta.atr(10)
    float volMa = ta.sma(volume, 20)
    float volRatio = volMa > 0.0 ? volume / volMa : 1.0
    float candleRange = math.max(high - low, syminfo.mintick)
    float closeEfficiency = math.abs(close - open) / candleRange
    bool bull = low > high[2]
    bool bear = high < low[2]
    float top = bull ? low : bear ? low[2] : na
    float bottom = bull ? high[2] : bear ? high : na
    float width = not na(top) and not na(bottom) ? math.abs(top - bottom) : na
    float widthScore = not na(width) and atr > 0 ? width / atr : 0.0
    float quality = (widthScore + volRatio + closeEfficiency) / 3.0
    int dir = bull and widthScore >= fvgAtrMin ? 1 : bear and widthScore >= fvgAtrMin ? -1 : 0
    [time, dir, top, bottom, quality]

f_lastBearTop(int maxBack) =>
    float result = na
    for i = 1 to maxBack
        if na(result) and close[i] < open[i]
            result := open[i]
    result

f_lastBearBottom(int maxBack) =>
    float result = na
    for i = 1 to maxBack
        if na(result) and close[i] < open[i]
            result := low[i]
    result

f_lastBullTop(int maxBack) =>
    float result = na
    for i = 1 to maxBack
        if na(result) and close[i] > open[i]
            result := high[i]
    result

f_lastBullBottom(int maxBack) =>
    float result = na
    for i = 1 to maxBack
        if na(result) and close[i] > open[i]
            result := open[i]
    result

f_obAndStructureEvent() =>
    var float lastSwingHighC = na
    var float lastSwingLowC  = na
    var int htfBias = 0
    float ph = ta.pivothigh(high, obSwingLen, obSwingLen)
    float pl = ta.pivotlow(low, obSwingLen, obSwingLen)
    if not na(ph)
        lastSwingHighC := ph
    if not na(pl)
        lastSwingLowC := pl
    float atr = ta.atr(10)
    float body = math.abs(close - open)
    bool displacement = body >= atr * obDisplacementAtr
    bool bullBos = not na(lastSwingHighC) and close > lastSwingHighC and close[1] <= lastSwingHighC and displacement
    bool bearBos = not na(lastSwingLowC) and close < lastSwingLowC and close[1] >= lastSwingLowC and displacement
    int eventTime = na
    int eventDir = 0
    float eventTop = na
    float eventBottom = na
    if bullBos
        htfBias := 1
        eventTime := time
        eventDir := 1
        eventTop := f_lastBearTop(obSearchBars)
        eventBottom := f_lastBearBottom(obSearchBars)
    if bearBos
        htfBias := -1
        eventTime := time
        eventDir := -1
        eventTop := f_lastBullTop(obSearchBars)
        eventBottom := f_lastBullBottom(obSearchBars)
    [eventTime, eventDir, eventTop, eventBottom, lastSwingHighC, lastSwingLowC, htfBias]

f_cisdTrend() =>
    var float lastPh = na
    var float lastPl = na
    var int trend = 0
    float ph = ta.pivothigh(high, obSwingLen, obSwingLen)
    float pl = ta.pivotlow(low, obSwingLen, obSwingLen)
    if not na(ph)
        lastPh := ph
    if not na(pl)
        lastPl := pl
    if not na(lastPh) and close > lastPh
        trend := 1
    else if not na(lastPl) and close < lastPl
        trend := -1
    [trend, lastPh, lastPl]

[fvgT15, fvgD15, fvgTop15, fvgBot15, fvgQ15] = request.security(syminfo.tickerid, primaryTf, f_fvgEvent(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[fvgT1, fvgD1, fvgTop1, fvgBot1, fvgQ1]       = request.security(syminfo.tickerid, confTf1, f_fvgEvent(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[fvgT2, fvgD2, fvgTop2, fvgBot2, fvgQ2]       = request.security(syminfo.tickerid, confTf2, f_fvgEvent(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[fvgT3, fvgD3, fvgTop3, fvgBot3, fvgQ3]       = request.security(syminfo.tickerid, confTf3, f_fvgEvent(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

[obTime, obDir, obTop, obBot, htfSwingHigh, htfSwingLow, htfBias] = request.security(syminfo.tickerid, primaryTf, f_obAndStructureEvent(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[htfCisdTrend, htfCisdHigh, htfCisdLow]                          = request.security(syminfo.tickerid, primaryTf, f_cisdTrend(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Base Series
float atrValue = ta.atr(atrLen)
float fastEma  = ta.ema(close, fastEmaLen)
float slowEma  = ta.ema(close, slowEmaLen)
[plusDI, minusDI, adxValue] = ta.dmi(10, 10)
float volMa = ta.sma(volume, 20)
float relVolume = volMa > 0.0 ? volume / volMa : 1.0
float candleRange = math.max(high - low, syminfo.mintick)
float closeEfficiency = math.abs(close - open) / candleRange

float linregNow = ta.linreg(hl2, regressionLen, 0)
float linregPrev = ta.linreg(hl2, regressionLen, 1)
float regressionSlope = linregNow - linregPrev
float regressionDev = ta.stdev(hl2, regressionLen)
bool contraction = math.abs(regressionSlope) * regressionLen < regressionDev * 0.65
bool chopRegime = adxValue < 16 and contraction

float rangeHigh = htfSwingHigh
float rangeLow = htfSwingLow
bool validDealingRange = not na(rangeHigh) and not na(rangeLow) and rangeHigh > rangeLow
float equilibrium = validDealingRange ? (rangeHigh + rangeLow) * 0.5 : na
bool inDiscount = validDealingRange and close <= equilibrium
bool inPremium = validDealingRange and close >= equilibrium

bool bullSweep = low < ta.lowest(low[1], sweepLen) and close > open and close > low + (high - low) * 0.60
bool bearSweep = high > ta.highest(high[1], sweepLen) and close < open and close < high - (high - low) * 0.60

// Liquidity Matrix
var array<LiquidityZone> zones = array.new<LiquidityZone>()
var int lastFvgT15 = na
var int lastFvgT1 = na
var int lastFvgT2 = na
var int lastFvgT3 = na
var int lastObTime = na

f_zoneConfluence(int dir, float top, float bottom) =>
    int count = 1
    float mid = (top + bottom) * 0.5
    float tol = atrValue * 5.0
    bool c1 = fvgD1 == dir and not na(fvgTop1) and math.abs(mid - (fvgTop1 + fvgBot1) * 0.5) <= tol
    bool c2 = fvgD2 == dir and not na(fvgTop2) and math.abs(mid - (fvgTop2 + fvgBot2) * 0.5) <= tol
    bool c3 = fvgD3 == dir and not na(fvgTop3) and math.abs(mid - (fvgTop3 + fvgBot3) * 0.5) <= tol
    count += c1 ? 1 : 0
    count += c2 ? 1 : 0
    count += c3 ? 1 : 0
    count

f_addZone(string kind, int dir, float topRaw, float botRaw, float baseQuality, int confluence, int bornTime) =>
    float top = math.max(topRaw, botRaw)
    float bottom = math.min(topRaw, botRaw)
    if dir != 0 and not na(top) and not na(bottom) and top > bottom
        float width = top - bottom
        float widthScore = f_safeDiv(width, atrValue, 0.0)
        float freshness = 1.0
        float quality = (baseQuality + widthScore + relVolume + closeEfficiency + confluence * 0.35 + freshness) / 5.0
        if quality >= minZoneQuality
            box b = na
            if showZones
                b := box.new(left=bar_index, top=top, right=bar_index + 1, bottom=bottom, bgcolor=f_zoneColor(dir, quality), border_color=color.new(dir == 1 ? color.lime : color.red, 35))
            zones.unshift(LiquidityZone.new(kind, dir, top, bottom, (top + bottom) * 0.5, quality, confluence, bar_index, bornTime, 0, false, b))
            while zones.size() > maxZones
                LiquidityZone old = zones.pop()
                if not na(old.boxId)
                    box.delete(old.boxId)

f_isMitigated(LiquidityZone z) =>
    z.direction == 1 ? low <= z.top : z.direction == -1 ? high >= z.bottom : false

if fvgD15 != 0 and fvgT15 != lastFvgT15
    int conf = f_zoneConfluence(fvgD15, fvgTop15, fvgBot15)
    f_addZone("FVG", fvgD15, fvgTop15, fvgBot15, fvgQ15, conf, fvgT15)
    lastFvgT15 := fvgT15

if obDir != 0 and obTime != lastObTime
    f_addZone("OB", obDir, obTop, obBot, 1.10, 1, obTime)
    lastObTime := obTime

float phLocal = ta.pivothigh(high, obSwingLen, obSwingLen)
float plLocal = ta.pivotlow(low, obSwingLen, obSwingLen)
if not na(phLocal)
    f_addZone("SR", -1, high[obSwingLen], math.max(open[obSwingLen], close[obSwingLen]), 0.95, 1, time[obSwingLen])
if not na(plLocal)
    f_addZone("SR", 1, math.min(open[obSwingLen], close[obSwingLen]), low[obSwingLen], 0.95, 1, time[obSwingLen])

bool touchedBullZone = false
bool touchedBearZone = false
float bestBullQuality = 0.0
float bestBearQuality = 0.0
string bestBullKind = "none"
string bestBearKind = "none"
float cvmiRaw = 0.0

if zones.size() > 0
    for i = zones.size() - 1 to 0
        LiquidityZone z = zones.get(i)
        
        bool touched = low <= z.top and high >= z.bottom
        if touched
            z.touches += 1
            if z.direction == 1
                touchedBullZone := true
                if z.quality > bestBullQuality
                    bestBullQuality := z.quality
                    bestBullKind := z.kind
            if z.direction == -1
                touchedBearZone := true
                if z.quality > bestBearQuality
                    bestBearQuality := z.quality
                    bestBearKind := z.kind

        float widthAtr = f_safeDiv(z.top - z.bottom, atrValue, 0.0)
        cvmiRaw += z.direction * widthAtr * z.quality

        bool expired = bar_index - z.bornBar > zoneMaxAgeBars
        bool mitigatedNow = f_isMitigated(z)

        if expired or mitigatedNow
            if not na(z.boxId)
                box.delete(z.boxId)
            zones.remove(i)
        else if touched and not na(z.boxId)
            box.set_right(z.boxId, bar_index + 1)
            box.set_bgcolor(z.boxId, f_zoneColor(z.direction, z.quality))

float cvmi = f_clamp(cvmiRaw / math.max(1.0, zones.size()), -5.0, 5.0)

// ============================================================================
// Hybrid Signal Engine (CIIF Quant + ML SMC CHoCH)
// ============================================================================
float trendFeature    = f_normSigned(fastEma - slowEma, atrValue * 2.0)
float slopeFeature    = f_normSigned(regressionSlope, atrValue * 0.15)
float momentumFeature = f_normSigned(close - close[5], atrValue * 2.0)
float volumeFeature   = f_clamp((relVolume - 1.0) / 2.0, -1.0, 1.0)
float cisdFeature     = htfCisdTrend == 1 ? 1.0 : htfCisdTrend == -1 ? -1.0 : 0.0
float pdFeature       = inDiscount ? 0.45 : inPremium ? -0.45 : 0.0
float sweepFeature    = bullSweep ? 0.60 : bearSweep ? -0.60 : 0.0
float zoneFeature     = touchedBullZone ? 0.85 : touchedBearZone ? -0.85 : 0.0
float cvmiFeature     = f_clamp(cvmi / 2.0, -1.0, 1.0)

float quantumScore = 
     trendFeature    * 0.14 +
     slopeFeature    * 0.10 +
     momentumFeature * 0.12 +
     volumeFeature   * 0.08 +
     cisdFeature     * 0.17 +
     pdFeature       * 0.09 +
     sweepFeature    * 0.08 +
     zoneFeature     * 0.14 +
     cvmiFeature     * 0.08

float confidence = f_clamp(0.50 + math.abs(quantumScore) * 0.42 + math.max(adxValue - 18.0, 0.0) / 140.0 + math.min(math.max(bestBullQuality, bestBearQuality), 3.0) / 40.0, 0.0, 1.0)

bool bullMajorTrigger = ta.crossover(fastEma, slowEma) or bullSweep or (touchedBullZone and not touchedBullZone[1]) or isBullishChoch
bool bearMajorTrigger = ta.crossunder(fastEma, slowEma) or bearSweep or (touchedBearZone and not touchedBearZone[1]) or isBearishChoch

float longScore  = f_clamp(50.0 + quantumScore * 50.0 + (bullMajorTrigger ? 8.0 : 0.0), 0.0, 100.0)
float shortScore = f_clamp(50.0 - quantumScore * 50.0 + (bearMajorTrigger ? 8.0 : 0.0), 0.0, 100.0)

bool confirmedOK   = barstate.isconfirmed
bool cisdLongOK    = htfCisdTrend == 1
bool cisdShortOK   = htfCisdTrend == -1
bool regimeOK      = not chopRegime

bool longConditionRaw  = enableLongs and confirmedOK and regimeOK and cisdLongOK and longScore >= minSniperScore and confidence >= minConfidence and bullMajorTrigger
bool shortConditionRaw = enableShorts and confirmedOK and regimeOK and cisdShortOK and shortScore >= minSniperScore and confidence >= minConfidence and bearMajorTrigger

var int lastSignalBar = na
bool signalCooldownOK = na(lastSignalBar) or (bar_index - lastSignalBar >= minBarsBetween)

bool longSignal  = longConditionRaw and not longConditionRaw[1] and signalCooldownOK
bool shortSignal = shortConditionRaw and not shortConditionRaw[1] and signalCooldownOK

if longSignal or shortSignal
    lastSignalBar := bar_index

string signalReason = longSignal ? str.format("ML_Long_{0}_q{1}", bestBullKind, f_fmt(bestBullQuality)) : shortSignal ? str.format("ML_Short_{0}_q{1}", bestBearKind, f_fmt(bestBearQuality)) : "wait"

// ============================================================================
// Single Order Execution Engine (EXACT KNN TP TARGET MATCHING - NO STACKING)
// ============================================================================
int currentDir     = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
bool flatConfirmed = strategy.position_size == 0 and strategy.opentrades == 0

bool positionInProfit = currentDir == 1 ? (close > strategy.position_avg_price) : currentDir == -1 ? (close < strategy.position_avg_price) : false
bool positionInLoss   = currentDir == 1 ? (close < strategy.position_avg_price) : currentDir == -1 ? (close > strategy.position_avg_price) : false

float totalQty = math.max(0.001, strategy.equity * riskPctPerTrade / 100.0 / close)
float activeQuality = longSignal ? bestBullQuality : shortSignal ? bestBearQuality : math.max(bestBullQuality, bestBearQuality)

var int lastExecBar = na
bool canExecuteBar = na(lastExecBar) or bar_index > lastExecBar
var string lastAction = "idle"

// Persistent TP & SL target prices locked AT ENTRY to match KNN boxes
var float tradeTpPrice = na
var float tradeSlPrice = na

if confirmedOK and canExecuteBar
    // 1. INITIAL ENTRY (Lock exact KNN TP Box Level on Entry)
    if flatConfirmed
        if longSignal
            tradeTpPrice := tp2Price > close ? tp2Price : (close + atrValue * tpAtrMult)
            tradeSlPrice := close - atrValue * slAtrMult
            
            strategy.entry("Long", strategy.long, qty=totalQty, comment="ML Long", alert_message=f_payload("buy", "long", signalReason, activeQuality, cvmi, riskPctPerTrade, confidence))
            strategy.exit("Exit Long", from_entry="Long", limit=tradeTpPrice, stop=tradeSlPrice, comment_profit="TP Long", comment_loss="SL Long", alert_profit=f_payload("close", "long", "take_profit", activeQuality, cvmi, riskPctPerTrade, confidence), alert_loss=f_payload("close", "long", "stop_loss", activeQuality, cvmi, riskPctPerTrade, confidence))
            
            lastAction  := "initial_long_single"
            lastExecBar := bar_index

        else if shortSignal
            tradeTpPrice := (tp2Price > 0 and tp2Price < close) ? tp2Price : (close - atrValue * tpAtrMult)
            tradeSlPrice := close + atrValue * slAtrMult
            
            strategy.entry("Short", strategy.short, qty=totalQty, comment="ML Short", alert_message=f_payload("sell", "short", signalReason, activeQuality, cvmi, riskPctPerTrade, confidence))
            strategy.exit("Exit Short", from_entry="Short", limit=tradeTpPrice, stop=tradeSlPrice, comment_profit="TP Short", comment_loss="SL Short", alert_profit=f_payload("close", "short", "take_profit", activeQuality, cvmi, riskPctPerTrade, confidence), alert_loss=f_payload("close", "short", "stop_loss", activeQuality, cvmi, riskPctPerTrade, confidence))
            
            lastAction  := "initial_short_single"
            lastExecBar := bar_index

    // 2. QUICK-FLIP (Instant Position Reverse on Gegensignal in Loss)
    else if enableQuickFlip and positionInLoss and (currentDir == 1 and shortSignal or currentDir == -1 and longSignal)
        if currentDir == 1
            tradeTpPrice := (tp2Price > 0 and tp2Price < close) ? tp2Price : (close - atrValue * tpAtrMult)
            tradeSlPrice := close + atrValue * slAtrMult
            
            strategy.close_all(comment="Quick Flip Long->Short", alert_message=f_payload("close", "long", "quick_flip", activeQuality, cvmi, riskPctPerTrade, confidence))
            strategy.entry("Short", strategy.short, qty=totalQty, comment="Flip Short", alert_message=f_payload("sell", "short", "quick_flip_short", activeQuality, cvmi, riskPctPerTrade, confidence))
            strategy.exit("Exit Short", from_entry="Short", limit=tradeTpPrice, stop=tradeSlPrice, comment_profit="TP Short", comment_loss="SL Short", alert_profit=f_payload("close", "short", "take_profit", activeQuality, cvmi, riskPctPerTrade, confidence), alert_loss=f_payload("close", "short", "stop_loss", activeQuality, cvmi, riskPctPerTrade, confidence))
            
            lastAction  := "QUICK_FLIP_TO_SHORT"
            lastExecBar := bar_index
        else
            tradeTpPrice := tp2Price > close ? tp2Price : (close + atrValue * tpAtrMult)
            tradeSlPrice := close - atrValue * slAtrMult
            
            strategy.close_all(comment="Quick Flip Short->Long", alert_message=f_payload("close", "short", "quick_flip", activeQuality, cvmi, riskPctPerTrade, confidence))
            strategy.entry("Long", strategy.long, qty=totalQty, comment="Flip Long", alert_message=f_payload("buy", "long", "quick_flip_long", activeQuality, cvmi, riskPctPerTrade, confidence))
            strategy.exit("Exit Long", from_entry="Long", limit=tradeTpPrice, stop=tradeSlPrice, comment_profit="TP Long", comment_loss="SL Long", alert_profit=f_payload("close", "long", "take_profit", activeQuality, cvmi, riskPctPerTrade, confidence), alert_loss=f_payload("close", "long", "stop_loss", activeQuality, cvmi, riskPctPerTrade, confidence))
            
            lastAction  := "QUICK_FLIP_TO_LONG"
            lastExecBar := bar_index

// ============================================================================
// ML SMC Visuals & Graphics
// ============================================================================
bullLineClr = color.new(color.rgb(140, 200, 255), 25)
bearLineClr = color.new(color.rgb(255, 140, 160), 25)
levelClr    = color.new(color.rgb(160, 155, 185), 65)

neonBullG1 = color.new(color.rgb(180, 220, 255),  90)
neonBullG2 = color.new(color.rgb(180, 220, 255),  78)
neonBullG3 = color.new(color.rgb(210, 235, 255),  55)
neonBullG4 = color.new(color.rgb(240, 248, 255),   0)

neonBearG1 = color.new(color.rgb(255, 160, 180),  90)
neonBearG2 = color.new(color.rgb(255, 160, 180),  78)
neonBearG3 = color.new(color.rgb(255, 195, 205),  55)
neonBearG4 = color.new(color.rgb(255, 230, 235),   0)

fillBullClr = color.new(color.rgb(140, 200, 255), fillTransp)
fillBearClr = color.new(color.rgb(255, 140, 160), fillTransp)

var line activeHighLevel = na
var line activeLowLevel  = na

if not na(swingHigh) and showBrokenLevel
    if not na(activeHighLevel)
        line.delete(activeHighLevel)
    int extRight = extendLines ? bar_index + lookahead * 2 : bar_index + lookahead
    activeHighLevel := line.new(lastHighIndex, lastSwingHigh, extRight, lastSwingHigh, color=levelClr, width=1, style=line.style_dashed)

if not na(swingLow) and showBrokenLevel
    if not na(activeLowLevel)
        line.delete(activeLowLevel)
    int extRight = extendLines ? bar_index + lookahead * 2 : bar_index + lookahead
    activeLowLevel := line.new(lastLowIndex, lastSwingLow, extRight, lastSwingLow, color=levelClr, width=1, style=line.style_dashed)

if isBullishChoch
    if not na(activeHighLevel)
        line.set_x2(activeHighLevel, bar_index)
        activeHighLevel := na
    
    if showSwingLines and not na(lastHighIndex) and not na(lastSwingHigh)
        line.new(lastHighIndex, lastSwingHigh, bar_index, close, color=bullLineClr, width=2, style=line.style_solid)
        
    if showWickTrace and not na(lastHighIndex)
        int traceLen = math.min(bar_index - lastHighIndex, 300)
        if traceLen > 1
            float baseline = lastSwingHigh
            for i = traceLen - 1 to 1
                int   x1 = bar_index - i
                int   x2 = bar_index - i + 1
                float y1 = low[i]
                float y2 = low[i - 1]
                line.new(x1, y1, x2, y2, color=neonBullG1, width=7)
                line.new(x1, y1, x2, y2, color=neonBullG2, width=4)
                line.new(x1, y1, x2, y2, color=neonBullG3, width=2)
                line.new(x1, y1, x2, y2, color=neonBullG4, width=1)
                if showFill
                    line wickSeg = line.new(x1, y1, x2, y2, color=color.new(color.green, 100), width=1)
                    line baseSeg = line.new(x1, baseline, x2, baseline, color=color.new(color.green, 100), width=1)
                    linefill.new(wickSeg, baseSeg, fillBullClr)

    if showPriceTarget and tp1Price > 0 and tp3Price > 0
        float boxTop    = tp3Price
        float boxBottom = tp1Price
        int   boxExtBars = manualBoxExt ? manualExtBars : targetExtBars
        int   rightBar  = bar_index + boxExtBars
        
        box.new(bar_index, boxTop, rightBar, boxBottom,
             bgcolor      = color.new(color.rgb(140, 200, 255), 93),
             border_color = color.new(color.rgb(140, 200, 255), 30),
             border_width = 1)
             
        if tp2Price > 0
            line.new(bar_index, tp2Price, rightBar, tp2Price, color = color.new(color.rgb(180, 225, 255), 55), width = 1, style = line.style_dotted)
            
        if showTpLabels
            int labelX = bar_index + int(boxExtBars / 2)
            label.new(labelX, boxBottom, "TP1", color=color.new(color.black, 100), style=label.style_none, textcolor=tp1Clr, size=size.tiny)
            if tp2Price > 0
                label.new(labelX, tp2Price, "TP2", color=color.new(color.black, 100), style=label.style_none, textcolor=tp2Clr, size=size.tiny)
            label.new(labelX, boxTop, "TP3", color=color.new(color.black, 100), style=label.style_none, textcolor=tp3Clr, size=size.tiny)
            
        array.push(outstandingTgts, TargetRecord.new(price=tp1Price, isBull=true, tier=1))
        if tp2Price > 0 and tp2Price != tp1Price
            array.push(outstandingTgts, TargetRecord.new(price=tp2Price, isBull=true, tier=2))
        if tp3Price > 0 and tp3Price != tp2Price
            array.push(outstandingTgts, TargetRecord.new(price=tp3Price, isBull=true, tier=3))

    if showBrokenLevel
        line.new(bar_index, lastSwingHigh, bar_index, close, color=color.new(hiProbClr, 40), width=1, style=line.style_dotted)

if isBearishChoch
    if not na(activeLowLevel)
        line.set_x2(activeLowLevel, bar_index)
        activeLowLevel := na
        
    if showSwingLines and not na(lastLowIndex) and not na(lastSwingLow)
        line.new(lastLowIndex, lastSwingLow, bar_index, close, color=bearLineClr, width=2, style=line.style_solid)
        
    if showWickTrace and not na(lastLowIndex)
        int traceLen = math.min(bar_index - lastLowIndex, 300)
        if traceLen > 1
            float baseline = lastSwingLow
            for i = traceLen - 1 to 1
                int   x1 = bar_index - i
                int   x2 = bar_index - i + 1
                float y1 = high[i]
                float y2 = high[i - 1]
                line.new(x1, y1, x2, y2, color=neonBearG1, width=7)
                line.new(x1, y1, x2, y2, color=neonBearG2, width=4)
                line.new(x1, y1, x2, y2, color=neonBearG3, width=2)
                line.new(x1, y1, x2, y2, color=neonBearG4, width=1)
                if showFill
                    line wickSeg = line.new(x1, y1, x2, y2, color=color.new(color.red, 100), width=1)
                    line baseSeg = line.new(x1, baseline, x2, baseline, color=color.new(color.red, 100), width=1)
                    linefill.new(wickSeg, baseSeg, fillBearClr)

    if showPriceTarget and tp1Price > 0 and tp3Price > 0
        float boxTop    = tp1Price
        float boxBottom = tp3Price
        int   boxExtBars = manualBoxExt ? manualExtBars : targetExtBars
        int   rightBar  = bar_index + boxExtBars
        
        box.new(bar_index, boxTop, rightBar, boxBottom,
             bgcolor      = color.new(color.rgb(255, 140, 160), 93),
             border_color = color.new(color.rgb(255, 140, 160), 30),
             border_width = 1)
             
        if tp2Price > 0
            line.new(bar_index, tp2Price, rightBar, tp2Price, color = color.new(color.rgb(255, 185, 200), 55), width = 1, style = line.style_dotted)
            
        if showTpLabels
            int labelXBear = bar_index + int(boxExtBars / 2)
            label.new(labelXBear, boxTop, "TP1", color=color.new(color.black, 100), style=label.style_none, textcolor=tp1Clr, size=size.tiny)
            if tp2Price > 0
                label.new(labelXBear, tp2Price, "TP2", color=color.new(color.black, 100), style=label.style_none, textcolor=tp2Clr, size=size.tiny)
            label.new(labelXBear, boxBottom, "TP3", color=color.new(color.black, 100), style=label.style_none, textcolor=tp3Clr, size=size.tiny)
            
        array.push(outstandingTgts, TargetRecord.new(price=tp1Price, isBull=false, tier=1))
        if tp2Price > 0 and tp2Price != tp1Price
            array.push(outstandingTgts, TargetRecord.new(price=tp2Price, isBull=false, tier=2))
        if tp3Price > 0 and tp3Price != tp2Price
            array.push(outstandingTgts, TargetRecord.new(price=tp3Price, isBull=false, tier=3))

    if showBrokenLevel
        line.new(bar_index, lastSwingLow, bar_index, close, color=color.new(medProbClr, 40), width=1, style=line.style_dotted)

// Badges & Labels
bool chochFired = isBullishChoch or isBearishChoch
if chochFired
    bool   hasScore    = outputSignificanceScore >= minScore
    bool   hasKnnData  = totalMatchesFound > 0
    color  layoutColor = hasScore ? (outputSignificanceScore >= 80 ? hiProbClr : medProbClr) : color.new(color.rgb(140, 135, 165), 0)
    float  dirProb     = isBullishChoch ? bullishProb : bearishProb
    string confStar    = dirProb >= 85.0 ? " ★" : ""
    string dirArrow    = isBullishChoch ? "▲" : "▼"
    
    string scoreTxt = hasKnnData ? dirArrow + " " + str.tostring(math.round(dirProb), "#") + "%" + confStar : dirArrow + " CHoCH"
    float  badgeY   = isBullishChoch ? low  - currentAtr * 1 : high + currentAtr * 1
    
    label.new(bar_index, badgeY, text=scoreTxt, color=color.new(color.black, 100), style=label.style_none, textcolor=color.new(layoutColor, 0), size=size.normal)
    label.new(bar_index, isBullishChoch ? low - currentAtr * 0.5 : high + currentAtr * 0.5, text=isBullishChoch ? "+CHoCH" : "-CHoCH", color=color.new(color.black, 100), style=label.style_none, textcolor=color.new(layoutColor, 15), size=size.normal)

// ============================================================================
// Combined Side Panel Dashboard Table
// ============================================================================
var table sidePanel = table.new(position.middle_right, 2, 11, bgcolor=color.new(bgTableClr, 12), border_color=color.new(color.white, 100), border_width=0, frame_color=color.new(color.white, 100), frame_width=0)

if showDashboard and barstate.islast
    float sumBullTgts = 0.0
    int   cntBullTgts = 0
    float sumBearTgts = 0.0
    int   cntBearTgts = 0
    
    if array.size(outstandingTgts) > 0
        for j = 0 to array.size(outstandingTgts) - 1
            TargetRecord r = array.get(outstandingTgts, j)
            if r.isBull
                sumBullTgts += r.price
                cntBullTgts += 1
            else
                sumBearTgts += r.price
                cntBearTgts += 1
            
    float meanHighTarget = cntBullTgts > 0 ? sumBullTgts / cntBullTgts : na
    float meanLowTarget  = cntBearTgts > 0 ? sumBearTgts / cntBearTgts : na
    color accentClr = marketTrend > 0 ? color.rgb(80, 255, 120) : marketTrend < 0 ? color.rgb(255, 80, 100) : color.gray

    table.cell(sidePanel, 0, 0, "ML SMC CIIF", bgcolor=color.new(color.rgb(30, 22, 55), 0), text_color=color.new(color.rgb(200, 190, 230), 0), text_size=size.small, text_halign=text.align_left)
    table.cell(sidePanel, 1, 0, "XRP 1m", bgcolor=color.new(color.rgb(30, 22, 55), 0), text_color=color.new(color.rgb(160, 130, 255), 0), text_size=size.small, text_halign=text.align_right)

    string biasText = marketTrend > 0 ? "▲ BULLISH" : marketTrend < 0 ? "▼ BEARISH" : "— NEUTRAL"
    table.cell(sidePanel, 0, 1, "Market Bias", text_color=color.new(txtTable, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(sidePanel, 1, 1, biasText, text_color=accentClr, text_size=size.small, text_halign=text.align_right)

    string scoreDisp = outputSignificanceScore >= minScore ? str.tostring(outputSignificanceScore, "#.0") + "%" : "—"
    color  scoreClr  = outputSignificanceScore >= 80 ? color.rgb(160, 130, 255) : outputSignificanceScore >= 60 ? color.rgb(200, 180, 255) : color.rgb(120, 115, 145)
    table.cell(sidePanel, 0, 2, "ML Score", text_color=color.new(txtTable, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(sidePanel, 1, 2, scoreDisp, text_color=scoreClr, text_size=size.small, text_halign=text.align_right)

    table.cell(sidePanel, 0, 3, "─── EXECUTION ───", text_color=color.new(txtTable, 55), text_size=size.tiny, text_halign=text.align_left)
    table.cell(sidePanel, 1, 3, "Single Order", text_color=color.new(txtTable, 55), text_size=size.tiny, text_halign=text.align_right)

    table.cell(sidePanel, 0, 4, "Position", text_color=color.new(txtTable, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(sidePanel, 1, 4, currentDir == 1 ? "LONG" : currentDir == -1 ? "SHORT" : "FLAT", text_color=currentDir == 1 ? color.lime : currentDir == -1 ? color.red : color.gray, text_size=size.small, text_halign=text.align_right)

    table.cell(sidePanel, 0, 5, "Status", text_color=color.new(txtTable, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(sidePanel, 1, 5, positionInProfit ? "PROFIT" : positionInLoss ? "LOSS" : "FLAT", text_color=positionInProfit ? color.lime : positionInLoss ? color.orange : color.gray, text_size=size.small, text_halign=text.align_right)

    table.cell(sidePanel, 0, 6, "─── TARGETS ───", text_color=color.new(txtTable, 55), text_size=size.tiny, text_halign=text.align_left)
    table.cell(sidePanel, 1, 6, "KNN TP2 Match", text_color=color.new(txtTable, 55), text_size=size.tiny, text_halign=text.align_right)

    string highTgtStr = not na(meanHighTarget) ? str.tostring(meanHighTarget, "#.00") : "—"
    table.cell(sidePanel, 0, 7, "Mean High Tgt", text_color=color.new(color.rgb(140, 200, 255), 0), text_size=size.small, text_halign=text.align_left)
    table.cell(sidePanel, 1, 7, highTgtStr, text_color=color.new(color.rgb(140, 200, 255), 0), text_size=size.small, text_halign=text.align_right)

    string lowTgtStr = not na(meanLowTarget) ? str.tostring(meanLowTarget, "#.00") : "—"
    table.cell(sidePanel, 0, 8, "Mean Low Tgt", text_color=color.new(color.rgb(255, 140, 160), 0), text_size=size.small, text_halign=text.align_left)
    table.cell(sidePanel, 1, 8, lowTgtStr, text_color=color.new(color.rgb(255, 140, 160), 0), text_size=size.small, text_halign=text.align_right)

    table.cell(sidePanel, 0, 9, "DB Records", text_color=color.new(txtTable, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(sidePanel, 1, 9, str.tostring(array.size(database)), text_color=color.new(color.rgb(160, 130, 255), 0), text_size=size.small, text_halign=text.align_right)

    table.cell(sidePanel, 0, 10, "Aktion", text_color=color.new(txtTable, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(sidePanel, 1, 10, lastAction, text_color=color.new(color.rgb(200, 190, 230), 0), text_size=size.tiny, text_halign=text.align_right)