// @version=6
// ATR GOD Strategy by TradeSmart – Indikator-Konvertierung
// Keine Order-Ausführung: Signale, virtuelle Position, SL/TP und Alerts werden nur visualisiert.
indicator(title="ATR GOD Indicator by TradeSmart", overlay=true, precision=8, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// PLOT SETTINGS
// ─────────────────────────────────────────────────────────────────────────────
plot_signals = input.bool(true, title="Plot Signals", group="Plot Settings")
plot_sl_tp = input.bool(true, title="Plot SL/TP Lines", group="Plot Settings")

// ─────────────────────────────────────────────────────────────────────────────
// SUPERTREND 1
// ─────────────────────────────────────────────────────────────────────────────
plot_st_1 = input.bool(false, title="Plot Supertrend 1", group="Supertrend 1")
can_be_entry_signal_st_1 = input.bool(true, title="Supertrend 1 can be entry signal", group="Supertrend 1")
long_trend_st_1 = input.string("uptrend", options=["uptrend", "downtrend", "unspecified"], title="Long: Supertrend 1 has to be in", group="Supertrend 1")
short_trend_st_1 = input.string("downtrend", options=["uptrend", "downtrend", "unspecified"], title="Short: Supertrend 1 has to be in", group="Supertrend 1")
per_st_1 = input.int(20, title="ATR Period 1", minval=1, group="Supertrend 1")
src_st_1 = input.source(hl2, title="Source 1", group="Supertrend 1")
mult_st_1 = input.float(2.0, title="ATR Multiplier 1", minval=0.1, step=0.1, group="Supertrend 1")

atr_st_1 = ta.atr(per_st_1)
float up_st_1 = src_st_1 - mult_st_1 * atr_st_1
up1_st_1 = nz(up_st_1[1], up_st_1)
up_st_1 := close[1] > up1_st_1 ? math.max(up_st_1, up1_st_1) : up_st_1
float dn_st_1 = src_st_1 + mult_st_1 * atr_st_1
dn1_st_1 = nz(dn_st_1[1], dn_st_1)
dn_st_1 := close[1] < dn1_st_1 ? math.min(dn_st_1, dn1_st_1) : dn_st_1
int trend_st_1 = 1
trend_st_1 := nz(trend_st_1[1], trend_st_1)
trend_st_1 := trend_st_1 == -1 and close > dn1_st_1 ? 1 : trend_st_1 == 1 and close < up1_st_1 ? -1 : trend_st_1
buySignal_st_1 = trend_st_1 == 1 and trend_st_1[1] == -1
sellSignal_st_1 = trend_st_1 == -1 and trend_st_1[1] == 1

// Supertrend 1 wird für die Logik berechnet, aber nicht einzeln geplottet.

// ─────────────────────────────────────────────────────────────────────────────
// SUPERTREND 2
// ─────────────────────────────────────────────────────────────────────────────
plot_st_2 = input.bool(false, title="Plot Supertrend 2", group="Supertrend 2")
can_be_entry_signal_st_2 = input.bool(false, title="Supertrend 2 can be entry signal", group="Supertrend 2")
long_trend_st_2 = input.string("uptrend", options=["uptrend", "downtrend", "unspecified"], title="Long: Supertrend 2 has to be in", group="Supertrend 2")
short_trend_st_2 = input.string("downtrend", options=["uptrend", "downtrend", "unspecified"], title="Short: Supertrend 2 has to be in", group="Supertrend 2")
per_st_2 = input.int(5, title="ATR Period 2", minval=1, group="Supertrend 2")
src_st_2 = input.source(hlcc4, title="Source 2", group="Supertrend 2")
mult_st_2 = input.float(15.0, title="ATR Multiplier 2", minval=0.1, step=0.1, group="Supertrend 2")

atr_st_2 = ta.atr(per_st_2)
float up_st_2 = src_st_2 - mult_st_2 * atr_st_2
up1_st_2 = nz(up_st_2[1], up_st_2)
up_st_2 := close[1] > up1_st_2 ? math.max(up_st_2, up1_st_2) : up_st_2
float dn_st_2 = src_st_2 + mult_st_2 * atr_st_2
dn1_st_2 = nz(dn_st_2[1], dn_st_2)
dn_st_2 := close[1] < dn1_st_2 ? math.min(dn_st_2, dn1_st_2) : dn_st_2
int trend_st_2 = 1
trend_st_2 := nz(trend_st_2[1], trend_st_2)
trend_st_2 := trend_st_2 == -1 and close > dn1_st_2 ? 1 : trend_st_2 == 1 and close < up1_st_2 ? -1 : trend_st_2
buySignal_st_2 = trend_st_2 == 1 and trend_st_2[1] == -1
sellSignal_st_2 = trend_st_2 == -1 and trend_st_2[1] == 1

// Supertrend 2 wird für die Logik berechnet, aber nicht einzeln geplottet.

// ─────────────────────────────────────────────────────────────────────────────
// SUPERTREND 3
// ─────────────────────────────────────────────────────────────────────────────
plot_st_3 = input.bool(false, title="Plot Supertrend 3", group="Supertrend 3")
can_be_entry_signal_st_3 = input.bool(true, title="Supertrend 3 can be entry signal", group="Supertrend 3")
long_trend_st_3 = input.string("uptrend", options=["uptrend", "downtrend", "unspecified"], title="Long: Supertrend 3 has to be in", group="Supertrend 3")
short_trend_st_3 = input.string("downtrend", options=["uptrend", "downtrend", "unspecified"], title="Short: Supertrend 3 has to be in", group="Supertrend 3")
per_st_3 = input.int(10, title="ATR Period 3", minval=1, group="Supertrend 3")
src_st_3 = input.source(hl2, title="Source 3", group="Supertrend 3")
mult_st_3 = input.float(3.0, title="ATR Multiplier 3", minval=0.1, step=0.1, group="Supertrend 3")

atr_st_3 = ta.atr(per_st_3)
float up_st_3 = src_st_3 - mult_st_3 * atr_st_3
up1_st_3 = nz(up_st_3[1], up_st_3)
up_st_3 := close[1] > up1_st_3 ? math.max(up_st_3, up1_st_3) : up_st_3
float dn_st_3 = src_st_3 + mult_st_3 * atr_st_3
dn1_st_3 = nz(dn_st_3[1], dn_st_3)
dn_st_3 := close[1] < dn1_st_3 ? math.min(dn_st_3, dn1_st_3) : dn_st_3
int trend_st_3 = 1
trend_st_3 := nz(trend_st_3[1], trend_st_3)
trend_st_3 := trend_st_3 == -1 and close > dn1_st_3 ? 1 : trend_st_3 == 1 and close < up1_st_3 ? -1 : trend_st_3
buySignal_st_3 = trend_st_3 == 1 and trend_st_3[1] == -1
sellSignal_st_3 = trend_st_3 == -1 and trend_st_3[1] == 1

// Supertrend 3 wird für die Logik berechnet, aber nicht einzeln geplottet.

// ─────────────────────────────────────────────────────────────────────────────
// SUPERTREND 4
// ─────────────────────────────────────────────────────────────────────────────
plot_st_4 = input.bool(false, title="Plot Supertrend 4", group="Supertrend 4")
can_be_entry_signal_st_4 = input.bool(true, title="Supertrend 4 can be entry signal", group="Supertrend 4")
long_trend_st_4 = input.string("uptrend", options=["uptrend", "downtrend", "unspecified"], title="Long: Supertrend 4 has to be in", group="Supertrend 4")
short_trend_st_4 = input.string("downtrend", options=["uptrend", "downtrend", "unspecified"], title="Short: Supertrend 4 has to be in", group="Supertrend 4")
per_st_4 = input.int(20, title="ATR Period 4", minval=1, group="Supertrend 4")
src_st_4 = input.source(hl2, title="Source 4", group="Supertrend 4")
mult_st_4 = input.float(10.0, title="ATR Multiplier 4", minval=0.1, step=0.1, group="Supertrend 4")

atr_st_4 = ta.atr(per_st_4)
float up_st_4 = src_st_4 - mult_st_4 * atr_st_4
up1_st_4 = nz(up_st_4[1], up_st_4)
up_st_4 := close[1] > up1_st_4 ? math.max(up_st_4, up1_st_4) : up_st_4
float dn_st_4 = src_st_4 + mult_st_4 * atr_st_4
dn1_st_4 = nz(dn_st_4[1], dn_st_4)
dn_st_4 := close[1] < dn1_st_4 ? math.min(dn_st_4, dn1_st_4) : dn_st_4
int trend_st_4 = 1
trend_st_4 := nz(trend_st_4[1], trend_st_4)
trend_st_4 := trend_st_4 == -1 and close > dn1_st_4 ? 1 : trend_st_4 == 1 and close < up1_st_4 ? -1 : trend_st_4
buySignal_st_4 = trend_st_4 == 1 and trend_st_4[1] == -1
sellSignal_st_4 = trend_st_4 == -1 and trend_st_4[1] == 1

// Supertrend 4 wird für die Logik berechnet, aber nicht einzeln geplottet.

// ─────────────────────────────────────────────────────────────────────────────
// HILFSFUNKTIONEN UND EXIT-STRATEGIE
// ─────────────────────────────────────────────────────────────────────────────
smooth_ma(source, length, smoothing) =>
    smoothing == "RMA/SMMA" ? ta.rma(source, length) : smoothing == "SMA" ? ta.sma(source, length) : smoothing == "EMA" ? ta.ema(source, length) : ta.wma(source, length)

round_down(number, decimals) =>
    factor = math.pow(10, decimals)
    int(number * factor) / factor

use_atr_based_sl = input.bool(true, "ATR Based Stop Loss", group="Exit Strategy")
nnatr_length = input.int(100, title="ATR Length", minval=1, group="Exit Strategy")
smoothing = input.string("RMA/SMMA", title="ATR Smoothing", options=["RMA/SMMA", "SMA", "EMA", "WMA"], group="Exit Strategy")
use_low_high_based_sl = input.bool(false, "Candle Low/High Based Stop Loss", group="Exit Strategy")
candle_lookback_sl = input.int(50, title="Candle Lookback", minval=1, group="Exit Strategy")
use_percentage_based_sl = input.bool(false, "Percentage Based Stop Loss", group="Exit Strategy")
percentage_sl = input.float(0.3, title="Percentage", minval=0.0, group="Exit Strategy")
use_pip_based_sl = input.bool(false, "Pip Based Stop Loss", group="Exit Strategy")
pip_sl = input.int(10, title="Pip", minval=1, group="Exit Strategy")
nnatr_loss = input.float(4.5, title="Base Risk Multiplier", minval=0.1, step=0.1, group="Exit Strategy")
rr_ratio = input.float(1.5, title="Risk to Reward Ratio", minval=0.1, step=0.1, group="Exit Strategy")

nnatr_profit = nnatr_loss * rr_ratio
nnatr = round_down(smooth_ma(ta.tr(true), nnatr_length, smoothing), 5)
lowest_point_sl = ta.lowest(low, candle_lookback_sl)
highest_point_sl = ta.highest(high, candle_lookback_sl)
percentage_val = percentage_sl * 0.01
percentage_long_sl = close - close * percentage_val * nnatr_loss
percentage_short_sl = close + close * percentage_val * nnatr_loss
pip_long_sl = close - pip_sl * syminfo.mintick
pip_short_sl = close + pip_sl * syminfo.mintick

// Die Formeln entsprechen bewusst der Quellstrategie, einschließlich Low/High-Modus.
b_atr_buy = use_atr_based_sl ? close + nnatr * nnatr_profit : use_low_high_based_sl ? close + (close - lowest_point_sl) * nnatr_profit : use_percentage_based_sl ? close + (close - percentage_long_sl) / nnatr_loss * nnatr_profit : use_pip_based_sl ? close + (close - pip_long_sl) * nnatr_profit : close + nnatr * nnatr_profit
b_atr_sell = use_atr_based_sl ? close - nnatr * nnatr_loss : use_low_high_based_sl ? lowest_point_sl * nnatr_loss : use_percentage_based_sl ? percentage_long_sl : use_pip_based_sl ? pip_long_sl : close - nnatr * nnatr_loss
s_atr_buy = use_atr_based_sl ? close - nnatr * nnatr_profit : use_low_high_based_sl ? close - (highest_point_sl - close) * nnatr_profit : use_percentage_based_sl ? close - (percentage_short_sl - close) / nnatr_loss * nnatr_profit : use_pip_based_sl ? close - (pip_short_sl - close) * nnatr_profit : close - nnatr * nnatr_profit
s_atr_sell = use_atr_based_sl ? close + nnatr * nnatr_loss : use_low_high_based_sl ? highest_point_sl * nnatr_loss : use_percentage_based_sl ? percentage_short_sl : use_pip_based_sl ? pip_short_sl : close + nnatr * nnatr_loss

// ─────────────────────────────────────────────────────────────────────────────
// FORCE EXITING
// ─────────────────────────────────────────────────────────────────────────────
use_force_exit_exact_time_1 = input.bool(false, title="1 - Force exit on custom session close", group="Force Exiting", inline="force_exit_exact_time_1")
force_exit_exact_time_1 = input.session("0930-1630:1234567", title="", group="Force Exiting", inline="force_exit_exact_time_1")
custom_session_1 = time("30S", force_exit_exact_time_1)
use_force_exit_exact_time_2 = input.bool(false, title="2 - Force exit on custom session close", group="Force Exiting", inline="force_exit_exact_time_2")
force_exit_exact_time_2 = input.session("0930-1630:1234567", title="", group="Force Exiting", inline="force_exit_exact_time_2")
custom_session_2 = time("30S", force_exit_exact_time_2)
use_force_exit_exact_time_3 = input.bool(false, title="3 - Force exit on custom session close", group="Force Exiting", inline="force_exit_exact_time_3")
force_exit_exact_time_3 = input.session("0930-1630:1234567", title="", group="Force Exiting", inline="force_exit_exact_time_3")
custom_session_3 = time("30S", force_exit_exact_time_3)
use_force_exit_exact_time_4 = input.bool(false, title="4 - Force exit on custom session close", group="Force Exiting", inline="force_exit_exact_time_4")
force_exit_exact_time_4 = input.session("0930-1630:1234567", title="", group="Force Exiting", inline="force_exit_exact_time_4")
custom_session_4 = time("30S", force_exit_exact_time_4)

// ─────────────────────────────────────────────────────────────────────────────
// BASE SETUPS UND ATR LIMITER
// ─────────────────────────────────────────────────────────────────────────────
allow_long = input.bool(true, title="Allow Long Entries", group="Base Setups")
allow_short = input.bool(true, title="Allow Short Entries", group="Base Setups")

switch_ma(ma_type, ma_src, ma_len) =>
    switch ma_type
        "SMA" => ta.sma(ma_src, ma_len)
        "EMA" => ta.ema(ma_src, ma_len)
        "WMA" => ta.wma(ma_src, ma_len)
        "VWMA" => ta.vwma(ma_src, ma_len)
        "RMA/SMMA" => ta.rma(ma_src, ma_len)
        "SWMA" => ta.swma(ma_src)
        "HMA" => ta.hma(ma_src, ma_len)
        => ta.ema(ma_src, ma_len)

use_atr_limiter = input.bool(true, title="Use ATR Limiter", group="ATR Limiter")
atrlim_len = input.int(50, title="ATR Limiter Length", minval=1, group="ATR Limiter")
atrlim_smoothing = input.string("RMA/SMMA", title="ATR Limiter Smoothing", options=["RMA/SMMA", "SMA", "EMA", "WMA"], group="ATR Limiter")
atrlim_boundary_high = input.float(1000, title="High Boundary", group="ATR Limiter")
atrlim_boundary_low = input.float(0.0003, title="Low Boundary", group="ATR Limiter")
atrlim_val = round_down(smooth_ma(ta.tr(true), atrlim_len, atrlim_smoothing), 5)
// ATR-Limiter wird nur intern berechnet.

atrlim_calc_by_ma = input.string("ATR value under MA", options=["ATR value over MA", "ATR value under MA", "Unspecified"], title="MA based calculation", group="ATR Limiter")
atrlim_ema_type = input.string("RMA/SMMA", options=["SMA", "EMA", "WMA", "VWMA", "RMA/SMMA", "SWMA", "HMA"], title="MA Type", group="ATR Limiter")
atrlim_ema_len = input.int(400, title="MA Length", minval=1, group="ATR Limiter")
atrlim_ema = switch_ma(atrlim_ema_type, atrlim_val, atrlim_ema_len)

check_atr_lim_long() =>
    use_atr_limiter ? (atrlim_calc_by_ma == "ATR value over MA" ? atrlim_val > atrlim_ema and atrlim_val < atrlim_boundary_high and atrlim_val > atrlim_boundary_low : atrlim_calc_by_ma == "ATR value under MA" ? atrlim_val < atrlim_ema and atrlim_val < atrlim_boundary_high and atrlim_val > atrlim_boundary_low : atrlim_val < atrlim_boundary_high and atrlim_val > atrlim_boundary_low) : true

check_atr_lim_short() =>
    use_atr_limiter ? (atrlim_calc_by_ma == "ATR value over MA" ? atrlim_val > atrlim_ema and atrlim_val > atrlim_boundary_low and atrlim_val < atrlim_boundary_high : atrlim_calc_by_ma == "ATR value under MA" ? atrlim_val < atrlim_ema and atrlim_val > atrlim_boundary_low and atrlim_val < atrlim_boundary_high : atrlim_val > atrlim_boundary_low and atrlim_val < atrlim_boundary_high) : true

// ─────────────────────────────────────────────────────────────────────────────
// ENTRY-LOGIK
// ─────────────────────────────────────────────────────────────────────────────
trend_ok(current_trend, requested_trend) =>
    requested_trend == "unspecified" or (requested_trend == "uptrend" and current_trend == 1) or (requested_trend == "downtrend" and current_trend != 1)

long_trends_ok = trend_ok(trend_st_1, long_trend_st_1) and trend_ok(trend_st_2, long_trend_st_2) and trend_ok(trend_st_3, long_trend_st_3) and trend_ok(trend_st_4, long_trend_st_4)
short_trends_ok = trend_ok(trend_st_1, short_trend_st_1) and trend_ok(trend_st_2, short_trend_st_2) and trend_ok(trend_st_3, short_trend_st_3) and trend_ok(trend_st_4, short_trend_st_4)
long_trigger = (can_be_entry_signal_st_1 and buySignal_st_1 and not buySignal_st_1[1]) or (can_be_entry_signal_st_2 and buySignal_st_2 and not buySignal_st_2[1]) or (can_be_entry_signal_st_3 and buySignal_st_3 and not buySignal_st_3[1]) or (can_be_entry_signal_st_4 and buySignal_st_4 and not buySignal_st_4[1])
short_trigger = (can_be_entry_signal_st_1 and sellSignal_st_1 and not sellSignal_st_1[1]) or (can_be_entry_signal_st_2 and sellSignal_st_2 and not sellSignal_st_2[1]) or (can_be_entry_signal_st_3 and sellSignal_st_3 and not sellSignal_st_3[1]) or (can_be_entry_signal_st_4 and sellSignal_st_4 and not sellSignal_st_4[1])
check_entry_long() => long_trigger and long_trends_ok
check_entry_short() => short_trigger and short_trends_ok

// ─────────────────────────────────────────────────────────────────────────────
// WADDAH ATTAR FILTER
// ─────────────────────────────────────────────────────────────────────────────
wafilt_calc_macd(source, fast_length, fast_type, slow_length, slow_type) =>
    switch_ma(fast_type, source, fast_length) - switch_ma(slow_type, source, slow_length)

wafilt_calc_bb_upper(ma_type, source, length, mult) =>
    switch_ma(ma_type, source, length) + mult * ta.stdev(source, length)

wafilt_calc_bb_lower(ma_type, source, length, mult) =>
    switch_ma(ma_type, source, length) - mult * ta.stdev(source, length)

wa_entry_logic = input.string("Not specified", options=["Explosion over Deadzone", "Explosion under Deadzone", "Not specified"], title="Explosion/Deadzone relation", group="Waddah Attar Filter")
wafilt_only_trade_when_trend = input.string("Not specified", options=["Strong Trends", "Soft Trends", "All Trends", "Not specified"], title="Limit trades based on trends", group="Waddah Attar Filter")
wa_over_e_dz = input.string("Not specified", options=["Over Explosion and Deadzone", "Not specified"], title="WA bar value", group="Waddah Attar Filter")
wafilt_sensitivity = input.int(150, title="Sensitivity", group="Waddah Attar Filter")
wafilt_fast_type = input.string("SMA", options=["SMA", "EMA", "WMA", "VWMA", "RMA/SMMA", "SWMA", "HMA"], title="Fast MA Type", inline="wa_1", group="Waddah Attar Filter")
wafilt_fast_length = input.int(10, title="Fast MA Length", minval=1, inline="wa_1", group="Waddah Attar Filter")
wafilt_slow_type = input.string("SMA", options=["SMA", "EMA", "WMA", "VWMA", "RMA/SMMA", "SWMA", "HMA"], title="Slow MA Type", inline="wa_2", group="Waddah Attar Filter")
wafilt_slow_length = input.int(20, title="Slow MA Length", minval=1, inline="wa_2", group="Waddah Attar Filter")
wafilt_channel_type = input.string("EMA", options=["SMA", "EMA", "WMA", "VWMA", "RMA/SMMA", "SWMA", "HMA"], title="Channel MA Type", group="Waddah Attar Filter")
wafilt_channel_length = input.int(20, title="BB Channel Length", minval=1, inline="wa_3", group="Waddah Attar Filter")
wafilt_mult = input.float(2.0, title="BB Stdev Multiplier", minval=0.0, inline="wa_3", group="Waddah Attar Filter")

wafilt_dead_zone = nz(ta.rma(ta.tr(true), 100)) * 3.7
wafilt_t1 = (wafilt_calc_macd(close, wafilt_fast_length, wafilt_fast_type, wafilt_slow_length, wafilt_slow_type) - wafilt_calc_macd(close[1], wafilt_fast_length, wafilt_fast_type, wafilt_slow_length, wafilt_slow_type)) * wafilt_sensitivity
wafilt_e1 = wafilt_calc_bb_upper(wafilt_channel_type, close, wafilt_channel_length, wafilt_mult) - wafilt_calc_bb_lower(wafilt_channel_type, close, wafilt_channel_length, wafilt_mult)
wafilt_trend_up = wafilt_t1 >= 0 ? wafilt_t1 : 0
wafilt_trend_down = wafilt_t1 < 0 ? -wafilt_t1 : 0
wafilt_trend_up_color = wafilt_trend_up < wafilt_trend_up[1] ? color.lime : color.green
wafilt_trend_down_color = wafilt_trend_down < wafilt_trend_down[1] ? color.orange : color.red
wafilt_trend_val = wafilt_trend_up != 0 ? wafilt_trend_up : wafilt_trend_down
wafilt_trend_color = wafilt_trend_up != 0 ? wafilt_trend_up_color : wafilt_trend_down_color

check_waddah_attar_long() =>
    logic = wa_entry_logic == "Explosion over Deadzone" ? wafilt_e1 > wafilt_dead_zone : wa_entry_logic == "Explosion under Deadzone" ? wafilt_e1 < wafilt_dead_zone : true
    trend = wafilt_only_trade_when_trend == "All Trends" ? (wafilt_trend_color == color.lime or wafilt_trend_color == color.green) : wafilt_only_trade_when_trend == "Strong Trends" ? wafilt_trend_color == color.green : wafilt_only_trade_when_trend == "Soft Trends" ? wafilt_trend_color == color.lime : true
    wa_bar_value = wa_over_e_dz == "Over Explosion and Deadzone" ? wafilt_trend_val > wafilt_e1 and wafilt_trend_val > wafilt_dead_zone : true
    logic and trend and wa_bar_value

check_waddah_attar_short() =>
    logic = wa_entry_logic == "Explosion over Deadzone" ? wafilt_e1 > wafilt_dead_zone : wa_entry_logic == "Explosion under Deadzone" ? wafilt_e1 < wafilt_dead_zone : true
    trend = wafilt_only_trade_when_trend == "All Trends" ? (wafilt_trend_color == color.red or wafilt_trend_color == color.orange) : wafilt_only_trade_when_trend == "Strong Trends" ? wafilt_trend_color == color.red : wafilt_only_trade_when_trend == "Soft Trends" ? wafilt_trend_color == color.orange : true
    wa_bar_value = wa_over_e_dz == "Over Explosion and Deadzone" ? wafilt_trend_val > wafilt_e1 and wafilt_trend_val > wafilt_dead_zone : true
    logic and trend and wa_bar_value

// ─────────────────────────────────────────────────────────────────────────────
// TREND- UND VOLUMENFILTER
// ─────────────────────────────────────────────────────────────────────────────
use_long_trend_filter_1 = input.bool(false, title="Use long trend filter 1", group="Trend Filter")
show_long_trend_filter_1 = input.bool(false, title="Show long trend filter 1", group="Trend Filter")
long_ma_type_1 = input.string("EMA", options=["SMA", "EMA", "WMA", "VWMA", "RMA/SMMA", "SWMA", "HMA"], title="TF1 - MA Type", inline="lTF1", group="Trend Filter")
long_ma_len_1 = input.int(120, title="TF1 - MA Length", minval=1, inline="lTF1", group="Trend Filter")
long_ma_source_1 = input.source(close, title="TF1 - MA Source", inline="lTF1", group="Trend Filter")
long_ma_tf_1 = switch_ma(long_ma_type_1, long_ma_source_1, long_ma_len_1)

use_short_trend_filter_1 = input.bool(false, title="Use short trend filter 1", group="Trend Filter")
show_short_trend_filter_1 = input.bool(false, title="Show short trend filter 1", group="Trend Filter")
short_ma_type_1 = input.string("EMA", options=["SMA", "EMA", "WMA", "VWMA", "RMA/SMMA", "SWMA", "HMA"], title="TF2 - MA Type", inline="sTF1", group="Trend Filter")
short_ma_len_1 = input.int(120, title="TF2 - MA Length", minval=1, inline="sTF1", group="Trend Filter")
short_ma_source_1 = input.source(close, title="TF2 - MA Source", inline="sTF1", group="Trend Filter")
short_ma_tf_1 = switch_ma(short_ma_type_1, short_ma_source_1, short_ma_len_1)
// Die Trendfilter-MAs werden nur intern berechnet.

check_trend_filter_long() => use_long_trend_filter_1 ? close > long_ma_tf_1 : true
check_trend_filter_short() => use_short_trend_filter_1 ? close < short_ma_tf_1 : true

use_volume_filter = input.bool(true, title="Only enter trades where volume is higher then the volume-based MA", group="Volume Filter")
vol_ma_type = input.string("RMA/SMMA", options=["SMA", "EMA", "WMA", "VWMA", "RMA/SMMA", "SWMA", "HMA"], title="Volume-based MA Type", group="Volume Filter")
vol_ma_len = input.int(200, title="Volume-based MA Length", minval=1, group="Volume Filter")
vol_ma = switch_ma(vol_ma_type, volume, vol_ma_len)
check_volume_filter() => use_volume_filter ? volume > vol_ma : true

// ─────────────────────────────────────────────────────────────────────────────
// DATUMS-, SESSION- UND ZEITFILTER
// ─────────────────────────────────────────────────────────────────────────────
limit_dates = input.bool(false, title="Limit Between Dates", group="Date Range Limiter")
start_date = input.time(timestamp("Jan 01 2023 00:00:00"), title="Start Date", group="Date Range Limiter")
end_date = input.time(timestamp("Jun 24 2023 00:00:00"), title="End Date", group="Date Range Limiter")

show_session_plots = input.bool(false, title="Show session plots", group="Session Limiter")
use_session_limit = input.bool(false, title="Use session limiter", group="Session Limiter")
limit_session1 = input.bool(false, title="Sidney session", group="Session Limiter")
limit_session2 = input.bool(false, title="Tokyo session", group="Session Limiter")
limit_session3 = input.bool(false, title="London session", group="Session Limiter")
limit_session4 = input.bool(false, title="New York session", group="Session Limiter")
session1 = time(timeframe.period, "1500-0000:1234567", "America/New_York")
session2 = time(timeframe.period, "1900-0400:1234567", "America/New_York")
session3 = time(timeframe.period, "0300-1100:1234567", "America/New_York")
session4 = time(timeframe.period, "0800-1700:1234567", "America/New_York")
// Sessionen werden als Filter genutzt, aber nicht hervorgehoben.

limit_trading_time = input.bool(true, title="Limit Trading Time", group="Trading Time Limiter")
days_to_trade_on = input.string("123567", title="Valid Trading Days Global", group="Trading Time Limiter")
limit_day1 = input.bool(false, title="", group="Trading Time Limiter", inline="day1")
days_to_trade_on1 = input.string("23456", title="(1) Valid Trading Days", inline="day1", group="Trading Time Limiter")
valid_hours1 = input.bool(false, title="", inline="inline1", group="Trading Time Limiter")
hours_to_trade_on1 = input.session("1800-2000", title="(1) Valid Trading Hours Between", inline="inline1", group="Trading Time Limiter")
limit_day2 = input.bool(false, title="", group="Trading Time Limiter", inline="day2")
days_to_trade_on2 = input.string("1234567", title="(2) Valid Trading Days", inline="day2", group="Trading Time Limiter")
valid_hours2 = input.bool(false, title="", inline="inline2", group="Trading Time Limiter")
hours_to_trade_on2 = input.session("0930-1600", title="(2) Valid Trading Hours Between", inline="inline2", group="Trading Time Limiter")
limit_day3 = input.bool(false, title="", group="Trading Time Limiter", inline="day3")
days_to_trade_on3 = input.string("1234567", title="(3) Valid Trading Days", inline="day3", group="Trading Time Limiter")
valid_hours3 = input.bool(false, title="", inline="inline3", group="Trading Time Limiter")
hours_to_trade_on3 = input.session("0930-1600", title="(3) Valid Trading Hours Between", inline="inline3", group="Trading Time Limiter")

in_date() => time > start_date and time < end_date
check_valid_session() =>
    s1 = limit_session1 ? session1 : na
    s2 = limit_session2 ? session2 : na
    s3 = limit_session3 ? session3 : na
    s4 = limit_session4 ? session4 : na
    use_session_limit ? (not na(s1) or not na(s2) or not na(s3) or not na(s4)) : true

check_valid_time() =>
    t = not limit_day1 and not limit_day2 and not limit_day3 ? time(timeframe.period, "0000-0000:" + days_to_trade_on) : na
    t7 = valid_hours1 and not limit_day1 ? time(timeframe.period, hours_to_trade_on1 + ":" + days_to_trade_on) : na
    t8 = valid_hours2 and not limit_day2 ? time(timeframe.period, hours_to_trade_on2 + ":" + days_to_trade_on) : na
    t9 = valid_hours3 and not limit_day3 ? time(timeframe.period, hours_to_trade_on3 + ":" + days_to_trade_on) : na
    t1 = valid_hours1 and limit_day1 ? time(timeframe.period, hours_to_trade_on1 + ":" + days_to_trade_on1) : na
    t2 = valid_hours2 and limit_day2 ? time(timeframe.period, hours_to_trade_on2 + ":" + days_to_trade_on2) : na
    t3 = valid_hours3 and limit_day3 ? time(timeframe.period, hours_to_trade_on3 + ":" + days_to_trade_on3) : na
    not na(t) or not na(t1) or not na(t2) or not na(t3) or not na(t7) or not na(t8) or not na(t9)

check_filters_long() => check_volume_filter() and check_waddah_attar_long() and check_valid_session() and check_atr_lim_long() and check_trend_filter_long()
check_filters_short() => check_volume_filter() and check_waddah_attar_short() and check_valid_session() and check_atr_lim_short() and check_trend_filter_short()
check_long() => check_entry_long() and check_filters_long()
check_short() => check_entry_short() and check_filters_short()

should_long_limit_dates = limit_dates ? in_date() and check_long() : check_long()
should_short_limit_dates = limit_dates ? in_date() and check_short() : check_short()
should_long_limit_day_trades = limit_trading_time ? check_valid_time() and check_long() : check_long()
should_short_limit_day_trades = limit_trading_time ? check_valid_time() and check_short() : check_short()
long_signal = should_long_limit_dates and should_long_limit_day_trades and allow_long
short_signal = should_short_limit_dates and should_short_limit_day_trades and allow_short
valid_values = not ((na(nnatr) and use_atr_based_sl) or (na(lowest_point_sl) and use_low_high_based_sl) or (na(highest_point_sl) and use_low_high_based_sl))

// ─────────────────────────────────────────────────────────────────────────────
// VIRTUELLE POSITION: ersetzt Positionsstatus und Order-Ausführung.
// Einstieg erfolgt auf Schlusskurs der Signalkerze; bei TP+SL in derselben Kerze
// wird der Stop konservativ priorisiert. Das beeinflusst nur die Anzeige/Alerts.
// ─────────────────────────────────────────────────────────────────────────────
var int virtual_position = 0
var float virtual_entry_price = na
var float long_exit_price = na
var float long_stop_price = na
var float short_exit_price = na
var float short_stop_price = na

bool long_entry_event = false
bool short_entry_event = false
bool long_tp_event = false
bool long_sl_event = false
bool short_tp_event = false
bool short_sl_event = false
bool force_exit_event = false
int exit_direction = 0
bool was_in_position = virtual_position != 0

force_exit_now = (use_force_exit_exact_time_1 and not na(custom_session_1[1]) and na(custom_session_1)) or (use_force_exit_exact_time_2 and not na(custom_session_2[1]) and na(custom_session_2)) or (use_force_exit_exact_time_3 and not na(custom_session_3[1]) and na(custom_session_3)) or (use_force_exit_exact_time_4 and not na(custom_session_4[1]) and na(custom_session_4))

if barstate.isconfirmed and virtual_position == 1
    stop_hit = low <= long_stop_price
    target_hit = high >= long_exit_price
    if stop_hit
        long_sl_event := true
        exit_direction := 1
        virtual_position := 0
        virtual_entry_price := na
    else if target_hit
        long_tp_event := true
        exit_direction := 1
        virtual_position := 0
        virtual_entry_price := na
    else if force_exit_now
        force_exit_event := true
        exit_direction := 1
        virtual_position := 0
        virtual_entry_price := na

if barstate.isconfirmed and virtual_position == -1
    stop_hit = high >= short_stop_price
    target_hit = low <= short_exit_price
    if stop_hit
        short_sl_event := true
        exit_direction := -1
        virtual_position := 0
        virtual_entry_price := na
    else if target_hit
        short_tp_event := true
        exit_direction := -1
        virtual_position := 0
        virtual_entry_price := na
    else if force_exit_now
        force_exit_event := true
        exit_direction := -1
        virtual_position := 0
        virtual_entry_price := na

if barstate.isconfirmed and valid_values and not was_in_position and virtual_position == 0
    if long_signal
        long_entry_event := true
        virtual_position := 1
        virtual_entry_price := close
        long_exit_price := b_atr_buy
        long_stop_price := b_atr_sell
        short_exit_price := na
        short_stop_price := na
    else if short_signal
        short_entry_event := true
        virtual_position := -1
        virtual_entry_price := close
        short_exit_price := s_atr_buy
        short_stop_price := s_atr_sell
        long_exit_price := na
        long_stop_price := na

plot(virtual_position > 0 and plot_sl_tp ? long_exit_price : na, color=color.green, style=plot.style_linebr, linewidth=2, title="Long Take Profit")
plot(virtual_position > 0 and plot_sl_tp ? long_stop_price : na, color=color.red, style=plot.style_linebr, linewidth=2, title="Long Stop Loss")
plot(virtual_position < 0 and plot_sl_tp ? short_exit_price : na, color=color.purple, style=plot.style_linebr, linewidth=2, title="Short Take Profit")
plot(virtual_position < 0 and plot_sl_tp ? short_stop_price : na, color=color.aqua, style=plot.style_linebr, linewidth=2, title="Short Stop Loss")
// Der virtuelle Einstiegspreis bleibt intern verfügbar, wird aber nicht geplottet.

plotshape(plot_signals and long_entry_event, title="Long Entry Signal", style=shape.labelup, location=location.belowbar, color=color.new(#046ff9, 0), size=size.large, text="Entry Signal\nLong/Buy", textcolor=color.white)
plotshape(plot_signals and short_entry_event, title="Short Entry Signal", style=shape.labeldown, location=location.abovebar, color=color.new(#046ff9, 0), size=size.large, text="Entry Signal\nShort/Sell", textcolor=color.white)
// TP-, SL- und Force-Exit-Ereignisse bleiben über Alerts verfügbar.

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS: alertcondition für TradingView; optionale dynamische PineConnector-Meldungen.
// Für PineConnector in TradingView die Bedingung „Any alert() function call“ wählen.
// ─────────────────────────────────────────────────────────────────────────────
use_pc_automation = input.bool(false, title="Use PineConnector Automation", group="PineConnector Automation")
pc_licence_id = input.int(60123456789, title="License ID", maxval=9999999999999, group="PineConnector Automation")
pc_risk = input.float(1, title="Risk (trading volume)", group="PineConnector Automation")
pc_long_entry_alert = str.tostring(pc_licence_id) + ",buy," + syminfo.ticker + ",risk=" + str.tostring(pc_risk) + ",comment=\"ATR GOD Indicator\""
pc_short_entry_alert = str.tostring(pc_licence_id) + ",sell," + syminfo.ticker + ",risk=" + str.tostring(pc_risk) + ",comment=\"ATR GOD Indicator\""
pc_long_exit_alert = str.tostring(pc_licence_id) + ",closelong," + syminfo.ticker + ",risk=" + str.tostring(pc_risk) + ",comment=\"ATR GOD Indicator\""
pc_short_exit_alert = str.tostring(pc_licence_id) + ",closeshort," + syminfo.ticker + ",risk=" + str.tostring(pc_risk) + ",comment=\"ATR GOD Indicator\""

if use_pc_automation and barstate.isconfirmed
    if long_entry_event
        alert(pc_long_entry_alert, alert.freq_once_per_bar_close)
    if short_entry_event
        alert(pc_short_entry_alert, alert.freq_once_per_bar_close)
    if exit_direction == 1
        alert(pc_long_exit_alert, alert.freq_once_per_bar_close)
    if exit_direction == -1
        alert(pc_short_exit_alert, alert.freq_once_per_bar_close)

alertcondition(long_entry_event, title="ATR GOD – Long Entry", message="ATR GOD Indicator: Long entry")
alertcondition(short_entry_event, title="ATR GOD – Short Entry", message="ATR GOD Indicator: Short entry")
alertcondition(long_tp_event, title="ATR GOD – Long Take Profit", message="ATR GOD Indicator: Long take-profit level reached")
alertcondition(long_sl_event, title="ATR GOD – Long Stop Loss", message="ATR GOD Indicator: Long stop-loss level reached")
alertcondition(short_tp_event, title="ATR GOD – Short Take Profit", message="ATR GOD Indicator: Short take-profit level reached")
alertcondition(short_sl_event, title="ATR GOD – Short Stop Loss", message="ATR GOD Indicator: Short stop-loss level reached")
alertcondition(force_exit_event, title="ATR GOD – Force Exit", message="ATR GOD Indicator: force exit")

// Es werden keine Connector-Plots erzeugt. Für Automatisierung stehen die Alert-Bedingungen und optional die dynamischen PineConnector-Alerts zur Verfügung.