// @version=6
// =============================================================================
// ZECUSDT.P 5m Intraday Multi-Filter Strategy
// =============================================================================
// Weighted voting engine: SMA bias + MACD + RSI + Bollinger + Stoch + ADX.
// Confirmed-bar entries, cooldown gating, ATR/percent trailing stop,
// Full Kelly sizing, optional SL/TP/BE, performance table dashboard.
// =============================================================================

// =============================================================================
// === STRATEGY DECLARATION ===
// =============================================================================
strategy("ZECUSDT.P 5m Intraday",
     overlay=true,
     initial_capital=10000.0,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     slippage=1,
     pyramiding=0,
     calc_on_every_tick=true,
     process_orders_on_close=true)

// =============================================================================
// === INPUTS ===
// =============================================================================

dfQty       = input.float(100.0,  "Default Order Size", group="Settings")

smaFL = input.int(9,   "SMA Fast Length", group="SMA", inline="s1")
smaSL = input.int(21,  "SMA Slow Length", group="SMA", inline="s1")
smaW  = input.float(1.0, "SMA Weight", step=0.1, group="SMA", inline="s2")
smaEn = input.bool(true, "SMA Enabled", group="SMA", inline="s2")

mcF  = input.int(12,  "MACD Fast", group="MACD", inline="m1")
mcS  = input.int(26,  "MACD Slow", group="MACD", inline="m1")
mcSg = input.int(9,   "MACD Signal", group="MACD", inline="m1")
mcW  = input.float(1.0, "MACD Weight", step=0.1, group="MACD", inline="m2")
mcEn = input.bool(true, "MACD Enabled", group="MACD", inline="m2")

rLen = input.int(14,  "RSI Length", group="RSI", inline="r1")
rOB  = input.int(70,  "RSI Overbought", group="RSI", inline="r1")
rOS  = input.int(30,  "RSI Oversold", group="RSI", inline="r1")
rW   = input.float(1.0, "RSI Weight", step=0.1, group="RSI", inline="r2")
rEn  = input.bool(true, "RSI Enabled", group="RSI", inline="r2")

bbL  = input.int(20,  "BB Length", group="BB", inline="b1")
bbM  = input.float(2.0, "BB StdDev", step=0.1, group="BB", inline="b1")
bbW  = input.float(1.0, "BB Weight", step=0.1, group="BB", inline="b2")
bbEn = input.bool(true, "BB Enabled", group="BB", inline="b2")

stK  = input.int(14,  "%K Length", group="Stoch", inline="k1")
stD  = input.int(3,   "%D Length", group="Stoch", inline="k1")
stSm = input.int(3,   "Smoothing", group="Stoch", inline="k1")
stOB = input.int(80,  "Stoch OB", group="Stoch", inline="k2")
stOS = input.int(20,  "Stoch OS", group="Stoch", inline="k2")
stW  = input.float(1.0, "Stoch Weight", step=0.1, group="Stoch", inline="k3")
stEn = input.bool(true, "Stoch Enabled", group="Stoch", inline="k3")

adxL  = input.int(14,  "ADX Length", group="ADX", inline="a1")
adxTh = input.int(20,  "ADX Threshold", group="ADX", inline="a1")
adxW  = input.float(1.0, "ADX Weight", step=0.1, group="ADX", inline="a2")
adxEn = input.bool(true, "ADX Enabled", group="ADX", inline="a2")

scrThresh = input.float(2.0, "Score Threshold", step=0.1, group="Scoring")
longEn    = input.bool(true,  "Long Enabled", group="Scoring")
shortEn   = input.bool(true,  "Short Enabled", group="Scoring")

cooldown  = input.int(3, "Cooldown Bars", group="Cooldown")

trlType  = input.string("ATR", "Trail Type", options=["ATR","Percent"], group="Trail")
trlMul   = input.float(2.0, "ATR Mult", step=0.1, group="Trail")
trlLen   = input.int(14,  "ATR Length", group="Trail")
trlPct   = input.float(1.0, "Trail %", step=0.1, group="Trail")
trlAct   = input.float(0.0, "Activation Profit %", step=0.1, group="Trail")

enSL = input.bool(true,  "Use SL", group="Exits")
slP  = input.float(1.5,  "SL %", step=0.1, group="Exits")
enTP = input.bool(true,  "Use TP", group="Exits")
tpP  = input.float(3.0,  "TP %", step=0.1, group="Exits")
enBE = input.bool(false, "Use BE", group="Exits")
beTr = input.float(1.0,  "BE Trigger %", step=0.1, group="Exits")
beOf = input.float(0.0,  "BE Offset (ticks)", step=0.1, group="Exits")

enKelly = input.bool(true,  "Use Kelly", group="Kelly")
kFrac   = input.float(1.0,  "Kelly Fraction", step=0.1, group="Kelly")
kMinTr  = input.int(10,   "Min Trades", group="Kelly")

showDash = input.bool(true,  "Show Dashboard", group="Dashboard")
dashPos  = input.string("top_right", "Position", options=["top_right","top_left","bottom_right","bottom_left"], group="Dashboard")
dashSz   = input.string("normal", "Size", options=["small","normal","large"], group="Dashboard")

// =============================================================================
// === ADX HELPERS ===
// =============================================================================

dirmov(len) =>
    up      = ta.change(high)
    down    = -ta.change(low)
    plusDM  = na(up)   ? na : (up > down and up > 0   ? up   : 0.0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0.0)
    truerange = ta.rma(ta.tr(true), len)
    plus  = nz(100 * ta.rma(plusDM,  len) / truerange)
    minus = nz(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]

calcADX(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)

// =============================================================================
// === CORE INDICATORS ===
// =============================================================================

smaFast = ta.sma(close, smaFL)
smaSlow = ta.sma(close, smaSL)

[macdLine, signalLine, _] = ta.macd(close, mcF, mcS, mcSg)

rsiVal = ta.rsi(close, rLen)

bbBasis = ta.sma(close, bbL)
bbDev   = bbM * ta.stdev(close, bbL)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

stochKVal = ta.sma(ta.stoch(high, low, close, stK), stSm)
stochDVal = ta.sma(stochKVal, stD)

[diPlus, diMinus] = dirmov(adxL)
adxVal = calcADX(adxL, adxL)

// =============================================================================
// === SCORING ENGINE ===
// =============================================================================

var longScore  = 0.0
var shortScore = 0.0

longScore  := 0.0
shortScore := 0.0

if mcEn and not na(macdLine) and not na(signalLine)
    if macdLine > signalLine
        longScore  += mcW
    else if macdLine < signalLine
        shortScore += mcW

rsiMid = (rOB + rOS) / 2.0
if rEn and not na(rsiVal)
    if rsiVal > rsiMid
        longScore  += rW
    else if rsiVal < rsiMid
        shortScore += rW

if bbEn and not na(bbBasis)
    if close > bbBasis
        longScore  += bbW
    else if close < bbBasis
        shortScore += bbW

if stEn and not na(stochKVal) and not na(stochDVal)
    if stochKVal > stochDVal and stochKVal < stOB
        longScore  += stW
    else if stochKVal < stochDVal and stochKVal > stOS
        shortScore += stW

if adxEn and not na(adxVal) and adxVal > adxTh
    longScore  += adxW
    shortScore += adxW

// =============================================================================
// === ENTRY LOGIC ===
// =============================================================================

var int lastEntryBar = na

bullBias = not na(smaFast) and not na(smaSlow) and smaFast > smaSlow
bearBias = not na(smaFast) and not na(smaSlow) and smaFast < smaSlow

longCond  = longEn and bullBias and longScore  >= scrThresh and barstate.isconfirmed
shortCond = shortEn and bearBias and shortScore >= scrThresh and barstate.isconfirmed

cdOK = na(lastEntryBar) or (bar_index - lastEntryBar) > cooldown

// =============================================================================
// === FULL KELLY POSITION SIZING ===
// =============================================================================

var float kellyF = na

if enKelly and strategy.closedtrades >= kMinTr and strategy.wintrades > 0 and strategy.losstrades > 0
    wr      = strategy.wintrades / strategy.closedtrades
    avgWin  = strategy.grossprofit / strategy.wintrades
    avgLoss = math.abs(strategy.grossloss / strategy.losstrades)
    if avgLoss != 0.0 and avgWin > 0.0
        W = wr
        R = avgWin / avgLoss
        kRaw = (W * R - (1.0 - W)) / R
        kellyF := math.max(0.0, kRaw) * kFrac
    else
        kellyF := 0.0
else
    kellyF := na

rawSz = enKelly and not na(kellyF) and kellyF > 0.0 ? math.round(dfQty * kellyF / close) : dfQty
posSz = int(math.max(rawSz, 1.0))

// =============================================================================
// === STRATEGY ENTRY ===
// =============================================================================

if longCond and cdOK
    if strategy.position_size < 0
        strategy.close("Short", comment="Close Short")
    strategy.entry("Long", strategy.long, qty=posSz, comment="Long S=" + str.tostring(longScore, "#.##"))
    lastEntryBar := bar_index

if shortCond and cdOK
    if strategy.position_size > 0
        strategy.close("Long", comment="Close Long")
    strategy.entry("Short", strategy.short, qty=posSz, comment="Short S=" + str.tostring(shortScore, "#.##"))
    lastEntryBar := bar_index

// =============================================================================
// === EXIT LOGIC ===
// =============================================================================

var bool  beTriggered = false
var float entryPrice  = na
var bool  trlActiveF  = false

isNewLong  = strategy.position_size > 0  and strategy.position_size[1] <= 0
isNewShort = strategy.position_size < 0  and strategy.position_size[1] >= 0
isFlat     = strategy.position_size == 0 and strategy.position_size[1] != 0

if isNewLong or isNewShort
    beTriggered := false
    trlActiveF  := false
    entryPrice  := strategy.position_avg_price
else if isFlat
    beTriggered := false
    trlActiveF  := false
    entryPrice  := na
else if strategy.position_size != 0
    entryPrice  := strategy.position_avg_price

unrlPct = 0.0
if strategy.position_size != 0 and not na(entryPrice) and entryPrice != 0.0
    if strategy.position_size > 0
        unrlPct := (close - entryPrice) / entryPrice * 100.0
    else
        unrlPct := (entryPrice - close) / entryPrice * 100.0

if enBE and not beTriggered and strategy.position_size != 0 and not na(entryPrice) and unrlPct >= beTr
    beTriggered := true

if strategy.position_size != 0 and not na(unrlPct) and unrlPct >= trlAct
    trlActiveF := true

trlActive = trlAct <= 0.0 or trlActiveF

safeMT = syminfo.mintick != 0.0 ? syminfo.mintick : 0.01
atrV   = ta.atr(trlLen)
trlOffPrice = trlType == "ATR" ? (nz(atrV, close * 0.01) * trlMul) : (close * trlPct / 100.0)
trlTicks    = int(math.max(trlOffPrice / safeMT, 1.0))

slTix = enSL and not na(entryPrice) ? int(entryPrice * slP / 100.0 / safeMT) : na
tpTix = enTP and not na(entryPrice) ? int(entryPrice * tpP / 100.0 / safeMT) : na

actTrlOff = trlActive and strategy.position_size != 0 ? trlTicks : na

// =============================================================================
// === STRATEGY EXIT ===
// =============================================================================

if strategy.position_size > 0
    strategy.exit("XL", "Long",
         trail_offset = actTrlOff,
         loss         = slTix,
         profit       = tpTix,
         comment_trailing = "Trail",
         comment_loss     = "SL",
         comment_profit   = "TP")

    beLvlL = not na(entryPrice) ? entryPrice - beOf * safeMT : na
    if enBE and beTriggered and not na(beLvlL) and close <= beLvlL
        strategy.close("Long", comment="BE")

if strategy.position_size < 0
    strategy.exit("XS", "Short",
         trail_offset = actTrlOff,
         loss         = slTix,
         profit       = tpTix,
         comment_trailing = "Trail",
         comment_loss     = "SL",
         comment_profit   = "TP")

    beLvlS = not na(entryPrice) ? entryPrice + beOf * safeMT : na
    if enBE and beTriggered and not na(beLvlS) and close >= beLvlS
        strategy.close("Short", comment="BE")

// =============================================================================
// === PLOTS ===
// =============================================================================

plot(smaFast, "SMAf", color=color.new(color.blue, 0),   linewidth=1)
plot(smaSlow, "SMAs", color=color.new(color.orange, 0), linewidth=1)
plot(bbUpper, "BBu",  color=color.new(color.gray, 50),  linewidth=1)
plot(bbLower, "BBb",  color=color.new(color.gray, 50),  linewidth=1)
plot(bbBasis, "BBm",  color=color.new(color.gray, 30),  linewidth=1)

bgcolor(bullBias ? color.new(color.green, 95) : bearBias ? color.new(color.red, 95) : color.new(color.gray, 95), title="Bias")

// =============================================================================
// === PERFORMANCE DASHBOARD ===
// =============================================================================
// Modern dashboard with Net P&L as headline, clean sections, and clear colors.

pMap = dashPos == "top_right"    ? position.top_right
     : dashPos == "top_left"     ? position.top_left
     : dashPos == "bottom_right" ? position.bottom_right
     : dashPos == "bottom_left"  ? position.bottom_left
     : position.top_right

sMap = dashSz == "small"  ? size.small
     : dashSz == "normal" ? size.normal
     : dashSz == "large"  ? size.large
     : size.normal

// ---- Colors ----
cBg       = color.new(color.black, 5)
cBgHeader = color.new(#1a1a2e, 0)
cBgGreen  = color.new(#0d2818, 0)
cBgRed    = color.new(#2d0d0d, 0)
cBgGray   = color.new(#2a2a2a, 0)
cGreen    = #4ade80
cRed      = #f87171
cYellow   = #fbbf24
cWhite    = #f3f4f6
cGray     = #9ca3af
cPurple   = #c084fc
cBlue     = #60a5fa

// ---- Data ----
np    = strategy.netprofit
npCol = np > 0 ? cGreen : np < 0 ? cRed : cGray
npBg  = np > 0 ? cBgGreen : np < 0 ? cBgRed : cBgGray

totalTrades = strategy.closedtrades
winTrades   = strategy.wintrades
lossTrades  = strategy.losstrades
winRate     = totalTrades > 0 ? winTrades / totalTrades * 100.0 : 0.0

pfVal = strategy.grossloss != 0.0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0

avgWin  = winTrades > 0 ? strategy.grossprofit / winTrades : 0.0
avgLoss = lossTrades > 0 ? math.abs(strategy.grossloss / lossTrades) : 0.0

kellyPct = not na(kellyF) ? kellyF * 100.0 : 0.0

unrlPnL = 0.0
if strategy.position_size != 0
    ep = strategy.position_avg_price
    if strategy.position_size > 0
        unrlPnL := (close - ep) * math.abs(strategy.position_size)
    else
        unrlPnL := (ep - close) * math.abs(strategy.position_size)

// ---- Table: 3 columns, 14 rows ----
var dashT = table.new(pMap, 3, 14,
     bgcolor       = cBg,
     frame_color   = color.new(cGray, 30),
     frame_width   = 2,
     border_color  = color.new(cGray, 50),
     border_width  = 1)

if showDash
    // --- Row 0: Title ---
    table.cell(dashT, 0, 0, "ZECUSDT.P 5m Strategy", text_color=cWhite, text_size=sMap, bgcolor=cBgHeader, text_halign=text.align_left)
    table.cell(dashT, 1, 0, "", text_color=cGray, text_size=sMap, bgcolor=cBgHeader)
    table.cell(dashT, 2, 0, "LIVE", text_color=cGreen, text_size=sMap, bgcolor=cBgHeader, text_halign=text.align_right)

    // --- Row 1: Net P&L (hero row) ---
    table.cell(dashT, 0, 1, "NET P&L", text_color=cGray, text_size=sMap, bgcolor=npBg, text_halign=text.align_left)
    table.cell(dashT, 1, 1, str.tostring(np, "#,###.##"), text_color=npCol, text_size=sMap, bgcolor=npBg)
    table.cell(dashT, 2, 1, np > 0 ? "+" : np < 0 ? "" : "", text_color=npCol, text_size=sMap, bgcolor=npBg, text_halign=text.align_right)

    // --- Row 2: separator ---
    table.cell(dashT, 0, 2, "", text_color=cGray, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 1, 2, "", text_color=cGray, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 2, "", text_color=cGray, text_size=sMap, bgcolor=cBg)

    // --- Row 3: Section header "Performance" ---
    table.cell(dashT, 0, 3, "PERFORMANCE", text_color=cBlue, text_size=sMap, bgcolor=cBgHeader, text_halign=text.align_left)
    table.cell(dashT, 1, 3, "", text_color=cGray, text_size=sMap, bgcolor=cBgHeader)
    table.cell(dashT, 2, 3, "", text_color=cGray, text_size=sMap, bgcolor=cBgHeader)

    // --- Row 4: Profit Factor ---
    pfClr = pfVal > 1.5 ? cGreen : pfVal > 1.0 ? cYellow : cRed
    table.cell(dashT, 0, 4, "Profit Factor", text_color=cGray, text_size=sMap, bgcolor=cBg, text_halign=text.align_left)
    table.cell(dashT, 1, 4, str.tostring(pfVal, "#.##"), text_color=pfClr, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 4, "", text_color=cGray, text_size=sMap, bgcolor=cBg)

    // --- Row 5: Win Rate ---
    wrClr = winRate > 55.0 ? cGreen : winRate > 45.0 ? cYellow : cRed
    table.cell(dashT, 0, 5, "Win Rate", text_color=cGray, text_size=sMap, bgcolor=cBg, text_halign=text.align_left)
    table.cell(dashT, 1, 5, str.tostring(winRate, "#.##") + "%", text_color=wrClr, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 5, "", text_color=cGray, text_size=sMap, bgcolor=cBg)

    // --- Row 6: Trades (W/L) ---
    table.cell(dashT, 0, 6, "Trades", text_color=cGray, text_size=sMap, bgcolor=cBg, text_halign=text.align_left)
    table.cell(dashT, 1, 6, str.tostring(totalTrades) + " (" + str.tostring(winTrades) + "/" + str.tostring(lossTrades) + ")", text_color=cWhite, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 6, "", text_color=cGray, text_size=sMap, bgcolor=cBg)

    // --- Row 7: Avg Win ---
    table.cell(dashT, 0, 7, "Avg Win", text_color=cGray, text_size=sMap, bgcolor=cBg, text_halign=text.align_left)
    table.cell(dashT, 1, 7, str.tostring(avgWin, "#,###.##"), text_color=cGreen, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 7, "", text_color=cGray, text_size=sMap, bgcolor=cBg)

    // --- Row 8: Avg Loss ---
    table.cell(dashT, 0, 8, "Avg Loss", text_color=cGray, text_size=sMap, bgcolor=cBg, text_halign=text.align_left)
    table.cell(dashT, 1, 8, str.tostring(avgLoss, "#,###.##"), text_color=cRed, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 8, "", text_color=cGray, text_size=sMap, bgcolor=cBg)

    // --- Row 9: separator ---
    table.cell(dashT, 0, 9, "", text_color=cGray, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 1, 9, "", text_color=cGray, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 9, "", text_color=cGray, text_size=sMap, bgcolor=cBg)

    // --- Row 10: Section header "Signals" ---
    table.cell(dashT, 0, 10, "SIGNALS", text_color=cPurple, text_size=sMap, bgcolor=cBgHeader, text_halign=text.align_left)
    table.cell(dashT, 1, 10, "", text_color=cGray, text_size=sMap, bgcolor=cBgHeader)
    table.cell(dashT, 2, 10, "", text_color=cGray, text_size=sMap, bgcolor=cBgHeader)

    // --- Row 11: Bias + Score ---
    biasStr = bullBias ? "LONG" : bearBias ? "SHORT" : "NEUTRAL"
    biasClr = bullBias ? cGreen : bearBias ? cRed : cGray
    table.cell(dashT, 0, 11, "Bias", text_color=cGray, text_size=sMap, bgcolor=cBg, text_halign=text.align_left)
    table.cell(dashT, 1, 11, biasStr, text_color=biasClr, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 11, str.tostring(longScore, "#.##") + "/" + str.tostring(shortScore, "#.##"), text_color=cWhite, text_size=sMap, bgcolor=cBg, text_halign=text.align_right)

    // --- Row 12: ADX + RSI ---
    adxDisp = nz(adxVal, 0.0)
    rsiDisp = nz(rsiVal, 50.0)
    adxClr  = adxDisp > adxTh ? cPurple : cGray
    rsiClr  = rsiDisp > 70.0 ? cRed : rsiDisp < 30.0 ? cGreen : cWhite
    table.cell(dashT, 0, 12, "ADX / RSI", text_color=cGray, text_size=sMap, bgcolor=cBg, text_halign=text.align_left)
    table.cell(dashT, 1, 12, str.tostring(adxDisp, "#.##"), text_color=adxClr, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 12, str.tostring(rsiDisp, "#.##"), text_color=rsiClr, text_size=sMap, bgcolor=cBg, text_halign=text.align_right)

    // --- Row 13: Kelly % ---
    kClr = kellyPct > 10.0 ? cGreen : kellyPct > 0.0 ? cYellow : cGray
    table.cell(dashT, 0, 13, "Kelly %", text_color=cGray, text_size=sMap, bgcolor=cBg, text_halign=text.align_left)
    table.cell(dashT, 1, 13, str.tostring(kellyPct, "#.##") + "%", text_color=kClr, text_size=sMap, bgcolor=cBg)
    table.cell(dashT, 2, 13, "", text_color=cGray, text_size=sMap, bgcolor=cBg)