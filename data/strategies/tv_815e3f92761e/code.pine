//@version=6
strategy("MOS - Muhamad Official Strategy (SNRZ Multi-Timeframe) Ultimate v3.0 5m", overlay=true, max_boxes_count=100, max_labels_count=100,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=500, margin_long=20, margin_short=20, pyramiding=0,
         commission_type=strategy.commission.percent, commission_value=0.05, slippage=2)

// ╔══════════════════════════════════════════════════════════════════════╗
// ║ DATEI:     MOS_Ultimate_Strategy.pine                                ║
// ║ ZWECK:     Optimierte SNRZ MTF Strategie mit Hurst, DER & Kelly      ║
// ║ VERSION:   3.0 (5m Edition - ZECUSDT.P Kalibrierung + S2-Fix)        ║
// ║                                                                      ║
// ║ CHANGELOG v3.0 (Umzug 3m -> 5m, ZECUSDT.P Perpetual):                ║
// ║ - S2-FIX (kritisch): In f_der() stand ta.wma() hinter einem          ║
// ║   Ternary (avg_vola != 0 ? ta.wma(...) : 0.0). ta.* hinter einer     ║
// ║   Bedingung bekommt Luecken in der internen History -> DER-Werte     ║
// ║   waren leise verfaelscht. Jetzt: unbedingt rechnen, dann waehlen.   ║
// ║ - Zeitfenster proportional von 3m auf 5m skaliert:                   ║
// ║     Min Hold 15 Bars (45 Min)  -> 9 Bars  (45 Min)                   ║
// ║     Max Trades/Tag 20          -> 12      (288 statt 480 Bars/Tag)   ║
// ║     Pivot Auto 10/5 (30/15 Min)-> 6/3     (30/15 Min)                ║
// ║ - Chart-Guard 180s -> 300s (REQUIRE_3M -> REQUIRE_5M).               ║
// ║ - SL/TP bleiben ATR-Multiplikatoren (2.5/3.0 als Start).             ║
// ║   Auf 5m neu sweepen: SL {2.0, 2.5, 3.0} x TP {2.5, 3.0, 4.0}.       ║
// ║ - Fee-Logik verbessert sich: 5m faengt groessere Moves pro Trade     ║
// ║   bei unveraenderter Break-even-Fee (~0.12% Roundtrip Taker).        ║
// ║                                                                      ║
// ║ CHANGELOG v2.9.1 (3m-Backtest 10.07.-10.08.2026, mit echten Kosten): ║
// ║ - Exit-Analyse: SL/TP-Exits (83% aller Trades) hatten 5.1% Winrate,  ║
// ║   Signal-Reversals 73% -> der 1.14-ATR-Stop toetete gesunde          ║
// ║   Positionen, der 9.55-ATR-TP war unerreichbar.                      ║
// ║ - FIX: SL 1.14 -> 2.5 ATR (Position darf atmen),                     ║
// ║        TP 9.55 -> 3.0 ATR (realistisch erreichbar).                  ║
// ╚══════════════════════════════════════════════════════════════════════╝

//---------------------------------------------------------------------------------------------------------------------
// STRATEGY INPUTS & OPTIMIZATION PARAMETERS
//---------------------------------------------------------------------------------------------------------------------
group_strat     = "Base Strategy Settings"
SL_PARAM        = input.float(2.5, "SL Parameter (ATR Multiplier)", group=group_strat, tooltip="v3.0: 2.5 ATR als Startwert, auf 5m neu sweepen: {2.0, 2.5, 3.0}. Backtest auf 3m zeigte: enge Stops wuergen Trades ab, signalbasierte Exits gewinnen 73%.")
TP_PARAM        = input.float(3.0, "TP Parameter (ATR Multiplier)", group=group_strat, tooltip="v3.0: 3.0 ATR als Startwert, auf 5m sweepen: {2.5, 3.0, 4.0}.")
ATR_LEN         = input.int(14, "ATR Length", group=group_strat)
USE_TRAILING    = input.bool(false, "Use Trailing Stop Loss", group=group_strat)
LEFT_LEN        = input.int(6, "Left Swing Lookback", group=group_strat, tooltip="v3.0: Manueller Fallback falls Auto aus. 6 Bars = 30 Min auf 5m (vorher 10 auf 3m).")
RIGHT_LEN       = input.int(3, "Right Swing Lookback", group=group_strat, tooltip="v3.0: 3 Bars = 15 Min auf 5m (vorher 5 auf 3m). Bestaetigungs-Lag bleibt identisch.")
USE_AUTO        = input.bool(true, "Use Auto Left/Right Lengths", group=group_strat)
MAX_ZONES       = input.int(15, "Max Active Zones", group=group_strat)
OPP_MODE        = input.string("Reverse", "Opposite Signal Mode", options=["Reverse", "Close only", "Ignore"], group=group_strat, tooltip="Reverse: Gegensignal dreht die Position um (mit Min Hold). Close only: Gegensignal schliesst nur. Ignore: Gegensignale werden ignoriert, bis SL oder TP getroffen wird.")
MIN_HOLD_BARS   = input.int(9, "Min Hold Bars before Reverse", minval=0, maxval=500, group=group_strat, tooltip="v3.0: 9 Bars = 45 Min auf 5m (vorher 15 Bars auf 3m, gleiches Zeitfenster). Position muss mindestens X Bars gehalten werden, bevor ein Gegensignal sie umdrehen darf.")
MAX_TRADES_DAY  = input.int(12, "Max Trades pro Tag (0 = aus)", minval=0, maxval=1000, group=group_strat, tooltip="v3.0: 12 auf 5m (proportional zu 20 auf 3m: 288 statt 480 Bars/Tag). Harte Tages-Obergrenze gegen Overtrading.")
REQUIRE_5M      = input.bool(true, "Require 5m chart", group=group_strat, tooltip="v3.0: Bricht mit Fehlermeldung ab, wenn das Skript nicht auf dem 5m-Chart laeuft. Nur fuer Research deaktivieren.")

group_visual    = "Visualization Settings"
SHOW_SBR        = input.bool(true, "Show SBR/RBS Zones & Signals", group=group_visual)
SHOW_INVERSION  = input.bool(true, "Show IVS/IVR Inversion Zones", group=group_visual)
SHOW_PO2        = input.bool(true, "Show PO2 Signals", group=group_visual)
SHOW_SWEEP      = input.bool(true, "Show Liquidity Sweep Signals", group=group_visual)
SHOW_DASHBOARD  = input.bool(true, "Show Performance Dashboard", group=group_visual)
OFFSET_LABELS   = input.bool(false, "Offset S/R Labels in Past", group=group_visual, tooltip="Wenn AKTIVIERT, werden VR/VS Labels in die Vergangenheit gezeichnet (Hindsight). Wenn DEAKTIVIERT, siehst du das Echtzeit-Signal dort, wo es tatsächlich erkannt wurde (empfohlen!).")

group_regime    = "Regime & Energy Filters (Optional)"
USE_REGIME_FLT  = input.bool(false, "Use Hurst Regime Filter", group=group_regime, tooltip="Trendfolge-Trades nur im Trendmarkt (H > 0.52). Reversals im Seitwärtsmarkt. (Standard: Aus)")
USE_DER_FILTER  = input.bool(false, "Use DER Trend Energy Filter", group=group_regime, tooltip="Filtert Trades basierend auf der Richtungs-Volumen-Energie. (Standard: Aus)")
DER_LOOKBACK    = input.int(20, "DER Lookback Period", group=group_regime, tooltip="20 Bars = 100 Min auf 5m (auf 3m waren es 60 Min). Fuer Zeit-Paritaet auf 12 setzen — optional, Filter ist standardmaessig aus.")
DER_SMOOTH      = input.int(5, "DER Smoothing Period", group=group_regime)

group_risk      = "Position Sizing & Risk Management"
SIZING_MODE     = input.string("Leverage", "Position Sizing Mode", options=["Leverage", "Kelly Risk Parity", "Fixed Percent"], group=group_risk, tooltip="'Leverage' nutzt die Original-Einstellung von 500% (5x Hebel).")
LEVERAGE_VAL    = input.float(500.0, "Leverage Value (% of Equity)", group=group_risk, tooltip="Hebeleinstellung. 500% = 5x Hebel.")
USE_KELLY       = input.bool(true, "Use Dynamic Kelly (only for Kelly Mode)", group=group_risk)
KELLY_MULT      = input.float(0.5, "Kelly Multiplier (Half-Kelly)", minval=0.1, maxval=1.0, step=0.1, group=group_risk)
DEFAULT_RISK    = input.float(1.5, "Fixed Risk % (or Fallback Risk)", minval=0.1, maxval=10.0, step=0.1, group=group_risk)

if REQUIRE_5M and timeframe.in_seconds(timeframe.period) != 300
    runtime.error("MOS Ultimate v3.0 ist fuer den 5-Minuten-Chart kalibriert. Guard nur fuer Research deaktivieren.")



//---------------------------------------------------------------------------------------------------------------------
// COLOR SCHEME CONSTANTS
//---------------------------------------------------------------------------------------------------------------------
color COLOR_GREEN = #089981
color COLOR_RED   = #f23645
color COLOR_BLUE  = #5b9cf6
color COLOR_DARK  = #0d0f14
color COLOR_PANEL = #1a1d26

var color vrColor  = color.new(COLOR_RED, 90)
var color vsColor  = color.new(COLOR_GREEN, 90)
var color sbrColor = color.new(COLOR_RED, 85)
var color rbsColor = color.new(COLOR_GREEN, 85)
var color ivsColor = color.new(COLOR_BLUE, 85)
var color ivrColor = color.new(COLOR_BLUE, 85)

//---------------------------------------------------------------------------------------------------------------------
// MATHEMATICAL ENGINES (HURST, DER, KELLY)
//---------------------------------------------------------------------------------------------------------------------
f_hurst(simple int len) =>
    int halfLen = int(len / 2)
    float hi_half1 = ta.highest(high, halfLen)
    float lo_half1 = ta.lowest(low, halfLen)
    float n2 = (hi_half1 - lo_half1) / halfLen

    float hi_half2 = ta.highest(high, halfLen)[halfLen]
    float lo_half2 = ta.lowest(low, halfLen)[halfLen]
    float n1 = (hi_half2 - lo_half2) / halfLen

    float hi_full = ta.highest(high, len)
    float lo_full = ta.lowest(low, len)
    float n3 = (hi_full - lo_full) / len

    float D = 1.0
    if (n1 + n2) > 0 and n3 > 0
        D := (math.log(math.max(1e-8, n1 + n2)) - math.log(math.max(1e-8, n3))) / math.log(2.0)
    float H = math.max(0.0, math.min(1.0, 2.0 - D))
    H

f_der(simple int len, simple int smooth_avg) =>
    float vola = na(volume) or volume == 0 ? 1.0 : volume
    float R = (ta.highest(high, 2) - ta.lowest(low, 2)) / 2.0
    float sr = R != 0 ? (close - close[1]) / R : 0.0
    float rsr = math.max(-1.0, math.min(1.0, sr))
    float c = rsr * vola
    float c_plus = math.max(c, 0.0)
    float c_minus = -math.min(c, 0.0)

    // v3.0 S2-FIX: ta.* unbedingt auf JEDER Bar rechnen, erst danach auswaehlen.
    // Vorher stand ta.wma hinter einem Ternary -> Luecken in der internen History.
    float avg_vola      = ta.wma(vola, len)
    float wma_c_plus    = ta.wma(c_plus, len)
    float wma_c_minus   = ta.wma(c_minus, len)
    float dem = avg_vola != 0 ? wma_c_plus / avg_vola : 0.0
    float sup = avg_vola != 0 ? wma_c_minus / avg_vola : 0.0

    float adp = ta.wma(dem, smooth_avg)
    float asp = ta.wma(sup, smooth_avg)
    float net_der = (adp - asp) * 100.0
    [net_der, adp * 100.0, asp * 100.0]

f_kelly_risk(simple float multiplier, simple float defRisk) =>
    int total_trades = strategy.closedtrades
    int win_count = 0
    int loss_count = 0
    float sum_wins = 0.0
    float sum_losses = 0.0

    if total_trades > 0
        int scan_range = math.min(100, total_trades)
        for i = 0 to scan_range - 1
            float pnl = strategy.closedtrades.profit(total_trades - 1 - i)
            if pnl > 0
                win_count += 1
                sum_wins += pnl
            else if pnl < 0
                loss_count += 1
                sum_losses += math.abs(pnl)

    float win_rate = total_trades > 0 ? float(win_count) / float(math.min(100, total_trades)) : 0.5
    float avg_win = win_count > 0 ? sum_wins / float(win_count) : 0.0
    float avg_loss = loss_count > 0 ? sum_losses / float(loss_count) : 0.0
    float R_ratio = avg_loss != 0.0 ? avg_win / avg_loss : 1.0

    float raw_kelly = R_ratio > 0.0 ? win_rate - ((1.0 - win_rate) / R_ratio) : 0.0
    float target_risk = total_trades > 0 ? math.max(0.5, math.min(12.0, raw_kelly * multiplier * 100.0)) : defRisk
    [target_risk, win_rate, R_ratio]

//---------------------------------------------------------------------------------------------------------------------
// SIGNAL PROCESSING & CO-EVOLUTION STRATEGY
//---------------------------------------------------------------------------------------------------------------------
bool isHighTf = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly or (timeframe.isminutes and timeframe.multiplier >= 240)

// v3.0: Intraday-Auto 6/3 auf 5m = 30/15 Min Zeitfenster (identisch zu 10/5 auf 3m)
int defaultLeft  = isHighTf ? 4 : 6
int defaultRight = isHighTf ? 2 : 3

int autoLeft  = USE_AUTO ? defaultLeft  : LEFT_LEN
int autoRight = USE_AUTO ? defaultRight : RIGHT_LEN

float ph = ta.pivothigh(high, autoLeft, autoRight)
float pl = ta.pivotlow(low, autoLeft, autoRight)

var array<box> liveVr  = array.new<box>()
var array<box> liveVs  = array.new<box>()
var array<box> liveIvr = array.new<box>()
var array<box> liveIvs = array.new<box>()

var int supportBreakCount = 0
var int resistanceBreakCount = 0

bool isNewDay = nz(ta.change(time("D"))) != 0
float atrValue = ta.atr(ATR_LEN)

var float slPrice = na
var float tpPrice = na
var float entryAtr = na
var bool pendingLevelsLong = false
var bool pendingLevelsShort = false

float H_val = f_hurst(100)
[der_net, der_bull, der_bear] = f_der(DER_LOOKBACK, DER_SMOOTH)
[kelly_pct, win_rate, win_loss_ratio] = f_kelly_risk(KELLY_MULT, DEFAULT_RISK)

bool isTrending   = H_val > 0.52
bool isMeanRevert = H_val < 0.48
bool isRandom     = not isTrending and not isMeanRevert

bool trendAllowed      = not USE_REGIME_FLT or isTrending
bool reversalAllowed   = not USE_REGIME_FLT or isMeanRevert or isRandom
bool bullEnergyAllowed = not USE_DER_FILTER or der_net > 0.0
bool bearEnergyAllowed = not USE_DER_FILTER or der_net < 0.0

//---------------------------------------------------------------------------------------------------------------------
// Drawing Base Zones (VS / VR)
//---------------------------------------------------------------------------------------------------------------------
if not na(ph)
    float topVal = high[autoRight]
    float botVal = math.max(open[autoRight], close[autoRight])
    box bx = box.new(left=bar_index - autoRight, top=topVal, right=bar_index, bottom=botVal,
                     bgcolor=vrColor, border_color=COLOR_RED, border_style=line.style_solid)
    array.push(liveVr, bx)
    int label_x = OFFSET_LABELS ? bar_index - autoRight : bar_index
    label.new(label_x, topVal, "VR", color=COLOR_RED, textcolor=chart.fg_color, style=label.style_label_down, size=size.small)
    if array.size(liveVr) > MAX_ZONES
        box.delete(array.shift(liveVr))

if not na(pl)
    float topVal = math.min(open[autoRight], close[autoRight])
    float botVal = low[autoRight]
    box bx = box.new(left=bar_index - autoRight, top=topVal, right=bar_index, bottom=botVal,
                     bgcolor=vsColor, border_color=COLOR_GREEN, border_style=line.style_solid)
    array.push(liveVs, bx)
    int label_x = OFFSET_LABELS ? bar_index - autoRight : bar_index
    label.new(label_x, botVal, "VS", color=COLOR_GREEN, textcolor=chart.fg_color, style=label.style_label_up, size=size.small)
    if array.size(liveVs) > MAX_ZONES
        box.delete(array.shift(liveVs))

//---------------------------------------------------------------------------------------------------------------------
// Advanced Checking Logic & Signal Generation
//---------------------------------------------------------------------------------------------------------------------
bool buySignal = false
bool sellSignal = false

if barstate.isconfirmed
    if isNewDay
        supportBreakCount := 0
        resistanceBreakCount := 0

    // Check VR Zones (Resistance)
    if array.size(liveVr) > 0
        for i = array.size(liveVr) - 1 to 0
            box b  = array.get(liveVr, i)
            float top = box.get_top(b)
            float bot = box.get_bottom(b)
            box.set_right(b, bar_index)

            if close > top and close[1] <= top
                resistanceBreakCount += 1

                if resistanceBreakCount >= 2
                    if trendAllowed
                        label.new(bar_index, high, "RSS (Double Break BUY)", color=COLOR_GREEN, textcolor=chart.fg_color, size=size.small)
                        buySignal := true
                    resistanceBreakCount := 0
                else if SHOW_SBR
                    box.set_bgcolor(b, rbsColor)
                    box.set_border_color(b, COLOR_GREEN)
                    if trendAllowed
                        label.new(bar_index, high, "RBS (BUY)", color=COLOR_GREEN, textcolor=chart.fg_color, size=size.small)
                        buySignal := true

                if SHOW_INVERSION
                    box.set_bgcolor(b, ivrColor)
                    box.set_border_color(b, COLOR_BLUE)
                    label.new(bar_index, bot, "IVR", color=COLOR_BLUE, textcolor=chart.fg_color, style=label.style_label_up, size=size.small)
                    array.push(liveIvr, b)

                array.remove(liveVr, i)

            else if high > top and close < top and SHOW_SWEEP and high[1] <= top
                if reversalAllowed
                    label.new(bar_index, high, "Liq Sweep ✗ (SELL)", color=COLOR_RED, textcolor=chart.fg_color, size=size.small)
                    sellSignal := true

    // Check VS Zones (Support)
    if array.size(liveVs) > 0
        for i = array.size(liveVs) - 1 to 0
            box b  = array.get(liveVs, i)
            float bot = box.get_bottom(b)
            float top = box.get_top(b)
            box.set_right(b, bar_index)

            if close < bot and close[1] >= bot
                supportBreakCount += 1

                if supportBreakCount >= 2
                    if trendAllowed
                        label.new(bar_index, low, "SRR (Double Break SELL)", color=COLOR_RED, textcolor=chart.fg_color, size=size.small)
                        sellSignal := true
                    supportBreakCount := 0
                else if SHOW_SBR
                    box.set_bgcolor(b, sbrColor)
                    box.set_border_color(b, COLOR_RED)
                    if trendAllowed
                        label.new(bar_index, low, "SBR (SELL)", color=COLOR_RED, textcolor=chart.fg_color, size=size.small)
                        sellSignal := true

                if SHOW_INVERSION
                    box.set_bgcolor(b, ivsColor)
                    box.set_border_color(b, COLOR_BLUE)
                    label.new(bar_index, top, "IVS", color=COLOR_BLUE, textcolor=chart.fg_color, style=label.style_label_down, size=size.small)
                    array.push(liveIvs, b)

                array.remove(liveVs, i)

            else if low < bot and close > bot and SHOW_SWEEP and low[1] >= bot
                if reversalAllowed
                    label.new(bar_index, low, "Liq Sweep ✓ (BUY)", color=COLOR_GREEN, textcolor=chart.fg_color, size=size.small)
                    buySignal := true

    // PO2 Logic (Power of Second Touch)
    if SHOW_PO2
        if array.size(liveIvr) > 0
            for i = array.size(liveIvr) - 1 to 0
                box b = array.get(liveIvr, i)
                float top = box.get_top(b)
                float bot = box.get_bottom(b)
                box.set_right(b, bar_index)

                if low <= top and high >= bot and close > bot and close[1] > top
                    if reversalAllowed
                        label.new(bar_index, low, "PO2 (BUY Call) ⚡", color=COLOR_GREEN, textcolor=chart.fg_color, size=size.normal)
                        buySignal := true
                    array.remove(liveIvr, i)

        if array.size(liveIvs) > 0
            for i = array.size(liveIvs) - 1 to 0
                box b = array.get(liveIvs, i)
                float bot = box.get_bottom(b)
                float top = box.get_top(b)
                box.set_right(b, bar_index)

                if high >= bot and low <= top and close < top and close[1] < bot
                    if reversalAllowed
                        label.new(bar_index, high, "PO2 (SELL Call) ⚡", color=COLOR_RED, textcolor=chart.fg_color, size=size.normal)
                        sellSignal := true
                    array.remove(liveIvs, i)
else
    if array.size(liveVr) > 0
        for i = 0 to array.size(liveVr) - 1
            box.set_right(array.get(liveVr, i), bar_index)
    if array.size(liveVs) > 0
        for i = 0 to array.size(liveVs) - 1
            box.set_right(array.get(liveVs, i), bar_index)
    if array.size(liveIvr) > 0
        for i = 0 to array.size(liveIvr) - 1
            box.set_right(array.get(liveIvr, i), bar_index)
    if array.size(liveIvs) > 0
        for i = 0 to array.size(liveIvs) - 1
            box.set_right(array.get(liveIvs, i), bar_index)

if array.size(liveIvr) > MAX_ZONES
    box.delete(array.shift(liveIvr))
if array.size(liveIvs) > MAX_ZONES
    box.delete(array.shift(liveIvs))

//---------------------------------------------------------------------------------------------------------------------
// Strategy Execution & Dynamic Sizing
//---------------------------------------------------------------------------------------------------------------------
bool finalBuySignal  = buySignal and bullEnergyAllowed
bool finalSellSignal = sellSignal and bearEnergyAllowed

if finalBuySignal and finalSellSignal
    finalBuySignal  := false
    finalSellSignal := false

float position_units = na

if SIZING_MODE == "Leverage"
    position_units := (strategy.equity * (LEVERAGE_VAL / 100.0)) / close
else if SIZING_MODE == "Fixed Percent"
    position_units := (strategy.equity * (DEFAULT_RISK / 100.0)) / close
else if SIZING_MODE == "Kelly Risk Parity"
    float risk_multiplier = USE_KELLY ? kelly_pct : DEFAULT_RISK
    float stop_distance   = atrValue * SL_PARAM
    float risk_currency   = (strategy.equity * (risk_multiplier / 100.0))
    position_units := stop_distance > 0 ? (risk_currency / stop_distance) : na

bool qtyOK = not na(position_units) and position_units > 0

bool reverseMode = OPP_MODE == "Reverse"
bool closeOnlyMode = OPP_MODE == "Close only"
bool canEnterLong  = reverseMode ? strategy.position_size <= 0 : strategy.position_size == 0
bool canEnterShort = reverseMode ? strategy.position_size >= 0 : strategy.position_size == 0

// Anti-Churn State (Min Hold + Tageslimit)
var int lastEntryBar = na
var int tradesToday = 0
if isNewDay
    tradesToday := 0
int barsSinceEntry = na(lastEntryBar) ? 99999 : bar_index - lastEntryBar
bool holdOK = strategy.position_size == 0 or barsSinceEntry >= MIN_HOLD_BARS
bool dailyCapOK = MAX_TRADES_DAY == 0 or tradesToday < MAX_TRADES_DAY

if strategy.position_size == 0 and not pendingLevelsLong and not pendingLevelsShort
    slPrice := na
    tpPrice := na

if closeOnlyMode and barstate.isconfirmed
    if strategy.position_size > 0 and finalSellSignal
        strategy.close("Long", comment="Opp Close")
    if strategy.position_size < 0 and finalBuySignal
        strategy.close("Short", comment="Opp Close")

if finalBuySignal and canEnterLong and qtyOK and holdOK and dailyCapOK
    strategy.entry("Long", strategy.long, qty=position_units)
    entryAtr := atrValue
    slPrice := close - (atrValue * SL_PARAM)
    tpPrice := close + (atrValue * TP_PARAM)
    pendingLevelsLong := true
    pendingLevelsShort := false
    lastEntryBar := bar_index
    tradesToday += 1

if finalSellSignal and canEnterShort and qtyOK and holdOK and dailyCapOK
    strategy.entry("Short", strategy.short, qty=position_units)
    entryAtr := atrValue
    slPrice := close + (atrValue * SL_PARAM)
    tpPrice := close - (atrValue * TP_PARAM)
    pendingLevelsShort := true
    pendingLevelsLong := false
    lastEntryBar := bar_index
    tradesToday += 1

if strategy.position_size > 0
    if pendingLevelsLong
        slPrice := strategy.position_avg_price - (entryAtr * SL_PARAM)
        tpPrice := strategy.position_avg_price + (entryAtr * TP_PARAM)
        pendingLevelsLong := false
    if USE_TRAILING
        slPrice := math.max(slPrice, close - (atrValue * SL_PARAM))
    if not na(slPrice) and not na(tpPrice)
        strategy.exit("Exit Long", "Long", stop=slPrice, limit=tpPrice)

if strategy.position_size < 0
    if pendingLevelsShort
        slPrice := strategy.position_avg_price + (entryAtr * SL_PARAM)
        tpPrice := strategy.position_avg_price - (entryAtr * TP_PARAM)
        pendingLevelsShort := false
    if USE_TRAILING
        slPrice := math.min(slPrice, close + (atrValue * SL_PARAM))
    if not na(slPrice) and not na(tpPrice)
        strategy.exit("Exit Short", "Short", stop=slPrice, limit=tpPrice)

//---------------------------------------------------------------------------------------------------------------------
// REAL-TIME PERFORMANCE DASHBOARD TABLE
//---------------------------------------------------------------------------------------------------------------------
var table dashTable = table.new(position=position.top_right, columns=3, rows=9,
                                bgcolor=color.new(COLOR_DARK, 5),
                                border_color=color.new(#2a2e39, 10),
                                border_width=1)

if SHOW_DASHBOARD and barstate.islast
    table.cell(dashTable, 0, 0, "🏆 MOS ULTIMATE SYSTEM Dashboard v3.0 (5m)", text_color=color.white, bgcolor=COLOR_PANEL, text_size=size.small, text_halign=text.align_center)
    table.merge_cells(dashTable, 0, 0, 2, 0)

    float pf = strategy.closedtrades > 0 and strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 1.0
    float netProfitPct = (strategy.netprofit / strategy.initial_capital) * 100.0
    float maxDrawdownPct = (strategy.max_drawdown / strategy.initial_capital) * 100.0

    string np_str = (netProfitPct >= 0 ? "+" : "") + str.tostring(netProfitPct, "#.##") + "%"
    string wr_str = str.tostring(win_rate * 100.0, "#.#") + "%"
    string pf_str = str.tostring(pf, "#.##")

    table.cell(dashTable, 0, 1, "Net Profit: " + np_str, text_color=netProfitPct >= 0 ? COLOR_GREEN : COLOR_RED, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small)
    table.cell(dashTable, 1, 1, "Win Rate: " + wr_str, text_color=color.white, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_center)
    table.cell(dashTable, 2, 1, "Prof. Factor: " + pf_str, text_color=pf >= 1.0 ? COLOR_GREEN : COLOR_RED, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_right)

    string hurst_state = H_val > 0.52 ? "Trending 🔥" : H_val < 0.48 ? "Mean Reverting 🔄" : "Chop/Random 🎲"
    color hurst_color = H_val > 0.52 ? COLOR_GREEN : H_val < 0.48 ? COLOR_BLUE : color.gray
    table.cell(dashTable, 0, 2, "Hurst Regime Index", text_color=color.white, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_left)
    table.cell(dashTable, 1, 2, str.tostring(H_val, "0.00"), text_color=hurst_color, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_center)
    table.cell(dashTable, 2, 2, hurst_state, text_color=hurst_color, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_right)

    string der_state = der_net > 5.0 ? "Bullish Demand 🟩" : der_net < -5.0 ? "Bearish Supply 🟥" : "Neutral Energy ⬜"
    color der_color = der_net > 5.0 ? COLOR_GREEN : der_net < -5.0 ? COLOR_RED : color.gray
    table.cell(dashTable, 0, 3, "DER Trend Energy", text_color=color.white, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_left)
    table.cell(dashTable, 1, 3, str.tostring(der_net, "0.0"), text_color=der_color, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_center)
    table.cell(dashTable, 2, 3, der_state, text_color=der_color, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_right)

    string size_info_str = SIZING_MODE == "Leverage" ? "Leverage (" + str.tostring(LEVERAGE_VAL, "#") + "%)" : SIZING_MODE == "Fixed Percent" ? "Fixed (" + str.tostring(DEFAULT_RISK, "#.##") + "%)" : "Kelly Risk Parity"
    table.cell(dashTable, 0, 4, "Sizing / Kelly Risk", text_color=color.white, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_left)
    table.cell(dashTable, 1, 4, str.tostring(kelly_pct, "0.00") + "%", text_color=COLOR_BLUE, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_center)
    table.cell(dashTable, 2, 4, size_info_str, text_color=COLOR_BLUE, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_right)

    table.cell(dashTable, 0, 5, "Account Equity", text_color=color.white, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_left)
    table.cell(dashTable, 1, 5, str.tostring(strategy.equity, "$#.##"), text_color=COLOR_GREEN, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_center)
    table.cell(dashTable, 2, 5, "Max DD: " + str.tostring(maxDrawdownPct, "0.0") + "%", text_color=COLOR_RED, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_right)

    string pos_str = strategy.position_size == 0 ? "No Position" : strategy.position_size > 0 ? "LONG 🟩" : "SHORT 🟥"
    color pos_color = strategy.position_size == 0 ? color.gray : strategy.position_size > 0 ? COLOR_GREEN : COLOR_RED
    table.cell(dashTable, 0, 6, "Active Order Size", text_color=color.white, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_left)
    table.cell(dashTable, 1, 6, str.tostring(math.abs(strategy.position_size), "0.####"), text_color=pos_color, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_center)
    table.cell(dashTable, 2, 6, pos_str, text_color=pos_color, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_right)

    string levels_str = na(slPrice) ? "-" : str.tostring(slPrice, "#.##") + " / " + str.tostring(tpPrice, "#.##")
    table.cell(dashTable, 0, 7, "SL / TP (" + OPP_MODE + ")", text_color=color.white, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_left)
    table.cell(dashTable, 1, 7, levels_str, text_color=color.white, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_center)
    table.cell(dashTable, 2, 7, pendingLevelsLong or pendingLevelsShort ? "anchoring..." : "anchored", text_color=pendingLevelsLong or pendingLevelsShort ? COLOR_BLUE : color.gray, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_right)

    string cap_str = MAX_TRADES_DAY == 0 ? "off" : str.tostring(tradesToday) + "/" + str.tostring(MAX_TRADES_DAY)
    table.cell(dashTable, 0, 8, "Trades heute", text_color=color.white, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_left)
    table.cell(dashTable, 1, 8, cap_str, text_color=dailyCapOK ? COLOR_GREEN : COLOR_RED, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_center)
    table.cell(dashTable, 2, 8, holdOK ? "hold OK" : "hold LOCK (" + str.tostring(barsSinceEntry) + ")", text_color=holdOK ? COLOR_GREEN : COLOR_RED, bgcolor=color.new(COLOR_DARK, 10), text_size=size.small, text_halign=text.align_right)

plot(strategy.position_size != 0 ? slPrice : na, "Active SL", color=color.new(COLOR_RED, 0), style=plot.style_linebr)
plot(strategy.position_size != 0 ? tpPrice : na, "Active TP", color=color.new(COLOR_GREEN, 0), style=plot.style_linebr)