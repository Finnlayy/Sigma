//@version=6
strategy("The Rule Book", overlay=true, initial_capital=10000, default_qty_type=strategy.cash, default_qty_value=1000)

// --- INPUTS: Einstiegs-Regeln ---
rsiLength   = input.int(14, "RSI Länge", group="Einstiegs-Regeln")
rsiOversold = input.float(30.0, "RSI Überverkauft", group="Einstiegs-Regeln")
rsiOverbought = input.float(70.0, "RSI Überverkauft", group="Einstiegs-Regeln")

fastMaLen   = input.int(9, "Fast MA Länge", group="Einstiegs-Regeln")
slowMaLen   = input.int(21, "Slow MA Länge", group="Einstiegs-Regeln")

// Regel-Verknüpfungen (AND / OR / AND NOT)
useRuleAndNotShort = input.bool(true, "Long: Signal UND NICHT bereits SHORT", group="Regel-Verknüpfungen")
useRuleAndNotLong  = input.bool(true, "Short: Signal UND NICHT bereits LONG", group="Regel-Verknüpfungen")

// --- INPUTS: Position Sizing ---
defaultRiskPct     = input.float(1.0, "Basis-Risiko %", minval=0.1, maxval=10.0, group="Position Sizing")
useConfidence      = input.bool(true, "Konfidenz-Sizing aktivieren", group="Position Sizing")
overrideConfidence = input.float(0.85, "Signal-Konfidenz (0.0 - 1.0)", minval=0.0, maxval=1.0, group="Position Sizing")
minConfidence      = input.float(0.50, "Mindest-Konfidenz", minval=0.0, maxval=1.0, group="Position Sizing")
maxRiskMult        = input.float(2.0, "Max Risiko-Multiplikator bei 100% Konfidenz", minval=1.0, maxval=5.0, group="Position Sizing")

// --- INPUTS: ATR & Volume Trailing Take Profit ---
useTTP          = input.bool(true, "Trailing Take Profit aktivieren", group="Trailing Take Profit")
atrLen          = input.int(14, "ATR Länge", group="Trailing Take Profit")
atrActMult      = input.float(2.0, "ATR Aktivierungs-Multiplikator", minval=0.5, step=0.1, group="Trailing Take Profit")
atrCallbackMult = input.float(1.0, "ATR Callback-Multiplikator", minval=0.1, step=0.1, group="Trailing Take Profit")

useVolScaling   = input.bool(true, "Volumen-Skalierung auf Callback", group="Trailing Take Profit")
volMaLen        = input.int(20, "Volumen MA Länge", group="Trailing Take Profit")
volSensitivity  = input.float(0.5, "Volumen Sensitivität (Exponent)", minval=0.0, maxval=2.0, step=0.1, group="Trailing Take Profit")
minVolFactor    = input.float(0.5, "Min Volumen-Faktor", minval=0.1, maxval=1.0, group="Trailing Take Profit")
maxVolFactor    = input.float(2.0, "Max Volumen-Faktor", minval=1.0, maxval=5.0, group="Trailing Take Profit")

// --- BERECHNUNG DER INDIKATOREN ---
rsiVal = ta.rsi(close, rsiLength)
fastMa = ta.sma(close, fastMaLen)
slowMa = ta.sma(close, slowMaLen)
atrVal = ta.atr(atrLen)
volMa  = ta.sma(volume, volMaLen)

// --- SUB-REGELN & HAUPTREGELN ---
subRule_rsiLong = rsiVal < rsiOversold
subRule_maLong  = fastMa > slowMa
rule_bullish    = subRule_rsiLong and subRule_maLong

subRule_rsiShort = rsiVal > rsiOverbought
subRule_maShort  = fastMa < slowMa
rule_bearish     = subRule_rsiShort and subRule_maShort

// Positionsstatus-Prüfung
isCurrentlyShort = strategy.position_size < 0
isCurrentlyLong  = strategy.position_size > 0

// Finale Signale mit AND NOT Verknüpfung
longCondition  = rule_bullish and (not useRuleAndNotShort or not isCurrentlyShort)
shortCondition = rule_bearish and (not useRuleAndNotLong or not isCurrentlyLong)

// --- POSITION SIZING CALCULATION ---
calcLotSize(stopLossDist) =>
    float effectiveRisk = defaultRiskPct
    if useConfidence
        float conf = math.max(0.0, math.min(1.0, overrideConfidence))
        if conf >= minConfidence
            float confScale = (conf - minConfidence) / (1.0 - minConfidence)
            effectiveRisk := defaultRiskPct * (1.0 + confScale * (maxRiskMult - 1.0))
        else
            effectiveRisk := 0.0
    
    float riskAmount = strategy.equity * (effectiveRisk / 100.0)
    float qty = stopLossDist > 0 ? (riskAmount / (stopLossDist * syminfo.pointvalue)) : 0.0
    qty

// --- DYNAMISCHES ATR & VOLUMEN TTP ---
var float ttpPeakPrice = na
var bool  ttpActivated = false

relVol       = volMa > 0 ? volume / volMa : 1.0
rawVolFactor = math.pow(relVol, volSensitivity)
volFactor    = useVolScaling ? math.max(minVolFactor, math.min(maxVolFactor, rawVolFactor)) : 1.0

activationDist = atrVal * atrActMult
callbackDist   = atrVal * atrCallbackMult * volFactor

// ENTRY EXECUTION
if longCondition and strategy.position_size <= 0
    float slDist = atrVal * 2.0
    float entryQty = calcLotSize(slDist)
    if entryQty > 0
        strategy.entry("Long", strategy.long, qty=entryQty)
        ttpPeakPrice := high
        ttpActivated := false

if shortCondition and strategy.position_size >= 0
    float slDist = atrVal * 2.0
    float entryQty = calcLotSize(slDist)
    if entryQty > 0
        strategy.entry("Short", strategy.short, qty=entryQty)
        ttpPeakPrice := low
        ttpActivated := false

// EXIT EXECUTION (TRAILING TAKE PROFIT)
if strategy.position_size > 0
    ttpPeakPrice := math.max(nz(ttpPeakPrice, high), high)
    float openProfit = ttpPeakPrice - strategy.position_avg_price
    if openProfit >= activationDist
        ttpActivated := true
    
    if ttpActivated
        float triggerPrice = ttpPeakPrice - callbackDist
        strategy.exit("TTP Exit Long", "Long", stop=triggerPrice)

else if strategy.position_size < 0
    ttpPeakPrice := math.min(nz(ttpPeakPrice, low), low)
    float openProfit = strategy.position_avg_price - ttpPeakPrice
    if openProfit >= activationDist
        ttpActivated := true
    
    if ttpActivated
        float triggerPrice = ttpPeakPrice + callbackDist
        strategy.exit("TTP Exit Short", "Short", stop=triggerPrice)

else
    ttpPeakPrice := na
    ttpActivated := false

// VISUALISIERUNG
plot(fastMa, "Fast MA", color=color.blue, linewidth=2)
plot(slowMa, "Slow MA", color=color.orange, linewidth=2)
