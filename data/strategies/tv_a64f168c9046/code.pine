//@version=6
// Datei: Top1_ETH_USDT_GA_Optimized.pine
// Zweck: GA-optimierter Pionex Signal Bot Indicator fuer ETH/USDT.
// Erstellt: 2026-04-08 | Version: 5.0
// Abhaengig: TradingView Pine Script v6, Pionex Signal Bot Webhook
// Generiert aus top3 | Rank: 1 | Fitness: -14.0154
// Nicht direkt auf den Indicator gemappt: risk_pct
strategy(
    title="ETH/USDT Glint News Pionex Bot GA #1",
    shorttitle="ETH_USDT GA #1",
    overlay=true,
    max_lines_count=200,
    max_labels_count=200,
    max_boxes_count=200,
    initial_capital=100,
    currency="USDT",
    default_qty_type=strategy.percent_of_equity,
    default_qty_value=100,
    pyramiding=1,
    margin_long=0,
    margin_short=0,
    calc_on_every_tick=false,
    process_orders_on_close=false
)

grp_main = "Bot Einstellungen"
signal_type = input.string("", "Pionex Signal Type (Bot UUID)", group=grp_main)
contracts = input.string("0.01", "Contracts", group=grp_main)
min_conf = input.int(35, "Min. Confidence Score", minval=0, maxval=100, group=grp_main)
use_shorts = input.bool(true, "Short Signale aktivieren", group=grp_main)
send_close = input.bool(true, "Close Signale senden", group=grp_main)

grp_risk = "Risiko und Filter"
sl_atr_mul = input.float(0.805, "SL ATR Multiplikator", minval=0.1, step=0.1, group=grp_risk)
tp_atr_mul = input.float(1.9, "TP ATR Multiplikator", minval=0.1, step=0.1, group=grp_risk)
vol_mult = input.float(0.8, "Volumen Multiplikator", minval=0.5, step=0.1, group=grp_risk)
max_daily_move_pct = input.float(15.702, "Max Tagesbewegung Prozent", minval=0.5, step=0.5, group=grp_risk)

grp_session = "Session"
use_session = input.bool(true, "Session Filter aktivieren", group=grp_session)
session_time = input.session("0800-2200", "Trading Session (UTC)", group=grp_session)

grp_news = "Glint News"
news_bull = input.bool(false, "News Bullish", group=grp_news)
news_bear = input.bool(false, "News Bearish", group=grp_news)

grp_vis = "Visualisierung"
show_ob = input.bool(true, "Order Blocks anzeigen", group=grp_vis)
show_fvg = input.bool(true, "FVGs anzeigen", group=grp_vis)
show_cisd = input.bool(true, "CISD Linien anzeigen", group=grp_vis)
show_table = input.bool(true, "Status Tabelle anzeigen", group=grp_vis)

f_payload(string tv_action, string tv_contracts, string pos_size) =>
    "{\"data\":{\"action\":\"" + tv_action + "\",\"contracts\":\"" + tv_contracts + "\",\"position_size\":\"" + pos_size + "\"},\"price\":\"" + str.tostring(close, format.mintick) + "\",\"signal_param\":\"{}\",\"signal_type\":\"" + signal_type + "\",\"symbol\":\"" + syminfo.ticker + "\",\"time\":\"" + str.tostring(timenow) + "\"}"

f_trend_bull() =>
    ema50 = ta.ema(close, 50)
    ema200 = ta.ema(close, 200)
    ema50 > ema200 and close > ema50

f_trend_bear() =>
    ema50 = ta.ema(close, 50)
    ema200 = ta.ema(close, 200)
    ema50 < ema200 and close < ema50

bool in_session = not use_session or not na(time(timeframe.period, session_time))
float day_open = request.security(syminfo.tickerid, "D", open[1], lookahead=barmerge.lookahead_off)
float daily_move_pct = day_open > 0 ? math.abs(close - day_open) / day_open * 100.0 : 0.0
bool daily_guard_active = daily_move_pct >= max_daily_move_pct

bool h4_bull = request.security(syminfo.tickerid, "240", f_trend_bull()[1], lookahead=barmerge.lookahead_off)
bool h4_bear = request.security(syminfo.tickerid, "240", f_trend_bear()[1], lookahead=barmerge.lookahead_off)
bool h1_bull = request.security(syminfo.tickerid, "60", f_trend_bull()[1], lookahead=barmerge.lookahead_off)
bool h1_bear = request.security(syminfo.tickerid, "60", f_trend_bear()[1], lookahead=barmerge.lookahead_off)
bool m15_bull = request.security(syminfo.tickerid, "15", f_trend_bull()[1], lookahead=barmerge.lookahead_off)
bool m15_bear = request.security(syminfo.tickerid, "15", f_trend_bear()[1], lookahead=barmerge.lookahead_off)

atr = ta.atr(14)
atr_safe = math.max(atr, close * 0.0001)
vol_ma = ta.sma(volume, 20)
bool is_vol_high = volume > vol_ma * vol_mult

pivot_high = ta.pivothigh(high, 4, 4)
pivot_low = ta.pivotlow(low, 4, 4)
var float last_ph = na
var float last_pl = na
if not na(pivot_high)
    last_ph := pivot_high
if not na(pivot_low)
    last_pl := pivot_low

bool cisd_bull = not na(last_ph) and ta.crossover(close, last_ph)
bool cisd_bear = not na(last_pl) and ta.crossunder(close, last_pl)

float body_curr = math.abs(close - open)
float body_prev = math.abs(close[1] - open[1])
float body_min = math.max(body_prev, atr_safe * 0.1)
bool ob_bull = close[1] < open[1] and close > open and body_curr > body_min * 1.1
bool ob_bear = close[1] > open[1] and close < open and body_curr > body_min * 1.1

bool fvg_bull = low > high[2] and close[1] > open[1]
bool fvg_bear = high < low[2] and close[1] < open[1]

int score_long = 0
int score_short = 0
if h4_bull
    score_long += 9
if h4_bear
    score_short += 9
if h1_bull
    score_long += 9
if h1_bear
    score_short += 9
if m15_bull
    score_long += 9
if m15_bear
    score_short += 9
if cisd_bull
    score_long += 35
if cisd_bear
    score_short += 35
if ob_bull
    score_long += 22
if ob_bear
    score_short += 22
if fvg_bull
    score_long += 23
if fvg_bear
    score_short += 23
if news_bull
    score_long += 20
if news_bear
    score_short += 20
if is_vol_high
    score_long += 16
    score_short += 16

bool confirmed = barstate.isconfirmed
bool block_long = news_bear or not in_session or daily_guard_active
bool block_short = news_bull or not in_session or daily_guard_active

var int position_state = 0
var float active_sl = na
var float active_tp = na
var float entry_price = na
var string exit_reason = ""

bool long_setup = confirmed and score_long >= min_conf and not block_long and position_state == 0
bool short_setup = confirmed and score_short >= min_conf and not block_short and use_shorts and position_state == 0

bool long_exit_signal = false
bool short_exit_signal = false
exit_reason := ""

if position_state == 1
    bool stop_hit = low <= nz(active_sl, low - 1)
    bool target_hit = high >= nz(active_tp, high + 1)
    bool blocker_hit = news_bear or not in_session or daily_guard_active
    bool reverse_hit = score_short >= min_conf and not block_short and use_shorts
    long_exit_signal := confirmed and (stop_hit or target_hit or blocker_hit or reverse_hit)
    if stop_hit
        exit_reason := "SL"
    else if target_hit
        exit_reason := "TP"
    else if blocker_hit
        exit_reason := "BLOCK"
    else if reverse_hit
        exit_reason := "REVERSE"

if position_state == -1
    bool stop_hit = high >= nz(active_sl, high + 1)
    bool target_hit = low <= nz(active_tp, low - 1)
    bool blocker_hit = news_bull or not in_session or daily_guard_active
    bool reverse_hit = score_long >= min_conf and not block_long
    short_exit_signal := confirmed and (stop_hit or target_hit or blocker_hit or reverse_hit)
    if stop_hit
        exit_reason := "SL"
    else if target_hit
        exit_reason := "TP"
    else if blocker_hit
        exit_reason := "BLOCK"
    else if reverse_hit
        exit_reason := "REVERSE"

bool long_entry = false
bool short_entry = false

if long_exit_signal and send_close
    alert(f_payload("sell", contracts, "0"), alert.freq_once_per_bar_close)
if short_exit_signal and send_close
    alert(f_payload("buy", contracts, "0"), alert.freq_once_per_bar_close)

if long_exit_signal
    position_state := 0
    active_sl := na
    active_tp := na
    entry_price := na

if short_exit_signal
    position_state := 0
    active_sl := na
    active_tp := na
    entry_price := na

if long_setup and position_state == 0 and str.length(signal_type) > 0
    long_entry := true
    position_state := 1
    entry_price := close
    active_sl := close - atr_safe * sl_atr_mul
    active_tp := close + atr_safe * tp_atr_mul
    alert(f_payload("buy", contracts, "1"), alert.freq_once_per_bar_close)

if short_setup and position_state == 0 and str.length(signal_type) > 0
    short_entry := true
    position_state := -1
    entry_price := close
    active_sl := close + atr_safe * sl_atr_mul
    active_tp := close - atr_safe * tp_atr_mul
    alert(f_payload("sell", contracts, "-1"), alert.freq_once_per_bar_close)

if show_cisd and not na(last_ph)
    line.new(bar_index - 1, last_ph, bar_index, last_ph, color=color.new(color.orange, 60), width=1)
if show_cisd and not na(last_pl)
    line.new(bar_index - 1, last_pl, bar_index, last_pl, color=color.new(color.aqua, 60), width=1)
if show_ob and ob_bull
    box.new(bar_index - 1, open[1], bar_index, close[1], bgcolor=color.new(color.green, 85), border_color=color.new(color.green, 40))
if show_ob and ob_bear
    box.new(bar_index - 1, open[1], bar_index, close[1], bgcolor=color.new(color.red, 85), border_color=color.new(color.red, 40))
if show_fvg and fvg_bull
    box.new(bar_index - 2, high[2], bar_index, low, bgcolor=color.new(color.teal, 88), border_color=color.new(color.teal, 50))
if show_fvg and fvg_bear
    box.new(bar_index - 2, low[2], bar_index, high, bgcolor=color.new(color.maroon, 88), border_color=color.new(color.maroon, 50))

plotshape(long_entry, title="Long Entry", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(short_entry, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")
plotshape(long_exit_signal or short_exit_signal, title="Exit", style=shape.circle, location=location.abovebar, color=color.yellow, size=size.tiny, text="EXIT")

if long_exit_signal or short_exit_signal
    label.new(
        bar_index,
        high,
        exit_reason,
        style=label.style_label_down,
        color=color.new(color.yellow, 0),
        textcolor=color.black,
        size=size.tiny
    )

plot(position_state == 1 ? active_sl : na, title="Long SL", color=color.new(color.red, 0), style=plot.style_linebr)
plot(position_state == 1 ? active_tp : na, title="Long TP", color=color.new(color.green, 0), style=plot.style_linebr)
plot(position_state == -1 ? active_sl : na, title="Short SL", color=color.new(color.red, 0), style=plot.style_linebr)
plot(position_state == -1 ? active_tp : na, title="Short TP", color=color.new(color.green, 0), style=plot.style_linebr)

var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 75), border_width=1)
if show_table and barstate.islast
    table.cell(dash, 0, 0, "ETH_USDT GA #1", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(dash, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(dash, 0, 1, "Session", text_color=color.silver)
    table.cell(dash, 1, 1, in_session ? "ACTIVE" : "CLOSED", text_color=in_session ? color.lime : color.red)
    table.cell(dash, 0, 2, "Daily Move", text_color=color.silver)
    table.cell(dash, 1, 2, str.tostring(daily_move_pct, "#.##") + "%", text_color=daily_guard_active ? color.red : color.white)
    table.cell(dash, 0, 3, "H4/H1/M15", text_color=color.silver)
    table.cell(dash, 1, 3, (h4_bull ? "B" : h4_bear ? "S" : "-") + "/" + (h1_bull ? "B" : h1_bear ? "S" : "-") + "/" + (m15_bull ? "B" : m15_bear ? "S" : "-"), text_color=color.white)
    table.cell(dash, 0, 4, "Long Score", text_color=color.silver)
    table.cell(dash, 1, 4, str.tostring(score_long), text_color=score_long >= min_conf ? color.lime : color.white)
    table.cell(dash, 0, 5, "Short Score", text_color=color.silver)
    table.cell(dash, 1, 5, str.tostring(score_short), text_color=score_short >= min_conf ? color.red : color.white)
    table.cell(dash, 0, 6, "Position", text_color=color.silver)
    table.cell(dash, 1, 6, position_state == 1 ? "LONG" : position_state == -1 ? "SHORT" : "FLAT", text_color=position_state == 0 ? color.white : position_state == 1 ? color.lime : color.red)
    table.cell(dash, 0, 7, "Signal Type", text_color=color.silver)
    table.cell(dash, 1, 7, str.length(signal_type) > 0 ? "SET" : "MISSING", text_color=str.length(signal_type) > 0 ? color.lime : color.orange)
    table.cell(dash, 0, 8, "Exit", text_color=color.silver)
    table.cell(dash, 1, 8, exit_reason == "" ? "-" : exit_reason, text_color=color.yellow)
