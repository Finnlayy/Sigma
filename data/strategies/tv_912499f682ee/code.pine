//@version=5
strategy("Recovery Center Alpha + MOS", overlay=true, margin_long=20, margin_short=20, max_boxes_count=100, default_qty_type=strategy.percent_of_equity, default_qty_value=500)

//---------------------------------------------------------------------------------------------------------------------}
// Inputs & Risk Parameters
//---------------------------------------------------------------------------------------------------------------------{

leftLen = input.int(10, title="Left Bars", minval=1)
rightLen = input.int(5, title="Right Bars", minval=1)
useAuto = input.bool(true, title="Auto Timeframe Control")

maxZones = input.int(15, title="Max Zones", minval=1)
showSBR = input.bool(true, title="Enable SBR & RBS Zones")
showInversion = input.bool(true, title="Enable IVS & IVR Zones")
showPO2 = input.bool(true, title="Enable PO2 (Second Touch)")
showSweep = input.bool(true, title="Enable Liquidity Sweep")

// Risk: Max Drawdown 15%
strategy.risk.max_drawdown(15, strategy.percent_of_equity)

// Risk: Tight Stop-Loss (Max 1%)
stopLossPct = 0.01

// High-Frequency: Rapid Exit on Volume Spikes
volSpike = volume > nz(ta.sma(volume, 20)) * 3

// Base Strategy Indicator
sma200 = ta.sma(close, 200)
plot(sma200, color=color.white, title="SMA 200")

//---------------------------------------------------------------------------------------------------------------------}
// Constants & Variables
//---------------------------------------------------------------------------------------------------------------------{

COLOR_GREEN = #089981
COLOR_RED   = #f23645
COLOR_BLUE  = #5b9cf6

var color vrColor  = color.new(COLOR_RED, 90) 
var color vsColor  = color.new(COLOR_GREEN, 90) 
var color sbrColor = color.new(COLOR_RED, 85) 
var color rbsColor = color.new(COLOR_GREEN, 85) 
var color ivsColor = color.new(COLOR_BLUE, 85) 
var color ivrColor = color.new(COLOR_BLUE, 85) 

isHighTf = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly or (timeframe.isminutes and timeframe.multiplier >= 240)

defaultLeft  = isHighTf ? 4 : 10
defaultRight = isHighTf ? 2 : 5

autoLeft  = useAuto ? defaultLeft  : leftLen
autoRight = useAuto ? defaultRight : rightLen

ph = ta.pivothigh(high, autoLeft, autoRight)
pl = ta.pivotlow(low, autoLeft, autoRight)

var box[] liveVr = array.new_box()
var box[] liveVs = array.new_box()
var box[] liveIvr = array.new_box()
var box[] liveIvs = array.new_box()

var int supportBreakCount = 0
var int resistanceBreakCount = 0

isNewDay = ta.change(time("D")) != 0

buySignal = false
sellSignal = false

//---------------------------------------------------------------------------------------------------------------------}
// Core MOS Logic (Zone Mapping)
//---------------------------------------------------------------------------------------------------------------------{

if not na(ph)
    topVal = high[autoRight]
    botVal = math.max(open[autoRight], close[autoRight])
    bx = box.new(left=bar_index - autoRight, top=topVal, right=bar_index, bottom=botVal, bgcolor=vrColor, border_color=COLOR_RED, border_style=line.style_solid)
    array.push(liveVr, bx)
    if array.size(liveVr) > maxZones
        box.delete(array.shift(liveVr))

if not na(pl)
    topVal = math.min(open[autoRight], close[autoRight])
    botVal = low[autoRight]
    bx = box.new(left=bar_index - autoRight, top=topVal, right=bar_index, bottom=botVal, bgcolor=vsColor, border_color=COLOR_GREEN, border_style=line.style_solid)
    array.push(liveVs, bx)
    if array.size(liveVs) > maxZones
        box.delete(array.shift(liveVs))

if barstate.isconfirmed
    if isNewDay
        supportBreakCount := 0
        resistanceBreakCount := 0

    if array.size(liveVr) > 0
        for i = array.size(liveVr) - 1 to 0 by 1
            b   = array.get(liveVr, i)
            top = box.get_top(b)
            bot = box.get_bottom(b)
            box.set_right(b, bar_index)
            
            if close > top and close[1] <= top
                resistanceBreakCount += 1
                if resistanceBreakCount >= 2
                    buySignal := true
                    resistanceBreakCount := 0
                else if showSBR
                    box.set_bgcolor(b, rbsColor)
                    box.set_border_color(b, COLOR_GREEN)
                    buySignal := true
                
                if showInversion
                    box.set_bgcolor(b, ivrColor)
                    box.set_border_color(b, COLOR_BLUE)
                    array.push(liveIvr, b)
                
                array.remove(liveVr, i)
                
            else if high > top and close < top and showSweep and high[1] <= top
                sellSignal := true

    if array.size(liveVs) > 0
        for i = array.size(liveVs) - 1 to 0 by 1
            b   = array.get(liveVs, i)
            bot = box.get_bottom(b)
            top = box.get_top(b)
            box.set_right(b, bar_index)
            
            if close < bot and close[1] >= bot
                supportBreakCount += 1
                
                if supportBreakCount >= 2
                    sellSignal := true
                    supportBreakCount := 0
                else if showSBR
                    box.set_bgcolor(b, sbrColor)
                    box.set_border_color(b, COLOR_RED)
                    sellSignal := true
                
                if showInversion
                    box.set_bgcolor(b, ivsColor)
                    box.set_border_color(b, COLOR_BLUE)
                    array.push(liveIvs, b)
                
                array.remove(liveVs, i)
                
            else if low < bot and close > bot and showSweep and low[1] >= bot
                buySignal := true

    if showPO2
        if array.size(liveIvr) > 0
            for i = array.size(liveIvr) - 1 to 0 by 1
                b = array.get(liveIvr, i)
                top = box.get_top(b)
                bot = box.get_bottom(b)
                box.set_right(b, bar_index)
                
                if low <= top and high >= bot and close > bot and close[1] > top
                    buySignal := true
                    array.remove(liveIvr, i)
                    
        if array.size(liveIvs) > 0
            for i = array.size(liveIvs) - 1 to 0 by 1
                b = array.get(liveIvs, i)
                bot = box.get_bottom(b)
                top = box.get_top(b)
                box.set_right(b, bar_index)
                
                if high >= bot and low <= top and close < top and close[1] < bot
                    sellSignal := true
                    array.remove(liveIvs, i)
else
    if array.size(liveVr) > 0
        for i = 0 to array.size(liveVr) - 1 by 1
            box.set_right(array.get(liveVr, i), bar_index)
    if array.size(liveVs) > 0
        for i = 0 to array.size(liveVs) - 1 by 1
            box.set_right(array.get(liveVs, i), bar_index)
    if array.size(liveIvr) > 0
        for i = 0 to array.size(liveIvr) - 1 by 1
            box.set_right(array.get(liveIvr, i), bar_index)
    if array.size(liveIvs) > 0
        for i = 0 to array.size(liveIvs) - 1 by 1
            box.set_right(array.get(liveIvs, i), bar_index)

//---------------------------------------------------------------------------------------------------------------------}
// Strategy Execution Combined with Base Concept
//---------------------------------------------------------------------------------------------------------------------{

longCondition = buySignal and close > sma200
shortCondition = sellSignal and close < sma200

if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL Long", from_entry="Long", stop=strategy.position_avg_price * (1 - stopLossPct))
    if volSpike
        strategy.close("Long", comment="Vol Exit")

if strategy.position_size < 0
    strategy.exit("SL Short", from_entry="Short", stop=strategy.position_avg_price * (1 + stopLossPct))
    if volSpike
        strategy.close("Short", comment="Vol Exit")