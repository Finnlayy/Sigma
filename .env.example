# =============================================================================
# Projekt:Sigma — Example Env (Blueprint §9 Env-Matrix)
# Copy to .env and fill secrets — never commit .env
# =============================================================================
# Core
SIGMA_DATA_DIR=./data
SIGMA_REDIS_URL=redis://127.0.0.1:6379/0
SIGMA_LIVE_TRADING=0
SIGMA_LOG_LEVEL=INFO

# Webhook — §17.1 mandatory in prod, timing-safe compare
SIGMA_WEBHOOK_SECRET=change-me-to-32-char-random-secret

# TradingView
SIGMA_TV_STORAGE_STATE=./data/secrets/tv_storage_state.json
SIGMA_TV_SCRAPER_URL=http://127.0.0.1:8001
SIGMA_TV_MCP_URL=fake
SIGMA_SELECTORS_PATH=./app/tv/selectors.yaml
SIGMA_SELECTORS_REMOTE_URL=https://raw.githubusercontent.com/Finnlayy/Sigma/main/app/tv/selectors.yaml
# Optional integrity check
# SIGMA_SELECTORS_SHA256=

# Quant / ONNX
SIGMA_ONNX_MODEL_PATH=./models/regime_classifier.onnx

# Flywheel — set after live approval
SIGMA_FLYWHEEL_USD_TO_EUR_RATE=0.92
SIGMA_FLYWHEEL_SPOT_EXECUTION=0

# GA hardening — env cannot exceed caps (15 pop, 5 gen, concurrency 1)
SIGMA_GA_MAX_POPULATION=15
SIGMA_GA_MAX_GENERATIONS=5
SIGMA_TV_CONCURRENCY=1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ollama
SIGMA_OLLAMA_URL=http://127.0.0.1:11434
